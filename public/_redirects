# 301 Redirects — single source of truth (Cloudflare edge-level)
# Wildcard :splat captures non-empty string after prefix
# Note: Cloudflare splat requires at least 1 char, so /en/ needs separate exact rule

# Old "en" prefix → root (en is default locale, no prefix needed)
/en     /           301
/en/    /           301
/en/*   /:splat     301

# Old "eng" prefix → root (legacy English prefix, deprecated)
/eng    /           301
/eng/   /           301
/eng/*  /:splat     301

# Old "converter" slug → correct "unit-converter" (per locale, both slash variants)
/converter      /unit-converter/      301
/converter/     /unit-converter/      301
/es/converter   /es/unit-converter/   301
/es/converter/  /es/unit-converter/   301
/pt/converter   /pt/unit-converter/   301
/pt/converter/  /pt/unit-converter/   301
/id/converter   /id/unit-converter/   301
/id/converter/  /id/unit-converter/   301
/ru/converter   /ru/unit-converter/   301
/ru/converter/  /ru/unit-converter/   301
/de/converter   /de/unit-converter/   301
/de/converter/  /de/unit-converter/   301
/ar/converter   /ar/unit-converter/   301
/ar/converter/  /ar/unit-converter/   301
