---
import { languages, type Lang } from '../i18n/ui';
import { getAlternateUrl } from '../i18n/utils';

export interface Props {
  title: string;
  lang: Lang;
}

const { title, lang } = Astro.props;

const allLangs = Object.keys(languages) as Lang[];

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "OPN Chat",
  "url": "https://opnchat.net",
  "description": "Message WhatsApp without saving the number. Free, private, no sign-up. Enter any phone number and start chatting instantly.",
  "inLanguage": allLangs,
};
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#25D366" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="OPN Chat" />
    <link rel="apple-touch-icon" href="/icon-192.svg" />
    {allLangs.map((l) => (
      <link rel="alternate" hreflang={l} href={getAlternateUrl(l)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={getAlternateUrl('en')} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <slot name="meta" />
    <meta name="robots" content="index, follow" />
  </head>
  <body>
    <slot />
    <script is:inline>
      // Theme: apply early to avoid flash
      (function() {
        var saved = localStorage.getItem('opnchat-theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = saved || (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();

      // Service Worker
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function() {
          navigator.serviceWorker.register('/sw.js').then(function(reg) {
            reg.update();
          }).catch(function() {});
        });
      }
    </script>
  </body>
</html>

<style is:global>
  /* Inter — self-hosted */
  @font-face {
    font-family: 'Inter';
    src: url('/fonts/Inter-Regular.woff2') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Inter';
    src: url('/fonts/Inter-Medium.woff2') format('woff2');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Inter';
    src: url('/fonts/Inter-SemiBold.woff2') format('woff2');
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Inter';
    src: url('/fonts/Inter-Bold.woff2') format('woff2');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* Force all form elements to inherit Inter from body */
  input,
  button,
  textarea,
  select {
    font-family: inherit;
  }

  /* ===== Dark theme (default) ===== */
  :root,
  [data-theme="dark"] {
    --opn-primary: #25D366;
    --opn-primary-dark: #1da851;
    --opn-primary-light: #6fe89d;
    --bg-primary: #0a0f1a;
    --bg-secondary: #101828;
    --bg-input: #1a2332;
    --text-primary: #e9edf5;
    --text-secondary: #8696a8;
    --border-color: #253040;
    --pattern-opacity: 0.04;
    --card-shadow: none;
  }

  /* ===== Light theme (premium Slate palette) ===== */
  [data-theme="light"] {
    --bg-primary: #f8fafc;
    --bg-secondary: #ffffff;
    --bg-input: #f1f5f9;
    --text-primary: #0f172a;
    --text-secondary: #64748b;
    --border-color: #e2e8f0;
    --pattern-opacity: 0.06;
    --card-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.05), 0 2px 4px -2px rgb(0 0 0 / 0.05);
  }

  body {
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    background-color: var(--bg-primary);
    color: var(--text-primary);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow-x: hidden;
    overflow-y: auto;
    position: relative;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  /* Subtle background pattern */
  body::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: var(--pattern-opacity);
    background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%2325D366' fill-opacity='1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 0;
    transition: opacity 0.25s ease;
  }

  /* ===== Theme toggle button ===== */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--bg-secondary);
    border: 1.5px solid var(--border-color);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.2s;
    padding: 0;
    flex-shrink: 0;
  }

  .theme-toggle:hover {
    color: var(--opn-primary);
    border-color: var(--opn-primary);
    background: var(--bg-input);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--opn-primary);
    outline-offset: 2px;
  }

  .theme-toggle svg {
    width: 18px;
    height: 18px;
  }

  /* Show sun in dark, moon in light */
  [data-theme="dark"] .theme-toggle .icon-sun { display: block; }
  [data-theme="dark"] .theme-toggle .icon-moon { display: none; }
  [data-theme="light"] .theme-toggle .icon-sun { display: none; }
  [data-theme="light"] .theme-toggle .icon-moon { display: block; }
</style>
