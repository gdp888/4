---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/utils';
import { getRelativeLocaleUrl, getAbsoluteLocaleUrl } from 'astro:i18n';
import { defaultLang, type Lang } from '../../i18n/ui';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import ToolSidebar from '../../components/ToolSidebar.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, lang: defaultLang },
  }));
}

const { post, lang } = Astro.props;
const { Content } = await post.render();
const t = useTranslations(lang);

const postSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": post.data.title,
      "description": post.data.description,
      "datePublished": post.data.pubDate.toISOString(),
      "url": getAbsoluteLocaleUrl(lang, `blog/${post.slug}`),
      "publisher": {
        "@type": "Organization",
        "name": "OPN Chat",
        "url": "https://opnchat.net/"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "OPN Chat",
          "item": getAbsoluteLocaleUrl(lang, '')
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('blog.title'),
          "item": getAbsoluteLocaleUrl(lang, 'blog')
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": post.data.title,
          "item": getAbsoluteLocaleUrl(lang, `blog/${post.slug}`)
        }
      ]
    }
  ]
};
---

<Layout title={`${post.data.title} | OPN Chat`} lang={lang}>
  <Fragment slot="meta">
    <meta name="description" content={post.data.description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={getAbsoluteLocaleUrl(lang, `blog/${post.slug}`)} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={post.data.title} />
    <meta property="og:description" content={post.data.description} />
    <script type="application/ld+json" set:html={JSON.stringify(postSchema)} />
  </Fragment>

  <div class="page-layout">
    <ToolSidebar lang={lang} activeTool="blog" />
    <main class="main-content">
      <div class="container">
        <!-- Header with nav -->
        <header class="site-header">
          <a href={getRelativeLocaleUrl(lang)} class="logo" aria-label="OPN Chat — Home">
            <span class="logo-text">OPN Chat</span>
            <svg viewBox="0 0 24 24" fill="currentColor" class="logo-icon" aria-hidden="true">
              <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
            </svg>
          </a>
          <LanguageSwitcher lang={lang} path="blog" />
          <button type="button" class="theme-toggle" aria-label="Toggle theme" id="theme-toggle">
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </button>
        </header>

        <!-- Breadcrumbs -->
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href={getRelativeLocaleUrl(lang)} class="bc-link">{t('bc.home')}</a>
          <span class="bc-sep">›</span>
          <a href={getRelativeLocaleUrl(lang, 'blog')} class="bc-link">{t('bc.blog')}</a>
          <span class="bc-sep">›</span>
          <span class="bc-current">{post.data.title}</span>
        </nav>

        <article class="post-article">
          <span class="post-date">
            {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </span>
          <h1 class="post-title">{post.data.title}</h1>
          <div class="post-content">
            <Content />
          </div>
        </article>
      </div>
    </main>
  </div>
</Layout>

<style>
  .page-layout {
    display: flex;
    gap: 1.5rem;
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1.25rem;
    min-height: 100vh;
  }

  .main-content {
    flex: 1;
    min-width: 0;
  }

  .container {
    position: relative;
    z-index: 1;
    width: 100%;
    margin: 0 auto;
    max-width: 680px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Site Header */
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 0.75rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--text-primary);
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .logo:hover {
    color: var(--opn-primary);
  }

  .logo-text {
    color: var(--text-primary);
  }

  .logo-icon {
    width: 18px;
    height: 18px;
    color: var(--opn-primary);
  }

  /* Breadcrumbs */
  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .bc-link {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s;
  }

  .bc-link:hover {
    color: var(--opn-primary);
  }

  .bc-sep {
    color: var(--text-secondary);
    opacity: 0.5;
  }

  .bc-current {
    font-weight: 600;
    color: var(--text-primary);
  }

  .post-article {
    margin-bottom: 2rem;
  }

  .post-date {
    font-size: 0.75rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .post-title {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0.5rem 0 1.5rem;
    line-height: 1.2;
  }

  /* Markdown content styles */
  .post-content :global(h2) {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 2rem 0 0.75rem;
    line-height: 1.3;
  }

  .post-content :global(h3) {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 1.5rem 0 0.5rem;
    line-height: 1.3;
  }

  .post-content :global(p) {
    font-size: 1rem;
    color: var(--text-primary);
    line-height: 1.7;
    margin: 0 0 1rem;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 0 0 1rem;
    padding-left: 1.5rem;
  }

  .post-content :global(li) {
    font-size: 1rem;
    color: var(--text-primary);
    line-height: 1.7;
    margin-bottom: 0.35rem;
  }

  .post-content :global(a) {
    color: var(--opn-primary);
    text-decoration: none;
  }

  .post-content :global(a:hover) {
    text-decoration: underline;
  }

  .post-content :global(strong) {
    font-weight: 700;
    color: var(--text-primary);
  }

  .post-content :global(blockquote) {
    border-left: 3px solid var(--opn-primary);
    padding: 0.5rem 1rem;
    margin: 1rem 0;
    color: var(--text-secondary);
    font-style: italic;
  }

  .post-content :global(code) {
    background: var(--bg-input);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.9rem;
  }

  .post-content :global(pre) {
    background: var(--bg-input);
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 1rem 0;
  }

  .post-content :global(pre code) {
    background: none;
    padding: 0;
  }

  @media (max-width: 768px) {
    .page-layout {
      flex-direction: column;
      max-width: 680px;
    }
  }

  @media (max-width: 520px) {
    .page-layout {
      padding: 1.25rem 1rem;
    }
    .site-header {
      justify-content: center;
    }
    .post-title {
      font-size: 1.5rem;
    }
  }
</style>
