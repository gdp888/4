---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { useTranslations, getLocalizedPath, getAlternateUrl } from '../../i18n/utils';
import { defaultLang, type Lang } from '../../i18n/ui';

// Blog listing is English-only for now
const lang: Lang = defaultLang;
const t = useTranslations(lang);

const allPosts = await getCollection('blog', ({ data }) => data.lang === 'en');
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const blogSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": t('blog.title'),
      "description": t('blog.description'),
      "url": getAlternateUrl(lang, 'blog'),
      "isPartOf": {
        "@type": "WebSite",
        "name": "OPN Chat",
        "url": "https://opnchat.net/"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "OPN Chat",
          "item": getAlternateUrl(lang, '')
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('blog.title'),
          "item": getAlternateUrl(lang, 'blog')
        }
      ]
    }
  ]
};
---

<Layout title={`${t('blog.title')} | OPN Chat`} lang={lang}>
  <Fragment slot="meta">
    <meta name="description" content={t('blog.description')} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={getAlternateUrl(lang, 'blog')} />
    <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />
  </Fragment>

  <main class="blog-container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={getLocalizedPath(lang)} class="bc-link">{t('bc.home')}</a>
      <span class="bc-sep">›</span>
      <span class="bc-current">{t('bc.blog')}</span>
    </nav>

    <header class="blog-header">
      <a href={getLocalizedPath(lang)} class="back-home">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="back-icon">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        OPN Chat
      </a>
      <button type="button" class="theme-toggle" aria-label="Toggle theme" id="theme-toggle">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
    </header>

    <h1 class="blog-title">{t('blog.title')}</h1>
    <p class="blog-subtitle">{t('blog.description')}</p>

    <div class="posts-list">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}`} class="post-card">
          <span class="post-date">
            {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </span>
          <h2 class="post-title">{post.data.title}</h2>
          <p class="post-excerpt">{post.data.description}</p>
        </a>
      ))}
    </div>

    {posts.length === 0 && (
      <p class="no-posts">{t('blog.noPosts')}</p>
    )}

    <footer class="blog-footer">
      <p class="disclaimer-brief">OPN Chat is not affiliated with Meta, WhatsApp, or OpenChat DAO.</p>
    </footer>
  </main>
</Layout>

<style>
  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .bc-link {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s;
  }

  .bc-link:hover {
    color: var(--opn-primary);
  }

  .bc-sep {
    color: var(--text-secondary);
    opacity: 0.5;
  }

  .bc-current {
    font-weight: 600;
    color: var(--text-primary);
  }

  .blog-container {
    max-width: 680px;
    width: 100%;
    padding: 1.5rem;
    margin: 0 auto;
  }

  .blog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .back-home {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.2s;
  }

  .back-home:hover {
    color: var(--opn-primary);
  }

  .back-icon {
    width: 18px;
    height: 18px;
  }

  .blog-title {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .blog-subtitle {
    font-size: 1rem;
    color: var(--text-secondary);
    margin-bottom: 2rem;
    line-height: 1.5;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .post-card {
    display: block;
    padding: 1.25rem 1.5rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.2s;
  }

  .post-card:hover {
    border-color: var(--opn-primary);
    transform: translateY(-1px);
    box-shadow: var(--card-shadow), 0 4px 12px rgba(37, 211, 102, 0.08);
  }

  .post-date {
    font-size: 0.75rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .post-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0.4rem 0;
    line-height: 1.3;
  }

  .post-excerpt {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .no-posts {
    text-align: center;
    color: var(--text-secondary);
    padding: 3rem 0;
  }

  .blog-footer {
    text-align: center;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
  }

  .disclaimer-brief {
    font-size: 0.7rem;
    color: var(--text-secondary);
    opacity: 0.5;
    line-height: 1.45;
  }

  @media (max-width: 520px) {
    .blog-container {
      padding: 1.25rem 1rem;
    }
    .blog-title {
      font-size: 1.5rem;
    }
    .post-card {
      padding: 1rem 1.25rem;
    }
  }
</style>


