---
import Layout from '../layouts/Layout.astro';
import { useTranslations, getLocalizedPath } from '../i18n/utils';
import { languages, defaultLang, type Lang } from '../i18n/ui';

// Detect language from URL path (2-letter codes: en, es, pt, id)
// EN is at root (no prefix), others have /es/, /pt/, /id/ prefix
function getLangFromPath(pathname: string): Lang {
  const segments = pathname.split('/').filter(Boolean);
  const first = segments[0];
  if (first && first in languages) return first as Lang;
  return defaultLang; // root paths = English
}

const lang = getLangFromPath(Astro.url.pathname);
const t = useTranslations(lang);
---

<Layout title={`404 — ${t('404.title')} | OPN Chat`} lang={lang}>
  <Fragment slot="meta">
    <meta name="description" content={t('404.message')} />
    <meta name="robots" content="noindex, follow" />
  </Fragment>

  <main class="container">
    <!-- Header with theme toggle -->
    <header class="site-header">
      <a href={getLocalizedPath(lang, 'whatsapp')} class="logo" aria-label="OPN Chat — Home">
        <span class="logo-text">OPN Chat</span>
        <svg viewBox="0 0 24 24" fill="currentColor" class="logo-icon" aria-hidden="true">
          <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
        </svg>
      </a>
      <button type="button" class="theme-toggle" aria-label="Toggle theme" id="theme-toggle">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
    </header>

    <div class="error-content">
      <div class="error-code">{t('404.heading')}</div>
      <h1 class="error-title">{t('404.message')}</h1>
      <p class="error-desc">{t('404.description')}</p>

      <a href={getLocalizedPath(lang, 'whatsapp')} class="back-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="back-icon">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        {t('404.back')}
      </a>
    </div>
  </main>
</Layout>

<style>
  /* Site Header */
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text-primary);
  }

  @media (max-width: 640px) {
    .logo { display: none; }
  }

  .logo-icon {
    width: 24px;
    height: 24px;
    color: var(--opn-primary);
    flex-shrink: 0;
  }

  .logo-text {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .container {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 520px;
    padding: 2rem 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 80vh;
  }

  .error-content {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .error-code {
    font-size: 8rem;
    font-weight: 800;
    line-height: 1;
    background: linear-gradient(135deg, #25D366, #6fe89d);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.04em;
    user-select: none;
    opacity: 0.9;
  }

  .error-title {
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.4;
    max-width: 380px;
  }

  .error-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 340px;
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #fff;
    background: var(--opn-primary);
    text-decoration: none;
    font-size: 1rem;
    font-weight: 600;
    padding: 0.85rem 1.75rem;
    border-radius: 12px;
    transition: all 0.2s;
    margin-top: 0.75rem;
  }

  .back-btn:hover {
    background: var(--opn-primary-dark);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.3);
  }

  .back-btn:active {
    transform: translateY(0);
    box-shadow: none;
  }

  .back-btn:focus-visible {
    outline: 2px solid var(--opn-primary);
    outline-offset: 2px;
  }

  .back-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  @media (max-width: 520px) {
    .container {
      padding: 1.25rem 1rem;
    }
    .error-code {
      font-size: 6rem;
    }
    .error-title {
      font-size: 1.15rem;
    }
    .error-desc {
      font-size: 0.85rem;
    }
    .site-header {
      justify-content: center;
    }
  }
</style>


