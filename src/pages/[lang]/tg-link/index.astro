---
import TgLinkContent from '../../../components/TgLinkContent.astro';
import { languages, defaultLang, type Lang } from '../../../i18n/ui';

// Only non-default languages — default (en) lives at root: /tg-link/
export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).filter((lang) => lang !== defaultLang).map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

const { lang } = Astro.props;
---

<TgLinkContent lang={lang} />
