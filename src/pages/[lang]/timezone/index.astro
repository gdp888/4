---
import TimeZoneContent from '../../../components/TimeZoneContent.astro';
import { languages, defaultLang, type Lang } from '../../../i18n/ui';

// Only non-default languages — default (en) lives at root: /timezone/
export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).filter((lang) => lang !== defaultLang).map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

const { lang } = Astro.props;
export const prerender = true;
---

<TimeZoneContent lang={lang} />
