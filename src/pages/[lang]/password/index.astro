---
import PasswordContent from '../../../components/PasswordContent.astro';
import { languages, defaultLang, type Lang } from '../../../i18n/ui';

// Only non-default languages — default (en) lives at root: /password/
export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).filter((lang) => lang !== defaultLang).map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

const { lang } = Astro.props;
---

<PasswordContent lang={lang} />
