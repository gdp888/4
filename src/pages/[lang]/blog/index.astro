---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../../i18n/utils';
import { getRelativeLocaleUrl, getAbsoluteLocaleUrl } from 'astro:i18n';
import { languages, defaultLang, type Lang } from '../../../i18n/ui';
import ToolSidebar from '../../../components/ToolSidebar.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SEOHead from '../../../components/SEOHead.astro';
import { localeMap, dateLocaleMap } from '../../../i18n/localeMap';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[])
    .filter((lang) => lang !== defaultLang)
    .map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Locale for date formatting
const dateLocale = dateLocaleMap[lang] || 'en-US';

const allPosts = await getCollection('blog', ({ data }) => data.lang === lang);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const blogSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": t('blog.title'),
      "description": t('blog.description'),
      "url": getAbsoluteLocaleUrl(lang, 'blog'),
      "isPartOf": {
        "@type": "WebSite",
        "name": "OPN Chat",
        "url": "https://opnchat.net/"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "OPN Chat",
          "item": getAbsoluteLocaleUrl(lang, '')
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('blog.title'),
          "item": getAbsoluteLocaleUrl(lang, 'blog')
        }
      ]
    }
  ]
};
---

<Layout title={`${t('blog.title')} | OPN Chat`} lang={lang}>
  <Fragment slot="meta">
  <SEOHead
  lang={lang}
  description={t('blog.description')}
  canonicalUrl={getAbsoluteLocaleUrl(lang, 'blog')}
  ogTitle={t('blog.title')}
  ogDescription={t('blog.description')}
  ogUrl={getAbsoluteLocaleUrl(lang, 'blog')}
  schema={blogSchema}
  extraMeta={`<meta name="robots" content="index, follow" />`}
/>
</Fragment>

  <div class="page-layout">
    <ToolSidebar lang={lang} activeTool="blog" />
    <main class="main-content">
      <div class="container">
            <SiteHeader lang={lang} path="blog" />

            <Breadcrumbs lang={lang} items={[{ label: t('bc.home'), href: getRelativeLocaleUrl(lang) }, { label: t('bc.blog') }]} />

        <h1 class="blog-title">{t('blog.title')}</h1>
        <p class="blog-subtitle">{t('blog.description')}</p>

        <div class="posts-list">
          {posts.map((post) => (
            <a href={getRelativeLocaleUrl(lang, `blog/${post.slug}`)} class="post-card">
              <span class="post-date">
                {post.data.pubDate.toLocaleDateString(dateLocale, { year: 'numeric', month: 'long', day: 'numeric' })}
              </span>
              <h2 class="post-title">{post.data.title}</h2>
              <p class="post-excerpt">{post.data.description}</p>
            </a>
          ))}
        </div>

        {posts.length === 0 && (
          <p class="no-posts">{t('blog.noPosts')}</p>
        )}
      </div>
    </main>
  </div>
</Layout>

<style>
  .page-layout {
    display: flex;
    gap: 1.5rem;
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1.25rem;
    min-height: 100vh;
  }

  .main-content {
    flex: 1;
    min-width: 0;
  }

  .container {
    position: relative;
    z-index: 1;
    width: 100%;
    margin: 0 auto;
    max-width: 680px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .blog-title {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .blog-subtitle {
    font-size: 1rem;
    color: var(--text-secondary);
    margin-bottom: 2rem;
    line-height: 1.5;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .post-card {
    display: block;
    padding: 1.25rem 1.5rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.2s;
  }

  .post-card:hover {
    border-color: var(--opn-primary);
    transform: translateY(-1px);
    box-shadow: var(--card-shadow), 0 4px 12px rgba(37, 211, 102, 0.08);
  }

  .post-date {
    font-size: 0.75rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .post-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0.4rem 0;
    line-height: 1.3;
  }

  .post-excerpt {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .no-posts {
    text-align: center;
    color: var(--text-secondary);
    padding: 3rem 0;
  }

  @media (max-width: 768px) {
    .page-layout {
      flex-direction: column;
      max-width: 680px;
    }
  }

  @media (max-width: 520px) {
    .page-layout {
      padding: 1.25rem 1rem;
    }

    .blog-title {
      font-size: 1.5rem;
    }
    .post-card {
      padding: 1rem 1.25rem;
    }
  }
</style>
