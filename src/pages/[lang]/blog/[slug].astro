---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../../i18n/utils';
import { getRelativeLocaleUrl, getAbsoluteLocaleUrl } from 'astro:i18n';
import { languages, defaultLang, type Lang } from '../../../i18n/ui';
import ToolSidebar from '../../../components/ToolSidebar.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SEOHead from '../../../components/SEOHead.astro';
import { localeMap, dateLocaleMap } from '../../../i18n/localeMap';

export async function getStaticPaths() {
  const nonDefaultLangs = (Object.keys(languages) as Lang[]).filter(l => l !== defaultLang);
  const results = [];
  for (const lang of nonDefaultLangs) {
    const posts = await getCollection('blog', ({ data }) => data.lang === lang);
    for (const post of posts) {
      results.push({
        params: { lang, slug: post.slug },
        props: { post, lang },
      });
    }
  }
  return results;
}

const { post, lang } = Astro.props;
const { Content } = await post.render();
const t = useTranslations(lang);

// Locale for date formatting
const dateLocale = dateLocaleMap[lang] || 'en-US';

const postSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": post.data.title,
      "description": post.data.description,
      "datePublished": post.data.pubDate.toISOString(),
      "url": getAbsoluteLocaleUrl(lang, `blog/${post.slug}`),
      "publisher": {
        "@type": "Organization",
        "name": "OPN Chat",
        "url": "https://opnchat.net/"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "OPN Chat",
          "item": getAbsoluteLocaleUrl(lang, '')
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('blog.title'),
          "item": getAbsoluteLocaleUrl(lang, 'blog')
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": post.data.title,
          "item": getAbsoluteLocaleUrl(lang, `blog/${post.slug}`)
        }
      ]
    }
  ]
};
---

<Layout title={`${post.data.title} | OPN Chat`} lang={lang}>
  <Fragment slot="meta">
  <SEOHead
  lang={lang}
  description={post.data.description}
  canonicalUrl={getAbsoluteLocaleUrl(lang, `blog/${post.slug}`)}
  ogTitle={post.data.title}
  ogDescription={post.data.description}
  ogUrl={getAbsoluteLocaleUrl(lang, `blog/${post.slug}`)}
  ogType="article"
  schema={postSchema}
  extraMeta={`<meta name="robots" content="index, follow" />`}
/>
</Fragment>

  <div class="page-layout">
    <ToolSidebar lang={lang} activeTool="blog" />
    <main class="main-content">
      <div class="container">
            <SiteHeader lang={lang} path="blog" />

            <Breadcrumbs lang={lang} items={[{ label: t('bc.home'), href: getRelativeLocaleUrl(lang) }, { label: t('bc.blog'), href: getRelativeLocaleUrl(lang, 'blog') }, { label: post.data.title }]} />

        <article class="post-article">
          <span class="post-date">
            {post.data.pubDate.toLocaleDateString(dateLocale, { year: 'numeric', month: 'long', day: 'numeric' })}
          </span>
          <h1 class="post-title">{post.data.title}</h1>
          <div class="post-content">
            <Content />
          </div>
        </article>
      </div>
    </main>
  </div>
</Layout>

<style>
  .page-layout {
    display: flex;
    gap: 1.5rem;
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1.25rem;
    min-height: 100vh;
  }

  .main-content {
    flex: 1;
    min-width: 0;
  }

  .container {
    position: relative;
    z-index: 1;
    width: 100%;
    margin: 0 auto;
    max-width: 680px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .post-article {
    margin-bottom: 2rem;
  }

  .post-date {
    font-size: 0.75rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .post-title {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0.5rem 0 1.5rem;
    line-height: 1.2;
  }

  /* Markdown content styles */
  .post-content :global(h2) {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 2rem 0 0.75rem;
    line-height: 1.3;
  }

  .post-content :global(h3) {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 1.5rem 0 0.5rem;
    line-height: 1.3;
  }

  .post-content :global(p) {
    font-size: 1rem;
    color: var(--text-primary);
    line-height: 1.7;
    margin: 0 0 1rem;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 0 0 1rem;
    padding-left: 1.5rem;
  }

  .post-content :global(li) {
    font-size: 1rem;
    color: var(--text-primary);
    line-height: 1.7;
    margin-bottom: 0.35rem;
  }

  .post-content :global(a) {
    color: var(--opn-primary);
    text-decoration: none;
  }

  .post-content :global(a:hover) {
    text-decoration: underline;
  }

  .post-content :global(strong) {
    font-weight: 700;
    color: var(--text-primary);
  }

  .post-content :global(blockquote) {
    border-left: 3px solid var(--opn-primary);
    padding: 0.5rem 1rem;
    margin: 1rem 0;
    color: var(--text-secondary);
    font-style: italic;
  }

  .post-content :global(code) {
    background: var(--bg-input);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.9rem;
  }

  .post-content :global(pre) {
    background: var(--bg-input);
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 1rem 0;
  }

  .post-content :global(pre code) {
    background: none;
    padding: 0;
  }

  @media (max-width: 768px) {
    .page-layout {
      flex-direction: column;
      max-width: 680px;
    }
  }

  @media (max-width: 520px) {
    .page-layout {
      padding: 1.25rem 1rem;
    }

    .post-title {
      font-size: 1.5rem;
    }
  }
</style>
