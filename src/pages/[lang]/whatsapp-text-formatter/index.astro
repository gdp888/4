---
import FormatterContent from '../../../components/FormatterContent.astro';
import { languages, defaultLang, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[])
    .filter((lang) => lang !== defaultLang)
    .map((lang) => ({ params: { lang }, props: { lang } }));
}
const { lang } = Astro.props;
export const prerender = true;
---
<FormatterContent lang={lang} />
