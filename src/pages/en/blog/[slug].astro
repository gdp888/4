---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { useTranslations, getLocalizedPath, getAlternateUrl } from '../../../i18n/utils';
import { defaultLang, type Lang } from '../../../i18n/ui';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, lang: defaultLang },
  }));
}

const { post, lang } = Astro.props;
const { Content } = await post.render();
const t = useTranslations(lang);
---

<Layout title={`${post.data.title} | OPN Chat`} lang={lang}>
  <Fragment slot="meta">
    <meta name="description" content={post.data.description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={getAlternateUrl(lang, `blog/${post.slug}`)} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={post.data.title} />
    <meta property="og:description" content={post.data.description} />
  </Fragment>

  <main class="post-container">
    <header class="post-header">
      <a href={getLocalizedPath(lang, 'blog')} class="back-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="back-icon">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        {t('blog.backToBlog')}
      </a>
      <div class="header-actions">
        <button type="button" class="theme-toggle" aria-label="Toggle theme" id="theme-toggle">
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
      </div>
    </header>

    <article class="post-article">
      <span class="post-date">
        {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </span>
      <h1 class="post-title">{post.data.title}</h1>
      <div class="post-content">
        <Content />
      </div>
    </article>

    <footer class="post-footer">
      <a href={getLocalizedPath(lang, 'blog')} class="back-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="back-icon">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        {t('blog.backToBlog')}
      </a>
      <p class="disclaimer-brief">OPN Chat is not affiliated with Meta, WhatsApp, or OpenChat DAO.</p>
    </footer>
  </main>
</Layout>

<style>
  .post-container {
    max-width: 680px;
    width: 100%;
    padding: 1.5rem;
    margin: 0 auto;
  }

  .post-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
  }

  .back-link {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--opn-primary);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .back-link:hover {
    opacity: 0.8;
  }

  .back-icon {
    width: 16px;
    height: 16px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .post-article {
    margin-bottom: 2rem;
  }

  .post-date {
    font-size: 0.75rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .post-title {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0.5rem 0 1.5rem;
    line-height: 1.2;
  }

  /* Markdown content styles */
  .post-content :global(h2) {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 2rem 0 0.75rem;
    line-height: 1.3;
  }

  .post-content :global(h3) {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 1.5rem 0 0.5rem;
    line-height: 1.3;
  }

  .post-content :global(p) {
    font-size: 1rem;
    color: var(--text-primary);
    line-height: 1.7;
    margin: 0 0 1rem;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 0 0 1rem;
    padding-left: 1.5rem;
  }

  .post-content :global(li) {
    font-size: 1rem;
    color: var(--text-primary);
    line-height: 1.7;
    margin-bottom: 0.35rem;
  }

  .post-content :global(a) {
    color: var(--opn-primary);
    text-decoration: none;
  }

  .post-content :global(a:hover) {
    text-decoration: underline;
  }

  .post-content :global(strong) {
    font-weight: 700;
    color: var(--text-primary);
  }

  .post-content :global(blockquote) {
    border-left: 3px solid var(--opn-primary);
    padding: 0.5rem 1rem;
    margin: 1rem 0;
    color: var(--text-secondary);
    font-style: italic;
  }

  .post-content :global(code) {
    background: var(--bg-input);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.9rem;
  }

  .post-content :global(pre) {
    background: var(--bg-input);
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 1rem 0;
  }

  .post-content :global(pre code) {
    background: none;
    padding: 0;
  }

  .post-footer {
    text-align: center;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
  }

  .disclaimer-brief {
    font-size: 0.7rem;
    color: var(--text-secondary);
    opacity: 0.5;
    line-height: 1.45;
    margin-top: 1rem;
  }

  @media (max-width: 520px) {
    .post-container {
      padding: 1.25rem 1rem;
    }
    .post-title {
      font-size: 1.5rem;
    }
  }
</style>

<script>
  const themeToggle = document.getElementById('theme-toggle');
  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme');
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('opnchat-theme', next);
    });
  }
</script>
