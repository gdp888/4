  // Daytime info
  function getDaytimeInfo(hours: number): { icon: string; period: string; className: string } {
    if (hours >= 5 && hours < 12) return { icon: '🌅', period: i18n.morning, className: 'morning' };
    if (hours >= 12 && hours < 17) return { icon: '☀️', period: i18n.day, className: 'day' };
    if (hours >= 17 && hours < 21) return { icon: '🌆', period: i18n.evening, className: 'evening' };
    return { icon: '🌙', period: i18n.night, className: 'night' };
  }

  // Update Analog Clock Hands
  function updateAnalogClock(hourEl: HTMLElement | null, minuteEl: HTMLElement | null, secondEl: HTMLElement | null, date: Date): void {
    if (!hourEl || !minuteEl || !secondEl) return;

    const hours = date.getHours() % 12;
    const minutes = date.getMinutes();
    const seconds = date.getSeconds();

    const hourAngle = (hours * 30) + (minutes * 0.5);
    const minuteAngle = minutes * 6;
    const secondAngle = seconds * 6;

    hourEl.style.transform = `rotate(${hourAngle}deg)`;
    minuteEl.style.transform = `rotate(${minuteAngle}deg)`;
    secondEl.style.transform = `rotate(${secondAngle}deg)`;
  }

  // Update Live Display
  function updateLiveDisplay(
    entry: SearchEntry,
    clockEl: HTMLElement | null,
    dateEl: HTMLElement | null,
    offsetEl: HTMLElement | null,
    daytimeEl: HTMLElement | null,
    emojiEl: HTMLElement | null,
    hourEl?: HTMLElement | null,
    minuteEl?: HTMLElement | null,
    secondEl?: HTMLElement | null
  ): void {
    try {
      const dateInTZ = getTimeInTZ(entry.tz);
      
      if (clockEl) clockEl.textContent = formatTime(dateInTZ);
      if (dateEl) dateEl.textContent = formatDate(dateInTZ);
      if (offsetEl) offsetEl.textContent = entry.offset;
      if (emojiEl) emojiEl.textContent = getRegionEmoji(entry.tz);
      
      if (daytimeEl) {
        const hours = dateInTZ.getHours();
        const daytime = getDaytimeInfo(hours);
        daytimeEl.innerHTML = `${daytime.icon} ${daytime.period}`;
        daytimeEl.className = `daytime-badge ${daytime.className}`;
      }

      updateAnalogClock(hourEl || null, minuteEl || null, secondEl || null, dateInTZ);
    } catch (e) {
      console.error('Error updating live display:', e);
    }
  }

  // Calculate Time Difference
  function calculateTimeDifference(timezone: string): string {
    const localTime = new Date();
    const localOffset = localTime.getTimezoneOffset() * 60000;
    const targetTime = new Date(new Date().toLocaleString('en-US', { timeZone: timezone }));

    const utcLocal = localTime.getTime() + localOffset;
    const utcTarget = targetTime.getTime() + localOffset;
    const diffHours = Math.round((utcTarget - utcLocal) / 3600000);

    if (diffHours === 0) {
      return i18n.sameTime;
    } else if (diffHours > 0) {
      return `${diffHours}h ${i18n.ahead}`;
    } else {
      return `${Math.abs(diffHours)}h ${i18n.behind}`;
    }
  }

  // Update Diff Info
  function updateDiffInfo(): void {
    if (!selectedCard1 || !selectedCard2) {
      if (diffInfo) diffInfo.style.display = 'none';
      return;
    }

    const diffMinutes = selectedCard2.offsetMinutes - selectedCard1.offsetMinutes;
    const absHours = Math.abs(Math.round(diffMinutes / 60 * 10) / 10);
    const absMinutes = Math.abs(diffMinutes % 60);

    let diffText = '';
    if (diffMinutes === 0) {
      diffText = i18n.sameTime;
    } else if (diffMinutes > 0) {
      diffText = `${absHours}h ${absMinutes > 0 ? absMinutes + 'm' : ''} ${i18n.ahead}`;
    } else {
      diffText = `${absHours}h ${absMinutes > 0 ? absMinutes + 'm' : ''} ${i18n.behind}`;
    }

    if (diffMain) diffMain.textContent = diffText;
    if (diffContext) diffContext.textContent = `${selectedCard1.localizedName} → ${selectedCard2.localizedName}`;
    if (diffInfo) diffInfo.style.display = 'block';
  }

  // Show Live Display
  function showLiveDisplay(
    searchInput: HTMLInputElement,
    resultsList: HTMLElement | null,
    liveDisplay: HTMLElement | null,
    entry: SearchEntry,
    cityEl: HTMLElement | null,
    clockEl: HTMLElement | null,
    dateEl: HTMLElement | null,
    offsetEl: HTMLElement | null,
    daytimeEl: HTMLElement | null,
    emojiEl: HTMLElement | null,
    changeBtn: HTMLElement | null,
    hourEl?: HTMLElement | null,
    minuteEl?: HTMLElement | null,
    secondEl?: HTMLElement | null
  ): void {
    if (searchInput) searchInput.style.display = 'none';
    if (resultsList) resultsList.style.display = 'none';
    if (liveDisplay) liveDisplay.style.display = 'block';

    if (cityEl) cityEl.textContent = entry.localizedName;
    
    updateLiveDisplay(entry, clockEl, dateEl, offsetEl, daytimeEl, emojiEl, hourEl, minuteEl, secondEl);
  }

  // Reset Card to Search
  function resetCardToSearch(
    searchInput: HTMLInputElement,
    resultsList: HTMLElement | null,
    liveDisplay: HTMLElement | null
  ): void {
    if (searchInput) {
      searchInput.style.display = 'block';
      searchInput.value = '';
    }
    if (resultsList) resultsList.style.display = 'none';
    if (liveDisplay) liveDisplay.style.display = 'none';
  }

  // Search Functionality
  function performSearch(query: string, resultsList: HTMLElement): void {
    if (!query.trim()) {
      resultsList.classList.remove('active');
      return;
    }

    const normalizedQuery = query.toLowerCase().replace(/[^a-zа-яё0-9+\-:_/\s]/giu, '');
    const matches = searchIndex.filter(item => item.searchStr.includes(normalizedQuery)).slice(0, 8);

    if (matches.length === 0) {
      resultsList.innerHTML = '<li class="search-result-item"><span class="result-city-name">No results found</span></li>';
      resultsList.classList.add('active');
      return;
    }

    resultsList.innerHTML = matches.map(item => `
      <li class="search-result-item" data-tz="${item.tz}" role="option">
        <span class="result-city-name">${item.localizedName}</span>
        <span class="result-city-offset">${item.offset}</span>
      </li>
    `).join('');
    resultsList.classList.add('active');
  }

  // Handle Result Selection
  function handleResultSelection(tzValue: string): SearchEntry | undefined {
    return searchIndex.find(item => item.tz === tzValue);
  }

