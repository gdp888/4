---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';
import { getRelativeLocaleUrl, getAbsoluteLocaleUrl } from 'astro:i18n';
import { languages, type Lang } from '../i18n/ui';
import SiteHeader from './SiteHeader.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import SEOHead from './SEOHead.astro';
import { localeMap } from '../i18n/localeMap';
import { timezones } from '../data/timezones';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Localized city name map for client-side JS
const cityTranslations: Record<string, string> = {};
const offsetMap: Record<string, string> = {};
timezones.forEach(tz => {
  cityTranslations[tz.value] = t(tz.cityKey);
  offsetMap[tz.value] = tz.offset;
});

const tzSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": t('tz.heading'),
      "url": getAbsoluteLocaleUrl(lang, 'timezone'),
      "description": t('tz.meta.description'),
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Any",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "isPartOf": {
        "@type": "WebSite",
        "name": "OPN Chat",
        "url": "https://opnchat.net/"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "OPN Chat",
          "item": getAbsoluteLocaleUrl(lang, '')
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('tz.heading'),
          "item": getAbsoluteLocaleUrl(lang, 'timezone')
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": t('tz.faq.q1'), "acceptedAnswer": { "@type": "Answer", "text": t('tz.faq.a1') } },
        { "@type": "Question", "name": t('tz.faq.q2'), "acceptedAnswer": { "@type": "Answer", "text": t('tz.faq.a2') } },
        { "@type": "Question", "name": t('tz.faq.q3'), "acceptedAnswer": { "@type": "Answer", "text": t('tz.faq.a3') } },
        { "@type": "Question", "name": t('tz.faq.q4'), "acceptedAnswer": { "@type": "Answer", "text": t('tz.faq.a4') } },
        { "@type": "Question", "name": t('tz.faq.q5'), "acceptedAnswer": { "@type": "Answer", "text": t('tz.faq.a5') } }
      ]
    }
  ]
};
---

<Layout title={t('tz.meta.title')} lang={lang} service="timezone">
  <Fragment slot="meta">
  <SEOHead
  lang={lang}
  description={t('tz.meta.description')}
  canonicalUrl={getAbsoluteLocaleUrl(lang, 'timezone')}
  ogTitle={t('tz.meta.og.title')}
  ogDescription={t('tz.meta.og.description')}
  ogUrl={getAbsoluteLocaleUrl(lang, 'timezone')}
  schema={tzSchema}
  extraMeta={`<meta name="keywords" content="${t('tz.meta.keywords')}" /><meta name="twitter:card" content="summary" /><meta name="twitter:title" content="${t('tz.meta.twitter.title')}" /><meta name="twitter:description" content="${t('tz.meta.twitter.description')}" />`}
/>
</Fragment>

  <div class="container">
      <!-- Header -->
      <SiteHeader lang={lang} path="timezone" activeTool="timezone" />

        <Breadcrumbs lang={lang} items={[{ label: t('bc.home'), href: getRelativeLocaleUrl(lang) }, { label: t('bc.timezone') }]} />

      <!-- Hero -->
      <div class="hero">
        <h1 class="title"><span class="title-full">{t('tz.heading')}</span><span class="title-short">{t('tz.heading.short')}</span></h1>
        <p class="subtitle">{t('tz.subtitle')}</p>
        <div class="privacy-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          {t('tz.privacy.badge')}
        </div>
      </div>

      <!-- ===== Guided Step-by-Step UX ===== -->

      <!-- Pass localized city names + offsets + i18n strings to client-side JS -->
      <div id="tz-city-data" data-cities={JSON.stringify(cityTranslations)} data-offsets={JSON.stringify(offsetMap)} style="display:none"></div>
      <div id="tz-i18n" data-lang={lang} data-same-time={t('tz.diff.same')} data-already-added={t('tz.modal.search.already_added')} data-no-results={t('tz.modal.search.no_results')} data-copy-time={t('tz.copy.time')} data-copy-done={t('tz.copy.done')} data-tl-title={t('tz.timeline.title')} data-tl-work={t('tz.timeline.legend.work')} data-tl-night={t('tz.timeline.legend.night')} data-tl-now={t('tz.timeline.now')} data-tl-best={t('tz.timeline.best')} data-bt-title={t('tz.besttime.title')} data-bt-no-overlap={t('tz.besttime.no_overlap')} data-bt-no-overlap-desc={t('tz.besttime.no_overlap.desc')} data-bt-in={t('tz.besttime.in')} data-bt-badge={t('tz.besttime.badge')} data-bt-now={t('tz.besttime.now')} data-bt-explain={t('tz.besttime.explain')} data-bt-explain-no-overlap={t('tz.besttime.explain.no_overlap')} data-step1-label={t('tz.step1.label')} data-step1-placeholder={t('tz.step1.placeholder')} data-step1-selected={t('tz.step1.selected')} data-step2-label={t('tz.step2.label')} data-step2-hint={t('tz.step2.hint')} data-step2-example={t('tz.step2.example')} data-step2-now={t('tz.step2.now')} data-step2-custom={t('tz.step2.custom')} data-step3-label={t('tz.step3.label')} data-step3-hint={t('tz.step3.hint')} data-step3-placeholder={t('tz.step3.placeholder')} data-result-add-more={t('tz.result.add_more')} data-result-in={t('tz.result.in')} data-modal-placeholder={t('tz.modal.search.placeholder')} data-modal-title={t('tz.modal.title')} data-modal-cancel={t('tz.modal.cancel')} data-modal-no-results={t('tz.modal.search.no_results')} data-add-city={t('tz.add.city')} style="display:none"></div>

      <!-- Hidden select for base TZ value (JS reads .value) -->
      <select id="base-tz" style="display:none">
        {timezones.map(tz => (
          <option value={tz.value}>{t(tz.cityKey)} ({tz.offset})</option>
        ))}
      </select>

      <!-- STEP 1: Choose your timezone -->
      <div class="step-card" id="step1-card">
        <div class="step-number">1</div>
        <div class="step-body">
          <label class="step-label" for="step1-search">{t('tz.step1.label')}</label>
          <p class="step-hint">{t('tz.step1.placeholder')}</p>
          <div class="step-search-wrap">
            <svg class="step-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="search" id="step1-search" class="step-search-input" placeholder={t('tz.step1.placeholder')} autocomplete="off" />
          </div>
          <ul class="step-results" id="step1-results" role="listbox"></ul>
          <!-- Selected timezone display (shown after selection) -->
          <div class="step1-selected" id="step1-selected" style="display:none">
            <span class="step1-selected-label">{t('tz.step1.selected')}</span>
            <span class="step1-selected-value" id="step1-selected-value"></span>
            <span class="step1-selected-offset" id="step1-selected-offset"></span>
            <button type="button" class="step1-change-btn" id="step1-change-btn" aria-label={t('tz.step1.label')}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            </button>
          </div>
        </div>
      </div>

      <!-- STEP 2: Specify time -->
      <div class="step-card step-inactive" id="step2-card">
        <div class="step-number">2</div>
        <div class="step-body">
          <label class="step-label">{t('tz.step2.label')}</label>
          <p class="step-hint" id="step2-hint">{t('tz.step2.hint')}</p>
          <p class="step-example" id="step2-example">{t('tz.step2.example')}</p>
          <div class="step2-time-toggle" id="step2-time-toggle">
            <button class="step2-toggle-btn active" data-mode="now" type="button">{t('tz.step2.now')}</button>
            <button class="step2-toggle-btn" data-mode="custom" type="button">{t('tz.step2.custom')}</button>
          </div>
          <div class="step2-custom-wrap" id="step2-custom-wrap" style="display:none">
            <input type="time" id="custom-time" class="step2-time-input" value="12:00" />
          </div>
          <div class="base-time-display" id="base-time-display">
            <span class="base-time-value" id="base-time-value">--:--:--</span>
            <span class="base-time-offset" id="base-time-offset"></span>
            <span class="base-time-date" id="base-time-date"></span>
          </div>
          <div class="time-format-toggle" id="time-format-toggle">
            <button class="format-btn active" data-format="24" type="button" aria-label={t('tz.timeformat.24h')}>{t('tz.timeformat.24h')}</button>
            <button class="format-btn" data-format="12" type="button" aria-label={t('tz.timeformat.12h')}>{t('tz.timeformat.12h')}</button>
          </div>
        </div>
      </div>

      <!-- STEP 3: Add contact city -->
      <div class="step-card step-inactive" id="step3-card">
        <div class="step-number">3</div>
        <div class="step-body">
          <label class="step-label">{t('tz.step3.label')}</label>
          <p class="step-hint">{t('tz.step3.hint')}</p>
          <div class="step-search-wrap">
            <svg class="step-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="search" id="step3-search" class="step-search-input" placeholder={t('tz.step3.placeholder')} autocomplete="off" />
          </div>
          <ul class="step-results" id="step3-results" role="listbox"></ul>
          <button class="add-city-btn" id="add-city-btn" type="button" style="display:none">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <span id="add-city-btn-text">{t('tz.result.add_more')}</span>
          </button>
        </div>
      </div>

      <!-- Conversion Result: Clock Grid -->
      <div class="result-section" id="result-section" style="display:none">
        <div class="clocks-grid" id="clocks-grid">
          <!-- Cards injected by JS -->
        </div>
      </div>

      <!-- Visual 24h Timeline -->
      <section class="timeline-section" id="timeline-section">
        <h2 class="section-title">{t('tz.timeline.title')}</h2>
        <div class="timeline-legend">
          <span class="legend-item legend-work"><span class="legend-swatch"></span>{t('tz.timeline.legend.work')}</span>
          <span class="legend-item legend-night"><span class="legend-swatch"></span>{t('tz.timeline.legend.night')}</span>
        </div>
        <!-- Placeholder shown when no cities added -->
        <div class="timeline-placeholder" id="timeline-placeholder">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12,6 12,12 16,14"/>
          </svg>
          <p class="timeline-placeholder-text">{t('tz.timeline.placeholder')}</p>
          <p class="timeline-placeholder-hint">↓ {t('tz.timeline.placeholderHint')} ↓</p>
        </div>
        <div class="timeline-wrapper" id="timeline-wrapper" style="display:none;">
          <!-- Hour header row -->
          <div class="timeline-header" id="timeline-header"></div>
          <!-- City rows injected by JS -->
          <div class="timeline-rows" id="timeline-rows"></div>
          <!-- Now marker -->
          <div class="timeline-now" id="timeline-now"></div>
          <!-- Best time badges -->
          <div class="timeline-best" id="timeline-best"></div>
        </div>
      </section>

      <!-- Best Time Recommendation Card -->
      <div class="besttime-card" id="besttime-card">
        <div class="besttime-header">
          <div class="besttime-icon-wrap">
            <svg class="besttime-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <h2 class="besttime-title">{t('tz.besttime.title')}</h2>
        </div>
        <div class="besttime-body" id="besttime-body">
          <!-- Injected by JS -->
        </div>
      </div>

      <!-- Business Use Case -->
      <section class="business-section">
        <h2 class="section-title">{t('tz.business.title')}</h2>
        <div class="business-grid">
          <div class="business-card">
            <div class="business-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </div>
            <h3 class="business-card-title">{t('tz.business.wa.title')}</h3>
            <p class="business-card-desc">{t('tz.business.wa.desc')}</p>
          </div>
          <div class="business-card">
            <div class="business-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
            </div>
            <h3 class="business-card-title">{t('tz.business.tg.title')}</h3>
            <p class="business-card-desc">{t('tz.business.tg.desc')}</p>
          </div>
          <div class="business-card">
            <div class="business-icon schedule-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01"/></svg>
            </div>
            <h3 class="business-card-title">{t('tz.business.schedule.title')}</h3>
            <p class="business-card-desc">{t('tz.business.schedule.desc')}</p>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section class="faq-section">
        <h2 class="section-title">{t('tz.faq.title')}</h2>
        {[
          { q: t('tz.faq.q1'), a: t('tz.faq.a1') },
          { q: t('tz.faq.q2'), a: t('tz.faq.a2') },
          { q: t('tz.faq.q3'), a: t('tz.faq.a3') },
          { q: t('tz.faq.q4'), a: t('tz.faq.a4') },
          { q: t('tz.faq.q5'), a: t('tz.faq.a5') },
        ].map((item) => (
          <details class="faq-item">
            <summary class="faq-q">{item.q}</summary>
            <p class="faq-a">{item.a}</p>
          </details>
        ))}
      </section>

      <!-- SEO -->
      <section class="seo-section">
        <h2 class="section-title">{t('tz.seo.title')}</h2>
        <div class="seo-grid">
          <div class="seo-card">
            <h3>{t('tz.seo.feature1.title')}</h3>
            <p>{t('tz.seo.feature1.desc')}</p>
          </div>
          <div class="seo-card">
            <h3>{t('tz.seo.feature2.title')}</h3>
            <p>{t('tz.seo.feature2.desc')}</p>
          </div>
          <div class="seo-card">
            <h3>{t('tz.seo.feature3.title')}</h3>
            <p>{t('tz.seo.feature3.desc')}</p>
          </div>
          <div class="seo-card">
            <h3>{t('tz.seo.feature4.title')}</h3>
            <p>{t('tz.seo.feature4.desc')}</p>
          </div>
        </div>
      </section>
</div>
</Layout>

<script>
  // ===== Guided Step-by-Step Timezone Converter =====

  // --- DOM refs ---
  const baseTzSelect = document.getElementById('base-tz') as HTMLSelectElement | null;
  const baseTimeValue = document.getElementById('base-time-value');
  const baseTimeOffset = document.getElementById('base-time-offset');
  const baseTimeDate = document.getElementById('base-time-date');
  const customTimeInput = document.getElementById('custom-time') as HTMLInputElement | null;
  const clocksGrid = document.getElementById('clocks-grid');
  const addCityBtn = document.getElementById('add-city-btn');

  // Step cards
  const step1Card = document.getElementById('step1-card');
  const step2Card = document.getElementById('step2-card');
  const step3Card = document.getElementById('step3-card');
  const step1Search = document.getElementById('step1-search') as HTMLInputElement | null;
  const step1Results = document.getElementById('step1-results');
  const step1Selected = document.getElementById('step1-selected');
  const step1SelectedValue = document.getElementById('step1-selected-value');
  const step1SelectedOffset = document.getElementById('step1-selected-offset');
  const step1ChangeBtn = document.getElementById('step1-change-btn');
  const step2TimeToggle = document.getElementById('step2-time-toggle');
  const step2CustomWrap = document.getElementById('step2-custom-wrap');
  const step3Search = document.getElementById('step3-search') as HTMLInputElement | null;
  const step3Results = document.getElementById('step3-results');
  const resultSection = document.getElementById('result-section');
  const timelineSection = document.getElementById('timeline-section');
  const besttimeCard = document.getElementById('besttime-card');

  // --- i18n data ---
  const tzI18nEl = document.getElementById('tz-i18n');
  const pageLocale = tzI18nEl?.dataset?.lang || 'en';
  const i18nAlreadyAdded = tzI18nEl?.dataset?.alreadyAdded || 'Added';
  const i18nNoResults = tzI18nEl?.dataset?.noResults || 'No cities found';
  const i18nCopyTime = tzI18nEl?.dataset?.copyTime || 'Copy time';
  const i18nCopyDone = tzI18nEl?.dataset?.copyDone || 'Copied!';
  const i18nTlNow = tzI18nEl?.dataset?.tlNow || 'now';
  const i18nTlBest = tzI18nEl?.dataset?.tlBest || 'Best time';
  const i18nBtTitle = tzI18nEl?.dataset?.btTitle || 'Best time to meet';
  const i18nBtNoOverlap = tzI18nEl?.dataset?.btNoOverlap || 'No working-hour overlap found';
  const i18nBtNoOverlapDesc = tzI18nEl?.dataset?.btNoOverlapDesc || 'The selected cities have no common working hours.';
  const i18nBtIn = tzI18nEl?.dataset?.btIn || 'in';
  const i18nBtBadge = tzI18nEl?.dataset?.btBadge || 'Best time';
  const i18nBtNow = tzI18nEl?.dataset?.btNow || 'now';
  const i18nBtExplain = tzI18nEl?.dataset?.btExplain || '';
  const i18nBtExplainNoOverlap = tzI18nEl?.dataset?.btExplainNoOverlap || '';
  const i18nStep2Example = tzI18nEl?.dataset?.step2Example || '';
  const i18nResultIn = tzI18nEl?.dataset?.resultIn || 'in';
  const i18nAddCity = tzI18nEl?.dataset?.addCity || 'Add city';

  // --- Localized city data ---
  const cityDataEl = document.getElementById('tz-city-data');
  const dataset = cityDataEl?.dataset || {};
  const cityNames: Record<string, string> = dataset.cities ? JSON.parse(dataset.cities) : {};
  const offsetMap: Record<string, string> = dataset.offsets ? JSON.parse(dataset.offsets) : {};

  // English fallback names for cross-locale search
  const englishNames: Record<string, string> = {
    'Europe/Moscow': 'Moscow', 'Asia/Dubai': 'Dubai', 'America/New_York': 'New York',
    'America/Los_Angeles': 'Los Angeles', 'Europe/London': 'London', 'Europe/Berlin': 'Berlin',
    'Asia/Kolkata': 'Mumbai', 'Asia/Shanghai': 'Shanghai', 'Asia/Tokyo': 'Tokyo',
    'Asia/Singapore': 'Singapore', 'Asia/Jakarta': 'Jakarta', 'Asia/Riyadh': 'Riyadh',
    'America/Sao_Paulo': 'Sao Paulo', 'America/Chicago': 'Chicago', 'America/Denver': 'Denver',
    'Australia/Sydney': 'Sydney', 'Pacific/Auckland': 'Auckland', 'Africa/Cairo': 'Cairo',
    'Africa/Lagos': 'Lagos', 'Asia/Karachi': 'Karachi', 'Asia/Bangkok': 'Bangkok',
    'Europe/Istanbul': 'Istanbul', 'Europe/Paris': 'Paris', 'America/Toronto': 'Toronto',
    'America/Mexico_City': 'Mexico City', 'America/Bogota': 'Bogota',
    'Asia/Kuala_Lumpur': 'Kuala Lumpur', 'Asia/Seoul': 'Seoul', 'Asia/Taipei': 'Taipei',
    'Asia/Hong_Kong': 'Hong Kong', 'Europe/Madrid': 'Madrid', 'Europe/Rome': 'Rome',
    'Europe/Amsterdam': 'Amsterdam', 'Europe/Warsaw': 'Warsaw', 'Europe/Kiev': 'Kyiv',
    'Europe/Lisbon': 'Lisbon', 'Europe/Zurich': 'Zurich', 'Asia/Dhaka': 'Dhaka',
    'Asia/Tehran': 'Tehran', 'Asia/Kabul': 'Kabul', 'Asia/Yangon': 'Yangon',
    'Pacific/Honolulu': 'Honolulu',
  };

  // Build search index
  type SearchEntry = { tz: string; localizedName: string; englishName: string; offset: string; searchStr: string; };
  const searchIndex: SearchEntry[] = Object.keys(cityNames).map(tz => {
    const localizedName = cityNames[tz] || tz.split('/').pop()!.replace(/_/g, ' ');
    const englishName = englishNames[tz] || tz.split('/').pop()!.replace(/_/g, ' ');
    const offset = offsetMap[tz] || '';
    const searchStr = (localizedName + ' ' + englishName + ' ' + tz + ' ' + offset)
      .toLowerCase().replace(/[^a-zа-яё0-9+\-:_/\s]/giu, ' ');
    return { tz, localizedName, englishName, offset, searchStr };
  });

  // --- State ---
  let addedCities: string[] = [];
  let use12h = localStorage.getItem('tz-use12h') === '12';
  let timeMode: 'now' | 'custom' = 'now';
  let currentBestHours: number[] = [];
  let step1Highlighted = -1;
  let step3Highlighted = -1;

  // --- 12h/24h format toggle ---
  const formatToggle = document.getElementById('time-format-toggle');
  const formatBtns = formatToggle?.querySelectorAll('.format-btn');
  formatBtns?.forEach(btn => {
    btn.classList.toggle('active', btn.getAttribute('data-format') === (use12h ? '12' : '24'));
  });
  formatBtns?.forEach(btn => {
    btn.addEventListener('click', () => {
      const fmt = btn.getAttribute('data-format');
      use12h = fmt === '12';
      localStorage.setItem('tz-use12h', use12h ? '12' : '24');
      formatBtns.forEach(b => b.classList.toggle('active', b.getAttribute('data-format') === fmt));
      updateAll();
    });
  });

  // --- Time mode toggle (Step 2) ---
  step2TimeToggle?.querySelectorAll('.step2-toggle-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const mode = btn.getAttribute('data-mode');
      timeMode = mode === 'custom' ? 'custom' : 'now';
      step2TimeToggle.querySelectorAll('.step2-toggle-btn').forEach(b =>
        b.classList.toggle('active', b.getAttribute('data-mode') === mode));
      if (step2CustomWrap) step2CustomWrap.style.display = timeMode === 'custom' ? 'block' : 'none';
      updateAll();
    });
  });

  customTimeInput?.addEventListener('input', () => updateAll());

  // --- Utility functions ---
  function getOffsetLabel(tz: string, date?: Date): string {
    try {
      const d = date || new Date();
      const formatter = new Intl.DateTimeFormat(pageLocale, { timeZone: tz, timeZoneName: 'shortOffset' });
      const parts = formatter.formatToParts(d);
      return parts.find(p => p.type === 'timeZoneName')?.value || tz;
    } catch { return tz; }
  }

  function getBaseOffset(tz: string, date: Date): number {
    const utcDate = new Date(date.getTime());
    const tzString = date.toLocaleString('en-US', { timeZone: tz });
    const tzDate = new Date(tzString);
    return (tzDate.getTime() - utcDate.getTime()) / 60000;
  }

  function formatDiff(diffHours: number): string {
    if (isNaN(diffHours)) return '';
    if (diffHours === 0) return tzI18nEl?.dataset?.sameTime || 'Same time';
    const sign = diffHours > 0 ? '+' : '-';
    const abs = Math.abs(diffHours);
    const h = Math.floor(abs);
    const m = Math.round((abs - h) * 60);
    if (m === 0) return sign + h + 'h';
    if (m === 30) return sign + h + ':30h';
    return sign + h + 'h ' + m + 'm';
  }

  function getTimeInTz(tz: string, baseTz: string, customTime?: string): { time: string; date: string; diff: string } {
    try {
      const now = new Date();
      if (customTime) {
        const [hours, minutes] = customTime.split(':').map(Number);
        const baseFormatter = new Intl.DateTimeFormat(pageLocale, {
          timeZone: baseTz, year: 'numeric', month: '2-digit', day: '2-digit',
          hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: use12h ? true : false
        });
        const baseParts = baseFormatter.formatToParts(now);
        const year = parseInt(baseParts.find(p => p.type === 'year')?.value || '0');
        const month = parseInt(baseParts.find(p => p.type === 'month')?.value || '0') - 1;
        const day = parseInt(baseParts.find(p => p.type === 'day')?.value || '0');
        const utcDate = new Date(Date.UTC(year, month, day, hours, minutes, 0));
        const baseOff = getBaseOffset(baseTz, utcDate);
        utcDate.setUTCMinutes(utcDate.getUTCMinutes() - baseOff);
        const targetFormatter = new Intl.DateTimeFormat(pageLocale, { timeZone: tz, hour: '2-digit', minute: '2-digit', hour12: use12h ? true : false });
        const dateFormatter = new Intl.DateTimeFormat(pageLocale, { timeZone: tz, weekday: 'short', month: 'short', day: 'numeric' });
        const time = targetFormatter.format(utcDate);
        const dateStr = dateFormatter.format(utcDate);
        const targetOffset = getBaseOffset(tz, utcDate);
        const diffHours = (targetOffset - baseOff) / 60;
        return { time, date: dateStr, diff: formatDiff(diffHours) };
      } else {
        const timeFormatter = new Intl.DateTimeFormat(pageLocale, { timeZone: tz, hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: use12h ? true : false });
        const dateFormatter = new Intl.DateTimeFormat(pageLocale, { timeZone: tz, weekday: 'short', month: 'short', day: 'numeric' });
        const time = timeFormatter.format(now);
        const dateStr = dateFormatter.format(now);
        const baseOff = getBaseOffset(baseTz, now);
        const targetOffset = getBaseOffset(tz, now);
        const diffHours = (targetOffset - baseOff) / 60;
        return { time, date: dateStr, diff: formatDiff(diffHours) };
      }
    } catch { return { time: '--:--', date: '', diff: '' }; }
  }

  function isNightTime(tz: string): boolean {
    try {
      const now = new Date();
      const formatter = new Intl.DateTimeFormat('en-US', { timeZone: tz, hour: 'numeric', hour12: false });
      const hour = parseInt(formatter.format(now));
      return hour < 6 || hour >= 21;
    } catch { return false; }
  }

  function getHourInTz(tz: string): number {
    try {
      const now = new Date();
      const formatter = new Intl.DateTimeFormat('en-US', { timeZone: tz, hour: 'numeric', hour12: false });
      return parseInt(formatter.format(now));
    } catch { return 0; }
  }

  function getMinuteInTz(tz: string): number {
    try {
      const now = new Date();
      const formatter = new Intl.DateTimeFormat('en-US', { timeZone: tz, minute: 'numeric' });
      return parseInt(formatter.format(now));
    } catch { return 0; }
  }

  const WORK_START = 9, WORK_END = 18, NIGHT_START = 21, NIGHT_END = 6;
  function isWorkHour(h: number): boolean { return h >= WORK_START && h < WORK_END; }
  function isNightHour(h: number): boolean { return h >= NIGHT_START || h < NIGHT_END; }

  function getBestHours(baseTz: string, allCities: string[]): number[] {
    const bestHours: number[] = [];
    for (let h = 0; h < 24; h++) {
      const allWork = allCities.every(tz => {
        const baseOffset = getBaseOffset(baseTz, new Date());
        const targetOffset = getBaseOffset(tz, new Date());
        const diffHours = (targetOffset - baseOffset) / 60;
        let targetHour = (h + diffHours) % 24;
        if (targetHour < 0) targetHour += 24;
        return isWorkHour(Math.floor(targetHour));
      });
      if (allWork) bestHours.push(h);
    }
    return bestHours;
  }

  function mergeHoursToRanges(hours: number[]): { start: number; end: number }[] {
    if (hours.length === 0) return [];
    const ranges: { start: number; end: number }[] = [];
    let rangeStart = hours[0], prev = hours[0];
    for (let i = 1; i < hours.length; i++) {
      if (hours[i] === prev + 1) { prev = hours[i]; }
      else { ranges.push({ start: rangeStart, end: prev + 1 }); rangeStart = hours[i]; prev = hours[i]; }
    }
    ranges.push({ start: rangeStart, end: prev + 1 });
    return ranges;
  }

  function formatHour(h: number): string {
    if (use12h) { const h12 = h % 12 || 12; return `${h12}${h < 12 ? 'AM' : 'PM'}`; }
    return `${String(h).padStart(2, '0')}:00`;
  }

  // --- Search rendering (shared for Step 1 & Step 3) ---
  function filterSearchIndex(query: string): SearchEntry[] {
    const q = query.trim().toLowerCase();
    if (!q) return searchIndex.slice().sort((a, b) => a.localizedName.localeCompare(b.localizedName, undefined, { sensitivity: 'base' }));
    const startsWith: SearchEntry[] = [], contains: SearchEntry[] = [];
    for (const entry of searchIndex) {
      if (entry.searchStr.includes(q)) {
        if (entry.localizedName.toLowerCase().startsWith(q) || entry.englishName.toLowerCase().startsWith(q)) startsWith.push(entry);
        else contains.push(entry);
      }
    }
    const sortFn = (a: SearchEntry, b: SearchEntry) => a.localizedName.localeCompare(b.localizedName, undefined, { sensitivity: 'base' });
    startsWith.sort(sortFn); contains.sort(sortFn);
    return [...startsWith, ...contains];
  }

  function renderStepResults(container: HTMLElement | null, results: SearchEntry[], options: { excludeTz?: string; maxVisible?: number; onSelect: (tz: string) => void; highlightedRef: { value: number } }) {
    if (!container) return;
    const excludeTz = options.excludeTz;
    const maxVisible = options.maxVisible || 8;
    const filtered = excludeTz ? results.filter(r => r.tz !== excludeTz) : results;
    const visible = filtered.slice(0, maxVisible);

    if (visible.length === 0) {
      container.innerHTML = `<li class="step-no-results">${i18nNoResults}</li>`;
      options.highlightedRef.value = -1;
      return;
    }

    if (options.highlightedRef.value >= visible.length) options.highlightedRef.value = 0;
    if (options.highlightedRef.value < 0) options.highlightedRef.value = 0;

    container.innerHTML = visible.map((r, i) => `
      <li class="step-result${i === options.highlightedRef.value ? ' highlighted' : ''}" role="option" data-tz="${r.tz}" data-idx="${i}">
        <span class="step-result-name">${r.localizedName}</span>
        <span class="step-result-offset">${r.offset}</span>
      </li>
    `).join('');

    container.querySelectorAll('.step-result').forEach(li => {
      li.addEventListener('click', () => {
        const tz = li.getAttribute('data-tz') || '';
        options.onSelect(tz);
      });
    });
  }

  function stepKeyboardNav(e: KeyboardEvent, container: HTMLElement | null, highlightedRef: { value: number }, onSelect: (tz: string) => void) {
    if (!container) return;
    const items = Array.from(container.querySelectorAll('.step-result')) as HTMLElement[];
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (highlightedRef.value < items.length - 1) highlightedRef.value++;
      updateStepHighlight(container, highlightedRef.value);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (highlightedRef.value > 0) highlightedRef.value--;
      updateStepHighlight(container, highlightedRef.value);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      const item = items[highlightedRef.value];
      if (item) onSelect(item.getAttribute('data-tz') || '');
    } else if (e.key === 'Escape') {
      e.preventDefault();
      container.innerHTML = '';
      highlightedRef.value = -1;
    }
  }

  function updateStepHighlight(container: HTMLElement, idx: number) {
    container.querySelectorAll('.step-result').forEach((li, i) => {
      li.classList.toggle('highlighted', i === idx);
    });
    const target = container.querySelectorAll('.step-result')[idx] as HTMLElement | undefined;
    target?.scrollIntoView({ block: 'nearest' });
  }

  // --- Step 1: Select base timezone ---
  const step1HighlightRef = { value: -1 };

  function selectBaseTz(tz: string) {
    if (baseTzSelect) baseTzSelect.value = tz;
    // Show selected display
    if (step1Search) step1Search.style.display = 'none';
    if (step1Results) step1Results.innerHTML = '';
    if (step1Selected) step1Selected.style.display = 'flex';
    if (step1SelectedValue) step1SelectedValue.textContent = cityNames[tz] || tz.split('/').pop() || tz;
    if (step1SelectedOffset) step1SelectedOffset.textContent = getOffsetLabel(tz);
    step1Card?.classList.add('step-done');
    // Activate step 2
    step2Card?.classList.remove('step-inactive');
    step2Card?.classList.add('step-active');
    // Update step 2 example text
    const step2Example = document.getElementById('step2-example');
    if (step2Example && i18nStep2Example) {
      const cityName = cityNames[tz] || tz.split('/').pop() || tz;
      step2Example.textContent = i18nStep2Example.replace(/Moscow|Москв/gi, cityName);
    }
    updateAll();
  }

  step1ChangeBtn?.addEventListener('click', () => {
    if (step1Search) { step1Search.style.display = 'block'; step1Search.value = ''; step1Search.focus(); }
    if (step1Selected) step1Selected.style.display = 'none';
    step1Card?.classList.remove('step-done');
    // Deactivate steps 2, 3
    step2Card?.classList.add('step-inactive');
    step2Card?.classList.remove('step-active');
    step3Card?.classList.add('step-inactive');
    step3Card?.classList.remove('step-active');
    if (resultSection) resultSection.style.display = 'none';
  });

  step1Search?.addEventListener('input', () => {
    const q = step1Search.value;
    const results = filterSearchIndex(q);
    step1HighlightRef.value = -1;
    renderStepResults(step1Results, results, { onSelect: selectBaseTz, highlightedRef: step1HighlightRef });
  });

  step1Search?.addEventListener('keydown', (e) => {
    stepKeyboardNav(e, step1Results, step1HighlightRef, selectBaseTz);
  });

  step1Search?.addEventListener('focus', () => {
    if (!step1Search.value) {
      const results = filterSearchIndex('');
      step1HighlightRef.value = -1;
      renderStepResults(step1Results, results, { onSelect: selectBaseTz, highlightedRef: step1HighlightRef, maxVisible: 8 });
    }
  });

  // Click on search icon focuses input and shows city list
  const step1SearchIcon = document.querySelector('#step1-card .step-search-icon');
  step1SearchIcon?.addEventListener('click', () => {
    if (step1Search) {
      step1Search.style.display = 'block';
      step1Search.focus();
    }
  });

  // --- Step 3: Add contact city ---
  const step3HighlightRef = { value: -1 };

  function addContactCity(tz: string) {
    if (!addedCities.includes(tz)) {
      addedCities.push(tz);
    }
    if (step3Search) step3Search.value = '';
    if (step3Results) step3Results.innerHTML = '';
    step3HighlightRef.value = -1;
    // Show add more button
    if (addCityBtn) addCityBtn.style.display = 'flex';
    updateAll();
  }

  step3Search?.addEventListener('input', () => {
    const baseTz = baseTzSelect?.value || '';
    const q = step3Search.value;
    const results = filterSearchIndex(q);
    step3HighlightRef.value = -1;
    renderStepResults(step3Results, results, { excludeTz: baseTz, onSelect: addContactCity, highlightedRef: step3HighlightRef });
  });

  step3Search?.addEventListener('keydown', (e) => {
    stepKeyboardNav(e, step3Results, step3HighlightRef, addContactCity);
  });

  step3Search?.addEventListener('focus', () => {
    const baseTz = baseTzSelect?.value || '';
    if (!step3Search.value) {
      const results = filterSearchIndex('');
      step3HighlightRef.value = -1;
      renderStepResults(step3Results, results, { excludeTz: baseTz, onSelect: addContactCity, highlightedRef: step3HighlightRef, maxVisible: 8 });
    }
  });

  // Click on search icon focuses input and shows city list
  const step3SearchIcon = document.querySelector('#step3-card .step-search-icon');
  step3SearchIcon?.addEventListener('click', () => {
    if (step3Search) step3Search.focus();
  });

  addCityBtn?.addEventListener('click', () => {
    if (step3Search) { step3Search.focus(); }
  });

  // --- Clocks grid rendering ---
  function renderClocks() {
    const baseTz = baseTzSelect?.value || 'Europe/Moscow';
    const customTime = timeMode === 'custom' ? (customTimeInput?.value || '') : '';

    // Update base time display
    if (baseTimeValue) {
      const formatter = new Intl.DateTimeFormat(pageLocale, { timeZone: baseTz, hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: use12h ? true : false });
      baseTimeValue.textContent = formatter.format(new Date());
    }
    if (baseTimeOffset) baseTimeOffset.textContent = getOffsetLabel(baseTz);
    if (baseTimeDate) {
      const df = new Intl.DateTimeFormat(pageLocale, { timeZone: baseTz, weekday: 'short', month: 'short', day: 'numeric' });
      baseTimeDate.textContent = df.format(new Date());
    }

    if (!clocksGrid) return;
    const allCities = [...addedCities.filter(c => c !== baseTz)];
    clocksGrid.innerHTML = '';

    allCities.forEach(tz => {
      const result = getTimeInTz(tz, baseTz, customTime || undefined);
      const isNight = isNightTime(tz);
      const name = cityNames[tz] || tz.split('/').pop() || tz;
      const offsetLabel = getOffsetLabel(tz);
      const isBestNow = currentBestHours.length > 0 && (() => {
        const h = getHourInTz(baseTz);
        return currentBestHours.includes(h);
      })();

      const card = document.createElement('div');
      card.className = 'clock-card' + (isNight ? ' night' : '') + (isBestNow ? ' best-now' : '');
      card.innerHTML = `
        ${isBestNow ? '<div class="clock-best-badge">' + i18nBtBadge + '</div>' : ''}
        <div class="clock-city">${name}</div>
        <div class="clock-offset">${offsetLabel}</div>
        <div class="clock-time" data-tz="${tz}">${result.time}</div>
        <div class="clock-date">${result.date}</div>
        <div class="clock-diff">${result.diff}</div>
        <button class="clock-copy" data-tz="${tz}" title="${i18nCopyTime}" aria-label="${i18nCopyTime}">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
        </button>
        <button class="clock-remove" data-tz="${tz}" title="Remove" aria-label="Remove">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      `;
      clocksGrid.appendChild(card);
    });

    // Attach copy buttons
    clocksGrid.querySelectorAll('.clock-copy').forEach(btn => {
      btn.addEventListener('click', async () => {
        const tz = btn.getAttribute('data-tz') || '';
        const timeEl = clocksGrid?.querySelector(`.clock-time[data-tz="${tz}"]`);
        const text = timeEl?.textContent || '';
        try { await navigator.clipboard.writeText(text); } catch {
          const ta = document.createElement('textarea'); ta.value = text;
          ta.style.position = 'fixed'; ta.style.opacity = '0';
          document.body.appendChild(ta); ta.select(); document.execCommand('copy'); document.body.removeChild(ta);
        }
        const origTitle = btn.getAttribute('title') || '';
        btn.setAttribute('title', i18nCopyDone); btn.classList.add('copied');
        setTimeout(() => { btn.setAttribute('title', origTitle); btn.classList.remove('copied'); }, 1500);
      });
    });

    // Attach remove buttons
    clocksGrid.querySelectorAll('.clock-remove').forEach(btn => {
      btn.addEventListener('click', () => {
        const tz = btn.getAttribute('data-tz') || '';
        addedCities = addedCities.filter(c => c !== tz);
        if (addedCities.length === 0 && addCityBtn) addCityBtn.style.display = 'none';
        updateAll();
      });
    });
  }

  // --- Timeline rendering ---
  const timelineHeader = document.getElementById('timeline-header');
  const timelineRows = document.getElementById('timeline-rows');
  const timelineNow = document.getElementById('timeline-now');
  const timelineBest = document.getElementById('timeline-best');
  const timelineWrapper = document.getElementById('timeline-wrapper');
  const timelinePlaceholder = document.getElementById('timeline-placeholder');

  function renderTimeline() {
    if (!timelineHeader || !timelineRows || !timelineNow || !timelineBest || !timelineWrapper) return;
    
    try {
      const baseTz = baseTzSelect?.value || 'Europe/Moscow';
      const customTime = timeMode === 'custom' ? (customTimeInput?.value || '') : '';
      const allCities = [baseTz, ...addedCities.filter(c => c !== baseTz)];
      
      // Show placeholder if less than 2 cities, show timeline otherwise
      if (allCities.length < 2) {
        timelineSection && (timelineSection.style.display = '');
        timelinePlaceholder && (timelinePlaceholder.style.display = 'flex');
        timelineWrapper && (timelineWrapper.style.display = 'none');
        return;
      }
      
      // Hide placeholder, show timeline
      timelinePlaceholder && (timelinePlaceholder.style.display = 'none');
      timelineWrapper && (timelineWrapper.style.display = '');
      timelineSection && (timelineSection.style.display = '');

    // Hour labels with AM/PM support
    const hourLabels = use12h ? [12, 3, 6, 9, 12, 3, 6, 9] : [0, 3, 6, 9, 12, 15, 18, 21];
    const hourLabelStrs = use12h 
      ? ['12am', '3am', '6am', '9am', '12pm', '3pm', '6pm', '9pm']
      : ['0', '3', '6', '9', '12', '15', '18', '21'];
    timelineHeader.innerHTML = '<div class="tl-header-spacer"></div>' +
      hourLabels.map((h, i) => `<div class="tl-hour-label" style="left:${(h / 24) * 100}%">${hourLabelStrs[i]}</div>`).join('');

    timelineRows.innerHTML = allCities.map((tz, idx) => {
      const name = idx === 0 ? (cityNames[tz] || tz.split('/').pop() || tz) + ' ★' : cityNames[tz] || tz.split('/').pop() || tz;
      const offsetLabel = getOffsetLabel(tz);
      const isBase = idx === 0;
      
      // Get current time in this timezone
      const timeResult = getTimeInTz(tz, baseTz, customTime || undefined);
      const currentHour = getHourInTz(tz);
      const currentMinute = getMinuteInTz(tz);
      const nowPercent = ((currentHour + currentMinute / 60) / 24) * 100;
      
      // Determine status for styling
      const isNight = isNightTime(tz);
      const isWork = isWorkHour(currentHour);
      
      // Generate 24 hour segments with enhanced styling
      const segments = Array.from({ length: 24 }, (_, h) => {
        let cls = 'tl-seg';
        if (isWorkHour(h)) cls += ' work'; else if (isNightHour(h)) cls += ' night'; else cls += ' day';
        // Mark current hour
        if (h === currentHour) cls += ' current-hour';
        return `<div class="${cls}" data-hour="${h}"></div>`;
      }).join('');
      
      // Time display with status indicator
      const statusClass = isNight ? 'night' : (isWork ? 'work' : 'day');
      
      return `
        <div class="tl-row ${isBase ? 'base-row' : ''}" data-tz="${tz}">
          <div class="tl-city-label">
            <span class="tl-city-name">${name}</span>
            <span class="tl-city-offset">${offsetLabel}</span>
          </div>
          <div class="tl-bar">${segments}</div>
          <div class="tl-time-display ${statusClass}">
            <span class="tl-current-time">${timeResult.time}</span>
            <span class="tl-current-date">${timeResult.date}</span>
          </div>
          <div class="tl-now-marker" style="left: ${nowPercent}%">
            <div class="tl-now-dot"></div>
          </div>
        </div>`;
    }).join('');

    // Global "now" line (based on base timezone)
    const baseHour = getHourInTz(baseTz), baseMinute = getMinuteInTz(baseTz);
    const globalNowPercent = ((baseHour + baseMinute / 60) / 24) * 100;
    timelineNow.style.left = `${globalNowPercent}%`;
    timelineNow.innerHTML = `<span class="tl-now-label">${i18nTlNow}</span>`;

    // Best time badges
    const bestHours = getBestHours(baseTz, allCities);
    currentBestHours = bestHours;

    if (bestHours.length > 0 && bestHours.length < 24) {
      const ranges = mergeHoursToRanges(bestHours);
      timelineBest.innerHTML = ranges.map(r => {
        const left = (r.start / 24) * 100, width = ((r.end - r.start) / 24) * 100;
        return `<div class="tl-best-badge" style="left:${left}%;width:${width}%"><span>${i18nTlBest}</span></div>`;
      }).join('');
    } else { timelineBest.innerHTML = ''; }
    
    // Add click handlers for time selection on segments
    timelineRows.querySelectorAll('.tl-seg').forEach(seg => {
      seg.addEventListener('click', () => {
        const hour = parseInt(seg.getAttribute('data-hour') || '0');
        if (customTimeInput) {
          // Set custom time to this hour
          const newTime = `${String(hour).padStart(2, '0')}:00`;
          customTimeInput.value = newTime;
          timeMode = 'custom';
          // Update toggle buttons
          step2TimeToggle?.querySelectorAll('.step2-toggle-btn').forEach(b => {
            b.classList.toggle('active', b.getAttribute('data-mode') === 'custom');
          });
          if (step2CustomWrap) step2CustomWrap.style.display = 'block';
          updateAll();
        }
      });
    });
    } catch (err) {
      console.error('[Timeline] Render error:', err);
      // Show placeholder on error
      timelinePlaceholder && (timelinePlaceholder.style.display = 'flex');
      timelineWrapper && (timelineWrapper.style.display = 'none');
    }
  }

  // --- Best Time rendering ---
  const besttimeBody = document.getElementById('besttime-body');

  function renderBestTime() {
    if (!besttimeBody || !besttimeCard) return;
    const baseTz = baseTzSelect?.value || 'Europe/Moscow';
    const allCities = [baseTz, ...addedCities.filter(c => c !== baseTz)];
    if (allCities.length < 2) { besttimeCard.style.display = 'none'; return; }
    besttimeCard.style.display = '';

    const bestHours = getBestHours(baseTz, allCities);
    currentBestHours = bestHours;

    if (bestHours.length === 0) {
      besttimeCard.classList.add('no-overlap');
      besttimeBody.innerHTML = `
        <div class="besttime-no-overlap">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <div>
            <p class="besttime-no-overlap-title">${i18nBtNoOverlap}</p>
            <p class="besttime-no-overlap-desc">${i18nBtNoOverlapDesc}</p>
            ${i18nBtExplainNoOverlap ? '<p class="besttime-explain">' + i18nBtExplainNoOverlap + '</p>' : ''}
          </div>
        </div>
      `;
      return;
    }

    if (bestHours.length >= 24) { besttimeCard.classList.add('no-overlap'); besttimeBody.innerHTML = ''; return; }
    besttimeCard.classList.remove('no-overlap');

    const ranges = mergeHoursToRanges(bestHours);
    const primary = ranges.reduce((a, b) => (b.end - b.start) > (a.end - a.start) ? b : a, ranges[0]);
    const baseHour = getHourInTz(baseTz);
    const isNowBest = bestHours.includes(baseHour);

    const cityRows = allCities.map(tz => {
      const baseOff = getBaseOffset(baseTz, new Date());
      const targetOff = getBaseOffset(tz, new Date());
      const diffH = (targetOff - baseOff) / 60;
      let startH = (primary.start + diffH) % 24; if (startH < 0) startH += 24;
      let endH = (primary.end + diffH) % 24; if (endH < 0) endH += 24;
      const name = cityNames[tz] || tz.split('/').pop() || tz;
      const isBase = tz === baseTz;
      return `<div class="bt-city-row${isBase ? ' base' : ''}"><span class="bt-city-name">${name}${isBase ? ' ★' : ''}</span><span class="bt-city-time">${formatHour(Math.floor(startH))} — ${formatHour(Math.floor(endH))}</span></div>`;
    }).join('');

    const extraRanges = ranges.filter(r => r !== primary);

    besttimeBody.innerHTML = `
      <div class="bt-primary-row">
        <div class="bt-range-badge${isNowBest ? ' active-now' : ''}">${formatHour(primary.start)} — ${formatHour(primary.end)}</div>
        <span class="bt-range-in">${i18nBtIn} ${cityNames[baseTz] || baseTz.split('/').pop()}</span>
        ${isNowBest ? '<span class="bt-now-badge">' + i18nBtNow + '</span>' : ''}
      </div>
      ${extraRanges.length > 0 ? '<div class="bt-extra-ranges">' + extraRanges.map(r => `<span class="bt-extra-badge">${formatHour(r.start)} — ${formatHour(r.end)}</span>`).join('') + '</div>' : ''}
      ${i18nBtExplain ? '<p class="besttime-explain">' + i18nBtExplain + '</p>' : ''}
      <div class="bt-cities-grid">${cityRows}</div>
    `;
  }

  // --- Master update ---
  function updateAll() {
    const baseTz = baseTzSelect?.value;
    const hasBase = !!baseTz;
    const hasCities = addedCities.length > 0;

    // Show result section & activate step 3 when base is set
    if (hasBase) {
      step3Card?.classList.remove('step-inactive');
      step3Card?.classList.add('step-active');
    }

    // Show results when we have at least one contact city
    if (hasBase && hasCities) {
      if (resultSection) resultSection.style.display = '';
    } else {
      if (resultSection) resultSection.style.display = 'none';
    }

    renderClocks();
    renderTimeline();
    renderBestTime();
  }

  // --- Initial state: pre-select base timezone from browser ---
  function detectBaseTz(): string {
    try {
      const intlTz = Intl.DateTimeFormat().resolvedOptions().timeZone;
      // Check if it's in our list
      if (searchIndex.some(e => e.tz === intlTz)) return intlTz;
      // Fallback: try common mappings
      const fallbacks: Record<string, string> = {
        'US/Eastern': 'America/New_York', 'US/Pacific': 'America/Los_Angeles',
        'US/Central': 'America/Chicago', 'US/Mountain': 'America/Denver',
      };
      if (fallbacks[intlTz]) return fallbacks[intlTz];
    } catch {}
    return 'Europe/Moscow';
  }

  // Auto-select the detected timezone on load
  const detectedTz = detectBaseTz();
  selectBaseTz(detectedTz);

  // Live clock update
  setInterval(() => updateAll(), 1000);
</script>

