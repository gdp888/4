<script>
  // ===== Enhanced Time Zone Converter with Multi-Clock Mode =====
  // Inspired by NickiMash17/World_Clock (GitHub)

  // --- Types ---
  interface CityData {
    tz: string;
    localizedName: string;
    englishName: string;
    offset: string;
    offsetMinutes: number;
  }

  interface SavedCity {
    timezone: string;
    name: string;
    emoji: string;
  }

  // --- Region Emojis (from GitHub repo) ---
  const regionEmojis: Record<string, string> = {
    'America': '🌎',
    'Europe': '🌍',
    'Asia': '🌏',
    'Australia': '🌏',
    'Pacific': '🌏',
    'Africa': '🌍',
    'Atlantic': '🌊',
    'Indian': '🌊',
    'Arctic': '❄️',
    'Antarctica': '🐧'
  };

  function getRegionEmoji(timezone: string): string {
    const region = timezone.split('/')[0];
    return regionEmojis[region] || '🌐';
  }

  // --- DOM Elements ---
  const card1Search = document.getElementById('card1-search') as HTMLInputElement;
  const card1Results = document.getElementById('card1-results');
  const card1Live = document.getElementById('card1-live');
  const card1City = document.getElementById('card1-city');
  const card1Clock = document.getElementById('card1-clock');
  const card1Date = document.getElementById('card1-date');
  const card1Offset = document.getElementById('card1-offset');
  const card1Daytime = document.getElementById('card1-daytime');
  const card1Change = document.getElementById('card1-change');
  const card1Emoji = document.getElementById('card1-emoji');

  const card2Search = document.getElementById('card2-search') as HTMLInputElement;
  const card2Results = document.getElementById('card2-results');
  const card2Live = document.getElementById('card2-live');
  const card2City = document.getElementById('card2-city');
  const card2Clock = document.getElementById('card2-clock');
  const card2Date = document.getElementById('card2-date');
  const card2Offset = document.getElementById('card2-offset');
  const card2Daytime = document.getElementById('card2-daytime');
  const card2Change = document.getElementById('card2-change');
  const card2Emoji = document.getElementById('card2-emoji');

  // Analog clock elements
  const card1Hour = document.getElementById('card1-hour');
  const card1Minute = document.getElementById('card1-minute');
  const card1Second = document.getElementById('card1-second');
  const card2Hour = document.getElementById('card2-hour');
  const card2Minute = document.getElementById('card2-minute');
  const card2Second = document.getElementById('card2-second');

  // Multi-clock mode elements
  const modeCompareBtn = document.getElementById('mode-compare');
  const modeMultiBtn = document.getElementById('mode-multi');
  const compareModeEl = document.getElementById('compare-mode');
  const multiModeEl = document.getElementById('multi-mode');
  const multiSearch = document.getElementById('multi-search') as HTMLInputElement;
  const multiResults = document.getElementById('multi-results');
  const clocksGrid = document.getElementById('clocks-grid');
  const emptyState = document.getElementById('empty-state');
  const savedActions = document.getElementById('saved-actions');
  const clearAllBtn = document.getElementById('clear-all-btn');
  const citiesCount = document.getElementById('cities-count');

  const diffInfo = document.getElementById('diff-info');
  const diffMain = document.getElementById('diff-main');
  const diffContext = document.getElementById('diff-context');

  // --- i18n ---
  const i18nEl = document.getElementById('tz-i18n');
  const i18n = {
    morning: i18nEl?.dataset?.morning || 'Morning',
    day: i18nEl?.dataset?.day || 'Day',
    evening: i18nEl?.dataset?.evening || 'Evening',
    night: i18nEl?.dataset?.night || 'Night',
    ahead: i18nEl?.dataset?.ahead || 'ahead of',
    behind: i18nEl?.dataset?.behind || 'behind',
    sameTime: i18nEl?.dataset?.sameTime || 'Same timezone',
    copyTime: i18nEl?.dataset?.copyTime || 'Copy time',
    copyDone: i18nEl?.dataset?.copyDone || 'Copied!',
    addCity: i18nEl?.dataset?.addCity || 'Add City',
    removeCity: i18nEl?.dataset?.removeCity || 'Remove',
    savedCities: i18nEl?.dataset?.savedCities || 'Saved Cities',
    clearAll: i18nEl?.dataset?.clearAll || 'Clear All',
  };

  // --- City Data ---
  const cityDataEl = document.getElementById('tz-city-data');
  const dataset = cityDataEl?.dataset || {};
  const cityNames: Record<string, string> = dataset.cities ? JSON.parse(dataset.cities) : {};
  const offsetMapData: Record<string, string> = dataset.offsets ? JSON.parse(dataset.offsets) : {};

  // English fallback names for search
  const englishNames: Record<string, string> = {
    'Europe/Moscow': 'Moscow', 'Asia/Dubai': 'Dubai', 'America/New_York': 'New York',
    'America/Los_Angeles': 'Los Angeles', 'Europe/London': 'London', 'Europe/Berlin': 'Berlin',
    'Asia/Kolkata': 'Mumbai', 'Asia/Shanghai': 'Shanghai', 'Asia/Tokyo': 'Tokyo',
    'Asia/Singapore': 'Singapore', 'Asia/Jakarta': 'Jakarta', 'Asia/Riyadh': 'Riyadh',
    'America/Sao_Paulo': 'Sao Paulo', 'America/Chicago': 'Chicago', 'America/Denver': 'Denver',
    'Australia/Sydney': 'Sydney', 'Pacific/Auckland': 'Auckland', 'Africa/Cairo': 'Cairo',
    'Africa/Lagos': 'Lagos', 'Asia/Karachi': 'Karachi', 'Asia/Bangkok': 'Bangkok',
    'Europe/Istanbul': 'Istanbul', 'Europe/Paris': 'Paris', 'America/Toronto': 'Toronto',
    'America/Mexico_City': 'Mexico City', 'America/Bogota': 'Bogota',
    'Asia/Kuala_Lumpur': 'Kuala Lumpur', 'Asia/Seoul': 'Seoul', 'Asia/Taipei': 'Taipei',
    'Asia/Hong_Kong': 'Hong Kong', 'Europe/Madrid': 'Madrid', 'Europe/Rome': 'Rome',
    'Europe/Amsterdam': 'Amsterdam', 'Europe/Warsaw': 'Warsaw', 'Europe/Kiev': 'Kyiv',
    'Europe/Lisbon': 'Lisbon', 'Europe/Zurich': 'Zurich', 'Asia/Dhaka': 'Dhaka',
    'Asia/Tehran': 'Tehran', 'Asia/Kabul': 'Kabul', 'Asia/Yangon': 'Yangon',
    'Pacific/Honolulu': 'Honolulu',
  };

  // Parse offset string like "GMT+3" or "GMT-5" to minutes
  function parseOffsetToMinutes(offsetStr: string): number {
    const match = offsetStr.match(/GMT([+-])(\d{1,2})(?::(\d{2}))?/);
    if (!match) return 0;
    const sign = match[1] === '+' ? 1 : -1;
    const hours = parseInt(match[2]) || 0;
    const minutes = parseInt(match[3]) || 0;
    return sign * (hours * 60 + minutes);
  }

  // Build search index
  interface SearchEntry {
    tz: string;
    localizedName: string;
    englishName: string;
    offset: string;
    offsetMinutes: number;
    searchStr: string;
  }

  const searchIndex: SearchEntry[] = Object.keys(cityNames).map(tz => ({
    tz,
    localizedName: cityNames[tz] || tz.split('/').pop()!.replace(/_/g, ' '),
    englishName: englishNames[tz] || tz.split('/').pop()!.replace(/_/g, ' '),
    offset: offsetMapData[tz] || '',
    offsetMinutes: parseOffsetToMinutes(offsetMapData[tz] || ''),
    searchStr: (
      (cityNames[tz] || '') + ' ' +
      (englishNames[tz] || '') + ' ' +
      tz + ' ' +
      (offsetMapData[tz] || '')
    ).toLowerCase().replace(/[^a-zа-яё0-9+\-:_/\s]/giu, ' '),
  }));

  // --- State ---
  let selectedCard1: SearchEntry | null = null;
  let selectedCard2: SearchEntry | null = null;
  let liveInterval: number | null = null;
  let savedCities: SavedCity[] = [];
  let currentMode: 'compare' | 'multi' = 'compare';

  // Load saved cities from localStorage
  function loadSavedCities(): void {
    try {
      const saved = localStorage.getItem('opnchat-world-clocks');
      if (saved) {
        savedCities = JSON.parse(saved);
        updateMultiClockDisplay();
      }
    } catch (e) {
      console.error('Error loading saved cities:', e);
    }
  }

  // Save cities to localStorage
  function saveCities(): void {
    try {
      localStorage.setItem('opnchat-world-clocks', JSON.stringify(savedCities));
    } catch (e) {
      console.error('Error saving cities:', e);
    }
  }

  // --- Daytime Detection ---
  function getDaytimeInfo(hours: number): { period: string; icon: string; className: string } {
    if (hours >= 6 && hours < 12) return { period: i18n.morning, icon: '🌅', className: 'morning' };
    if (hours >= 12 && hours < 18) return { period: i18n.day, icon: '☀️', className: 'day' };
    if (hours >= 18 && hours < 23) return { period: i18n.evening, icon: '🌆', className: 'evening' };
    return { period: i18n.night, icon: '🌙', className: 'night' };
  }

  // --- Format Time ---
  function formatTime(date: Date): string {
    return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
  }

  function formatDate(date: Date): string {
    return date.toLocaleDateString([], { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
  }

  // --- Get time in timezone ---
  function getTimeInTZ(tzString: string): Date {
    const now = new Date();
    const formatter = new Intl.DateTimeFormat('en-US', {
      timeZone: tzString,
      hour: 'numeric',
      minute: 'numeric',
      second: 'numeric',
      hour12: false,
      year: 'numeric',
      month: 'numeric',
      day: 'numeric',
      weekday: 'long',
    });
    const parts = formatter.formatToParts(now);
    
    const getVal = (type: Intl.DateTimeFormatPartTypes) => parts.find(p => p.type === type)?.value;
    return new Date(
      parseInt(getVal('year')!),
      parseInt(getVal('month')!) - 1,
      parseInt(getVal('day')!),
      parseInt(getVal('hour')!),
      parseInt(getVal('minute')!),
      parseInt(getVal('second')!)
    );
  }

  // --- Update Analog Clock Hands (from GitHub repo) ---
  function updateAnalogClock(hourEl: HTMLElement | null, minuteEl: HTMLElement | null, secondEl: HTMLElement | null, date: Date): void {
    if (!hourEl || !minuteEl || !secondEl) return;

    const hours = date.getHours() % 12;
    const minutes = date.getMinutes();
    const seconds = date.getSeconds();

    const hourAngle = (hours * 30) + (minutes * 0.5);
    const minuteAngle = minutes * 6;
    const secondAngle = seconds * 6;

    hourEl.style.transform = `rotate(${hourAngle}deg)`;
    minuteEl.style.transform = `rotate(${minuteAngle}deg)`;
    secondEl.style.transform = `rotate(${secondAngle}deg)`;
  }

  // --- Update Live Display ---
  function updateLiveDisplay(
    entry: SearchEntry,
    clockEl: HTMLElement | null,
    dateEl: HTMLElement | null,
    offsetEl: HTMLElement | null,
    daytimeEl: HTMLElement | null,
    emojiEl: HTMLElement | null,
    hourEl?: HTMLElement | null,
    minuteEl?: HTMLElement | null,
    secondEl?: HTMLElement | null
  ): void {
    try {
      const dateInTZ = getTimeInTZ(entry.tz);
      
      if (clockEl) clockEl.textContent = formatTime(dateInTZ);
      if (dateEl) dateEl.textContent = formatDate(dateInTZ);
      if (offsetEl) offsetEl.textContent = entry.offset;
      if (emojiEl) emojiEl.textContent = getRegionEmoji(entry.tz);
      
      if (daytimeEl) {
        const hours = dateInTZ.getHours();
        const daytime = getDaytimeInfo(hours);
        daytimeEl.innerHTML = `${daytime.icon} ${daytime.period}`;
        daytimeEl.className = `daytime-badge ${daytime.className}`;
      }

      // Update analog clock
      updateAnalogClock(hourEl || null, minuteEl || null, secondEl || null, dateInTZ);
    } catch (e) {
      console.error('Error updating live display:', e);
    }
  }

  // --- Calculate Time Difference (from GitHub repo) ---
  function calculateTimeDifference(timezone: string): string {
    const localTime = new Date();
    const localOffset = localTime.getTimezoneOffset() * 60000;
    const targetTime = new Date(new Date().toLocaleString('en-US', { timeZone: timezone }));

    const utcLocal = localTime.getTime() + localOffset;
    const utcTarget = targetTime.getTime() + localOffset;
    const diffHours = Math.round((utcTarget - utcLocal) / 3600000);

    if (diffHours === 0) {
      return i18n.sameTime;
    } else if (diffHours > 0) {
      return `${diffHours}h ${i18n.ahead}`;
    } else {
      return `${Math.abs(diffHours)}h ${i18n.behind}`;
    }
  }

  // --- Update Diff Info ---
  function updateDiffInfo(): void {
    if (!selectedCard1 || !selectedCard2) {
      if (diffInfo) diffInfo.style.display = 'none';
      return;
    }

    const diffMinutes = selectedCard2.offsetMinutes - selectedCard1.offsetMinutes;
    const absHours = Math.abs(Math.round(diffMinutes / 60 * 10) / 10);
    const absMinutes = Math.abs(diffMinutes % 60);

    let diffText = '';
    if (diffMinutes === 0) {
      diffText = i18n.sameTime;
    } else if (diffMinutes > 0) {
      diffText = `${absHours}h ${absMinutes > 0 ? absMinutes + 'm' : ''} ${i18n.ahead}`;
    } else {
      diffText = `${absHours}h ${absMinutes > 0 ? absMinutes + 'm' : ''} ${i18n.behind}`;
    }

    if (diffMain) diffMain.textContent = diffText;
    if (diffContext) diffContext.textContent = `${selectedCard1.localizedName} → ${selectedCard2.localizedName}`;
    if (diffInfo) diffInfo.style.display = 'block';
  }

  // --- Show Live Display ---
  function showLiveDisplay(
    searchInput: HTMLInputElement,
    resultsList: HTMLElement | null,
    liveDisplay: HTMLElement | null,
    entry: SearchEntry,
    cityEl: HTMLElement | null,
    clockEl: HTMLElement | null,
    dateEl: HTMLElement | null,
    offsetEl: HTMLElement | null,
    daytimeEl: HTMLElement | null,
    emojiEl: HTMLElement | null,
    changeBtn: HTMLElement | null,
    hourEl?: HTMLElement | null,
    minuteEl?: HTMLElement | null,
    secondEl?: HTMLElement | null
  ): void {
    if (searchInput) searchInput.style.display = 'none';
    if (resultsList) resultsList.style.display = 'none';
    if (liveDisplay) liveDisplay.style.display = 'block';

    if (cityEl) cityEl.textContent = entry.localizedName;
    
    updateLiveDisplay(entry, clockEl, dateEl, offsetEl, daytimeEl, emojiEl, hourEl, minuteEl, secondEl);
  }

  // --- Reset Card to Search ---
  function resetCardToSearch(
    searchInput: HTMLInputElement,
    resultsList: HTMLElement | null,
    liveDisplay: HTMLElement | null
  ): void {
    if (searchInput) {
      searchInput.style.display = 'block';
      searchInput.value = '';
    }
    if (resultsList) resultsList.style.display = 'none';
    if (liveDisplay) liveDisplay.style.display = 'none';
  }

  // --- Search Functionality ---
  function performSearch(query: string, resultsList: HTMLElement): void {
    if (!query.trim()) {
      resultsList.classList.remove('active');
      return;
    }

    const normalizedQuery = query.toLowerCase().replace(/[^a-zа-яё0-9+\-:_/\s]/giu, '');
    const matches = searchIndex.filter(item => item.searchStr.includes(normalizedQuery)).slice(0, 8);

    if (matches.length === 0) {
      resultsList.innerHTML = '<li class="search-result-item"><span class="result-city-name">No results found</span></li>';
      resultsList.classList.add('active');
      return;
    }

    resultsList.innerHTML = matches.map(item => `
      <li class="search-result-item" data-tz="${item.tz}" role="option">
        <span class="result-city-name">${item.localizedName}</span>
        <span class="result-city-offset">${item.offset}</span>
      </li>
    `).join('');
    resultsList.classList.add('active');
  }

  // --- Handle Result Selection ---
  function handleResultSelection(tzValue: string): SearchEntry | undefined {
    return searchIndex.find(item => item.tz === tzValue);
  }

  // --- Create World Clock Card (for multi-clock mode, inspired by GitHub repo) ---
  function createWorldClockCard(timezone: string, name: string): HTMLElement {
    const card = document.createElement('div');
    card.className = 'world-clock-card';
    card.dataset.timezone = timezone;

    const emoji = getRegionEmoji(timezone);

    card.innerHTML = `
      <div class="world-clock-header">
        <div class="world-clock-city">
          <span class="world-clock-emoji">${emoji}</span>
          <span class="world-clock-name">${name}</span>
        </div>
        <button class="remove-btn">${i18n.removeCity}</button>
      </div>
      <div class="world-clock-time">--:--:--</div>
      <div class="world-clock-meta">
        <span class="world-clock-date"></span>
        <span class="world-clock-offset"></span>
      </div>
      <div class="world-clock-diff">${calculateTimeDifference(timezone)}</div>
      <div class="world-clock-analog">
        <div class="analog-clock">
          <div class="clock-face">
            <div class="hand hour-hand"></div>
            <div class="hand minute-hand"></div>
            <div class="hand second-hand"></div>
            <div class="clock-center"></div>
          </div>
        </div>
      </div>
    `;

    // Remove button handler
    const removeBtn = card.querySelector('.remove-btn');
    removeBtn?.addEventListener('click', () => {
      card.style.animation = 'slideIn 0.3s ease-out reverse forwards';
      setTimeout(() => {
        savedCities = savedCities.filter(c => c.timezone !== timezone);
        saveCities();
        updateMultiClockDisplay();
      }, 300);
    });

    return card;
  }

  // --- Update Multi-Clock Display ---
  function updateMultiClockDisplay(): void {
    if (!clocksGrid || !emptyState || !savedActions || !citiesCount) return;

    if (savedCities.length === 0) {
      clocksGrid.innerHTML = '';
      emptyState.style.display = 'block';
      savedActions.style.display = 'none';
      return;
    }

    emptyState.style.display = 'none';
    savedActions.style.display = 'flex';
    citiesCount.textContent = `${savedCities.length} ${i18n.savedCities.toLowerCase()}`;

    // Clear and rebuild grid
    clocksGrid.innerHTML = '';
    savedCities.forEach(city => {
      const card = createWorldClockCard(city.timezone, city.name);
      clocksGrid.appendChild(card);
    });
  }

  // --- Update All Multi-Clocks ---
  function updateAllMultiClocks(): void {
    if (!clocksGrid) return;

    const cards = clocksGrid.querySelectorAll('.world-clock-card');
    cards.forEach(card => {
      const timezone = card.dataset.timezone;
      if (!timezone) return;

      try {
        const dateInTZ = getTimeInTZ(timezone);
        
        const timeEl = card.querySelector('.world-clock-time');
        const dateEl = card.querySelector('.world-clock-date');
        const offsetEl = card.querySelector('.world-clock-offset');
        const diffEl = card.querySelector('.world-clock-diff');
        
        const hourHand = card.querySelector('.hour-hand') as HTMLElement;
        const minuteHand = card.querySelector('.minute-hand') as HTMLElement;
        const secondHand = card.querySelector('.second-hand') as HTMLElement;

        if (timeEl) timeEl.textContent = formatTime(dateInTZ);
        if (dateEl) dateEl.textContent = formatDate(dateInTZ);
        if (diffEl) diffEl.textContent = calculateTimeDifference(timezone);

        // Find offset
        const entry = searchIndex.find(e => e.tz === timezone);
        if (offsetEl && entry) offsetEl.textContent = entry.offset;

        // Update analog clock
        updateAnalogClock(hourHand, minuteHand, secondHand, dateInTZ);
      } catch (e) {
        console.error('Error updating clock:', e);
      }
    });
  }

  // --- Mode Switching ---
  function switchMode(mode: 'compare' | 'multi'): void {
    currentMode = mode;

    if (mode === 'compare') {
      compareModeEl!.style.display = 'grid';
      multiModeEl!.style.display = 'none';
      modeCompareBtn?.classList.add('active');
      modeMultiBtn?.classList.remove('active');
    } else {
      compareModeEl!.style.display = 'none';
      multiModeEl!.style.display = 'block';
      modeCompareBtn?.classList.remove('active');
      modeMultiBtn?.classList.add('active');
      updateMultiClockDisplay();
    }
  }

  // --- Event Listeners Setup ---
  function setupEventListeners(): void {
    // Mode toggle
    modeCompareBtn?.addEventListener('click', () => switchMode('compare'));
    modeMultiBtn?.addEventListener('click', () => switchMode('multi'));

    // Card 1 search
    card1Search?.addEventListener('input', (e) => {
      performSearch((e.target as HTMLInputElement).value, card1Results!);
    });

    card1Results?.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('.search-result-item');
      if (!target) return;
      
      const entry = handleResultSelection(target.dataset.tz || '');
      if (entry) {
        selectedCard1 = entry;
        showLiveDisplay(
          card1Search, card1Results, card1Live, entry,
          card1City, card1Clock, card1Date, card1Offset, card1Daytime, card1Emoji, card1Change,
          card1Hour, card1Minute, card1Second
        );
        
        // Enable card 2
        if (card2Search) card2Search.disabled = false;
        updateDiffInfo();
      }
    });

    // Card 1 change button
    card1Change?.addEventListener('click', () => {
      resetCardToSearch(card1Search, card1Results, card1Live);
      selectedCard1 = null;
      if (card2Search) card2Search.disabled = true;
      updateDiffInfo();
    });

    // Card 2 search
    card2Search?.addEventListener('input', (e) => {
      performSearch((e.target as HTMLInputElement).value, card2Results!);
    });

    card2Results?.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('.search-result-item');
      if (!target) return;
      
      const entry = handleResultSelection(target.dataset.tz || '');
      if (entry) {
        selectedCard2 = entry;
        showLiveDisplay(
          card2Search, card2Results, card2Live, entry,
          card2City, card2Clock, card2Date, card2Offset, card2Daytime, card2Emoji, card2Change,
          card2Hour, card2Minute, card2Second
        );
        updateDiffInfo();
      }
    });

    // Card 2 change button
    card2Change?.addEventListener('click', () => {
      resetCardToSearch(card2Search, card2Results, card2Live);
      selectedCard2 = null;
      updateDiffInfo();
    });

    // Multi-clock search
    multiSearch?.addEventListener('input', (e) => {
      performSearch((e.target as HTMLInputElement).value, multiResults!);
    });

    multiResults?.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('.search-result-item');
      if (!target) return;
      
      const entry = handleResultSelection(target.dataset.tz || '');
      if (entry) {
        // Check if already exists
        if (savedCities.some(c => c.timezone === entry.tz)) {
          alert('This city is already in your world clock.');
          return;
        }

        // Add to saved cities
        const newCity: SavedCity = {
          timezone: entry.tz,
          name: entry.localizedName,
          emoji: getRegionEmoji(entry.tz)
        };

        savedCities.push(newCity);
        saveCities();
        updateMultiClockDisplay();

        // Clear search
        if (multiSearch) multiSearch.value = '';
        if (multiResults) multiResults.classList.remove('active');
      }
    });

    // Clear all button
    clearAllBtn?.addEventListener('click', () => {
      if (confirm('Remove all cities from your world clock?')) {
        savedCities = [];
        saveCities();
        updateMultiClockDisplay();
      }
    });

    // Close search results on outside click
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest('.search-wrap')) {
        [card1Results, card2Results, multiResults].forEach(list => {
          if (list) list.classList.remove('active');
        });
      }
    });
  }

  // --- Start Live Updates ---
  function startLiveUpdates(): void {
    if (liveInterval) clearInterval(liveInterval);
    
    liveInterval = window.setInterval(() => {
      // Update compare mode cards
      if (currentMode === 'compare') {
        if (selectedCard1) {
          updateLiveDisplay(selectedCard1, card1Clock, card1Date, card1Offset, card1Daytime, card1Emoji, card1Hour, card1Minute, card1Second);
        }
        if (selectedCard2) {
          updateLiveDisplay(selectedCard2, card2Clock, card2Date, card2Offset, card2Daytime, card2Emoji, card2Hour, card2Minute, card1Second);
        }
      } else {
        // Update multi-clock mode
        updateAllMultiClocks();
      }
    }, 1000);
  }

  // --- Initialize ---
  function init(): void {
    loadSavedCities();
    setupEventListeners();
    startLiveUpdates();
  }

  // Start when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
