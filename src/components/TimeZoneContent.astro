    'Europe/Kiev': 'Kyiv',
    'Europe/Lisbon': 'Lisbon',
    'Europe/Zurich': 'Zurich',
    'Asia/Dhaka': 'Dhaka',
    'Asia/Tehran': 'Tehran',
    'Asia/Kabul': 'Kabul',
    'Asia/Yangon': 'Yangon',
    'Pacific/Honolulu': 'Honolulu',
  };

  // Track added cities (avoid duplicates)
  let addedCities: string[] = [];

  function getOffsetLabel(tz: string, date?: Date): string {
    try {
      const d = date || new Date();
      const formatter = new Intl.DateTimeFormat('en-US', {
        timeZone: tz,
        timeZoneName: 'shortOffset'
      });
      const parts = formatter.formatToParts(d);
      const offsetPart = parts.find(p => p.type === 'timeZoneName');
      return offsetPart?.value || tz;
    } catch {
      return tz;
    }
  }

  function getTimeInTz(tz: string, baseTz: string, customTime?: string): { time: string; date: string; diff: string } {
    try {
      // Create a date with the base timezone's current or custom time
      const now = new Date();

      if (customTime) {
        // Parse custom time and create date in base timezone
        const [hours, minutes] = customTime.split(':').map(Number);
        // Get current date in base timezone, then set the custom time
        const baseFormatter = new Intl.DateTimeFormat('en-US', {
          timeZone: baseTz,
          year: 'numeric', month: '2-digit', day: '2-digit',
          hour: '2-digit', minute: '2-digit', second: '2-digit',
          hour12: false
        });
        const baseParts = baseFormatter.formatToParts(now);
        const year = parseInt(baseParts.find(p => p.type === 'year')?.value || '0');
        const month = parseInt(baseParts.find(p => p.type === 'month')?.value || '0') - 1;
        const day = parseInt(baseParts.find(p => p.type === 'day')?.value || '0');

        // Create a date in UTC that represents the custom time in the base timezone
        // First, find the UTC offset for the base timezone at that time
        const utcDate = new Date(Date.UTC(year, month, day, hours, minutes, 0));

        // Calculate offset for base timezone
        const baseOffset = getBaseOffset(baseTz, utcDate);

        // Adjust to UTC
        utcDate.setUTCMinutes(utcDate.getUTCMinutes() - baseOffset);

        // Now format this UTC date in the target timezone
        const targetFormatter = new Intl.DateTimeFormat('en-US', {
          timeZone: tz,
          hour: '2-digit', minute: '2-digit',
          hour12: false
        });
        const dateFormatter = new Intl.DateTimeFormat('en-US', {
          timeZone: tz,
          weekday: 'short', month: 'short', day: 'numeric'
        });

        const time = targetFormatter.format(utcDate);
        const dateStr = dateFormatter.format(utcDate);

        // Calculate difference
        const targetOffset = getBaseOffset(tz, utcDate);
        const diffHours = (targetOffset - baseOffset) / 60;
        const diffStr = formatDiff(diffHours);

        return { time, date: dateStr, diff: diffStr };
      } else {
        // Current time mode
        const timeFormatter = new Intl.DateTimeFormat('en-US', {
          timeZone: tz,
          hour: '2-digit', minute: '2-digit', second: '2-digit',
          hour12: false
        });
        const dateFormatter = new Intl.DateTimeFormat('en-US', {
          timeZone: tz,
          weekday: 'short', month: 'short', day: 'numeric'
        });

        const time = timeFormatter.format(now);
        const dateStr = dateFormatter.format(now);

        // Calculate offset difference
        const baseOffset = getBaseOffset(baseTz, now);
        const targetOffset = getBaseOffset(tz, now);
        const diffHours = (targetOffset - baseOffset) / 60;
        const diffStr = formatDiff(diffHours);

        return { time, date: dateStr, diff: diffStr };
      }
    } catch {
      return { time: '--:--', date: '', diff: '' };
    }
  }

  function getBaseOffset(tz: string, date: Date): number {
    // Returns offset in minutes (positive = ahead of UTC)
    const utcDate = new Date(date.getTime());
    const tzString = date.toLocaleString('en-US', { timeZone: tz });
    const tzDate = new Date(tzString);
    return (tzDate.getTime() - utcDate.getTime()) / 60000;
  }

  function formatDiff(diffHours: number): string {
    if (diffHours === 0) return 'Same time';
    const sign = diffHours > 0 ? '+' : '-';
    const abs = Math.abs(diffHours);
    const h = Math.floor(abs);
    const m = Math.round((abs - h) * 60);
    if (m === 0) return sign + h + 'h';
    if (m === 30) return sign + h + ':30h';
    return sign + h + 'h ' + m + 'm';
  }

  function isNightTime(tz: string): boolean {
    try {
      const now = new Date();
      const formatter = new Intl.DateTimeFormat('en-US', {
        timeZone: tz,
        hour: 'numeric',
        hour12: false
      });
      const hour = parseInt(formatter.format(now));
      return hour < 6 || hour >= 21;
    } catch {
      return false;
    }
  }

  function renderClocks() {
    const baseTz = baseTzSelect?.value || 'Europe/Moscow';
    const customTime = customTimeInput?.value || '';

    // Update base time display
    if (baseTimeValue) {
      const formatter = new Intl.DateTimeFormat('en-US', {
        timeZone: baseTz,
        hour: '2-digit', minute: '2-digit', second: '2-digit',
        hour12: false
      });
      baseTimeValue.textContent = formatter.format(new Date());
    }
    if (baseTimeOffset) {
      baseTimeOffset.textContent = getOffsetLabel(baseTz);
    }
    if (baseTimeDate) {
      const df = new Intl.DateTimeFormat('en-US', {
        timeZone: baseTz,
        weekday: 'short', month: 'short', day: 'numeric'
      });
      baseTimeDate.textContent = df.format(new Date());
    }

    // Render comparison clocks
    if (!clocksGrid) return;
    const allCities = [...defaultCities.filter(c => c !== baseTz), ...addedCities.filter(c => c !== baseTz && !defaultCities.includes(c))];
    clocksGrid.innerHTML = '';

    allCities.forEach(tz => {
      const result = getTimeInTz(tz, baseTz, customTime || undefined);
      const isNight = isNightTime(tz);
      const name = cityNames[tz] || tz.split('/').pop() || tz;
      const offsetLabel = getOffsetLabel(tz);

      const card = document.createElement('div');
      card.className = 'clock-card' + (isNight ? ' night' : '');
      card.innerHTML = `
        <div class="clock-city">${name}</div>
        <div class="clock-offset">${offsetLabel}</div>
        <div class="clock-time">${result.time}</div>
        <div class="clock-date">${result.date}</div>
        <div class="clock-diff">${result.diff}</div>
        <button class="clock-remove" data-tz="${tz}" title="Remove">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      `;
      clocksGrid.appendChild(card);
    });

    // Attach remove buttons
    clocksGrid.querySelectorAll('.clock-remove').forEach(btn => {
      btn.addEventListener('click', () => {
        const tz = btn.getAttribute('data-tz') || '';
        addedCities = addedCities.filter(c => c !== tz);
        // Also allow removing from defaults
        const idx = defaultCities.indexOf(tz);
        if (idx > -1) defaultCities.splice(idx, 1);
        renderClocks();
      });
    });
  }

  // Modal logic
  addCityBtn?.addEventListener('click', () => {
    modalOverlay?.classList.add('active');
  });

  modalCancelBtn?.addEventListener('click', () => {
    modalOverlay?.classList.remove('active');
  });

  modalOverlay?.addEventListener('click', (e) => {
    if (e.target === modalOverlay) modalOverlay.classList.remove('active');
  });

  modalAddBtn?.addEventListener('click', () => {
    const tz = modalTzSelect?.value || '';
    if (tz && !addedCities.includes(tz) && !defaultCities.includes(tz)) {
      addedCities.push(tz);
    } else if (tz && !defaultCities.includes(tz)) {
      // Already added, skip
    } else if (tz && defaultCities.includes(tz)) {
      // Already in defaults, skip
    }
    modalOverlay?.classList.remove('active');
    renderClocks();
  });

  // Live updates
  baseTzSelect?.addEventListener('change', renderClocks);
  customTimeInput?.addEventListener('input', renderClocks);

  // Initial render + live clock
  renderClocks();
  setInterval(renderClocks, 1000);
</script>

