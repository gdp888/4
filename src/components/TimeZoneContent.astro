          <span class="world-clock-name">${name}</span>
        </div>
        <button class="remove-btn">${i18n.removeCity}</button>
      </div>
      <div class="world-clock-time">--:--:--</div>
      <div class="world-clock-meta">
        <span class="world-clock-date"></span>
        <span class="world-clock-offset"></span>
      </div>
      <div class="world-clock-diff">${calculateTimeDifference(timezone)}</div>
      <div class="world-clock-analog">
        <div class="analog-clock">
          <div class="clock-face">
            <div class="hand hour-hand"></div>
            <div class="hand minute-hand"></div>
            <div class="hand second-hand"></div>
            <div class="clock-center"></div>
          </div>
        </div>
      </div>
    `;

    const removeBtn = card.querySelector('.remove-btn');
    removeBtn?.addEventListener('click', () => {
      card.style.animation = 'slideIn 0.3s ease-out reverse forwards';
      setTimeout(() => {
        savedCities = savedCities.filter(c => c.timezone !== timezone);
        saveCities();
        updateMultiClockDisplay();
      }, 300);
    });

    return card;
  }

  // Update Multi-Clock Display
  function updateMultiClockDisplay(): void {
    if (!clocksGrid || !emptyState || !savedActions || !citiesCount) return;

    if (savedCities.length === 0) {
      clocksGrid.innerHTML = '';
      emptyState.style.display = 'block';
      savedActions.style.display = 'none';
      return;
    }

    emptyState.style.display = 'none';
    savedActions.style.display = 'flex';
    citiesCount.textContent = `${savedCities.length} ${i18n.savedCities.toLowerCase()}`;

    clocksGrid.innerHTML = '';
    savedCities.forEach(city => {
      const card = createWorldClockCard(city.timezone, city.name);
      clocksGrid.appendChild(card);
    });
  }

  // Update All Multi-Clocks
  function updateAllMultiClocks(): void {
    if (!clocksGrid) return;

    const cards = clocksGrid.querySelectorAll('.world-clock-card');
    cards.forEach(card => {
      const timezone = card.dataset.timezone;
      if (!timezone) return;

      try {
        const dateInTZ = getTimeInTZ(timezone);
        
        const timeEl = card.querySelector('.world-clock-time');
        const dateEl = card.querySelector('.world-clock-date');
        const offsetEl = card.querySelector('.world-clock-offset');
        const diffEl = card.querySelector('.world-clock-diff');
        
        const hourHand = card.querySelector('.hour-hand') as HTMLElement;
        const minuteHand = card.querySelector('.minute-hand') as HTMLElement;
        const secondHand = card.querySelector('.second-hand') as HTMLElement;

        if (timeEl) timeEl.textContent = formatTime(dateInTZ);
        if (dateEl) dateEl.textContent = formatDate(dateInTZ);
        if (diffEl) diffEl.textContent = calculateTimeDifference(timezone);

        const entry = searchIndex.find(e => e.tz === timezone);
        if (offsetEl && entry) offsetEl.textContent = entry.offset;

        updateAnalogClock(hourHand, minuteHand, secondHand, dateInTZ);
      } catch (e) {
        console.error('Error updating clock:', e);
      }
    });
  }

  // ===== CONVERTER MODE FUNCTIONS =====

  /**
   * Populate timezone select dropdowns
   */
  function populateConverterSelects(): void {
    if (!convFromTz || !convToTz) return;
    
    const optionsHTML = searchIndex.map(item => 
      `<option value="${item.tz}" data-offset="${item.offset}">${item.localizedName} (${item.offset})</option>`
    ).join('');
    
    convFromTz.innerHTML = optionsHTML;
    convToTz.innerHTML = optionsHTML;
    
    // Set defaults
    if (searchIndex.length >= 2) {
      convFromTz.value = searchIndex[0].tz; // First city (Moscow)
      convToTz.value = searchIndex[2].tz; // Third city (New York)
    }
    
    // Set default date to today
    if (convToDate) {
      const today = new Date().toISOString().split('T')[0];
      convToDate.value = today;
    }
  }

  /**
   * Perform time conversion using Spacetime (async)
   */
  async function performConversion(): Promise<void> {
    if (!convFromTz || !convToDate || !convFromTime || !convToTz || !convResult) return;
    
    const fromTZ = convFromTz.value;
    const toDate = convToDate.value;
    const toTime = convFromTime.value;
    const toTZ = convToTz.value;
    
    if (!fromTZ || !toDate || !toTime || !toTZ) {
      convResult.innerHTML = '<span class="result-placeholder">Please fill all fields</span>';
      return;
    }
    
    // Show loading state
    convResult.innerHTML = '<span class="result-placeholder">Converting...</span>';
    
    const result = await convertTimeWithSpacetime(fromTZ, toDate, toTime, toTZ);
    
    if (!result) {
      convResult.innerHTML = '<span class="result-placeholder">Conversion error</span>';
      return;
    }
    
    // Show main result
    convResult.innerHTML = `<span class="converted-time">${result.formatted}</span>`;
    
    // Show detailed result
    if (convDetailed && convDetailedBody) {
      const fromEntry = searchIndex.find(e => e.tz === fromTZ);
      const toEntry = searchIndex.find(e => e.tz === toTZ);
      
      convDetailedBody.innerHTML = `
        <div style="margin-bottom: 8px;">
          <strong>${toDate} ${toTime}</strong> in ${fromEntry?.localizedName || fromTZ}
        </div>
        <div style="margin-bottom: 8px;">
          → <strong>${result.formatted}</strong> on ${result.dateFormatted} in ${toEntry?.localizedName || toTZ}
        </div>
        <div style="color: var(--accent-primary); font-weight: 500;">
          ${result.offsetDiff}
        </div>
        ${result.isDST ? '<div style="margin-top: 8px; font-size: 0.85rem; color: #d97706;">⏰ Daylight Saving Time is active in target timezone</div>' : ''}
      `;
      convDetailed.style.display = 'block';
    }
  }

  /**
   * Swap from/to timezones
   */
  function swapTimezones(): void {
    if (!convFromTz || !convToTz) return;
    
    const temp = convFromTz.value;
    convFromTz.value = convToTz.value;
    convToTz.value = temp;
    
    // Re-run conversion if we have values
    if (convFromDate && convFromTime) {
      performConversion();
    }
  }

  /**
   * Copy conversion result to clipboard
   */
  async function copyResult(): Promise<void> {
    if (!convResult) return;
    
    const timeText = convResult.textContent;
    if (!timeText || timeText === '--:--') return;
    
    try {
      await navigator.clipboard.writeText(timeText);
      if (convCopyBtn) {
        const originalText = convCopyBtn.querySelector('span')?.textContent;
        if (convCopyBtn.querySelector('span')) {
          (convCopyBtn.querySelector('span') as HTMLElement).textContent = i18n.copyDone;
        }
        setTimeout(() => {
          if (convCopyBtn.querySelector('span')) {
            (convCopyBtn.querySelector('span') as HTMLElement).textContent = i18n.copyTime;
          }
        }, 2000);
      }
    } catch (e) {
      console.error('Failed to copy:', e);
    }
  }

  /**
   * Populate quick reference conversions
   */
  function populateQuickRef(): void {
    if (!quickRefGrid) return;
    
    // Common conversion pairs
    const commonPairs = [
      { from: 'America/New_York', to: 'Europe/London', label: 'NY ↔ London' },
      { from: 'Europe/London', to: 'Europe/Moscow', label: 'London ↔ Moscow' },
      { from: 'Asia/Tokyo', to: 'America/Los_Angeles', label: 'Tokyo ↔ LA' },
      { from: 'Europe/Berlin', to: 'Asia/Dubai', label: 'Berlin ↔ Dubai' },
      { from: 'Australia/Sydney', to: 'Asia/Tokyo', label: 'Sydney ↔ Tokyo' },
    ];
    
    quickRefGrid.innerHTML = commonPairs.map(pair => {
      const fromEntry = searchIndex.find(e => e.tz === pair.from);
      const toEntry = searchIndex.find(e => e.tz === pair.to);
      
      return `
        <div class="quick-ref-item" data-from="${pair.from}" data-to="${pair.to}">
          <span class="quick-ref-from">${fromEntry?.localizedName || pair.from}</span>
          <span class="quick-ref-arrow">→</span>
          <span class="quick-ref-to">${toEntry?.localizedName || pair.to}</span>
        </div>
      `;
    }).join('');
    
    // Add click handlers
    quickRefGrid.querySelectorAll('.quick-ref-item').forEach(item => {
      item.addEventListener('click', () => {
        const from = item.getAttribute('data-from');
        const to = item.getAttribute('data-to');
        if (from && to && convFromTz && convToTz) {
          convFromTz.value = from;
          convToTz.value = to;
          // Switch to converter mode
          switchMode('converter');
          performConversion();
        }
      });
    });
  }

  // Mode Switching
  function switchMode(mode: 'compare' | 'multi' | 'converter'): void {
    currentMode = mode;

    // Hide all modes
    if (compareModeEl) compareModeEl.style.display = 'none';
    if (multiModeEl) multiModeEl.style.display = 'none';
    if (converterModeEl) converterModeEl.style.display = 'none';

    // Remove active from all buttons
    modeCompareBtn?.classList.remove('active');
    modeMultiBtn?.classList.remove('active');
    modeConverterBtn?.classList.remove('active');

    // Show selected mode
    switch (mode) {
      case 'compare':
        if (compareModeEl) compareModeEl.style.display = 'grid';
        modeCompareBtn?.classList.add('active');
        break;
      case 'multi':
        if (multiModeEl) multiModeEl.style.display = 'block';
        modeMultiBtn?.classList.add('active');
        updateMultiClockDisplay();
        break;
      case 'converter':
        if (converterModeEl) converterModeEl.style.display = 'block';
        modeConverterBtn?.classList.add('active');
        // Initialize converter on first show
        if (convFromTz && convFromTz.options.length === 0) {
          populateConverterSelects();
          populateQuickRef();
        }
        break;
    }
  }

  // LocalStorage for saved cities
  function loadSavedCities(): void {
    try {
      const saved = localStorage.getItem('opnchat-worldclock');
      if (saved) {
        savedCities = JSON.parse(saved);
      }
    } catch (e) {
      console.warn('Failed to load saved cities:', e);
    }
  }

  function saveCities(): void {
    try {
      localStorage.setItem('opnchat-worldclock', JSON.stringify(savedCities));
    } catch (e) {
      console.warn('Failed to save cities:', e);
    }
  }

  // Event Listeners Setup
  function setupEventListeners(): void {
    // Mode toggle
    modeCompareBtn?.addEventListener('click', () => switchMode('compare'));
    modeMultiBtn?.addEventListener('click', () => switchMode('multi'));
    modeConverterBtn?.addEventListener('click', () => switchMode('converter'));

    // Card 1 search
    card1Search?.addEventListener('input', (e) => {
      performSearch((e.target as HTMLInputElement).value, card1Results!);
    });

    card1Results?.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('.search-result-item');
      if (!target) return;
      
      const entry = handleResultSelection(target.dataset.tz || '');
      if (entry) {
        selectedCard1 = entry;
        showLiveDisplay(
          card1Search, card1Results, card1Live, entry,
          card1City, card1Clock, card1Date, card1Offset, card1Daytime, card1Emoji, card1Change,
          card1Hour, card1Minute, card1Second
        );
        
        if (card2Search) card2Search.disabled = false;
        updateDiffInfo();
      }
    });

    card1Change?.addEventListener('click', () => {
      resetCardToSearch(card1Search, card1Results, card1Live);
      selectedCard1 = null;
      if (card2Search) card2Search.disabled = true;
      updateDiffInfo();
    });

    // Card 2 search
    card2Search?.addEventListener('input', (e) => {
      performSearch((e.target as HTMLInputElement).value, card2Results!);
    });

    card2Results?.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('.search-result-item');
      if (!target) return;
      
      const entry = handleResultSelection(target.dataset.tz || '');
      if (entry) {
        selectedCard2 = entry;
        showLiveDisplay(
          card2Search, card2Results, card2Live, entry,
          card2City, card2Clock, card2Date, card2Offset, card2Daytime, card2Emoji, card2Change,
          card2Hour, card2Minute, card2Second
        );
        updateDiffInfo();
      }
    });

    card2Change?.addEventListener('click', () => {
      resetCardToSearch(card2Search, card2Results, card2Live);
      selectedCard2 = null;
      updateDiffInfo();
    });

    // Multi-clock search
    multiSearch?.addEventListener('input', (e) => {
      performSearch((e.target as HTMLInputElement).value, multiResults!);
    });

    multiResults?.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('.search-result-item');
      if (!target) return;
      
      const entry = handleResultSelection(target.dataset.tz || '');
      if (entry) {
        if (savedCities.some(c => c.timezone === entry.tz)) {
          alert('This city is already in your world clock.');
          return;
        }

        const newCity: SavedCity = {
          timezone: entry.tz,
          name: entry.localizedName,
          emoji: getRegionEmoji(entry.tz)
        };

        savedCities.push(newCity);
        saveCities();
        updateMultiClockDisplay();

        if (multiSearch) multiSearch.value = '';
        if (multiResults) multiResults.classList.remove('active');
      }
    });

    clearAllBtn?.addEventListener('click', () => {
      if (confirm('Remove all cities from your world clock?')) {
        savedCities = [];
        saveCities();
        updateMultiClockDisplay();
      }
    });

    // Converter event listeners
    convConvertBtn?.addEventListener('click', performConversion);
    convSwapBtn?.addEventListener('click', swapTimezones);
    convCopyBtn?.addEventListener('click', copyResult);
    
    // Auto-convert when inputs change
    convFromTz?.addEventListener('change', performConversion);
    convToTz?.addEventListener('change', performConversion);
    convFromDate?.addEventListener('change', performConversion);
    convFromTime?.addEventListener('change', performConversion);

    // Close search results on outside click
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest('.search-wrap')) {
        [card1Results, card2Results, multiResults].forEach(list => {
          if (list) list.classList.remove('active');
        });
      }
    });
  }

  // Start Live Updates
  function startLiveUpdates(): void {
    if (liveInterval) clearInterval(liveInterval);
    
    liveInterval = window.setInterval(() => {
      if (currentMode === 'compare') {
        if (selectedCard1) {
          updateLiveDisplay(selectedCard1, card1Clock, card1Date, card1Offset, card1Daytime, card1Emoji, card1Hour, card1Minute, card1Second);
        }
        if (selectedCard2) {
          updateLiveDisplay(selectedCard2, card2Clock, card2Date, card2Offset, card2Daytime, card2Emoji, card2Hour, card2Minute, card2Second);
        }
      } else if (currentMode === 'multi') {
        updateAllMultiClocks();
      }
    }, 1000);
  }

  // Initialize
  function init(): void {
    loadSavedCities();
    setupEventListeners();
    startLiveUpdates();
    
    // Preload Spacetime in background (non-blocking)
    getSpacetime().then(sp => {
      if (sp) {
        console.log('✅ Spacetime library ready for conversions');
      }
    });
  }

  // Start when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
