  // Build search index from server-rendered data
  function buildSearchIndex(): SearchEntry[] {
    const cityDataEl = document.getElementById('tz-city-data');
    if (!cityDataEl) return [];
    
    const cities: Record<string, string> = JSON.parse(cityDataEl.dataset.cities || '{}');
    const offsets: Record<string, string> = JSON.parse(cityDataEl.dataset.offsets || '{}');
    
    return Object.entries(cities).map(([tz, name]) => ({
      tz,
      localizedName: name,
      offset: offsets[tz] || '',
      offsetMinutes: parseOffsetToMinutes(offsets[tz] || ''),
      searchStr: `${name.toLowerCase()} ${tz.toLowerCase()} ${offsets[tz]?.toLowerCase() || ''}`
    }));
  }

  function parseOffsetToMinutes(offsetStr: string): number {
    // Parse offsets like "UTC+3", "UTC-5/-4", "UTC+5:30"
    const match = offsetStr.match(/UTC([+-])(\d+)(?::(\d+))?/);
    if (!match) return 0;
    
    const sign = match[1] === '+' ? 1 : -1;
    const hours = parseInt(match[2]) || 0;
    const minutes = parseInt(match[3]) || 0;
    
    return sign * (hours * 60 + minutes);
  }

  const searchIndex: SearchEntry[] = buildSearchIndex();

  // ===== SPACETIME INTEGRATION =====
  // Dynamic loading with proper error handling
  let spacetimeLoadPromise: Promise<boolean> | null = null;
  const SPACETIME_CDN_URL = 'https://cdn.jsdelivr.net/npm/spacetime@7.4.0/builds/spacetime.min.js';

  /**
   * Check if Spacetime is available (sync check)
   */
  function isSpacetimeReady(): boolean {
    return typeof (window as any).spacetime !== 'undefined';
  }

  /**
   * Get Spacetime sync (for live clock updates - may return null if not loaded yet)
   */
  function getSpacetimeSync(): typeof window.spacetime | null {
    if (isSpacetimeReady()) {
      return (window as any).spacetime;
    }
    return null;
  }

  /**
   * Ensure Spacetime is loaded - loads from CDN if needed
   */
  async function ensureSpacetime(): Promise<boolean> {
    // Already available
    if (isSpacetimeReady()) {
      return true;
    }
    
    // Already loading
    if (spacetimeLoadPromise) {
      return spacetimeLoadPromise;
    }
    
    // Load from CDN
    spacetimeLoadPromise = (async () => {
      try {
        console.log('📦 Loading Spacetime from CDN...');
        
        return new Promise<boolean>((resolve, reject) => {
          const script = document.createElement('script');
          script.src = SPACETIME_CDN_URL;
          script.async = true;
          
          script.onload = () => {
            // Wait a tick for the script to execute
            setTimeout(() => {
              if (isSpacetimeReady()) {
                console.log('✅ Spacetime loaded successfully (v' + ((window as any).spacetime).version + ')');
                console.log('📚 GitHub: https://github.com/spencermountain/spacetime');
                resolve(true);
              } else {
                reject(new Error('Spacetime not available after load'));
              }
            }, 50);
          };
          
          script.onerror = () => {
            reject(new Error('Failed to load Spacetime script'));
          };
          
          document.head.appendChild(script);
        });
      } catch (error) {
        console.warn('⚠️ Failed to load Spacetime:', error);
        console.warn('Using Intl API fallback for timezone conversion');
        return false;
      }
    })();
    
    return spacetimeLoadPromise;
  }

  /**
   * Get Spacetime library (alias for ensureSpacetime + get)
   */
  async function getSpacetime(): Promise<typeof window.spacetime | null> {
    const ready = await ensureSpacetime();
    return ready ? (window as any).spacetime : null;
  }

  /**
   * Get current time in timezone using Spacetime (with fallback)
   */
  function getTimeInTZ(timezone: string): Date {
    const sp = getSpacetimeSync(); // Use sync version for live clock updates
    
    if (sp) {
      try {
        // Use Spacetime for accurate timezone conversion
        const now = sp.now();
        const inTz = now.goto(timezone);
        return inTz.toNativeDate();
      } catch (e) {
        console.warn('Spacetime error, falling back:', e);
      }
    }
    
    // Fallback: Use Intl.DateTimeFormat
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: timezone,
      year: 'numeric', month: 'numeric', day: 'numeric',
      hour: 'numeric', minute: 'numeric', second: 'numeric',
      hour12: false
    }).formatToParts(new Date());
    
    const getVal = (type: Intl.DateTimeFormatPartTypes) => parts.find(p => p.type === type)?.value;
    return new Date(
      parseInt(getVal('year')!),
      parseInt(getVal('month')!) - 1,
      parseInt(getVal('day')!),
      parseInt(getVal('hour')!),
      parseInt(getVal('minute')!),
      parseInt(getVal('second')!)
    );
  }

  /**
   * Convert specific time between timezones using Spacetime (async with retry)
   */
  async function convertTimeWithSpacetime(fromTZ: string, dateStr: string, timeStr: string, toTZ: string): Promise<{
    resultDate: Date;
    formatted: string;
    dateFormatted: string;
    offsetDiff: string;
    isDST: boolean;
  } | null> {
    console.log('🔄 convertTimeWithSpacetime called');
    const sp = await getSpacetime();
    console.log('🔄 getSpacetime returned:', sp ? 'spacetime object' : 'null', '| window.spacetime exists:', typeof (window as any).spacetime !== 'undefined');
    
    if (!sp) {
      console.error('Spacetime not available');
      return null;
    }

    try {
      // Parse input date/time
      const [year, month, day] = dateStr.split('-').map(Number);
      const [hour, minute] = timeStr.split(':').map(Number);
      
      // Create spacetime instance in source timezone
      const sourceTime = sp([year, month - 1, day, hour, minute], fromTZ);
      
      // Convert to target timezone
      const converted = sourceTime.goto(toTZ);
      
      // Get offset difference using Spacetime
      const sourceOffset = sourceTime.timezone().current.offset;
      const targetOffset = converted.timezone().current.offset;
      
      // Calculate difference in hours
      const diffMs = converted.time() - sourceTime.time(); // This isn't right, need proper calculation
      // Actually we need to compare the same instant
      
      // Get formatted results
      const formatted = converted.format('{hours}:{minutes-pad}');
      const dateFormatted = converted.format('{month-pad}/{day-pad}/{year}');
      
      // Check DST status
      const isDST = converted.isDST();
      
      // Calculate actual time difference
      const sourceInstant = sp.now().goto(fromTZ);
      const targetInstant = sp.now().goto(toTZ);
      const sourceOffsetMinutes = parseInt(sourceInstant.timezone().current.offset) * 60;
      const targetOffsetMinutes = parseInt(targetInstant.timezone().current.offset) * 60;
      const totalDiffMinutes = targetOffsetMinutes - sourceOffsetMinutes;
      
      const absHours = Math.abs(Math.floor(totalDiffMinutes / 60));
      const absMins = Math.abs(totalDiffMinutes % 60);
      let offsetDiff = '';
      
      if (totalDiffMinutes === 0) {
        offsetDiff = i18n.sameTime;
      } else if (totalDiffMinutes > 0) {
        offsetDiff = `${absHours}h ${absMins > 0 ? absMins + 'm' : ''} ${i18n.ahead}`;
      } else {
        offsetDiff = `${absHours}h ${absMins > 0 ? absMins + 'm' : ''} ${i18n.behind}`;
      }
      
      return {
        resultDate: converted.toNativeDate(),
        formatted,
        dateFormatted,
        offsetDiff,
        isDST
      };
    } catch (e) {
      console.error('Spacetime conversion error:', e);
      return null;
    }
  }

  // Formatting functions
  function formatTime(date: Date): string {
    return date.toLocaleTimeString('en-US', { 
      hour: '2-digit', 
