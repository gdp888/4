<script>
  // ===== Time Zone Converter Logic =====
  const baseTzSelect = document.getElementById('base-tz');
  const baseTimeValue = document.getElementById('base-time-value');
  const baseTimeOffset = document.getElementById('base-time-offset');
  const baseTimeDate = document.getElementById('base-time-date');
  const customTimeInput = document.getElementById('custom-time');
