---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';
import { getRelativeLocaleUrl, getAbsoluteLocaleUrl } from 'astro:i18n';
import { languages, type Lang } from '../i18n/ui';
import SiteHeader from './SiteHeader.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import SEOHead from './SEOHead.astro';
import { timezones } from '../data/timezones';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Localized city name map for client-side JS
const cityTranslations: Record<string, string> = {};
timezones.forEach(tz => { cityTranslations[tz.value] = t(tz.cityKey); });

const offsetMap: Record<string, string> = {};
timezones.forEach(tz => { offsetMap[tz.value] = tz.offset; });

const tzSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": t('tz.heading'),
      "url": getAbsoluteLocaleUrl(lang, 'timezone'),
      "description": t('tz.meta.description'),
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Any",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      isPartOf: {
        "@type": "WebSite",
        "name": "OPN Chat",
        "url": "https://opnchat.net/"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "OPN Chat",
          "item": getAbsoluteLocaleUrl(lang, '')
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('bc.timezone'),
          "item": getAbsoluteLocaleUrl(lang, 'timezone')
        }
      ]
    }
  ]
};
---

<Layout title={t('tz.meta.title')} lang={lang} service="timezone">
  <Fragment slot="meta">
  <SEOHead
    lang={lang}
    description={t('tz.meta.description')}
    canonicalUrl={getAbsoluteLocaleUrl(lang, 'timezone')}
    ogTitle={t('tz.meta.og.title')}
    ogDescription={t('tz.meta.description')}
    ogUrl={getAbsoluteLocaleUrl(lang, 'timezone')}
    schema={tzSchema}
    extraMeta={`<meta name="keywords" content="${t('tz.meta.keywords')}" /><meta name="twitter:card" content="summary" /><meta name="twitter:title" content="${t('tz.meta.twitter.title')}" /><meta name="twitter:description" content="${t('tz.meta.twitter.description')}" />`}
/>
</Fragment>

<div class="container">
  <!-- Header -->
  <SiteHeader lang={lang} path="timezone" activeTool="timezone" />

  <Breadcrumbs lang={lang} items={[{ label: t('bc.home'), href: getRelativeLocaleUrl(lang) }, { label: t('bc.timezone') }]} />

  <!-- Hero -->
  <div class="hero">
    <h1 class="title"><span class="title-full">{t('tz.heading')}</span><span class="title-short">{t('tz.heading.short')}</span></h1>
    <p class="subtitle">{t('tz.subtitle')}</p>
    <div class="privacy-badge">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      {t('tz.privacy.badge')}
    </div>
  </div>

  <!-- Pass data to JS -->
  <div id="tz-city-data" data-cities={JSON.stringify(cityTranslations)} data-offsets={JSON.stringify(offsetMap)} style="display:none"></div>
  <div id="tz-i18n" 
    data-lang={lang} 
    data-card1-label={t('tz.card1.label')} 
    data-card1-placeholder={t('tz.card1.placeholder')}
    data-card2-label={t('tz.card2.label')} 
    data-card2-placeholder={t('tz.card2.placeholder')}
    data-time-diff={t('tz.timeDiff.label')}
    data-ahead={t('tz.timeDiff.ahead')}
    data-behind={t('tz.timeDiff.behind')}
    data-same-time={t('tz.diff.same')}
    data-morning={t('tz.daytime.morning')}
    data-day={t('tz.daytime.day')}
    data-evening={t('tz.daytime.evening')}
    data-night={t('tz.daytime.night')}
    data-copy-time={t('tz.copy.time')}
    data-copy-done={t('tz.copy.done')}
    data-add-city={t('tz.multi.addCity') || 'Add City'}
    data-remove-city={t('tz.multi.removeCity') || 'Remove'}
    data-saved-cities={t('tz.multi.savedCities') || 'Saved Cities'}
    data-clear-all={t('tz.multi.clearAll') || 'Clear All'}
    style="display:none"></div>

  <!-- ===== ENHANCED UI: Multi-Clock World Clock ===== -->
  
  <!-- Mode Toggle: Compare vs Multi-Clock -->
  <div class="mode-toggle">
    <button class="mode-btn active" id="mode-compare">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      {t('tz.mode.compare') || 'Compare'}
    </button>
    <button class="mode-btn" id="mode-multi">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      {t('tz.mode.worldClock') || 'World Clock'}
    </button>
  </div>

  <!-- COMPARE MODE: Two Cards + Live Time -->
  <div id="compare-mode">
    <!-- CARD 1: Your Timezone -->
    <div class="tz-card" id="card1">
      <div class="card-header">
        <span class="card-number">1</span>
        <span class="card-title">{t('tz.card1.label')}</span>
      </div>
      
      <div class="search-wrap">
        <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="search" id="card1-search" class="search-input" placeholder={t('tz.card1.placeholder')} autocomplete="off" />
      </div>
      <ul class="search-results" id="card1-results" role="listbox"></ul>

      <!-- Live time display with analog clock -->
      <div class="live-time-display" id="card1-live" style="display:none">
        <div class="live-time-main">
          <div class="city-info">
            <span class="city-name" id="card1-city"></span>
            <span class="region-emoji" id="card1-emoji"></span>
          </div>
          <div class="clock-wrapper">
            <span class="live-clock" id="card1-clock">--:--:--</span>
            <div class="analog-clock" id="card1-analog">
              <div class="clock-face">
                <div class="hand hour-hand" id="card1-hour"></div>
                <div class="hand minute-hand" id="card1-minute"></div>
                <div class="hand second-hand" id="card1-second"></div>
                <div class="clock-center"></div>
              </div>
            </div>
          </div>
        </div>
        <div class="live-time-meta">
          <span class="live-date" id="card1-date"></span>
          <span class="live-offset" id="card1-offset"></span>
        </div>
        <div class="daytime-badge" id="card1-daytime"></div>
        <button class="change-btn" id="card1-change" aria-label="Change city">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        </button>
      </div>
    </div>

    <!-- CARD 2: Contact's Timezone -->
    <div class="tz-card tz-card-secondary" id="card2">
      <div class="card-header">
        <span class="card-number">2</span>
        <span class="card-title">{t('tz.card2.label')}</span>
      </div>
      
      <div class="search-wrap">
        <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="search" id="card2-search" class="search-input" placeholder={t('tz.card2.placeholder')} autocomplete="off" disabled />
      </div>
      <ul class="search-results" id="card2-results" role="listbox"></ul>

      <!-- Live time display with analog clock -->
      <div class="live-time-display" id="card2-live" style="display:none">
        <div class="live-time-main">
          <div class="city-info">
            <span class="city-name" id="card2-city"></span>
            <span class="region-emoji" id="card2-emoji"></span>
          </div>
          <div class="clock-wrapper">
            <span class="live-clock" id="card2-clock">--:--:--</span>
            <div class="analog-clock" id="card2-analog">
              <div class="clock-face">
                <div class="hand hour-hand" id="card2-hour"></div>
                <div class="hand minute-hand" id="card2-minute"></div>
                <div class="hand second-hand" id="card2-second"></div>
                <div class="clock-center"></div>
              </div>
            </div>
          </div>
        </div>
        <div class="live-time-meta">
          <span class="live-date" id="card2-date"></span>
          <span class="live-offset" id="card2-offset"></span>
        </div>
        <div class="daytime-badge" id="card2-daytime"></div>
        <button class="change-btn" id="card2-change" aria-label="Change city">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        </button>
      </div>

      <!-- Time Difference Info -->
      <div class="diff-info" id="diff-info" style="display:none">
        <div class="diff-main" id="diff-main"></div>
        <div class="diff-context" id="diff-context"></div>
      </div>
    </div>
  </div>

  <!-- MULTI-CLOCK MODE: Multiple Cities Grid -->
  <div id="multi-mode" style="display:none">
    <!-- Add City Section -->
    <div class="add-city-section">
      <h3 class="add-city-title">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
        {t('tz.multi.addCity') || 'Add City'}
      </h3>
      <div class="add-city-form">
        <div class="search-wrap">
          <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="search" id="multi-search" class="search-input" placeholder={t('tz.card1.placeholder')} autocomplete="off" />
        </div>
        <ul class="search-results" id="multi-results" role="listbox"></ul>
      </div>
    </div>

    <!-- Clocks Grid -->
    <div class="clocks-grid" id="clocks-grid">
      <!-- Clocks will be added here dynamically -->
    </div>

    <!-- Empty State -->
    <div class="empty-state" id="empty-state">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="12" cy="12" r="10"/>
        <polyline points="12 6 12 12 16 14"/>
      </svg>
      <p>{t('tz.multi.emptyState') || 'No cities added yet. Search and add cities above to see their current time.'}</p>
    </div>

    <!-- Saved Cities Actions -->
    <div class="saved-actions" id="saved-actions" style="display:none">
      <button class="btn-secondary" id="clear-all-btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
        {t('tz.multi.clearAll') || 'Clear All'}
      </button>
      <span class="cities-count" id="cities-count">0 cities</span>
    </div>
  </div>

  <!-- Visual 24h Timeline -->
  <section class="timeline-section" id="timeline-section">
    <h2 class="section-title">{t('tz.timeline.title')}</h2>
    <div class="timeline-legend">
      <span class="legend-item legend-work"><span class="legend-swatch"></span>{t('tz.timeline.legend.work')}</span>
      <span class="legend-item legend-night"><span class="legend-swatch"></span>{t('tz.timeline.legend.night')}</span>
    </div>
    <div class="timeline-placeholder" id="timeline-placeholder">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="12" cy="12" r="10"/>
        <polyline points="12,6 12,12 16,14"/>
      </svg>
      <p class="timeline-placeholder-text">{t('tz.timeline.placeholder')}</p>
      <p class="timeline-placeholder-hint">↓ {t('tz.timeline.placeholderHint')} ↓</p>
    </div>
    <div class="timeline-wrapper" id="timeline-wrapper" style="display:none;">
      <div class="timeline-header" id="timeline-header"></div>
      <div class="timeline-rows" id="timeline-rows"></div>
      <div class="timeline-now" id="timeline-now"></div>
      <div class="timeline-best" id="timeline-best"></div>
    </div>
  </section>

  <!-- Best Time Recommendation Card -->
  <div class="besttime-card" id="besttime-card" style="display:none;">
    <div class="besttime-header">
      <div class="besttime-icon-wrap">
        <svg class="besttime-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      </div>
      <h2 class="besttime-title">{t('tz.besttime.title')}</h2>
    </div>
    <div class="besttime-body" id="besttime-body"></div>
  </div>

  <!-- FAQ -->
  <section class="faq-section">
    <h2 class="section-title">{t('tz.faq.title')}</h2>
    {[
      { q: t('tz.faq.q1'), a: t('tz.faq.a1') },
      { q: t('tz.faq.q2'), a: t('tz.faq.a2') },
      { q: t('tz.faq.q3'), a: t('tz.faq.a3') },
      { q: t('tz.faq.q4'), a: t('tz.faq.a4') },
      { q: t('tz.faq.q5'), a: t('tz.faq.a5') },
    ].map((item) => (
      <details class="faq-item">
        <summary class="faq-q">{item.q}</summary>
        <p class="faq-a">{item.a}</p>
      </details>
    ))}
  </section>

  <!-- SEO Section -->
  <section class="seo-section">
    <h2 class="section-title">{t('tz.seo.title')}</h2>
    <div class="seo-grid">
      <div class="seo-card">
        <h3>{t('tz.seo.feature1.title')}</h3>
        <p>{t('tz.seo.feature1.desc')}</p>
      </div>
      <div class="seo-card">
        <h3>{t('tz.seo.feature2.title')}</h3>
        <p>{t('tz.seo.feature2.desc')}</p>
      </div>
      <div class="seo-card">
        <h3>{t('tz.seo.feature3.title')}</h3>
        <p>{t('tz.seo.feature3.desc')}</p>
      </div>
      <div class="seo-card">
        <h3>{t('tz.seo.feature4.title')}</h3>
        <p>{t('tz.seo.feature4.desc')}</p>
      </div>
    </div>
  </section>
</div>
</Layout>

<style>
  :global(.container) {
    max-width: 900px;
    margin: 0 auto;
    padding: 20px;
  }

  /* Hero */
  .hero {
    text-align: center;
    padding: 40px 20px 30px;
  }

  .title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 12px;
    line-height: 1.2;
  }

  .title-short { display: none; }

  .subtitle {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 500px;
    margin: 0 auto 16px;
    line-height: 1.5;
  }

  .privacy-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: rgba(16, 185, 129, 0.1);
    color: #059669;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 500;
  }

  /* Mode Toggle */
  .mode-toggle {
    display: flex;
    gap: 8px;
    margin-bottom: 24px;
    background: var(--bg-secondary);
    padding: 4px;
    border-radius: 12px;
    border: 1px solid var(--border-color);
  }

  .mode-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 16px;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: var(--text-secondary);
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .mode-btn:hover {
    color: var(--text-primary);
    background: var(--bg-primary);
  }

  .mode-btn.active {
    background: var(--accent-primary);
    color: white;
    box-shadow: 0 2px 8px rgba(99, 102, 241, 0.3);
  }

  /* Cards Container */
  #compare-mode {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 30px;
  }

  @media (max-width: 768px) {
    #compare-mode {
      grid-template-columns: 1fr;
    }
  }

  /* Card Styles */
  .tz-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 20px;
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .tz-card:hover {
    box-shadow: var(--card-shadow);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }

  .card-number {
    width: 28px;
    height: 28px;
    background: linear-gradient(135deg, var(--accent-primary), #128C7E);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.9rem;
  }

  .card-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  /* Search */
  .search-wrap {
    position: relative;
    margin-bottom: 12px;
  }

  .search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-secondary);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    padding: 12px 12px 12px 40px;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    color: var(--text-primary);
    font-size: 0.95rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--accent-primary);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
  }

  .search-input:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 200px;
    overflow-y: auto;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    display: none;
  }

  .search-results.active {
    display: block;
  }

  .search-result-item {
    padding: 12px 14px;
    cursor: pointer;
    border-radius: 8px;
    margin-bottom: 4px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: background 0.15s;
    background: var(--bg-primary);
    border: 1px solid transparent;
  }

  .search-result-item:hover,
  .search-result-item.highlighted {
    background: rgba(99, 102, 241, 0.1);
    border-color: var(--accent-primary);
  }

  .result-city-name {
    font-weight: 500;
    color: var(--text-primary);
  }

  .result-city-offset {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  /* Live Time Display - Enhanced */
  .live-time-display {
    position: relative;
    margin-top: 16px;
    padding: 20px;
    padding-right: 48px;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.08), rgba(168, 85, 247, 0.08));
    border-radius: 12px;
    border: 1px solid rgba(99, 102, 241, 0.2);
  }

  .live-time-main {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .city-info {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .city-name {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .region-emoji {
    font-size: 1.5rem;
  }

  .clock-wrapper {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .live-clock {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--accent-primary);
    font-family: 'SF Mono', 'Fira Code', monospace;
    letter-spacing: 2px;
  }

  /* Analog Clock - Inspired by GitHub repo */
  .analog-clock {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: white;
    border: 2px solid var(--border-color);
    position: relative;
    box-shadow: inset 0 0 0 2px white, inset 0 0 4px rgba(0, 0, 0, 0.1);
  }

  .clock-face {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .hand {
    position: absolute;
    bottom: 50%;
    left: 50%;
    transform-origin: bottom center;
    border-radius: 4px;
  }

  .hour-hand {
    width: 4px;
    height: 16px;
    margin-left: -2px;
    background: var(--text-primary);
  }

  .minute-hand {
    width: 3px;
    height: 22px;
    margin-left: -1.5px;
    background: var(--text-primary);
  }

  .second-hand {
    width: 1px;
    height: 26px;
    margin-left: -0.5px;
    background: #EF4444;
  }

  .clock-center {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 6px;
    height: 6px;
    margin: -3px 0 0 -3px;
    background: var(--accent-primary);
    border-radius: 50%;
    z-index: 3;
  }

