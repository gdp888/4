---
import Layout from '../layouts/Layout.astro';
import { useTranslations, getLocalizedPath, getAlternateUrl } from '../i18n/utils';
import { languages, langCodes, type Lang } from '../i18n/ui';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const otherLangs = (Object.keys(languages) as Lang[]).filter(l => l !== lang);

const localeMap: Record<Lang, string> = { en: 'en_US', es: 'es_ES', pt: 'pt_BR', id: 'id_ID' };
const alternateLocales = otherLangs.map(l => localeMap[l]);

// Schema.org — FAQ data
const faqItems = [
  { q: t('wl.seo.faq.q1'), a: t('wl.seo.faq.a1') },
  { q: t('wl.seo.faq.q2'), a: t('wl.seo.faq.a2') },
  { q: t('wl.seo.faq.q3'), a: t('wl.seo.faq.a3') },
  { q: t('wl.seo.faq.q4'), a: t('wl.seo.faq.a4') },
  { q: t('wl.seo.faq.q5'), a: t('wl.seo.faq.a5') },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "OPN Chat WhatsApp Link Generator",
      "url": getAlternateUrl(lang, 'wa-link'),
      "description": t('wl.meta.description'),
      "applicationCategory": "CommunicationApplication",
      "operatingSystem": "Any",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "inLanguage": Object.keys(languages),
      "featureList": [
        t('wl.seo.why.feature1.title') + ': ' + t('wl.seo.why.feature1.desc'),
        t('wl.seo.why.feature2.title') + ': ' + t('wl.seo.why.feature2.desc'),
        t('wl.seo.why.feature3.title') + ': ' + t('wl.seo.why.feature3.desc'),
        t('wl.seo.why.feature4.title') + ': ' + t('wl.seo.why.feature4.desc'),
      ],
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "OPN Chat",
          "item": getAlternateUrl(lang, '')
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "WhatsApp Link Generator",
          "item": getAlternateUrl(lang, 'wa-link')
        }
      ]
    }
  ]
};
---

<Layout title={t('wl.meta.title')} lang={lang} service="wa-link">
  <Fragment slot="meta">
    <link rel="dns-prefetch" href="https://wa.me" />
    <link rel="preconnect" href="https://wa.me" crossorigin />
    <meta name="description" content={t('wl.meta.description')} />
    <meta name="keywords" content={t('wl.meta.keywords')} />
    <link rel="canonical" href={getAlternateUrl(lang, 'wa-link')} />
    <meta property="og:title" content={t('wl.meta.og.title')} />
    <meta property="og:description" content={t('wl.meta.og.description')} />
    <meta property="og:url" content={getAlternateUrl(lang, 'wa-link')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OPN Chat" />
    <meta property="og:locale" content={localeMap[lang]} />
    {alternateLocales.map(loc => (
      <meta property="og:locale:alternate" content={loc} />
    ))}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={t('wl.meta.twitter.title')} />
    <meta name="twitter:description" content={t('wl.meta.twitter.description')} />
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  </Fragment>

  <main class="container">
    <!-- Header with nav -->
    <header class="site-header">
      <a href={getLocalizedPath(lang, 'whatsapp')} class="logo" aria-label="OPN Chat — Home">
        <span class="logo-text">OPN Chat</span>
        <svg viewBox="0 0 24 24" fill="currentColor" class="logo-icon" aria-hidden="true">
          <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
        </svg>
      </a>
      <div class="header-actions">
        <nav aria-label="Language switcher">
          <ul class="lang-switcher">
            <li class="globe-icon-item" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="globe-icon">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
            </li>
            {(Object.keys(languages) as Lang[]).map((l) => (
              <li>
                <a
                  href={getLocalizedPath(l, 'wa-link')}
                  class:list={['lang-btn', { active: l === lang }]}
                  title={languages[l]}
                  aria-current={l === lang ? 'page' : undefined}
                >
                  <span class="full-lang">{languages[l]}</span>
                  <span class="short-lang">{langCodes[l]}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <button type="button" class="theme-toggle" aria-label="Toggle theme" id="theme-toggle">
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
      </div>
    </header>

    <!-- Hero -->
    <div class="hero">
      <h1 class="title">{t('wl.heading')}</h1>
      <p class="subtitle">{t('wl.subtitle')}</p>
      <div class="privacy-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        {t('wl.privacy.badge')}
      </div>
    </div>

    <!-- Generator Form -->
    <div class="generator">
      <!-- Step 1: Phone Number -->
      <div class="step-section">
        <div class="step-number">1</div>
        <div class="step-content">
          <label for="wl-phone" class="label">{t('wl.form.phone.label')}</label>
          <div class="phone-input-group">
            <span class="phone-prefix">+</span>
            <input type="tel" id="wl-phone" class="phone-input" placeholder={t('wl.form.phone.placeholder')} autocomplete="tel" required />
          </div>
          <span class="hint">{t('wl.form.phone.hint')}</span>
          <span id="wl-error" class="error-msg" role="alert"></span>
        </div>
      </div>

      <!-- Step 2: Custom Message -->
      <div class="step-section">
        <div class="step-number">2</div>
        <div class="step-content">
          <label for="wl-message" class="label">{t('wl.form.message.label')}</label>
          <span class="optional">{t('wl.form.label.optional')}</span>
          <textarea id="wl-message" class="message-input" placeholder={t('wl.form.message.placeholder')} rows="2"></textarea>
        </div>
      </div>

      <!-- Step 3: Generate -->
      <div class="step-section">
        <div class="step-number">3</div>
        <div class="step-content">
          <button type="button" id="wl-generate" class="submit-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-icon">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
            </svg>
            {t('wl.form.generate')}
          </button>
        </div>
      </div>

      <!-- Result Section (hidden until generated) -->
      <div id="wl-result" class="result-section" style="display:none;">
        <h2 class="result-title">{t('wl.result.title')}</h2>

        <!-- Generated Link -->
        <div class="link-box">
          <code id="wl-link" class="link-text"></code>
          <button type="button" id="wl-copy-link" class="copy-btn" aria-label={t('wl.copy')} title={t('wl.copy')}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="copy-icon">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
            <span class="copy-label">{t('wl.copy')}</span>
          </button>
        </div>

        <!-- QR Code -->
        <div class="qr-section">
          <h3 class="qr-title">{t('wl.qr.title')}</h3>
          <div id="wl-qr-canvas" class="qr-canvas"></div>
          <button type="button" id="wl-download-qr" class="download-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-icon">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            {t('wl.qr.download')}
          </button>
        </div>

        <!-- Share Buttons -->
        <div class="share-section">
          <p class="share-label">{t('wl.share.label')}</p>
          <div class="share-buttons">
            <button type="button" id="wl-share-whatsapp" class="share-btn wa-share">
              <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </button>
            <button type="button" id="wl-share-telegram" class="share-btn tg-share">
              <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
            </button>
            <button type="button" id="wl-share-copy" class="share-btn copy-share">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            </button>
          </div>
        </div>

        <!-- Preview -->
        <div class="preview-section">
          <p class="preview-label">{t('wl.preview.label')}</p>
          <div class="preview-card">
            <div class="preview-bubble">
              <div class="preview-message" id="wl-preview-msg"></div>
              <div class="preview-time">10:30</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- SEO Content Section -->
    <section class="seo-section" aria-label="About WhatsApp Link Generator">
      <article class="seo-block">
        <h2 class="seo-heading">{t('wl.seo.what.heading')}</h2>
        <p class="seo-text">{t('wl.seo.what.text')}</p>
      </article>

      <article class="seo-block">
        <h2 class="seo-heading">{t('wl.seo.why.heading')}</h2>
        <div class="feature-grid">
          <div class="feature-card">
            <div class="feature-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <h3 class="feature-title">{t('wl.seo.why.feature1.title')}</h3>
            <p class="feature-desc">{t('wl.seo.why.feature1.desc')}</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3 class="feature-title">{t('wl.seo.why.feature2.title')}</h3>
            <p class="feature-desc">{t('wl.seo.why.feature2.desc')}</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="3" height="3"/></svg>
            </div>
            <h3 class="feature-title">{t('wl.seo.why.feature3.title')}</h3>
            <p class="feature-desc">{t('wl.seo.why.feature3.desc')}</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            </div>
            <h3 class="feature-title">{t('wl.seo.why.feature4.title')}</h3>
            <p class="feature-desc">{t('wl.seo.why.feature4.desc')}</p>
          </div>
        </div>
      </article>

      <article class="seo-block">
        <h2 class="seo-heading">{t('wl.seo.how.heading')}</h2>
        <p class="seo-text">{t('wl.seo.how.text')}</p>
      </article>

      <article class="seo-block">
        <h2 class="seo-heading">{t('wl.seo.use.heading')}</h2>
        <p class="seo-text">{t('wl.seo.use.text')}</p>
      </article>

      <article class="seo-block">
        <h2 class="seo-heading">{t('wl.seo.faq.heading')}</h2>
        <div class="faq-list">
          {faqItems.map((item, i) => (
            <details class="faq-item">
              <summary class="faq-q">{item.q}</summary>
              <p class="faq-a">{item.a}</p>
            </details>
          ))}
        </div>
      </article>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <p class="footer-tagline">opnchat.net — {t('footer.tagline')}</p>
      <div class="footer-links">
        <a href={getLocalizedPath(lang, 'whatsapp')} class="footer-link">{t('footer.whatsapp.link')}</a>
        <a href={getLocalizedPath(lang, 'telegram')} class="footer-link">{t('footer.telegram')}</a>
        <a href={getLocalizedPath(lang, 'qr-code')} class="footer-link">{t('footer.qr.link')}</a>
        <a href={getLocalizedPath(lang, 'password')} class="footer-link">{t('footer.password.link')}</a>
        <a href={getLocalizedPath(lang, 'notepad')} class="footer-link">{t('footer.notepad.link')}</a>
        <a href={getLocalizedPath(lang, 'unit-converter')} class="footer-link">{t('footer.converter.link')}</a>
        <a href={getLocalizedPath(lang, 'wa-link')} class="footer-link">{t('footer.walink.link')}</a>
        <a href={getLocalizedPath(lang, 'disclaimer')} class="footer-link">{t('footer.disclaimer.link')}</a>
        <a href={getLocalizedPath(lang, 'privacy')} class="footer-link">{t('footer.privacy.link')}</a>
      </div>
      <p class="disclaimer-brief">{t('footer.disclaimer.brief')}</p>
    </footer>
  </main>
</Layout>

<script is:inline>
  // WhatsApp Link Generator — client-side logic
  function initLinkGenerator() {
    var generateBtn = document.getElementById('wl-generate');
    var phoneInput = document.getElementById('wl-phone');
    var messageInput = document.getElementById('wl-message');
    var resultSection = document.getElementById('wl-result');
    var linkDisplay = document.getElementById('wl-link');
    var errorMsg = document.getElementById('wl-error');
    var copyBtn = document.getElementById('wl-copy-link');
    var previewMsg = document.getElementById('wl-preview-msg');
    var downloadQrBtn = document.getElementById('wl-download-qr');
    var shareWhatsAppBtn = document.getElementById('wl-share-whatsapp');
    var shareTelegramBtn = document.getElementById('wl-share-telegram');
    var shareCopyBtn = document.getElementById('wl-share-copy');

    var generatedLink = '';

    // QR code generation
    function generateQR(text, container) {
      if (typeof QRCode !== 'undefined') {
        container.innerHTML = '';
        new QRCode(container, {
          text: text,
          width: 200,
          height: 200,
          colorDark: '#0f172a',
          colorLight: '#ffffff',
          correctLevel: QRCode.CorrectLevel.M,
        });
        var theme = document.documentElement.getAttribute('data-theme');
        if (theme === 'light') {
          // Re-generate with light theme colors
          container.innerHTML = '';
          new QRCode(container, {
            text: text,
            width: 200,
            height: 200,
            colorDark: '#0f172a',
            colorLight: '#f8fafc',
            correctLevel: QRCode.CorrectLevel.M,
          });
        }
      } else {
        container.innerHTML = '<p style="text-align:center;color:var(--text-secondary);padding:1rem;">QR library loading...</p>';
      }
    }

    // Generate link
    function doGenerate() {
      var phone = phoneInput.value.replace(/\D/g, '');
      var message = messageInput.value.trim();

      if (!phone || phone.length < 7) {
        errorMsg.textContent = document.documentElement.lang === 'es' ? 'Ingresa un número válido (incluye código de país)' :
          document.documentElement.lang === 'pt' ? 'Insira um número válido (inclua código do país)' :
          document.documentElement.lang === 'id' ? 'Masukkan nomor yang valid (sertakan kode negara)' :
          'Please enter a valid phone number (include country code)';
        errorMsg.style.display = 'block';
        return;
      }

      if (phone.length < 10) {
        errorMsg.textContent = document.documentElement.lang === 'es' ? 'El número parece demasiado corto — verifica el código de país' :
          document.documentElement.lang === 'pt' ? 'O número parece muito curto — verifique o código do país' :
          document.documentElement.lang === 'id' ? 'Nomor terlihat terlalu pendek — periksa kode negara' :
          'Phone number seems too short — check country code';
        errorMsg.style.display = 'block';
        // Still allow generation but warn
      } else {
        errorMsg.style.display = 'none';
      }

      var link = 'https://wa.me/' + phone;
      if (message) {
        link += '?text=' + encodeURIComponent(message);
      }

      generatedLink = link;
      linkDisplay.textContent = link;
      resultSection.style.display = 'block';
      previewMsg.textContent = message || '👋';
      previewMsg.style.display = 'block';

      var qrCanvas = document.getElementById('wl-qr-canvas');
      generateQR(link, qrCanvas);

      resultSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // Copy link
    function doCopy(text) {
      navigator.clipboard.writeText(text).then(function() {
        var label = copyBtn.querySelector('.copy-label');
        var originalText = label.textContent;
        label.textContent = '✓';
        setTimeout(function() { label.textContent = originalText; }, 1500);
      }).catch(function() {
        var textarea = document.createElement('textarea');
        textarea.value = text;
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
      });
    }

    // Download QR
    function doDownloadQR() {
      var qrCanvas = document.getElementById('wl-qr-canvas');
      var canvas = qrCanvas && qrCanvas.querySelector('canvas');
      if (canvas) {
        var link = document.createElement('a');
        link.download = 'whatsapp-link-qr.png';
        link.href = canvas.toDataURL('image/png');
        link.click();
      } else {
        var img = qrCanvas && qrCanvas.querySelector('img');
        if (img) {
          var link = document.createElement('a');
          link.download = 'whatsapp-link-qr.png';
          link.href = img.src;
          link.click();
        }
      }
    }

    // Share via WhatsApp
    function doShareWhatsApp() {
      if (!generatedLink) return;
      window.open('https://wa.me/?text=' + encodeURIComponent(generatedLink), '_blank');
    }

    // Share via Telegram
    function doShareTelegram() {
      if (!generatedLink) return;
      window.open('https://t.me/share/url?url=' + encodeURIComponent(generatedLink), '_blank');
    }

    // Event listeners
    generateBtn.addEventListener('click', doGenerate);
    copyBtn.addEventListener('click', function() { doCopy(generatedLink); });
    downloadQrBtn.addEventListener('click', doDownloadQR);
    shareWhatsAppBtn.addEventListener('click', doShareWhatsApp);
    shareTelegramBtn.addEventListener('click', doShareTelegram);
    shareCopyBtn.addEventListener('click', function() { doCopy(generatedLink); });

    phoneInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') doGenerate();
    });
  }

  initLinkGenerator();
</script>

