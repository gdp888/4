---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { type Lang } from '../i18n/ui';

export interface Props {
  lang: Lang;
  /** Service slug for LanguageSwitcher (e.g. 'telegram', 'qr-code'). Empty string = hub. */
  path?: string;
  /** Active tool slug for highlighting in the mobile menu (e.g. 'whatsapp', 'telegram') */
  activeTool?: string;
}

const { lang, path = '', activeTool = '' } = Astro.props;
const t = useTranslations(lang);

// Tool categories — same structure as ToolSidebar
const tools = [
  { category: 'sidebar.whatsapp', items: [
    { slug: 'whatsapp', key: 'hub.service.whatsapp.title', icon: 'wa' },
    { slug: 'wa-link', key: 'hub.service.walink.title', icon: 'wa' },
    { slug: 'wa-widget', key: 'hub.service.widget.title', icon: 'wa' },
    { slug: 'whatsapp-text-formatter', key: 'hub.service.formatter.title', icon: 'format' },
    { slug: 'quick-replies', key: 'hub.service.quickreplies.title', icon: 'reply' },
    { slug: 'broadcast', key: 'hub.service.broadcast.title', icon: 'broadcast' },
  ]},
  { category: 'sidebar.telegram', items: [
    { slug: 'telegram', key: 'hub.service.telegram.title', icon: 'tg' },
    { slug: 'tg-link', key: 'hub.service.tglink.title', icon: 'tg' },
  ]},
  { category: 'sidebar.viber', items: [
    { slug: 'viber', key: 'hub.service.viber.title', icon: 'vb' },
  ]},
  { category: 'sidebar.signal', items: [
    { slug: 'signal', key: 'hub.service.signal.title', icon: 'sg' },
  ]},
  { category: 'sidebar.kakaotalk', items: [
    { slug: 'kakaotalk', key: 'hub.service.kakaotalk.title', icon: 'kt' },
  ]},
  { category: 'sidebar.instagram', items: [
    { slug: 'instagram', key: 'hub.service.instagram.title', icon: 'ig' },
  ]},
  { category: 'sidebar.texttools', items: [
    { slug: 'fancy-text', key: 'hub.service.fancytext.title', icon: 'format' },
    { slug: 'word-counter', key: 'hub.service.wordcounter.title', icon: 'doc' },
    { slug: 'notepad', key: 'hub.service.notepad.title', icon: 'notepad' },
  ]},
  { category: 'sidebar.utilities', items: [
    { slug: 'qr-code', key: 'hub.service.qr.title', icon: 'qr' },
    { slug: 'password', key: 'hub.service.password.title', icon: 'lock' },
    { slug: 'unit-converter', key: 'hub.service.converter.title', icon: 'convert' },
    { slug: 'emoji-picker', key: 'hub.service.emojipicker.title', icon: 'emoji' },
  ]},
  { category: 'sidebar.beta', items: [
    { slug: 'timezone', key: 'hub.service.timezone.title', icon: 'clock' },
    { slug: 'meeting-scheduler', key: 'hub.service.meetingscheduler.title', icon: 'calendar' },
    { slug: 'pomodoro', key: 'hub.service.pomodoro.title', icon: 'pomodoro' },
  ]},
];

// SVG icon map (same as ToolSidebar)
const icons: Record<string, string> = {
  wa: `<svg viewBox="0 0 24 24" fill="currentColor" class="nav-icon" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>`,
  tg: `<svg viewBox="0 0 24 24" fill="currentColor" class="nav-icon" aria-hidden="true"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>`,
  vb: `<svg viewBox="0 0 24 24" fill="currentColor" class="nav-icon" aria-hidden="true"><path d="M11.4 0C5.1 0 0 5.1 0 11.4c0 2.4.7 4.6 2 6.5L.1 23.5l5.8-1.9c1.8 1.1 3.9 1.7 6.1 1.7 6.3 0 11.4-5.1 11.4-11.4S17.7 0 11.4 0zm6.7 16.1c-.3.8-1.6 1.6-2.2 1.7-.6.1-1.2.2-4-1.1-3.3-1.5-5.4-4.9-5.6-5.1-.2-.3-1.5-2-1.5-3.8 0-1.8.9-2.7 1.3-3.1.4-.4.8-.5 1.1-.5h.8c.3 0 .6 0 .9.6.3.7 1.1 2.7 1.2 2.9.1.2.1.4 0 .6-.1.2-.1.4-.3.6-.2.2-.4.5-.6.7-.2.2-.4.4-.2.7.2.3.9 1 1.3 1.9 2.2.9.7.1.8.4.6.7-.2.3-.3.5-.5.8-.2.3-.4.6-.2.9.2.3 1 1.1 1.2 2.3 1.8s1.8.8 2.1.9c.3.1.5.1.7-.1.2-.2.8-1 1-1.3.2-.3.4-.3.7-.1.2.1.5.3.7.4.2.1.5.3.7.1.2.1.5 0 .7-.1.3-.6 1.1-1.4 1.9-1.9 1.9z"/></svg>`,
  sg: `<svg viewBox="0 0 24 24" fill="currentColor" class="nav-icon" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.98 4-3.08 6-3.08 1.99 0 5.97 1.1 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/></svg>`,
  format: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="nav-icon" aria-hidden="true"><path d="M4 7V4h16v3"/><path d="M9 20h6"/><path d="M12 4v16"/></svg>`,
  doc: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="nav-icon" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>`,
  notepad: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="nav-icon" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>`,
  qr: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="nav-icon" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="3" height="3"/><line x1="21" y1="14" x2="21" y2="14.01"/><line x1="21" y1="21" x2="21" y2="21.01"/><line x1="17" y1="18" x2="17" y2="18.01"/></svg>`,
