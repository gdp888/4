  convert: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="nav-icon" aria-hidden="true"><path d="M7 16V4m0 0L3 8m4-4l4 4M17 8v12m0 0l4-4m-4 4l-4-4"/></svg>`,
  clock: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="nav-icon" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
  emoji: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="nav-icon" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>`,
  reply: `<svg viewBox="0 0 24 24" fill="currentColor" class="nav-icon" aria-hidden="true"><path d="M10 9V5l-7 7 7 7v-4.1c5 0 8.5 1.6 11 5.1-1-5-4-10-11-11z"/></svg>`,
  calendar: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="nav-icon" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`,
  broadcast: `<svg viewBox="0 0 24 24" fill="currentColor" class="nav-icon" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>`,
  pomodoro: `<svg viewBox="0 0 24 24" fill="currentColor" class="nav-icon" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>`,
  kt: `<svg viewBox="0 0 24 24" fill="currentColor" class="nav-icon" aria-hidden="true"><path d="M12 2C8.5 2 5.4 3.6 3.7 6C2.2 8.1 1.3 10.7 1.3 13.5c0 2.5.8 4.9 2.2 6.8L1.9 23l3.2-.9c2 1.3 4.4 2 6.9 2 6.6 0 12-4.5 12-10.1S18.6 2 12 2zm-1 14h-2v-2h2v2zm0-3.5h-2V7h2v5.5zm4.5 3.5h-2v-2h2v2zm0-3.5h-2V7h2v5.5z"/></svg>`,
  ig: `<svg viewBox="0 0 24 24" fill="currentColor" class="nav-icon" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>`,
};
---

<header class="site-header">
  <!-- Hamburger button — mobile only -->
  <button type="button" class="hamburger" id="nav-hamburger" aria-label={t('nav.menu')} aria-expanded="false">
    <span class="hamburger-line"></span>
    <span class="hamburger-line"></span>
    <span class="hamburger-line"></span>
  </button>

  <a href={getRelativeLocaleUrl(lang)} class="logo" aria-label="OPN Chat — Home">
    <span class="logo-text">OPN Chat</span>
    <svg viewBox="0 0 24 24" fill="currentColor" class="logo-icon" aria-hidden="true">
      <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
    </svg>
  </a>

  <div class="header-right">
    <LanguageSwitcher lang={lang} path={path} />
    <button type="button" class="theme-toggle" aria-label="Toggle theme" id="theme-toggle">
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    </button>
  </div>
</header>

<!-- Mobile navigation drawer -->
<div class="nav-overlay" id="nav-overlay"></div>
<nav class="nav-drawer" id="nav-drawer" aria-label="Tools navigation">
  <div class="nav-drawer-header">
    <a href={getRelativeLocaleUrl(lang)} class="nav-drawer-logo">OPN Chat</a>
    <button type="button" class="nav-drawer-close" id="nav-drawer-close" aria-label="Close menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <!-- Search input for mobile menu -->
  <div class="nav-search-wrapper">
    <svg class="nav-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="11" cy="11" r="8"/>
      <line x1="21" y1="21" x2="16.65" y2="16.65"/>
    </svg>
    <input
      type="text"
      class="nav-search-input"
      id="nav-search-input"
      placeholder={t('nav.search.placeholder')}
      aria-label={t('nav.search.label')}
    />
    <button type="button" class="nav-search-clear" id="nav-search-clear" aria-label="Clear search" style="display: none;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <div class="nav-search-results-info" id="nav-search-results-info" style="display: none;"></div>

  <div class="nav-categories-wrapper" id="nav-categories-wrapper">
    {tools.map((cat) => (
      <div class="nav-category" data-category>
        <h3 class="nav-cat-title">{t(cat.category)}</h3>
        {cat.items.map((item) => (
          <a
            href={getRelativeLocaleUrl(lang, item.slug)}
            class:list={['nav-link', { 'nav-link-active': item.slug === activeTool }]}
            data-searchable
            data-search-text={t(item.key).toLowerCase()}
          >
            <Fragment set:html={icons[item.icon]} />
            {t(item.key)}
          </a>
        ))}
      </div>
    ))}
  </div>
  <div class="nav-no-results" id="nav-no-results" style="display: none;">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
    </svg>
    <span>{t('nav.search.noResults')}</span>
  </div>
</nav>

<script is:inline>
  // Mobile nav drawer toggle
  // IMPORTANT: Use event delegation on `document` so the listener survives
  // Astro View Transitions (ClientRouter) DOM swaps. Direct element.addEventListener
  // dies after the first SPA navigation because the element reference becomes stale.
  // The lang switcher and theme toggle already use this pattern (see LanguageSwitcher.astro
  // and Layout.astro) — that's why they work after VT navigation but the burger didn't.
  (function() {
    function openDrawer() {
      var drawer = document.getElementById('nav-drawer');
      var overlay = document.getElementById('nav-overlay');
      var hamburger = document.getElementById('nav-hamburger');
      if (!drawer || !overlay || !hamburger) return;
      drawer.classList.add('nav-drawer-open');
      overlay.classList.add('nav-overlay-open');
      hamburger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      var drawer = document.getElementById('nav-drawer');
      var overlay = document.getElementById('nav-overlay');
      var hamburger = document.getElementById('nav-hamburger');
      if (!drawer || !overlay || !hamburger) return;
      drawer.classList.remove('nav-drawer-open');
      overlay.classList.remove('nav-overlay-open');
      hamburger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    // Single delegated click listener — attached ONCE on document, which persists
    // across View Transitions swaps. Elements are looked up fresh inside handlers.
    document.addEventListener('click', function(e) {
      // Burger toggle
      if (e.target.closest('#nav-hamburger')) {
        var drawer = document.getElementById('nav-drawer');
        var isOpen = drawer && drawer.classList.contains('nav-drawer-open');
        isOpen ? closeDrawer() : openDrawer();
        return;
      }
      // Close button inside drawer
      if (e.target.closest('#nav-drawer-close')) {
        closeDrawer();
        return;
      }
      // Click on overlay (outside drawer) closes
      if (e.target.closest('#nav-overlay')) {
        closeDrawer();
        return;
      }
      // Click on a nav link inside drawer closes (before VT navigation)
      if (e.target.closest('#nav-drawer .nav-link')) {
        closeDrawer();
        return;
      }
    });

    // Close on Escape — also delegated via document, survives VT swaps
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeDrawer();
    });

    // ===== Mobile Nav Search =====
    (function() {
      var searchInput = null;
      var searchClear = null;
      var categoriesWrapper = null;
      var noResults = null;
      var resultsInfo = null;

      function initSearchElements() {
        searchInput = document.getElementById('nav-search-input');
        searchClear = document.getElementById('nav-search-clear');
        categoriesWrapper = document.getElementById('nav-categories-wrapper');
        noResults = document.getElementById('nav-no-results');
        resultsInfo = document.getElementById('nav-search-results-info');
      }

      function filterNav(query) {
        if (!searchInput || !categoriesWrapper) { initSearchElements(); }
        if (!categoriesWrapper) return;

        var q = query.toLowerCase().trim();
        var categories = categoriesWrapper.querySelectorAll('[data-category]');
        var totalVisible = 0;

        // Show all categories wrapper, hide no-results
        categoriesWrapper.style.display = '';
        if (noResults) noResults.style.display = 'none';

        if (!q) {
          // Reset: show everything
          categories.forEach(function(cat) {
            cat.style.display = '';
            cat.querySelectorAll('.nav-link').forEach(function(link) {
              link.style.display = '';
            });
          });
          if (searchClear) searchClear.style.display = 'none';
          if (resultsInfo) resultsInfo.style.display = 'none';
          return;
        }

        // Show clear button
        if (searchClear) searchClear.style.display = 'flex';

        categories.forEach(function(cat) {
          var links = cat.querySelectorAll('[data-searchable]');
          var visibleCount = 0;

          links.forEach(function(link) {
            var text = link.getAttribute('data-search-text') || '';
            if (text.indexOf(q) !== -1) {
              link.style.display = '';
              visibleCount++;
            } else {
              link.style.display = 'none';
            }
          });

          // Hide category header if no visible links
          if (visibleCount > 0) {
            cat.style.display = '';
            totalVisible += visibleCount;
          } else {
            cat.style.display = 'none';
          }
        });

        // Show/hide no results message
        if (totalVisible === 0) {
          categoriesWrapper.style.display = 'none';
          if (noResults) noResults.style.display = 'flex';
        }

        // Show results count
        if (resultsInfo && totalVisible > 0) {
          resultsInfo.textContent = totalVisible + ' found';
          resultsInfo.style.display = '';
        } else if (resultsInfo) {
          resultsInfo.style.display = 'none';
        }
      }

      // Delegated events for search
      document.addEventListener('input', function(e) {
        if (e.target && e.target.id === 'nav-search-input') {
          filterNav(e.target.value);
        }
      });

      document.addEventListener('click', function(e) {
        // Clear button
        if (e.target.closest('#nav-search-clear')) {
          if (!searchInput) initSearchElements();
          if (searchInput) {
            searchInput.value = '';
            filterNav('');
            searchInput.focus();
          }
          return;
        }
      });

      // Auto-focus search when drawer opens
      var originalOpen = openDrawer;
      openDrawer = function() {
        originalOpen();
        setTimeout(function() {
          if (!searchInput) initSearchElements();
          if (searchInput) searchInput.focus();
        }, 300); // After slide-in animation
      };

      // Clear search when drawer closes
      var originalClose = closeDrawer;
      closeClose = function() {
        if (!searchInput) initSearchElements();
        if (searchInput) {
          searchInput.value = '';
          filterNav('');
        }
        originalClose();
      };
      
      // Fix: use the correct function name
      closeDrawer = function() {
        if (!searchInput) initSearchElements();
        if (searchInput) {
          searchInput.value = '';
          filterNav('');
        }
        originalClose();
      };
    })();
  })();
</script>

