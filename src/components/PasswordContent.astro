---
import Layout from '../layouts/Layout.astro';
import { useTranslations, getLocalizedPath, getAlternateUrl } from '../i18n/utils';
import { languages, langCodes, type Lang } from '../i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const otherLangs = (Object.keys(languages) as Lang[]).filter(l => l !== lang);

const localeMap: Record<Lang, string> = { en: 'en_US', es: 'es_ES', pt: 'pt_BR', id: 'id_ID', ru: 'ru_RU', ar: 'ar_SA', de: 'de_DE' };

const pwSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": t('pw.heading'),
      "url": getAlternateUrl(lang, 'password'),
      "description": t('pw.meta.description'),
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Any",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "isPartOf": {
        "@type": "WebSite",
        "name": "OPN Chat",
        "url": "https://opnchat.net/"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "OPN Chat",
          "item": getAlternateUrl(lang, '')
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('pw.heading'),
          "item": getAlternateUrl(lang, 'password')
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": t('pw.faq.q1'), "acceptedAnswer": { "@type": "Answer", "text": t('pw.faq.a1') } },
        { "@type": "Question", "name": t('pw.faq.q2'), "acceptedAnswer": { "@type": "Answer", "text": t('pw.faq.a2') } },
        { "@type": "Question", "name": t('pw.faq.q3'), "acceptedAnswer": { "@type": "Answer", "text": t('pw.faq.a3') } },
        { "@type": "Question", "name": t('pw.faq.q4'), "acceptedAnswer": { "@type": "Answer", "text": t('pw.faq.a4') } },
        { "@type": "Question", "name": t('pw.faq.q5'), "acceptedAnswer": { "@type": "Answer", "text": t('pw.faq.a5') } },
        { "@type": "Question", "name": t('pw.faq.q6'), "acceptedAnswer": { "@type": "Answer", "text": t('pw.faq.a6') } }
      ]
    }
  ]
};
---

<Layout title={t('pw.meta.title')} lang={lang} service="password">
  <Fragment slot="meta">
    <meta name="description" content={t('pw.meta.description')} />
    <meta name="keywords" content={t('pw.meta.keywords')} />
    <link rel="canonical" href={getAlternateUrl(lang, 'password')} />
    <meta property="og:title" content={t('pw.meta.og.title')} />
    <meta property="og:description" content={t('pw.meta.og.description')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t('pw.meta.twitter.title')} />
    <meta name="twitter:description" content={t('pw.meta.twitter.description')} />
    <script type="application/ld+json" set:html={JSON.stringify(pwSchema)} />
  </Fragment>

  <main class="container">
    <!-- Header -->
    <header class="site-header">
      <a href={getLocalizedPath(lang, '')} class="logo" aria-label="OPN Chat — Home">
        <span class="logo-text">OPN Chat</span>
        <svg viewBox="0 0 24 24" fill="currentColor" class="logo-icon" aria-hidden="true">
          <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
        </svg>
      </a>
      <LanguageSwitcher lang={lang} path="password" />
      <button type="button" class="theme-toggle" aria-label="Toggle theme" id="theme-toggle">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
    </header>

    <!-- Breadcrumbs -->
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={getLocalizedPath(lang)} class="bc-link">{t('bc.home')}</a>
      <span class="bc-sep">›</span>
      <span class="bc-current">{t('bc.password')}</span>
    </nav>

    <!-- Hero -->
    <div class="hero">
      <h1 class="title">{t('pw.heading')}</h1>
      <p class="subtitle">{t('pw.subtitle')}</p>
      <div class="privacy-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        {t('pw.privacy.badge')}
      </div>
    </div>

    <!-- Generator Tool -->
    <div class="generator">
      <!-- Result Display -->
      <div class="result-area">
        <label class="result-label">{t('pw.result.label')}</label>
        <div class="result-display">
          <input type="text" id="pw-result" readonly placeholder={t('pw.result.placeholder')} />
          <button class="copy-btn" id="btn-copy-pw" title={t('pw.copy')} disabled>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <span id="copy-pw-text">{t('pw.copy')}</span>
          </button>
        </div>
      </div>

      <!-- Strength Meter -->
      <div class="strength-area">
        <div class="strength-header">
          <span class="strength-label">{t('pw.strength.label')}</span>
          <span class="strength-text" id="strength-text">—</span>
        </div>
        <div class="strength-bar-bg">
          <div class="strength-bar-fill" id="strength-bar"></div>
        </div>
        <div class="strength-entropy">
          <span>{t('pw.strength.entropy')}:</span>
          <span id="entropy-value">0</span> bits
        </div>
      </div>

      <!-- Generate Button -->
      <button class="generate-btn" id="btn-generate">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
        {t('pw.generate')}
      </button>

      <!-- Settings -->
      <div class="settings">
        <!-- Length Slider -->
        <div class="setting-row length-row">
          <label for="pw-length">{t('pw.length.label')}</label>
          <div class="length-control">
            <input type="range" id="pw-length" min="4" max="128" value="20" />
            <span class="length-value" id="length-display">20</span>
            <span class="length-unit">{t('pw.length.value')}</span>
          </div>
        </div>

        <!-- Character Options -->
        <div class="options-grid">
          <label class="option-toggle">
            <input type="checkbox" id="opt-uppercase" checked />
            <span class="toggle-switch"></span>
            <span class="toggle-label">{t('pw.options.uppercase')}</span>
          </label>
          <label class="option-toggle">
            <input type="checkbox" id="opt-lowercase" checked />
            <span class="toggle-switch"></span>
            <span class="toggle-label">{t('pw.options.lowercase')}</span>
          </label>
          <label class="option-toggle">
            <input type="checkbox" id="opt-numbers" checked />
            <span class="toggle-switch"></span>
            <span class="toggle-label">{t('pw.options.numbers')}</span>
          </label>
          <label class="option-toggle">
            <input type="checkbox" id="opt-symbols" checked />
            <span class="toggle-switch"></span>
            <span class="toggle-label">{t('pw.options.symbols')}</span>
          </label>
        </div>
      </div>

      <!-- Batch Generate -->
      <details class="batch-section">
        <summary class="batch-toggle">{t('pw.batch.heading')}</summary>
        <div class="batch-content">
          <div class="batch-row">
            <label for="batch-count">{t('pw.batch.count')}</label>
            <select id="batch-count">
              <option value="3">3</option>
              <option value="5" selected>5</option>
              <option value="10">10</option>
            </select>
          </div>
          <button class="action-btn" id="btn-batch">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
            {t('pw.batch.generate')}
          </button>
          <div class="batch-list" id="batch-list"></div>
          <button class="action-btn secondary" id="btn-copy-all" style="display:none;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            {t('pw.batch.copyAll')}
          </button>
        </div>
      </details>
    </div>

    <!-- Features -->
    <section class="features">
      <h2 class="section-heading">{t('pw.features.heading')}</h2>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <h3 class="feature-title">{t('pw.features.crypto.title')}</h3>
          <p class="feature-desc">{t('pw.features.crypto.desc')}</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3 class="feature-title">{t('pw.features.local.title')}</h3>
          <p class="feature-desc">{t('pw.features.local.desc')}</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          </div>
          <h3 class="feature-title">{t('pw.features.custom.title')}</h3>
          <p class="feature-desc">{t('pw.features.custom.desc')}</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
          </div>
          <h3 class="feature-title">{t('pw.features.free.title')}</h3>
          <p class="feature-desc">{t('pw.features.free.desc')}</p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq">
      <h2 class="section-heading">{t('pw.faq.heading')}</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary>{t('pw.faq.q1')}</summary>
          <p>{t('pw.faq.a1')}</p>
        </details>
        <details class="faq-item">
          <summary>{t('pw.faq.q2')}</summary>
          <p>{t('pw.faq.a2')}</p>
        </details>
        <details class="faq-item">
          <summary>{t('pw.faq.q3')}</summary>
          <p>{t('pw.faq.a3')}</p>
        </details>
        <details class="faq-item">
          <summary>{t('pw.faq.q4')}</summary>
          <p>{t('pw.faq.a4')}</p>
        </details>
        <details class="faq-item">
          <summary>{t('pw.faq.q5')}</summary>
          <p>{t('pw.faq.a5')}</p>
        </details>
        <details class="faq-item">
          <summary>{t('pw.faq.q6')}</summary>
          <p>{t('pw.faq.a6')}</p>
        </details>
      </div>
    </section>
</main>
</Layout>

<style>
  .container {
    position: relative;
    z-index: 1;
    width: 100%;
    margin: 0 auto;
    max-width: 720px;
    padding: 2rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* Breadcrumbs */
  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .bc-link {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s;
  }

  .bc-link:hover {
    color: var(--opn-primary);
  }

  .bc-sep {
    color: var(--text-secondary);
    opacity: 0.5;
  }

  .bc-current {
    font-weight: 600;
    color: var(--text-primary);
  }

  /* Site Header */
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 0.75rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text-primary);
  }

  @media (max-width: 640px) {
    .logo { display: none; }
  }

  .logo-icon { width: 24px; height: 24px; color: var(--opn-primary); flex-shrink: 0; }
  .logo-text { font-size: 1.15rem; font-weight: 700; letter-spacing: -0.02em; color: var(--text-primary); }
  /* Hero */
  .hero { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
  .title {
    font-size: 2rem; font-weight: 800; letter-spacing: -0.03em;
    background: linear-gradient(135deg, #25D366, #6fe89d);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .subtitle { font-size: 1rem; color: var(--text-secondary); font-weight: 500; }
  .privacy-badge {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-size: 0.8rem; color: var(--opn-primary); background: var(--bg-secondary);
    border: 1px solid var(--border-color); padding: 0.35rem 0.75rem; border-radius: 20px;
    margin-top: 0.25rem;
  }

  /* Generator Box */
  .generator {
    background: var(--bg-secondary); border: 1.5px solid var(--border-color);
    border-radius: 16px; padding: 1.5rem; display: flex; flex-direction: column; gap: 1.25rem;
  }

  /* Result Display */
  .result-area { display: flex; flex-direction: column; gap: 0.4rem; }
  .result-label { font-size: 0.85rem; font-weight: 600; color: var(--text-primary); }
  .result-display {
    display: flex; gap: 0.5rem; align-items: center;
    background: var(--bg-input); border: 1.5px solid var(--border-color);
    border-radius: 12px; padding: 0.5rem; overflow: hidden;
  }
  .result-display input {
    flex: 1; border: none; background: transparent; color: var(--text-primary);
    font-size: 1.05rem; font-family: 'Courier New', Courier, monospace;
    font-weight: 700; letter-spacing: 0.05em; outline: none; min-width: 0;
    padding: 0.35rem 0.5rem;
  }
  .result-display input::placeholder { color: var(--text-secondary); opacity: 0.5; font-weight: 400; letter-spacing: 0; }
  .copy-btn {
    display: inline-flex; align-items: center; gap: 0.35rem;
    padding: 0.5rem 0.85rem; border-radius: 8px; border: 1.5px solid var(--border-color);
    background: var(--bg-secondary); color: var(--text-primary); font-size: 0.82rem; font-weight: 600;
    cursor: pointer; transition: all 0.2s; white-space: nowrap; flex-shrink: 0;
  }
  .copy-btn:hover:not(:disabled) { border-color: var(--opn-primary); color: var(--opn-primary); }
  .copy-btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .copy-btn.copied { background: var(--opn-primary); border-color: var(--opn-primary); color: #fff; }

  /* Strength Meter */
  .strength-area { display: flex; flex-direction: column; gap: 0.4rem; }
  .strength-header { display: flex; justify-content: space-between; align-items: center; }
  .strength-label { font-size: 0.82rem; font-weight: 600; color: var(--text-secondary); }
  .strength-text { font-size: 0.82rem; font-weight: 700; }
  .strength-bar-bg {
    width: 100%; height: 6px; background: var(--bg-input);
    border-radius: 3px; overflow: hidden;
  }
  .strength-bar-fill {
    height: 100%; width: 0%; border-radius: 3px; transition: all 0.3s ease;
  }
  .strength-entropy {
    font-size: 0.75rem; color: var(--text-secondary); display: flex; gap: 0.3rem;
  }

  /* Generate Button */
  .generate-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
    padding: 0.75rem 1.5rem; border-radius: 12px; border: none;
    background: var(--opn-primary); color: #fff; font-size: 1rem; font-weight: 700;
    cursor: pointer; transition: all 0.2s;
  }
  .generate-btn:hover { background: #1ebe5d; transform: translateY(-1px); }
  .generate-btn:active { transform: translateY(0); }

  /* Settings */
  .settings { display: flex; flex-direction: column; gap: 1rem; border-top: 1px solid var(--border-color); padding-top: 1rem; }

  /* Length Row */
  .setting-row { display: flex; flex-direction: column; gap: 0.4rem; }
  .setting-row label { font-size: 0.85rem; font-weight: 600; color: var(--text-primary); }
  .length-control { display: flex; align-items: center; gap: 0.75rem; }
  .length-control input[type="range"] {
    flex: 1; -webkit-appearance: none; appearance: none; height: 6px;
    background: var(--bg-input); border-radius: 3px; outline: none;
    border: 1px solid var(--border-color);
  }
  .length-control input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none; width: 20px; height: 20px;
    border-radius: 50%; background: var(--opn-primary); cursor: pointer;
    border: 2px solid #fff; box-shadow: 0 2px 6px rgba(0,0,0,0.2);
  }
  .length-control input[type="range"]::-moz-range-thumb {
    width: 20px; height: 20px; border-radius: 50%; background: var(--opn-primary);
    cursor: pointer; border: 2px solid #fff; box-shadow: 0 2px 6px rgba(0,0,0,0.2);
  }
  .length-value { font-size: 1.1rem; font-weight: 700; color: var(--opn-primary); min-width: 2ch; text-align: center; }
  .length-unit { font-size: 0.82rem; color: var(--text-secondary); }

  /* Options Grid */
  .options-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }

  .option-toggle {
    display: flex; align-items: center; gap: 0.5rem; cursor: pointer;
    padding: 0.5rem 0.65rem; border-radius: 8px; border: 1.5px solid var(--border-color);
    background: var(--bg-input); transition: all 0.2s;
  }
  .option-toggle:hover { border-color: var(--opn-primary); }
  .option-toggle input { display: none; }

  .toggle-switch {
    width: 18px; height: 18px; border-radius: 4px; border: 2px solid var(--border-color);
    background: var(--bg-secondary); transition: all 0.2s; flex-shrink: 0;
    position: relative;
  }
  .toggle-switch::after {
    content: ''; position: absolute; top: 2px; left: 2px; width: 10px; height: 10px;
    border-radius: 2px; background: transparent; transition: all 0.2s;
  }
  .option-toggle input:checked + .toggle-switch {
    background: var(--opn-primary); border-color: var(--opn-primary);
  }
  .option-toggle input:checked + .toggle-switch::after {
    background: #fff;
  }
  .toggle-label { font-size: 0.82rem; font-weight: 500; color: var(--text-primary); }

  /* Batch Section */
  .batch-section { border-top: 1px solid var(--border-color); padding-top: 0.5rem; }
  .batch-toggle {
    font-size: 0.9rem; font-weight: 600; color: var(--text-secondary);
    cursor: pointer; padding: 0.5rem 0; list-style: none;
  }
  .batch-toggle::-webkit-details-marker { display: none; }
  .batch-toggle::before { content: "▸ "; transition: transform 0.2s; display: inline-block; }
  .batch-section[open] .batch-toggle::before { transform: rotate(90deg); }
  .batch-content { display: flex; flex-direction: column; gap: 0.75rem; padding-top: 0.75rem; }
  .batch-row { display: flex; align-items: center; gap: 0.75rem; }
  .batch-row label { font-size: 0.85rem; font-weight: 600; color: var(--text-primary); white-space: nowrap; }
  .batch-row select {
    padding: 0.45rem 0.6rem; border-radius: 8px; border: 1.5px solid var(--border-color);
    background: var(--bg-input); color: var(--text-primary); font-size: 0.85rem;
  }
  .action-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
    padding: 0.6rem 1rem; border-radius: 10px; border: 1.5px solid var(--border-color);
    background: var(--bg-input); color: var(--text-primary); font-size: 0.85rem; font-weight: 600;
    cursor: pointer; transition: all 0.2s; width: 100%;
  }
  .action-btn:hover { border-color: var(--opn-primary); color: var(--opn-primary); transform: translateY(-1px); }
  .action-btn.secondary { background: var(--opn-primary); color: #fff; border-color: var(--opn-primary); }
  .action-btn.secondary:hover { background: #1ebe5d; color: #fff; }

  .batch-list {
    display: flex; flex-direction: column; gap: 0.35rem;
    max-height: 240px; overflow-y: auto;
  }
  .batch-item {
    display: flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0.65rem;
    background: var(--bg-input); border: 1px solid var(--border-color); border-radius: 8px;
    font-family: 'Courier New', Courier, monospace; font-size: 0.82rem; color: var(--text-primary);
    font-weight: 600; letter-spacing: 0.03em; word-break: break-all;
  }
  .batch-item button {
    margin-left: auto; background: none; border: none; color: var(--opn-primary);
    cursor: pointer; padding: 0.2rem; flex-shrink: 0; display: flex;
  }
  .batch-item button:hover { opacity: 0.7; }

  /* Features */
  .section-heading { font-size: 1.25rem; font-weight: 700; color: var(--text-primary); text-align: center; }
  .features-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 0.75rem; }
  .feature-card {
    background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 12px;
    padding: 1.25rem; display: flex; flex-direction: column; gap: 0.5rem;
  }
  .feature-icon { color: var(--opn-primary); }
  .feature-title { font-size: 0.95rem; font-weight: 700; color: var(--text-primary); }
  .feature-desc { font-size: 0.85rem; line-height: 1.6; color: var(--text-secondary); }

  /* FAQ */
  .faq-list { display: flex; flex-direction: column; gap: 0.5rem; margin-top: 0.75rem; }
  .faq-item {
    background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 10px;
    overflow: hidden;
  }
  .faq-item summary {
    padding: 0.85rem 1rem; font-size: 0.9rem; font-weight: 600; color: var(--text-primary);
    cursor: pointer; list-style: none;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::before { content: "+ "; color: var(--opn-primary); font-weight: 700; }
  .faq-item[open] summary::before { content: "− "; }
  .faq-item[open] summary { border-bottom: 1px solid var(--border-color); }
  .faq-item p { padding: 0.85rem 1rem; font-size: 0.85rem; line-height: 1.7; color: var(--text-secondary); }  /* Mobile */
  @media (max-width: 640px) {
    .container { padding: 1.25rem 1rem; }
    .title { font-size: 1.5rem; }
    .subtitle { font-size: 0.9rem; }
    .options-grid { grid-template-columns: 1fr; }
    .features-grid { grid-template-columns: 1fr; }
    .generator { padding: 1rem; }
    .site-header { justify-content: center; }
    .result-display input { font-size: 0.9rem; }
  }
</style>

<script>

  // DOM refs
  const resultInput = document.getElementById('pw-result') as HTMLInputElement;
  const btnCopy = document.getElementById('btn-copy-pw') as HTMLButtonElement;
  const copyPwText = document.getElementById('copy-pw-text')!;
  const btnGenerate = document.getElementById('btn-generate') as HTMLButtonElement;
  const lengthSlider = document.getElementById('pw-length') as HTMLInputElement;
  const lengthDisplay = document.getElementById('length-display')!;
  const optUpper = document.getElementById('opt-uppercase') as HTMLInputElement;
  const optLower = document.getElementById('opt-lowercase') as HTMLInputElement;
  const optNumbers = document.getElementById('opt-numbers') as HTMLInputElement;
  const optSymbols = document.getElementById('opt-symbols') as HTMLInputElement;
  const strengthBar = document.getElementById('strength-bar') as HTMLDivElement;
  const strengthText = document.getElementById('strength-text') as HTMLSpanElement;
  const entropyValue = document.getElementById('entropy-value') as HTMLSpanElement;
  const batchCount = document.getElementById('batch-count') as HTMLSelectElement;
  const btnBatch = document.getElementById('btn-batch') as HTMLButtonElement;
  const batchList = document.getElementById('batch-list') as HTMLDivElement;
  const btnCopyAll = document.getElementById('btn-copy-all') as HTMLButtonElement;

  const CHARS = {
    upper: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
    lower: 'abcdefghijklmnopqrstuvwxyz',
    numbers: '0123456789',
    symbols: '!@#$%^&*()_+-=[]{}|;:,.<>?'
  };

  let batchPasswords: string[] = [];

  // Build charset from options
  function getCharset(): string {
    let cs = '';
    if (optUpper.checked) cs += CHARS.upper;
    if (optLower.checked) cs += CHARS.lower;
    if (optNumbers.checked) cs += CHARS.numbers;
    if (optSymbols.checked) cs += CHARS.symbols;
    return cs;
  }

  // Generate a single password using crypto.getRandomValues
  function generateOne(length: number, charset: string): string {
    if (!charset) return '';
    const arr = new Uint32Array(length);
    crypto.getRandomValues(arr);
    let pw = '';
    for (let i = 0; i < length; i++) {
      pw += charset[arr[i] % charset.length];
    }
    return pw;
  }

  // Calculate entropy
  function calcEntropy(length: number, charsetSize: number): number {
    if (charsetSize === 0 || length === 0) return 0;
    return Math.round(length * Math.log2(charsetSize) * 10) / 10;
  }

  // Update strength meter
  function updateStrength(pw: string, charsetSize: number) {
    const entropy = calcEntropy(pw.length, charsetSize);
    entropyValue.textContent = entropy.toFixed(1);

    let level = 0;
    let label = '';
    let color = '';

    if (entropy < 28) { level = 10; label = 'veryWeak'; color = '#ef4444'; }
    else if (entropy < 36) { level = 25; label = 'weak'; color = '#f97316'; }
    else if (entropy < 60) { level = 50; label = 'fair'; color = '#eab308'; }
    else if (entropy < 80) { level = 75; label = 'strong'; color = '#22c55e'; }
    else { level = 100; label = 'veryStrong'; color = '#16a34a'; }

    strengthBar.style.width = level + '%';
    strengthBar.style.background = color;

    // Get translated label from data attributes or fallback
    const strengthLabels: Record<string, string> = {
      veryWeak: (document.querySelector('[data-strength-veryWeak]') as HTMLElement)?.dataset.strengthVeryweak || 'Very Weak',
      weak: (document.querySelector('[data-strength-weak]') as HTMLElement)?.dataset.strengthWeak || 'Weak',
      fair: (document.querySelector('[data-strength-fair]') as HTMLElement)?.dataset.strengthFair || 'Fair',
      strong: (document.querySelector('[data-strength-strong]') as HTMLElement)?.dataset.strengthStrong || 'Strong',
      veryStrong: (document.querySelector('[data-strength-veryStrong]') as HTMLElement)?.dataset.strengthVerystrong || 'Very Strong'
    };

    strengthText.textContent = strengthLabels[label] || label;
    strengthText.style.color = color;
  }

  // Generate
  function generate() {
    const charset = getCharset();
    if (!charset) {
      resultInput.value = '';
      btnCopy.disabled = true;
      updateStrength('', 0);
      return;
    }
    const length = parseInt(lengthSlider.value);
    const pw = generateOne(length, charset);
    resultInput.value = pw;
    btnCopy.disabled = false;
    updateStrength(pw, charset.length);
  }

  // Length slider
  lengthSlider.addEventListener('input', () => {
    lengthDisplay.textContent = lengthSlider.value;
    if (resultInput.value) generate();
  });

  // Option checkboxes
  [optUpper, optLower, optNumbers, optSymbols].forEach(opt => {
    opt.addEventListener('change', () => {
      // Ensure at least one is checked
      const checked = [optUpper, optLower, optNumbers, optSymbols].filter(o => o.checked);
      if (checked.length === 0) {
        opt.checked = true;
        return;
      }
      if (resultInput.value) generate();
    });
  });

  // Generate button
  btnGenerate.addEventListener('click', generate);

  // Copy single
  btnCopy.addEventListener('click', async () => {
    if (!resultInput.value) return;
    try {
      await navigator.clipboard.writeText(resultInput.value);
      btnCopy.classList.add('copied');
      const origText = copyPwText.textContent;
      copyPwText.textContent = (document.querySelector('[data-pw-copied]') as HTMLElement)?.dataset.pwCopied || 'Copied!';
      setTimeout(() => {
        btnCopy.classList.remove('copied');
        copyPwText.textContent = origText;
      }, 2000);
    } catch (e) {
      // Fallback
      resultInput.select();
      document.execCommand('copy');
    }
  });

  // Batch generate
  btnBatch.addEventListener('click', () => {
    const charset = getCharset();
    if (!charset) return;
    const length = parseInt(lengthSlider.value);
    const count = parseInt(batchCount.value);
    batchPasswords = [];

    batchList.innerHTML = '';
    for (let i = 0; i < count; i++) {
      const pw = generateOne(length, charset);
      batchPasswords.push(pw);
      const item = document.createElement('div');
      item.className = 'batch-item';
      item.innerHTML = `<span class="batch-pw">${pw}</span><button title="Copy" data-idx="${i}"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button>`;
      batchList.appendChild(item);
    }

    // Copy individual batch items
    batchList.querySelectorAll('button[data-idx]').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt((btn as HTMLElement).dataset.idx!);
        navigator.clipboard.writeText(batchPasswords[idx]);
        const pw = btn.previousElementSibling as HTMLElement;
        const orig = pw.textContent;
        pw.textContent = '✓';
        setTimeout(() => { pw.textContent = orig; }, 1500);
      });
    });

    btnCopyAll.style.display = '';
  });

  // Copy all batch
  btnCopyAll.addEventListener('click', async () => {
    if (!batchPasswords.length) return;
    await navigator.clipboard.writeText(batchPasswords.join('\n'));
    const orig = btnCopyAll.textContent;
    btnCopyAll.textContent = '✓ Copied!';
    setTimeout(() => { btnCopyAll.textContent = orig; }, 2000);
  });

  // Auto-generate on load
  generate();
</script>
