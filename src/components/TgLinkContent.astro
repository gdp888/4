<script is:inline>
  // Telegram Link Generator — client-side logic
  function initTgLinkGenerator() {
    var generateBtn = document.getElementById('tgl-generate');
    var usernameInput = document.getElementById('tgl-username');
    var messageInput = document.getElementById('tgl-message');
    var messageLabel = document.getElementById('tgl-message-label');
    var resultSection = document.getElementById('tgl-result');
    var linkDisplay = document.getElementById('tgl-link');
    var errorMsg = document.getElementById('tgl-error');
    var copyBtn = document.getElementById('tgl-copy-link');
    var previewMsg = document.getElementById('tgl-preview-msg');
    var downloadQrBtn = document.getElementById('tgl-download-qr');
    var shareWhatsAppBtn = document.getElementById('tgl-share-whatsapp');
    var shareTelegramBtn = document.getElementById('tgl-share-telegram');
    var shareCopyBtn = document.getElementById('tgl-share-copy');
    var openTelegramBtn = document.getElementById('tgl-open-telegram');

    var linkTypeBot = document.getElementById('tgl-linktype-bot');
    var linkTypePersonal = document.getElementById('tgl-linktype-personal');

    var generatedLink = '';
    var selectedLinkType = 'bot'; // default

    // Link type selection
    function selectLinkType(type) {
      selectedLinkType = type;
      if (type === 'bot') {
        linkTypeBot.classList.add('link-type-option-active');
        linkTypeBot.setAttribute('aria-checked', 'true');
        linkTypePersonal.classList.remove('link-type-option-active');
        linkTypePersonal.setAttribute('aria-checked', 'false');
        messageLabel.textContent = messageInput.getAttribute('data-label-bot');
        messageInput.placeholder = messageInput.getAttribute('data-placeholder-bot');
      } else {
        linkTypePersonal.classList.add('link-type-option-active');
        linkTypePersonal.setAttribute('aria-checked', 'true');
        linkTypeBot.classList.remove('link-type-option-active');
        linkTypeBot.setAttribute('aria-checked', 'false');
        messageLabel.textContent = messageInput.getAttribute('data-label-personal');
        messageInput.placeholder = messageInput.getAttribute('data-placeholder-personal');
      }
    }

    linkTypeBot.addEventListener('click', function() { selectLinkType('bot'); });
    linkTypePersonal.addEventListener('click', function() { selectLinkType('personal'); });
    linkTypeBot.addEventListener('keydown', function(e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectLinkType('bot'); } });
    linkTypePersonal.addEventListener('keydown', function(e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectLinkType('personal'); } });

    // QR code generation
    function generateQR(text, container) {
      if (typeof QRCode !== 'undefined') {
        container.innerHTML = '';
        new QRCode(container, {
          text: text,
          width: 200,
          height: 200,
          colorDark: '#0088cc',
          colorLight: '#ffffff',
          correctLevel: QRCode.CorrectLevel.M,
        });
        var theme = document.documentElement.getAttribute('data-theme');
        if (theme === 'light') {
          container.innerHTML = '';
          new QRCode(container, {
            text: text,
            width: 200,
            height: 200,
            colorDark: '#0088cc',
            colorLight: '#f8fafc',
            correctLevel: QRCode.CorrectLevel.M,
          });
        }
      } else {
        container.innerHTML = '<p style="text-align:center;color:var(--text-secondary);padding:1rem;">QR library loading...</p>';
      }
    }

    // Generate link
    function doGenerate() {
      var username = usernameInput.value.trim().replace(/^@/, '');
      var message = messageInput.value.trim();

      if (!username) {
        errorMsg.textContent = usernameInput.getAttribute('data-error-empty');
        errorMsg.style.display = 'block';
        return;
      }

      // Validate username: 5-32 chars, letters, digits, underscores
      if (!/^[a-zA-Z][a-zA-Z0-9_]{4,31}$/.test(username)) {
        errorMsg.textContent = usernameInput.getAttribute('data-error-format');
        errorMsg.style.display = 'block';
        return;
      }

      errorMsg.style.display = 'none';

      var link = 'https://t.me/' + username;
      if (message) {
        if (selectedLinkType === 'bot') {
          link += '?start=' + encodeURIComponent(message);
        } else {
          link += '?text=' + encodeURIComponent(message);
        }
      }

      generatedLink = link;
      linkDisplay.textContent = link;
      resultSection.style.display = 'block';
      previewMsg.textContent = message || '👋';
      previewMsg.style.display = 'block';

      var qrCanvas = document.getElementById('tgl-qr-canvas');
      generateQR(link, qrCanvas);

      resultSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // Copy link
    function doCopy(text) {
      navigator.clipboard.writeText(text).then(function() {
        var label = copyBtn.querySelector('.copy-label');
        var originalText = label.textContent;
        label.textContent = '✓';
        setTimeout(function() { label.textContent = originalText; }, 1500);
      }).catch(function() {
        var textarea = document.createElement('textarea');
        textarea.value = text;
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
      });
    }

    // Download QR
    function doDownloadQR() {
      var qrCanvas = document.getElementById('tgl-qr-canvas');
      var canvas = qrCanvas && qrCanvas.querySelector('canvas');
      if (canvas) {
        var link = document.createElement('a');
        link.download = 'telegram-link-qr.png';
        link.href = canvas.toDataURL('image/png');
        link.click();
      } else {
        var img = qrCanvas && qrCanvas.querySelector('img');
        if (img) {
          var link = document.createElement('a');
          link.download = 'telegram-link-qr.png';
          link.href = img.src;
          link.click();
        }
      }
    }

    // Share via WhatsApp
    function doShareWhatsApp() {
      if (!generatedLink) return;
      window.open('https://wa.me/?text=' + encodeURIComponent(generatedLink), '_blank');
    }

    // Share via Telegram
    function doShareTelegram() {
      if (!generatedLink) return;
      window.open('https://t.me/share/url?url=' + encodeURIComponent(generatedLink), '_blank');
    }

    // Open in Telegram
    function doOpenTelegram() {
      if (!generatedLink) return;
      window.open(generatedLink, '_blank');
    }

    // Event listeners
    generateBtn.addEventListener('click', doGenerate);
    copyBtn.addEventListener('click', function() { doCopy(generatedLink); });
    downloadQrBtn.addEventListener('click', doDownloadQR);
    shareWhatsAppBtn.addEventListener('click', doShareWhatsApp);
    shareTelegramBtn.addEventListener('click', doShareTelegram);
    shareCopyBtn.addEventListener('click', function() { doCopy(generatedLink); });
    openTelegramBtn.addEventListener('click', doOpenTelegram);

    usernameInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') doGenerate();
    });
  }

  initTgLinkGenerator();
</script>

