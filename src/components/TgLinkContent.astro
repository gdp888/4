---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';
import { getRelativeLocaleUrl, getAbsoluteLocaleUrl } from 'astro:i18n';
import { languages, langCodes, type Lang } from '../i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const otherLangs = (Object.keys(languages) as Lang[]).filter(l => l !== lang);

const localeMap: Record<Lang, string> = { en: 'en_US', es: 'es_ES', pt: 'pt_BR', id: 'id_ID', ru: 'ru_RU', ar: 'ar_SA', de: 'de_DE' };
const alternateLocales = otherLangs.map(l => localeMap[l]);

// Schema.org — FAQ data
const faqItems = [
  { q: t('tgl.seo.faq.q1'), a: t('tgl.seo.faq.a1') },
  { q: t('tgl.seo.faq.q2'), a: t('tgl.seo.faq.a2') },
  { q: t('tgl.seo.faq.q3'), a: t('tgl.seo.faq.a3') },
  { q: t('tgl.seo.faq.q4'), a: t('tgl.seo.faq.a4') },
  { q: t('tgl.seo.faq.q5'), a: t('tgl.seo.faq.a5') },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "OPN Chat Telegram Link Generator",
      "url": getAbsoluteLocaleUrl(lang, 'tg-link'),
      "description": t('tgl.meta.description'),
      "applicationCategory": "CommunicationApplication",
      "operatingSystem": "Any",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "inLanguage": Object.keys(languages),
      "featureList": [
        t('tgl.seo.why.feature1.title') + ': ' + t('tgl.seo.why.feature1.desc'),
        t('tgl.seo.why.feature2.title') + ': ' + t('tgl.seo.why.feature2.desc'),
        t('tgl.seo.why.feature3.title') + ': ' + t('tgl.seo.why.feature3.desc'),
        t('tgl.seo.why.feature4.title') + ': ' + t('tgl.seo.why.feature4.desc'),
      ],
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "OPN Chat",
          "item": getAbsoluteLocaleUrl(lang, '')
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Telegram Link Generator",
          "item": getAbsoluteLocaleUrl(lang, 'tg-link')
        }
      ]
    }
  ]
};
---

<Layout title={t('tgl.meta.title')} lang={lang} service="tg-link">
  <Fragment slot="meta">
    <link rel="dns-prefetch" href="https://t.me" />
    <link rel="preconnect" href="https://t.me" crossorigin />
    <meta name="description" content={t('tgl.meta.description')} />
    <meta name="keywords" content={t('tgl.meta.keywords')} />
    <link rel="canonical" href={getAbsoluteLocaleUrl(lang, 'tg-link')} />
    <meta property="og:title" content={t('tgl.meta.og.title')} />
    <meta property="og:description" content={t('tgl.meta.og.description')} />
    <meta property="og:url" content={getAbsoluteLocaleUrl(lang, 'tg-link')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OPN Chat" />
    <meta property="og:locale" content={localeMap[lang]} />
    {alternateLocales.map(loc => (
      <meta property="og:locale:alternate" content={loc} />
    ))}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={t('tgl.meta.twitter.title')} />
    <meta name="twitter:description" content={t('tgl.meta.twitter.description')} />
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  </Fragment>

  <div class="page-layout">
    <!-- Sidebar (desktop only) -->
    <aside class="sidebar" aria-label="Tools navigation">
      <div class="sidebar-header">
        <a href={getRelativeLocaleUrl(lang)} class="sidebar-logo">OPN Chat</a>
      </div>

      <div class="sidebar-category">
        <h3 class="sidebar-cat-title">{t('sidebar.messaging')}</h3>
        <a href={getRelativeLocaleUrl(lang, 'whatsapp')} class="sidebar-link">
          <svg viewBox="0 0 24 24" fill="currentColor" class="sidebar-icon" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          {t('hub.service.whatsapp.title')}
        </a>
        <a href={getRelativeLocaleUrl(lang, 'telegram')} class="sidebar-link">
          <svg viewBox="0 0 24 24" fill="currentColor" class="sidebar-icon" aria-hidden="true"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
          {t('hub.service.telegram.title')}
        </a>
        <a href={getRelativeLocaleUrl(lang, 'wa-link')} class="sidebar-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="sidebar-icon" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          {t('hub.service.walink.title')}
        </a>
        <a href={getRelativeLocaleUrl(lang, 'tg-link')} class="sidebar-link sidebar-link-active">
          <svg viewBox="0 0 24 24" fill="currentColor" class="sidebar-icon" aria-hidden="true"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
          {t('hub.service.tglink.title')}
        </a>
        <a href={getRelativeLocaleUrl(lang, 'wa-widget')} class="sidebar-link">
          <svg viewBox="0 0 24 24" fill="currentColor" class="sidebar-icon" aria-hidden="true"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.17L4 17.17V4h16v12z"/><path d="M7 9h2v2H7zm4 0h2v2h-2zm4 0h2v2h-2z"/></svg>
          {t('hub.service.widget.title')}
        </a>
      </div>

      <div class="sidebar-category">
        <h3 class="sidebar-cat-title">{t('sidebar.texttools')}</h3>
        <a href={getRelativeLocaleUrl(lang, 'whatsapp-text-formatter')} class="sidebar-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="sidebar-icon" aria-hidden="true"><path d="M4 7V4h16v3"/><path d="M9 20h6"/><path d="M12 4v16"/></svg>
          {t('hub.service.formatter.title')}
        </a>
        <a href={getRelativeLocaleUrl(lang, 'fancy-text')} class="sidebar-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="sidebar-icon" aria-hidden="true"><path d="M4 7V4h16v3"/><path d="M9 20h6"/><path d="M12 4v16"/></svg>
          {t('hub.service.fancytext.title')}
        </a>
        <a href={getRelativeLocaleUrl(lang, 'word-counter')} class="sidebar-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="sidebar-icon" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
          {t('hub.service.wordcounter.title')}
        </a>
        <a href={getRelativeLocaleUrl(lang, 'notepad')} class="sidebar-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="sidebar-icon" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          {t('hub.service.notepad.title')}
        </a>
      </div>

      <div class="sidebar-category">
        <h3 class="sidebar-cat-title">{t('sidebar.utilities')}</h3>
        <a href={getRelativeLocaleUrl(lang, 'qr-code')} class="sidebar-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="sidebar-icon" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="3" height="3"/><line x1="21" y1="14" x2="21" y2="14.01"/><line x1="21" y1="21" x2="21" y2="21.01"/><line x1="17" y1="18" x2="17" y2="18.01"/></svg>
          {t('hub.service.qr.title')}
        </a>
        <a href={getRelativeLocaleUrl(lang, 'password')} class="sidebar-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="sidebar-icon" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          {t('hub.service.password.title')}
        </a>
        <a href={getRelativeLocaleUrl(lang, 'unit-converter')} class="sidebar-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="sidebar-icon" aria-hidden="true"><path d="M7 16V4m0 0L3 8m4-4l4 4M17 8v12m0 0l4-4m-4 4l-4-4"/></svg>
          {t('hub.service.converter.title')}
        </a>
        <a href={getRelativeLocaleUrl(lang, 'emoji-picker')} class="sidebar-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="sidebar-icon" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
          {t('hub.service.emojipicker.title')}
        </a>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
      <div class="container">
        <!-- Header with nav -->
        <header class="site-header">
          <a href={getRelativeLocaleUrl(lang)} class="logo" aria-label="OPN Chat — Home">
            <span class="logo-text">OPN Chat</span>
            <svg viewBox="0 0 24 24" fill="currentColor" class="logo-icon" aria-hidden="true">
              <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
            </svg>
          </a>
          <LanguageSwitcher lang={lang} path="tg-link" />
          <button type="button" class="theme-toggle" aria-label="Toggle theme" id="theme-toggle">
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </button>
        </header>

        <!-- Breadcrumbs -->
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href={getRelativeLocaleUrl(lang)} class="bc-link">{t('bc.home')}</a>
          <span class="bc-sep">›</span>
          <a href={getRelativeLocaleUrl(lang, 'telegram')} class="bc-link">{t('bc.telegram')}</a>
          <span class="bc-sep">›</span>
          <span class="bc-current">{t('bc.tglink')}</span>
        </nav>

        <!-- Hero -->
        <div class="hero">
          <h1 class="title">{t('tgl.heading')}</h1>
          <p class="subtitle">{t('tgl.subtitle')}</p>
          <div class="privacy-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            {t('tgl.privacy.badge')}
          </div>
        </div>

        <!-- Generator Form -->
        <div class="generator">
          <!-- Step 1: Telegram Username -->
          <div class="step-section">
            <div class="step-number">1</div>
            <div class="step-content">
              <label for="tgl-username" class="label">{t('tgl.form.username.label')}</label>
              <div class="username-input-group">
                <span class="username-prefix">@</span>
                <input type="text" id="tgl-username" class="username-input" placeholder={t('tgl.form.username.placeholder')} autocomplete="off" required data-error-empty={t('tgl.form.username.error.empty')} data-error-format={t('tgl.form.username.error.format')} />
              </div>
              <span class="hint">{t('tgl.form.username.hint')}</span>
              <span id="tgl-error" class="error-msg" role="alert"></span>
            </div>
          </div>

          <!-- Step 2: Link Type -->
          <div class="step-section">
            <div class="step-number">2</div>
            <div class="step-content">
              <label class="label">{t('tgl.linktype.label')}</label>
              <div class="link-type-selector">
                <div class="link-type-option link-type-option-active" id="tgl-linktype-bot" data-type="bot" role="radio" aria-checked="true" tabindex="0">
                  <div class="link-type-radio">
                    <div class="link-type-radio-dot"></div>
                  </div>
                  <div class="link-type-info">
                    <span class="link-type-name">{t('tgl.linktype.bot')}</span>
                    <span class="link-type-desc">{t('tgl.linktype.bot.desc')}</span>
                  </div>
                </div>
                <div class="link-type-option" id="tgl-linktype-personal" data-type="personal" role="radio" aria-checked="false" tabindex="0">
                  <div class="link-type-radio">
                    <div class="link-type-radio-dot"></div>
                  </div>
                  <div class="link-type-info">
                    <span class="link-type-name">{t('tgl.linktype.personal')}</span>
                    <span class="link-type-desc">{t('tgl.linktype.personal.desc')}</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Step 3: Message -->
          <div class="step-section">
            <div class="step-number">3</div>
            <div class="step-content">
              <label for="tgl-message" class="label" id="tgl-message-label">{t('tgl.form.message.label')}</label>
              <span class="optional">{t('tgl.form.label.optional')}</span>
              <textarea id="tgl-message" class="message-input" placeholder={t('tgl.form.message.placeholder')} rows="2" data-placeholder-bot={t('tgl.form.message.placeholder')} data-placeholder-personal={t('tgl.form.message.placeholder.personal')} data-label-bot={t('tgl.form.message.label')} data-label-personal={t('tgl.form.message.label.personal')}></textarea>
            </div>
          </div>

          <!-- Step 4: Generate -->
          <div class="step-section">
            <div class="step-number">4</div>
            <div class="step-content">
              <button type="button" id="tgl-generate" class="submit-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-icon">
                  <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                  <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                </svg>
                {t('tgl.form.generate')}
              </button>
            </div>
          </div>

          <!-- Result Section (hidden until generated) -->
          <div id="tgl-result" class="result-section" style="display:none;">
            <h2 class="result-title">{t('tgl.result.title')}</h2>

            <!-- Generated Link -->
            <div class="link-box">
              <code id="tgl-link" class="link-text"></code>
              <button type="button" id="tgl-copy-link" class="copy-btn" aria-label={t('tgl.copy')} title={t('tgl.copy')}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="copy-icon">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                </svg>
                <span class="copy-label">{t('tgl.copy')}</span>
              </button>
            </div>

            <!-- Open in Telegram Button -->
            <button type="button" id="tgl-open-telegram" class="open-tg-btn">
              <svg viewBox="0 0 24 24" fill="currentColor" class="open-tg-icon" aria-hidden="true">
                <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
              </svg>
              {t('tgl.open')}
            </button>

            <!-- QR Code -->
            <div class="qr-section">
              <h3 class="qr-title">{t('tgl.qr.title')}</h3>
              <div id="tgl-qr-canvas" class="qr-canvas"></div>
              <button type="button" id="tgl-download-qr" class="download-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-icon">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                  <polyline points="7 10 12 15 17 10"/>
                  <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
                {t('tgl.qr.download')}
              </button>
            </div>

            <!-- Share Buttons -->
            <div class="share-section">
              <p class="share-label">{t('tgl.share.label')}</p>
              <div class="share-buttons">
                <button type="button" id="tgl-share-whatsapp" class="share-btn wa-share">
