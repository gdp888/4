---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';
import { getRelativeLocaleUrl, getAbsoluteLocaleUrl } from 'astro:i18n';
import { languages, type Lang } from '../i18n/ui';
import SiteHeader from './SiteHeader.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import SEOHead from './SEOHead.astro';
import { localeMap } from '../i18n/localeMap';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Schema.org — FAQ data
const faqItems = [
  { q: t('sg.seo.faq.q1'), a: t('sg.seo.faq.a1') },
  { q: t('sg.seo.faq.q2'), a: t('sg.seo.faq.a2') },
  { q: t('sg.seo.faq.q3'), a: t('sg.seo.faq.a3') },
  { q: t('sg.seo.faq.q4'), a: t('sg.seo.faq.a4') },
  { q: t('sg.seo.faq.q5'), a: t('sg.seo.faq.a5') },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "OPN Chat — Signal",
      "url": getAbsoluteLocaleUrl(lang, 'signal'),
      "description": t('sg.meta.description'),
      "applicationCategory": "CommunicationApplication",
      "operatingSystem": "Any",
      "browserRequirements": "Requires JavaScript. Requires Signal app installed.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "inLanguage": Object.keys(languages),
      "featureList": [
        t('sg.seo.why.feature1.title') + ': ' + t('sg.seo.why.feature1.desc'),
        t('sg.seo.why.feature2.title') + ': ' + t('sg.seo.why.feature2.desc'),
        t('sg.seo.why.feature3.title') + ': ' + t('sg.seo.why.feature3.desc'),
        t('sg.seo.why.feature4.title') + ': ' + t('sg.seo.why.feature4.desc'),
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "OPN Chat",
          "item": getAbsoluteLocaleUrl(lang, '')
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Signal",
          "item": getAbsoluteLocaleUrl(lang, 'signal')
        }
      ]
    }
  ]
};
---

<Layout title={t('sg.meta.title')} lang={lang} service="signal">
  <Fragment slot="meta">
  <SEOHead
  lang={lang}
  description={t('sg.meta.description')}
  canonicalUrl={getAbsoluteLocaleUrl(lang, 'signal')}
  ogTitle={t('sg.meta.og.title')}
  ogDescription={t('sg.meta.og.description')}
  ogUrl={getAbsoluteLocaleUrl(lang, 'signal')}
  schema={pageSchema}
  extraMeta={`<meta name="keywords" content="${t('sg.meta.keywords')}" /><meta name="twitter:card" content="summary" /><meta name="twitter:title" content="${t('sg.meta.twitter.title')}" /><meta name="twitter:description" content="${t('sg.meta.twitter.description')}" />`}
/>
</Fragment>

  <div class="container">
    <SiteHeader lang={lang} path="signal" activeTool="signal" />

    <Breadcrumbs lang={lang} items={[{ label: t('bc.home'), href: getRelativeLocaleUrl(lang) }, { label: t('bc.signal') }]} />

    <!-- Hero -->
    <div class="hero">
      <h1 class="title">{t('sg.header.description')}</h1>
    </div>

    <!-- Signal Required Hint — adapts to desktop/mobile -->
    <div class="signal-hint" id="signal-hint">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hint-icon">
        <circle cx="12" cy="12" r="10"/>
        <line x1="12" y1="16" x2="12" y2="12"/>
        <line x1="12" y1="8" x2="12.01" y2="8"/>
      </svg>
      <div class="hint-content">
        <span id="signal-hint-text">{t('sg.hint.required')}</span>
        <a href="https://signal.org/download/" target="_blank" rel="noopener noreferrer" class="signal-download-link" id="signal-download-link" style="display:none;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="download-icon">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          {t('sg.hint.download')}
        </a>
      </div>
    </div>

    <!-- Form -->
    <form id="signal-form" class="form">
      <div class="input-group">
        <label for="phone" class="label">{t('sg.form.label.phone')}</label>
        <div class="phone-input-group">
          <span class="phone-prefix">+</span>
          <input
            type="tel"
            id="phone"
            class="phone-input"
            placeholder={t('sg.form.placeholder.phone')}
            autocomplete="tel"
            required
          />
        </div>
        <span class="hint">{t('sg.form.hint')}</span>
        <span id="error-msg" class="error-msg" role="alert"></span>
      </div>

      <button type="submit" class="submit-btn" id="submit-btn">
        <svg viewBox="0 0 24 24" fill="currentColor" class="btn-icon">
          <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
        </svg>
        {t('sg.form.submit')}
      </button>

      <details class="message-details">
        <summary class="message-toggle">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="toggle-icon">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
          {t('sg.form.addMessage')}
          <span class="optional">{t('sg.form.label.optional')}</span>
        </summary>
        <div class="message-body">
          <textarea
            id="message"
            class="message-input"
            placeholder={t('sg.form.placeholder.message')}
            rows="3"
          ></textarea>
        </div>
      </details>
    </form>

    <!-- History -->
    <div id="history-section" class="history-section" style="display:none;">
      <div class="history-header">
        <h3 class="history-title">{t('sg.history.title')}</h3>
        <button type="button" id="clear-history" class="clear-btn" aria-label="Clear history">{t('sg.history.clear')}</button>
      </div>
      <ul id="history-list" class="history-list"></ul>
    </div>

    <!-- Cross-link: WhatsApp alternative -->
    <div class="cross_link-section">
      <a href={getRelativeLocaleUrl(lang, 'whatsapp')} class="cross-link-card">
        <svg viewBox="0 0 24 24" fill="currentColor" class="cross-link-icon">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <div>
          <span class="cross-link-title">{t('sg.crosslink.whatsapp.title')}</span>
          <span class="cross-link-desc">{t('sg.crosslink.whatsapp.desc')}</span>
        </div>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="cross-link-arrow"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

    <!-- SEO Content Section -->
    <section class="seo-section" aria-label="About Signal Direct Chat">

      <article class="seo-block">
        <h2 class="seo-heading">{t('sg.seo.what.heading')}</h2>
        <p class="seo-text" set:html={t('sg.seo.what.text')} />
      </article>

      <article class="seo-block">
        <h2 class="seo-heading">{t('sg.seo.without.heading')}</h2>
        <p class="seo-text">{t('sg.seo.without.text')}</p>
      </article>

      <article class="seo-block">
        <h2 class="seo-heading">{t('sg.seo.how.heading')}</h2>
        <p class="seo-text">{t('sg.seo.how.text')}</p>
      </article>

      <article class="seo-block">
        <h2 class="seo-heading">{t('sg.seo.why.heading')}</h2>
        <div class="seo-features">
          <div class="feature-item">
            <span class="feature-icon">&#9889;</span>
            <div>
              <h3 class="feature-title">{t('sg.seo.why.feature1.title')}</h3>
              <p class="feature-desc">{t('sg.seo.why.feature1.desc')}</p>
            </div>
          </div>
          <div class="feature-item">
            <span class="feature-icon">&#128274;</span>
            <div>
              <h3 class="feature-title">{t('sg.seo.why.feature2.title')}</h3>
              <p class="feature-desc">{t('sg.seo.why.feature2.desc')}</p>
            </div>
          </div>
          <div class="feature-item">
            <span class="feature-icon">&#127760;</span>
            <div>
              <h3 class="feature-title">{t('sg.seo.why.feature3.title')}</h3>
              <p class="feature-desc">{t('sg.seo.why.feature3.desc')}</p>
            </div>
          </div>
          <div class="feature-item">
            <span class="feature-icon">&#9993;</span>
            <div>
              <h3 class="feature-title">{t('sg.seo.why.feature4.title')}</h3>
              <p class="feature-desc">{t('sg.seo.why.feature4.desc')}</p>
            </div>
          </div>
        </div>
      </article>

      <article class="seo-block">
        <h2 class="seo-heading">{t('sg.seo.cases.heading')}</h2>
        <p class="seo-text">{t('sg.seo.cases.text')}</p>
      </article>

      <article class="seo-block">
        <h2 class="seo-heading">{t('sg.seo.deep.heading')}</h2>
        <p class="seo-text">{t('sg.seo.deep.text')}</p>
      </article>

      <article class="seo-block">
        <h2 class="seo-heading">{t('sg.seo.faq.heading')}</h2>
        <div class="faq-list">
          <details class="faq-item">
            <summary class="faq-question">{t('sg.seo.faq.q1')}</summary>
            <p class="faq-answer">{t('sg.seo.faq.a1')}</p>
          </details>
          <details class="faq-item">
            <summary class="faq-question">{t('sg.seo.faq.q2')}</summary>
            <p class="faq-answer">{t('sg.seo.faq.a2')}</p>
          </details>
          <details class="faq-item">
            <summary class="faq-question">{t('sg.seo.faq.q3')}</summary>
            <p class="faq-answer">{t('sg.seo.faq.a3')}</p>
          </details>
          <details class="faq-item">
            <summary class="faq-question">{t('sg.seo.faq.q4')}</summary>
            <p class="faq-answer">{t('sg.seo.faq.a4')}</p>
          </details>
          <details class="faq-item">
            <summary class="faq-question">{t('sg.seo.faq.q5')}</summary>
            <p class="faq-answer">{t('sg.seo.faq.a5')}</p>
          </details>
        </div>
      </article>
    </section>
</div>
</Layout>

<style>
  .container {
    position: relative;
    z-index: 1;
    width: 100%;
    margin: 0 auto;
    max-width: 480px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hero {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .title {
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    line-height: 1.2;
  }

  /* Signal hint banner */
  .signal-hint {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.75rem 1rem;
    background: rgba(58, 118, 240, 0.08);
    border: 1px solid rgba(58, 118, 240, 0.2);
    border-radius: 12px;
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .hint-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: #3A76F0;
    margin-top: 0.1rem;
  }

  .hint-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .signal-download-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #3A76F0;
    font-weight: 600;
    font-size: 0.82rem;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .signal-download-link:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  .download-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .form {
    background: var(--bg-secondary);
    border-radius: 16px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    box-shadow: var(--card-shadow), 0 4px 24px rgba(0, 0, 0, 0.15);
    border: 1px solid var(--border-color);
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .label {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: none;
    letter-spacing: 0.01em;
  }

  .optional {
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .phone-input-group {
    display: flex;
    align-items: stretch;
    border: 2px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg-input);
    transition: border-color 0.2s;
  }

  .phone-input-group:focus-within {
    border-color: #3A76F0;
  }

  .phone-prefix {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 0.75rem 0.85rem 1rem;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-secondary);
    background: var(--border-color);
    border-right: 2px solid var(--border-color);
    user-select: none;
    min-width: 44px;
  }

  .phone-input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--text-primary);
    padding: 0.85rem 1rem;
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    outline: none;
    width: 100%;
  }

  .phone-input::placeholder {
    color: var(--text-secondary);
    opacity: 0.7;
  }

  .hint {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .error-msg {
    font-size: 0.8rem;
    color: #ff6b6b;
    min-height: 1.2em;
    transition: opacity 0.2s;
  }

  .message-details {
    border: 1px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
  }

  .message-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-secondary);
    cursor: pointer;
    list-style: none;
    transition: background 0.15s;
  }

  .message-toggle::-webkit-details-marker {
    display: none;
  }

  .message-toggle::after {
    content: '\25BC';
    margin-left: auto;
    font-size: 0.65rem;
    transition: transform 0.2s;
    opacity: 0.5;
  }

  .message-details[open] .message-toggle::after {
    transform: rotate(180deg);
  }

  .message-toggle:hover {
    background: var(--border-color);
  }

  .toggle-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    opacity: 0.6;
  }

  .message-body {
    padding: 0 0.75rem 0.75rem 0.75rem;
  }

  .message-input {
    background: var(--bg-input);
    border: 2px solid var(--border-color);
    border-radius: 10px;
    color: var(--text-primary);
    padding: 0.75rem 1rem;
    font-size: 0.95rem;
    resize: vertical;
    min-height: 80px;
    width: 100%;
    transition: border-color 0.2s;
    outline: none;
  }

  .message-input:focus {
    border-color: #3A76F0;
  }

  .message-input::placeholder {
    color: var(--text-secondary);
    opacity: 0.7;
  }

  .submit-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background: #3A76F0;
    color: #fff;
    border: none;
    border-radius: 12px;
    padding: 1rem 1.5rem;
    font-size: 1.05rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
    text-transform: none;
    letter-spacing: 0.01em;
  }

  .submit-btn:hover {
    background: #2E5FCC;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(58, 118, 240, 0.35);
  }

  .submit-btn:active {
    transform: translateY(0);
    box-shadow: none;
  }

  .submit-btn:focus-visible {
    outline: 2px solid #3A76F0;
    outline-offset: 2px;
  }

  .btn-icon {
    width: 22px;
    height: 22px;
  }

  .history-section {
    background: var(--bg-secondary);
    border-radius: 16px;
    padding: 1.25rem;
    border: 1px solid var(--border-color);
    box-shadow: var(--card-shadow);
  }

  .history-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .history-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .clear-btn {
    font-size: 0.75rem;
    color: var(--text-secondary);
    background: none;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 0.25rem 0.6rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .clear-btn:hover {
    color: #ff6b6b;
    border-color: #ff6b6b;
  }

  .history-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  :global(.history-item) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 0.75rem;
    border-radius: 10px;
    background: var(--bg-input);
    transition: background 0.15s;
  }

  :global(.history-item:hover) {
    background: var(--border-color);
  }

  :global(.history-number) {
    font-weight: 500;
    font-size: 0.95rem;
    cursor: pointer;
  }

  :global(.history-number:hover) {
    color: #3A76F0;
  }

  :global(.history-time) {
    font-size: 0.72rem;
    color: var(--text-secondary);
  }

  :global(.history-chat-btn) {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.3rem 0.65rem;
    border-radius: 6px;
    background: #3A76F0;
    color: #fff;
    border: none;
    cursor: pointer;
    transition: background 0.2s;
    text-transform: none;
  }

  :global(.history-chat-btn:hover) {
    background: #2E5FCC;
  }

  :global(.history-left) {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  /* Cross-link section */
  .cross_link-section {
    margin-top: 0.5rem;
  }

  .cross-link-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.2s;
  }

  .cross-link-card:hover {
    border-color: #25D366;
    box-shadow: 0 4px 12px rgba(37, 211, 102, 0.1);
  }

  .cross-link-icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    color: #25D366;
  }

  .cross-link-title {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .cross-link-desc {
    display: block;
    font-size: 0.78rem;
    color: var(--text-secondary);
    margin-top: 0.15rem;
  }

  .cross-link-arrow {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: var(--text-secondary);
    margin-left: auto;
  }

  /* SEO Section */
  .seo-section {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-top: 1.5rem;
  }

  .seo-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .seo-heading {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .seo-text {
    font-size: 0.9rem;
    line-height: 1.75;
    color: var(--text-secondary);
  }

  .seo-features {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .feature-item {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .feature-icon {
    font-size: 1.4rem;
    line-height: 1;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .feature-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.2rem;
  }

  .feature-desc {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* FAQ */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .faq-item {
    background: var(--bg-input);
    border-radius: 10px;
    overflow: hidden;
