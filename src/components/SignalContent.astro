</style>

<script define:vars={{ lang }}>
  // Desktop detection — show download link if user is on desktop
  const isDesktop = !/Android|iPhone|iPad|iPod|Opera Mini|IEMobile|WPDesktop/i.test(navigator.userAgent);
  const hintDownloadLink = document.getElementById('signal-download-link');
  const hintDownloadText = document.getElementById('signal-hint-text');
  if (isDesktop && hintDownloadLink) {
    hintDownloadLink.style.display = 'inline-flex';
  }

  const form = document.getElementById('signal-form');
  const phoneInput = document.getElementById('phone');
  const messageInput = document.getElementById('message');
  const errorMsg = document.getElementById('error-msg');
  const historySection = document.getElementById('history-section');
  const historyList = document.getElementById('history-list');
  const clearBtn = document.getElementById('clear-history');

  const STORAGE_KEY = 'opnchat-signal-history';
  const MAX_HISTORY = 5;

  const localeMap = { en: 'en-US', es: 'es-ES', pt: 'pt-BR', id: 'id-ID', ru: 'ru-RU', ar: 'ar-SA', de: 'de-DE' };
  const locale = localeMap[lang] || 'en-US';

  const chatLabel = 'Signal';

  // Phone input — digits only
  phoneInput.addEventListener('input', () => {
    let val = phoneInput.value.replace(/\D/g, '');
    if (val.length > 15) val = val.slice(0, 15);
    phoneInput.value = val;
    errorMsg.textContent = '';
  });

  // Load history from localStorage
  function loadHistory() {
    try {
      const data = localStorage.getItem(STORAGE_KEY);
      return data ? JSON.parse(data) : [];
    } catch {
      return [];
    }
  }

  // Save — store clean digits (no +), display with +
  function saveHistory(cleanDigits) {
    const history = loadHistory().filter(h => h.number !== cleanDigits);
    history.unshift({ number: cleanDigits, timestamp: Date.now() });
    if (history.length > MAX_HISTORY) history.pop();
    localStorage.setItem(STORAGE_KEY, JSON.stringify(history));
    renderHistory();
  }

  function renderHistory() {
    const history = loadHistory();
    if (history.length === 0) {
      historySection.style.display = 'none';
      return;
    }
    historySection.style.display = 'block';
    historyList.innerHTML = '';

    history.forEach(item => {
      const digits = item.number.replace(/\D/g, '');
      const li = document.createElement('li');
      li.className = 'history-item';

      // Left side: number + time
      const leftDiv = document.createElement('div');
      leftDiv.className = 'history-left';

      const numSpan = document.createElement('span');
      numSpan.className = 'history-number';
      numSpan.textContent = '+' + digits;
      // Click number → fill input
      numSpan.addEventListener('click', (e) => {
        e.stopPropagation();
        phoneInput.value = digits;
        phoneInput.focus();
      });

      const timeSpan = document.createElement('span');
      timeSpan.className = 'history-time';
      const time = new Date(item.timestamp);
      timeSpan.textContent = time.toLocaleTimeString(locale, { hour: '2-digit', minute: '2-digit' });

      leftDiv.appendChild(numSpan);
      leftDiv.appendChild(timeSpan);

      // Right side: Chat button
      const chatBtn = document.createElement('button');
      chatBtn.type = 'button';
      chatBtn.className = 'history-chat-btn';
      chatBtn.textContent = chatLabel;
      chatBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        window.open(`https://signal.me/#p/+${digits}`, '_blank');
      });

      li.appendChild(leftDiv);
      li.appendChild(chatBtn);
      historyList.appendChild(li);
    });
  }

  // Clear history
  clearBtn.addEventListener('click', () => {
    localStorage.removeItem(STORAGE_KEY);
    renderHistory();
  });

  // Initial render
  renderHistory();

  // Form submit
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    errorMsg.textContent = '';

    const rawPhone = phoneInput.value.replace(/\D/g, '');
    const message = messageInput.value.trim();

    // Error messages by language
    const errorMessages = {
      valid: lang === 'ru' ? 'Введите корректный номер телефона' : lang === 'es' ? 'Ingresa un número de teléfono válido' : lang === 'pt' ? 'Insira um número de telefone válido' : lang === 'de' ? 'Bitte geben Sie eine gültige Telefonnummer ein' : lang === 'id' ? 'Masukkan nomor telepon yang valid' : lang === 'ar' ? 'أدخل رقم هاتف صالح' : 'Please enter a valid phone number',
      short: lang === 'ru' ? 'Номер телефона слишком короткий' : lang === 'es' ? 'El número de teléfono es demasiado corto' : lang === 'pt' ? 'O número de telefone é muito curto' : lang === 'de' ? 'Die Telefonnummer ist zu kurz' : lang === 'id' ? 'Nomor telepon terlalu pendek' : lang === 'ar' ? 'رقم الهاتف قصير جداً' : 'Phone number is too short',
    };

    if (rawPhone.length < 7) {
      errorMsg.textContent = errorMessages.valid;
      phoneInput.focus();
      return;
    }

    if (rawPhone.length < 10) {
      errorMsg.textContent = errorMessages.short;
      phoneInput.focus();
      return;
    }

    // Save clean digits (without +)
    saveHistory(rawPhone);

    // Signal link: https://signal.me/#p/+{phone}
    // This web link works on both mobile (opens Signal app) and desktop (prompts to install)
    const url = `https://signal.me/#p/+${rawPhone}`;
    window.open(url, '_blank');
  });

  // Keyboard shortcut — Enter to submit when phone is focused
  phoneInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      form.dispatchEvent(new Event('submit', { cancelable: true }));
    }
  });
</script>
