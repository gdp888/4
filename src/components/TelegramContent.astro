  }

  @media (max-width: 520px) {
    .page-layout {
      padding: 1.25rem 1rem;
    }
    .title {
      font-size: 1.75rem;
    }
    .site-header {
      justify-content: center;
    }
    .form {
      padding: 1.25rem;
    }
    .seo-heading {
      font-size: 1.1rem;
    }
    .seo-text {
      font-size: 0.85rem;
    }

  }
</style>

<script define:vars={{ lang }}>
  const form = document.getElementById('telegram-form');
  const input = document.getElementById('tg-input');
  const messageInput = document.getElementById('message');
  const errorMsg = document.getElementById('error-msg');
  const historySection = document.getElementById('history-section');
  const historyList = document.getElementById('history-list');
  const clearBtn = document.getElementById('clear-history');

  const STORAGE_KEY = 'opnchat-telegram-history';
  const MAX_HISTORY = 5;

  const localeMap = { en: 'en-US', es: 'es-ES', pt: 'pt-BR', id: 'id-ID', ru: 'ru-RU', ar: 'ar-SA', de: 'de-DE' };
  const locale = localeMap[lang] || 'en-US';

  const chatLabel = 'Chat';

  // Detect if input is a username or phone number
  function isUsername(val) {
    // Strip leading @, check if remaining is alphanumeric/underscores
    var cleaned = val.replace(/^@/, '');
    return /[a-zA-Z]/.test(cleaned);
  }

  // Clean username: strip @, keep alphanumeric + underscores
  function cleanUsername(val) {
    return val.replace(/^@/, '').replace(/[^a-zA-Z0-9_]/g, '');
  }

  // Clean phone: digits only
  function cleanPhone(val) {
    return val.replace(/\D/g, '');
  }

  // Input handler
  input.addEventListener('input', () => {
    errorMsg.textContent = '';
  });

  // Load history from localStorage
  function loadHistory() {
    try {
      var data = localStorage.getItem(STORAGE_KEY);
      return data ? JSON.parse(data) : [];
    } catch {
      return [];
    }
  }

  function saveHistory(entry) {
    var history = loadHistory().filter(h => h.value !== entry.value);
    history.unshift(entry);
    if (history.length > MAX_HISTORY) history.pop();
    localStorage.setItem(STORAGE_KEY, JSON.stringify(history));
    renderHistory();
  }

  function renderHistory() {
    var history = loadHistory();
    if (history.length === 0) {
      historySection.style.display = 'none';
      return;
    }
    historySection.style.display = 'block';
    historyList.innerHTML = '';

    history.forEach(function(item) {
      var li = document.createElement('li');
      li.className = 'history-item';

      var leftDiv = document.createElement('div');
      leftDiv.className = 'history-left';

      var numSpan = document.createElement('span');
      numSpan.className = 'history-number';
      numSpan.textContent = item.type === 'phone' ? '+' + item.value : '@' + item.value;
      numSpan.addEventListener('click', function(e) {
        e.stopPropagation();
        input.value = item.type === 'phone' ? item.value : '@' + item.value;
        input.focus();
      });

      var timeSpan = document.createElement('span');
      timeSpan.className = 'history-time';
      var time = new Date(item.timestamp);
      timeSpan.textContent = time.toLocaleTimeString(locale, { hour: '2-digit', minute: '2-digit' });

      leftDiv.appendChild(numSpan);
      leftDiv.appendChild(timeSpan);

      var chatBtn = document.createElement('button');
      chatBtn.type = 'button';
      chatBtn.className = 'history-chat-btn';
      chatBtn.textContent = chatLabel;
      chatBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        var url = item.type === 'phone'
          ? 'https://t.me/+' + item.value
          : 'https://t.me/' + item.value;
        window.open(url, '_blank', 'noopener,noreferrer');
      });

      li.appendChild(leftDiv);
      li.appendChild(chatBtn);
      historyList.appendChild(li);
    });
  }

  // Clear history
  clearBtn.addEventListener('click', function() {
    localStorage.removeItem(STORAGE_KEY);
    renderHistory();
  });

  // Initial render
  renderHistory();

  // Form submit
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    errorMsg.textContent = '';

    var rawVal = input.value.trim();
    var message = messageInput.value.trim();

    var errorMessages = {
      username: lang === 'es' ? 'Ingresa un nombre de usuario válido (3+ caracteres)' : lang === 'pt' ? 'Digite um nome de usuário válido (3+ caracteres)' : lang === 'id' ? 'Silakan masukkan username yang valid (3+ karakter)' : 'Please enter a valid username (3+ characters)',
      phone: lang === 'es' ? 'Ingresa un número de teléfono válido' : lang === 'pt' ? 'Digite um número de telefone válido' : lang === 'id' ? 'Silakan masukkan nomor telepon yang valid' : 'Please enter a valid phone number',
      short: lang === 'es' ? 'El número de teléfono es demasiado corto' : lang === 'pt' ? 'O número de telefone é muito curto' : lang === 'id' ? 'Nomor telepon terlalu pendek' : 'Phone number is too short',
    };

    if (!rawVal) {
      errorMsg.textContent = errorMessages.username;
      input.focus();
      return;
    }

    if (isUsername(rawVal)) {
      // Username mode
      var username = cleanUsername(rawVal);
      if (username.length < 3) {
        errorMsg.textContent = errorMessages.username;
        input.focus();
        return;
      }
      saveHistory({ value: username, type: 'username', timestamp: Date.now() });
      var url = 'https://t.me/' + username;
      if (message) {
        url += '?text=' + encodeURIComponent(message);
      }
      window.open(url, '_blank');
    } else {
      // Phone mode
      var digits = cleanPhone(rawVal);
      if (digits.length < 7) {
        errorMsg.textContent = errorMessages.phone;
        input.focus();
        return;
      }
      if (digits.length < 10) {
        errorMsg.textContent = errorMessages.short;
        input.focus();
        return;
      }
      saveHistory({ value: digits, type: 'phone', timestamp: Date.now() });
      var url = 'https://t.me/+' + digits;
      if (message) {
        url += '?text=' + encodeURIComponent(message);
      }
      window.open(url, '_blank');
    }
  });

  // Keyboard shortcut
  input.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') {
      e.preventDefault();
      form.dispatchEvent(new Event('submit', { cancelable: true }));
    }
  });
</script>
