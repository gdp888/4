    overflow: hidden;
    border: 1px solid var(--border-color);
  }

  .faq-question {
    display: block;
    padding: 0.85rem 1rem;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--text-primary);
    cursor: pointer;
    list-style: none;
    transition: background 0.15s;
  }

  .faq-question::-webkit-details-marker {
    display: none;
