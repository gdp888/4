  }

  :global(.history-item:hover) {
    background: var(--border-color);
  }

  :global(.history-number) {
    font-weight: 500;
    font-size: 0.95rem;
    cursor: pointer;
  }

  :global(.history-number:hover) {
    color: var(--tg-primary);
  }

  :global(.history-time) {
    font-size: 0.72rem;
    color: var(--text-secondary);
  }

  :global(.history-chat-btn) {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.3rem 0.65rem;
    border-radius: 6px;
    background: var(--tg-primary);
    color: #fff;
    border: none;
    cursor: pointer;
    transition: background 0.2s;
    text-transform: none;
  }

  :global(.history-chat-btn:hover) {
    background: var(--tg-primary-dark);
  }

  :global(.history-left) {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  /* SEO Section */
  .seo-section {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-top: 1.5rem;
  }

  .seo-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .seo-heading {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .seo-text {
    font-size: 0.9rem;
    line-height: 1.75;
    color: var(--text-secondary);
  }

  .seo-features {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .feature-item {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .feature-icon {
    font-size: 1.4rem;
    line-height: 1;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .feature-title {
    font-size: 0.9rem;
