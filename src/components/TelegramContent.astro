---
import Layout from '../layouts/Layout.astro';
import { useTranslations, getLocalizedPath, getAlternateUrl } from '../i18n/utils';
import { languages, langCodes, type Lang } from '../i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ToolSidebar from './ToolSidebar.astro';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const otherLangs = (Object.keys(languages) as Lang[]).filter(l => l !== lang);

const localeMap: Record<Lang, string> = { en: 'en_US', es: 'es_ES', pt: 'pt_BR', id: 'id_ID', ru: 'ru_RU', ar: 'ar_SA', de: 'de_DE' };
const alternateLocales = otherLangs.map(l => localeMap[l]);

// Schema.org — FAQ data
const faqItems = [
  { q: t('tg.seo.faq.q1'), a: t('tg.seo.faq.a1') },
  { q: t('tg.seo.faq.q2'), a: t('tg.seo.faq.a2') },
  { q: t('tg.seo.faq.q3'), a: t('tg.seo.faq.a3') },
  { q: t('tg.seo.faq.q4'), a: t('tg.seo.faq.a4') },
  { q: t('tg.seo.faq.q5'), a: t('tg.seo.faq.a5') },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "OPN Chat Telegram",
      "url": getAlternateUrl(lang, 'telegram'),
      "description": t('tg.meta.description'),
      "applicationCategory": "CommunicationApplication",
      "operatingSystem": "Any",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "inLanguage": Object.keys(languages),
      "featureList": [
        t('tg.seo.why.feature1.title') + ': ' + t('tg.seo.why.feature1.desc'),
        t('tg.seo.why.feature2.title') + ': ' + t('tg.seo.why.feature2.desc'),
        t('tg.seo.why.feature3.title') + ': ' + t('tg.seo.why.feature3.desc'),
        t('tg.seo.why.feature4.title') + ': ' + t('tg.seo.why.feature4.desc'),
      ],
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "OPN Chat",
          "item": getAlternateUrl(lang, '')
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Telegram",
          "item": getAlternateUrl(lang, 'telegram')
        }
      ]
    }
  ]
};
---

<Layout title={t('tg.meta.title')} lang={lang} service="telegram">
  <Fragment slot="meta">
    <link rel="dns-prefetch" href="https://t.me" />
    <link rel="preconnect" href="https://t.me" crossorigin />
    <meta name="description" content={t('tg.meta.description')} />
    <meta name="keywords" content={t('tg.meta.keywords')} />
    <link rel="canonical" href={getAlternateUrl(lang, 'telegram')} />
    <meta property="og:title" content={t('tg.meta.og.title')} />
    <meta property="og:description" content={t('tg.meta.og.description')} />
    <meta property="og:url" content={getAlternateUrl(lang, 'telegram')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OPN Chat" />
    <meta property="og:locale" content={localeMap[lang]} />
    {alternateLocales.map(loc => (
      <meta property="og:locale:alternate" content={loc} />
    ))}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={t('tg.meta.twitter.title')} />
    <meta name="twitter:description" content={t('tg.meta.twitter.description')} />
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  </Fragment>

  <div class="page-layout">
    <ToolSidebar lang={lang} activeTool="telegram" accentColor="#2AABEE" />
    <main class="main-content">
      <div class="container">
    <!-- Header with nav -->
    <header class="site-header">
      <a href={getLocalizedPath(lang)} class="logo" aria-label="OPN Chat — Home">
        <span class="logo-text">OPN Chat</span>
        <svg viewBox="0 0 24 24" fill="currentColor" class="logo-icon" aria-hidden="true">
          <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
        </svg>
      </a>
      <LanguageSwitcher lang={lang} path="telegram" />
      <button type="button" class="theme-toggle" aria-label="Toggle theme" id="theme-toggle">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
    </header>

    <!-- Breadcrumbs -->
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={getLocalizedPath(lang)} class="bc-link">{t('bc.home')}</a>
      <span class="bc-sep">›</span>
      <span class="bc-current">{t('bc.telegram')}</span>
    </nav>

    <!-- Hero -->
    <div class="hero">
      <h1 class="title">{t('tg.header.description')}</h1>
    </div>

    <!-- Form -->
    <form id="telegram-form" class="form">
      <div class="input-group">
        <label for="tg-input" class="label">{t('tg.form.label.input')}</label>
        <span class="hint-plus">{t('tg.form.hint.plus')}</span>
        <div class="tg-input-group">
          <span class="tg-prefix">
            <svg viewBox="0 0 24 24" fill="currentColor" class="prefix-icon" aria-hidden="true">
              <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
            </svg>
          </span>
          <input
            type="text"
            id="tg-input"
            class="tg-input"
            placeholder={t('tg.form.placeholder.input')}
            autocomplete="off"
            required
          />
        </div>
        <span class="hint">{t('tg.form.hint')}</span>
        <span id="error-msg" class="error-msg" role="alert"></span>
      </div>

      <button type="submit" class="submit-btn" id="submit-btn">
        <svg viewBox="0 0 24 24" fill="currentColor" class="btn-icon">
          <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
        </svg>
        {t('tg.form.submit')}
      </button>

      <details class="message-details">
        <summary class="message-toggle">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="toggle-icon">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
          {t('form.addMessage')}
          <span class="optional">{t('form.label.optional')}</span>
        </summary>
        <div class="message-body">
          <textarea
            id="message"
            class="message-input"
            placeholder={t('form.placeholder.message')}
            rows="3"
          ></textarea>
        </div>
      </details>
    </form>

    <!-- History -->
    <div id="history-section" class="history-section" style="display:none;">
      <div class="history-header">
        <h3 class="history-title">{t('tg.history.title')}</h3>
        <button type="button" id="clear-history" class="clear-btn" aria-label="Clear history">{t('tg.history.clear')}</button>
      </div>
      <ul id="history-list" class="history-list"></ul>
    </div>

    <!-- SEO Content Section -->
    <section class="seo-section" aria-label="About OPN Chat Telegram">

      <article class="seo-block">
        <h2 class="seo-heading">{t('tg.seo.opn.heading')}</h2>
        <p class="seo-text" set:html={t('tg.seo.opn.text')} />
      </article>

      <article class="seo-block">
        <h2 class="seo-heading">{t('tg.seo.without.heading')}</h2>
        <p class="seo-text">{t('tg.seo.without.text')}</p>
      </article>

      <article class="seo-block">
        <h2 class="seo-heading">{t('tg.seo.how.heading')}</h2>
        <p class="seo-text">{t('tg.seo.how.text')}</p>
      </article>

      <article class="seo-block">
        <h2 class="seo-heading">{t('tg.seo.why.heading')}</h2>
        <div class="seo-features">
          <div class="feature-item">
            <span class="feature-icon">&#9889;</span>
            <div>
              <h3 class="feature-title">{t('tg.seo.why.feature1.title')}</h3>
              <p class="feature-desc">{t('tg.seo.why.feature1.desc')}</p>
            </div>
          </div>
          <div class="feature-item">
            <span class="feature-icon">&#128274;</span>
            <div>
              <h3 class="feature-title">{t('tg.seo.why.feature2.title')}</h3>
              <p class="feature-desc">{t('tg.seo.why.feature2.desc')}</p>
            </div>
          </div>
          <div class="feature-item">
            <span class="feature-icon">&#127760;</span>
            <div>
              <h3 class="feature-title">{t('tg.seo.why.feature3.title')}</h3>
              <p class="feature-desc">{t('tg.seo.why.feature3.desc')}</p>
            </div>
          </div>
          <div class="feature-item">
            <span class="feature-icon">&#128172;</span>
            <div>
              <h3 class="feature-title">{t('tg.seo.why.feature4.title')}</h3>
              <p class="feature-desc">{t('tg.seo.why.feature4.desc')}</p>
            </div>
          </div>
        </div>
      </article>

      <article class="seo-block">
        <h2 class="seo-heading">{t('tg.seo.cases.heading')}</h2>
        <p class="seo-text">{t('tg.seo.cases.text')}</p>
      </article>

      <article class="seo-block">
        <h2 class="seo-heading">{t('tg.seo.direct.heading')}</h2>
        <p class="seo-text">{t('tg.seo.direct.text')}</p>
      </article>

      <article class="seo-block">
        <h2 class="seo-heading">{t('tg.seo.faq.heading')}</h2>
        <div class="faq-list">
          <details class="faq-item">
            <summary class="faq-question">{t('tg.seo.faq.q1')}</summary>
            <p class="faq-answer">{t('tg.seo.faq.a1')}</p>
          </details>
          <details class="faq-item">
            <summary class="faq-question">{t('tg.seo.faq.q2')}</summary>
            <p class="faq-answer">{t('tg.seo.faq.a2')}</p>
          </details>
          <details class="faq-item">
            <summary class="faq-question">{t('tg.seo.faq.q3')}</summary>
            <p class="faq-answer">{t('tg.seo.faq.a3')}</p>
          </details>
          <details class="faq-item">
            <summary class="faq-question">{t('tg.seo.faq.q4')}</summary>
            <p class="faq-answer">{t('tg.seo.faq.a4')}</p>
          </details>
          <details class="faq-item">
            <summary class="faq-question">{t('tg.seo.faq.q5')}</summary>
            <p class="faq-answer">{t('tg.seo.faq.a5')}</p>
          </details>
        </div>
      </article>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <p class="footer-tagline">{t('tg.footer.tagline')}</p>
      <div class="footer-links">
        <a href={getLocalizedPath(lang, 'whatsapp')} class="footer-link">{t('tg.footer.whatsapp')}</a>
        <a href={getLocalizedPath('en', 'blog')} class="footer-link">{t('footer.blog')}</a>
        <a href={getLocalizedPath(lang, 'disclaimer')} class="footer-link">{t('footer.disclaimer.link')}</a>
        <a href={getLocalizedPath(lang, 'privacy')} class="footer-link">{t('footer.privacy.link')}</a>
        <a href={getLocalizedPath(lang, 'qr-code')} class="footer-link">{t('footer.qr.link')}</a>
        <a href={getLocalizedPath(lang, 'notepad')} class="footer-link">{t('footer.notepad.link')}</a>
        <a href={getLocalizedPath(lang, 'unit-converter')} class="footer-link">{t('footer.converter.link')}</a>
        <a href={getLocalizedPath(lang, 'wa-link')} class="footer-link">{t('footer.walink.link')}</a>
      </div>
      <p class="disclaimer-brief">{t('tg.footer.disclaimer.brief')}</p>
    </footer>
      </div>
    </main>
  </div>
</Layout>

<style>
  /* Telegram blue accent */
  :root {
    --tg-primary: #2AABEE;
    --tg-primary-dark: #229ED9;
    --tg-primary-light: #7EC8F2;
  }

  /* Page Layout — Sidebar + Main */
  .page-layout {
    display: flex;
    gap: 1.5rem;
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1.25rem;
    min-height: 100vh;
  }

  .main-content {
    flex: 1;
    min-width: 0;
  }

  .container {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 480px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Breadcrumbs */
  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .bc-link {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s;
  }

  .bc-link:hover {
    color: var(--opn-primary);
  }

  .bc-sep {
    color: var(--text-secondary);
    opacity: 0.5;
  }

  .bc-current {
    font-weight: 600;
    color: var(--text-primary);
  }

  /* Site Header */
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 0.75rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text-primary);
  }

  @media (max-width: 640px) {
    .logo { display: none; }
  }

  .logo-icon {
    width: 24px;
    height: 24px;
    color: var(--tg-primary);
    flex-shrink: 0;
  }

  .logo-text {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }




  .hero {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .title {
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    line-height: 1.2;
  }

  /* title is now pure description — brand lives in the logo */

  .form {
    background: var(--bg-secondary);
    border-radius: 16px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    box-shadow: var(--card-shadow), 0 4px 24px rgba(0, 0, 0, 0.15);
    border: 1px solid var(--border-color);
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .label {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: none;
    letter-spacing: 0.01em;
  }

  .optional {
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .tg-input-group {
    display: flex;
    align-items: stretch;
    border: 2px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg-input);
    transition: border-color 0.2s;
  }

  .tg-input-group:focus-within {
    border-color: var(--tg-primary);
  }

  .tg-prefix {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 0.75rem 0.85rem 1rem;
    background: var(--border-color);
    border-right: 2px solid var(--border-color);
    user-select: none;
    min-width: 44px;
    color: var(--tg-primary);
  }

  .prefix-icon {
    width: 20px;
    height: 20px;
  }

  .tg-input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--text-primary);
    padding: 0.85rem 1rem;
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    outline: none;
    width: 100%;
  }

  .tg-input::placeholder {
    color: var(--text-secondary);
    opacity: 0.7;
  }

  .hint {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .hint-plus {
    display: block;
    font-size: 0.8rem;
    color: var(--accent);
    opacity: 0.85;
    margin-bottom: 0.4rem;
    font-weight: 500;
  }

  .error-msg {
    font-size: 0.8rem;
    color: #ff6b6b;
    min-height: 1.2em;
    transition: opacity 0.2s;
  }

  .message-details {
    border: 1px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
  }

  .message-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-secondary);
    cursor: pointer;
    list-style: none;
    transition: background 0.15s;
  }

  .message-toggle::-webkit-details-marker {
    display: none;
  }

  .message-toggle::after {
    content: '\25BC';
    margin-left: auto;
    font-size: 0.65rem;
    transition: transform 0.2s;
    opacity: 0.5;
  }

  .message-details[open] .message-toggle::after {
    transform: rotate(180deg);
  }

  .message-toggle:hover {
    background: var(--border-color);
  }

  .toggle-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    opacity: 0.6;
  }

  .message-body {
    padding: 0 0.75rem 0.75rem 0.75rem;
  }

  .message-input {
    background: var(--bg-input);
    border: 2px solid var(--border-color);
    border-radius: 10px;
    color: var(--text-primary);
    padding: 0.75rem 1rem;
    font-size: 0.95rem;
    resize: vertical;
    min-height: 80px;
    width: 100%;
    transition: border-color 0.2s;
    outline: none;
  }

  .message-input:focus {
    border-color: var(--tg-primary);
  }

  .message-input::placeholder {
    color: var(--text-secondary);
    opacity: 0.7;
  }

  .submit-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background: var(--tg-primary-dark);
    color: #fff;
    border: none;
    border-radius: 12px;
    padding: 1rem 1.5rem;
    font-size: 1.05rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
    text-transform: none;
    letter-spacing: 0.01em;
  }

  .submit-btn:hover {
    background: #1a8bc4;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(42, 171, 238, 0.3);
  }

  .submit-btn:active {
    transform: translateY(0);
    box-shadow: none;
  }

  .submit-btn:focus-visible {
    outline: 2px solid var(--tg-primary);
    outline-offset: 2px;
  }

  .btn-icon {
    width: 22px;
    height: 22px;
  }

  .history-section {
    background: var(--bg-secondary);
    border-radius: 16px;
    padding: 1.25rem;
    border: 1px solid var(--border-color);
    box-shadow: var(--card-shadow);
  }

  .history-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .history-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .clear-btn {
