};

// --- State ---
let currentOutput = '';
let recentEmojis = JSON.parse(localStorage.getItem('tc-recent-emojis') || '[]');

// --- DOM Elements ---
const inputEl = document.getElementById('tc-input');
const outputPreview = document.getElementById('output-preview');
const charCountNum = document.getElementById('char-count-num');
const copyBtn = document.getElementById('output-copy');
const clearBtn = document.getElementById('output-clear');
const tabBtns = document.querySelectorAll('.tab-btn');
const tabContents = document.querySelectorAll('.tab-content');

// --- Tab Switching ---
tabBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    const targetTab = btn.getAttribute('data-tab');
    tabBtns.forEach(b => b.classList.remove('active'));
    tabContents.forEach(c => c.classList.remove('active'));
    btn.classList.add('active');
    const targetContent = document.getElementById('tab-' + targetTab);
    if (targetContent) targetContent.classList.add('active');
  });
});

// --- Styles Rendering ---
function renderStyles(text) {
  const container = document.getElementById('styles-results');
  if (!container) return;
  
  if (!text.trim()) {
    container.innerHTML = '<p class="empty-state">Введите текст выше чтобы увидеть стили</p>';
    return;
  }

  container.innerHTML = Object.keys(styleMaps).map(styleName => {
    const map = styleMaps[styleName];
    const label = styleLabels[styleName] || styleName;
    const output = convertText(text, map);
    return `
      <div class="style-card" data-text="${output.replace(/"/g, '&quot;')}">
        <span class="style-name">${label}</span>
        <span class="style-output">${output}</span>
        <button class="style-copy-btn" title="Копировать">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
        </button>
      </div>
    `;
  }).join('');

  container.querySelectorAll('.style-card').forEach(card => {
    card.addEventListener('click', () => {
      const text = card.getAttribute('data-text') || '';
      appendToOutput(text);
    });
  });
}

// --- Emoji Rendering ---
function renderEmojis(category, search) {
  const grid = document.getElementById('emoji-grid');
  if (!grid) return;

  let emojis = category ? (emojiData[category] || []) : Object.values(emojiData).flat();
  
  if (search) {
    const q = search.toLowerCase();
    emojis = emojis.filter(e => e.keywords.includes(q));
  }

  if (emojis.length === 0) {
    grid.innerHTML = '<p class="empty-state">Эмодзи не найдены</p>';
    return;
  }

  grid.innerHTML = emojis.map(e => 
    `<button class="emoji-item" data-emoji="${e.emoji}" title="${e.keywords}">${e.emoji}</button>`
  ).join('');

  grid.querySelectorAll('.emoji-item').forEach(item => {
    item.addEventListener('click', () => {
      const emoji = item.getAttribute('data-emoji') || '';
      appendToOutput(emoji);
      addRecentEmoji(emoji);
    });
  });
}

function renderRecentEmojis() {
  const container = document.getElementById('recent-emojis');
  if (!container) return;
  
  if (recentEmojis.length === 0) {
    container.parentElement.style.display = 'none';
    return;
  }
  
  container.parentElement.style.display = '';
  container.innerHTML = recentEmojis.slice(0, 10).map(emoji =>
    `<button class="recent-emoji" data-emoji="${emoji}">${emoji}</button>`
  ).join('');

  container.querySelectorAll('.recent-emoji').forEach(item => {
    item.addEventListener('click', () => {
      const emoji = item.getAttribute('data-emoji') || '';
      appendToOutput(emoji);
    });
  });
}

function addRecentEmoji(emoji) {
  recentEmojis = recentEmojis.filter(e => e !== emoji);
  recentEmojis.unshift(emoji);
  recentEmojis = recentEmojis.slice(0, 20);
  localStorage.setItem('tc-recent-emojis', JSON.stringify(recentEmojis));
  renderRecentEmojis();
}

// --- Templates Rendering ---
function renderTemplates(category) {
  const grid = document.getElementById('templates-grid');
  if (!grid) return;

  const templates = templatesData[category] || [];
  
  grid.innerHTML = templates.map(t => `
    <div class="template-card" data-text="${t.text.replace(/"/g, '&quot;')}">
      <span class="template-text">${t.text}</span>
      <span class="template-desc">${t.desc}</span>
      <button class="template-use-btn">Использовать</button>
    </div>
  `).join('');

  grid.querySelectorAll('.template-card').forEach(card => {
    card.querySelector('.template-use-btn').addEventListener('click', () => {
      const text = card.getAttribute('data-text') || '';
      appendToOutput(text);
    });
    card.addEventListener('click', (e) => {
      if (!(e.target).closest('.template-use-btn')) {
        const text = card.getAttribute('data-text') || '';
        navigator.clipboard.writeText(text).then(() => {
          const btn = card.querySelector('.template-use-btn');
          if (btn) { btn.textContent = 'Скопировано!'; setTimeout(() => btn.textContent = 'Использовать', 1500); }
        });
      }
    });
  });
}

// --- Symbols Rendering ---
function renderSymbols(category) {
  const grid = document.getElementById('symbols-grid');
  if (!grid) return;

  const symbols = symbolsData[category] || [];
  
  grid.innerHTML = symbols.map(s => 
    `<button class="symbol-item" data-symbol="${s}">${s}</button>`
  ).join('');

  grid.querySelectorAll('.symbol-item').forEach(item => {
    item.addEventListener('click', () => {
      const sym = item.getAttribute('data-symbol') || '';
      appendToOutput(sym);
    });
  });
}

// --- Output Management ---
function appendToOutput(text) {
  currentOutput += text;
  updateOutputPreview();
}

function updateOutputPreview() {
  if (outputPreview) outputPreview.textContent = currentOutput;
  if (charCountNum) charCountNum.textContent = String(currentOutput.length);
}

function clearOutput() {
  currentOutput = '';
  updateOutputPreview();
}

async function copyOutput() {
  if (!currentOutput) return;
  try {
    await navigator.clipboard.writeText(currentOutput);
    const span = copyBtn.querySelector('span');
    if (copyBtn && span) {
      copyBtn.classList.add('copied');
      span.textContent = 'Скопировано!';
      setTimeout(() => {
        copyBtn.classList.remove('copied');
        span.textContent = 'Копировать';
      }, 1500);
    }
  } catch (err) {
    console.error('Copy failed:', err);
  }
}

// --- Event Listeners ---
if (inputEl) {
  inputEl.addEventListener('input', () => renderStyles(inputEl.value));
  if (inputEl.value) renderStyles(inputEl.value);
  else renderStyles('');
}

if (copyBtn) copyBtn.addEventListener('click', copyOutput);
if (clearBtn) clearBtn.addEventListener('click', clearOutput);

// Emoji categories
document.querySelectorAll('.emoji-cat').forEach(cat => {
  cat.addEventListener('click', () => {
    document.querySelectorAll('.emoji-cat').forEach(c => c.classList.remove('active'));
    cat.classList.add('active');
    renderEmojis(cat.getAttribute('data-cat') || '');
  });
});

// Emoji search
const emojiSearch = document.getElementById('emoji-search');
if (emojiSearch) {
  emojiSearch.addEventListener('input', () => {
    renderEmojis('', emojiSearch.value);
  });
}

// Template categories
document.querySelectorAll('.template-cat').forEach(cat => {
  cat.addEventListener('click', () => {
    document.querySelectorAll('.template-cat').forEach(c => c.classList.remove('active'));
    cat.classList.add('active');
    renderTemplates(cat.getAttribute('tcat') || '');
  });
});

// Symbol categories
document.querySelectorAll('.symbol-cat').forEach(cat => {
  cat.addEventListener('click', () => {
    document.querySelectorAll('.symbol-cat').forEach(c => c.classList.remove('active'));
    cat.classList.add('active');
    renderSymbols(cat.getAttribute('scat') || '');
  });
});

// --- Initialize All ---
renderStyles('');
renderEmojis('smileys');
renderRecentEmojis();
renderTemplates('greeting');
renderSymbols('stars');

// FAQ Toggle
document.querySelectorAll('.faq-question').forEach(btn => {
  btn.addEventListener('click', () => {
    const item = btn.closest('.faq-item');
    if (item) item.classList.toggle('open');
    btn.setAttribute('aria-expanded', item?.classList.contains('open') ? 'true' : 'false');
  });
});
</script>

