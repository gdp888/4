---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';
import { getRelativeLocaleUrl, getAbsoluteLocaleUrl } from 'astro:i18n';
import { languages, type Lang } from '../i18n/ui';
import SiteHeader from './SiteHeader.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import SEOHead from './SEOHead.astro';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const faqItems = [
  { q: t('tc.faq.q1'), a: t('tc.faq.a1') },
  { q: t('tc.faq.q2'), a: t('tc.faq.a2') },
  { q: t('tc.faq.q3'), a: t('tc.faq.a3') },
  { q: t('tc.faq.q4'), a: t('tc.faq.a4') },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": t('tc.heading'),
      "url": getAbsoluteLocaleUrl(lang, 'text-composer'),
      "description": t('tc.meta.description'),
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Any",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "inLanguage": Object.keys(languages),
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": { "@type": "Answer", "text": item.a }
      }))
    }
  ]
};
---

<Layout title={t('tc.meta.title')} lang={lang} service="fancy-text">
  <Fragment slot="meta">
  <SEOHead
    lang={lang}
    description={t('tc.meta.description')}
    canonicalUrl={getAbsoluteLocaleUrl(lang, 'text-composer')}
    ogTitle={t('tc.meta.og.title')}
    ogDescription={t('tc.meta.og.description')}
    ogUrl={getAbsoluteLocaleUrl(lang, 'text-composer')}
    schema={pageSchema}
    extraMeta={`<meta name="keywords" content="${t('tc.meta.keywords')}" /><meta name="twitter:card" content="summary" /><meta name="twitter:title" content="${t('tc.meta.twitter.title')}" /><meta name="twitter:description" content="${t('tc.meta.twitter.description')}" />`}
/>
</Fragment>

<div class="container">
  <SiteHeader lang={lang} path="fancy-text" activeTool="fancy-text" />
  <Breadcrumbs lang={lang} items={[{ label: t('bc.home'), href: getRelativeLocaleUrl(lang) }, { label: t('bc.textcomposer') }]} />

  <!-- Hero -->
  <div class="hero">
    <h1 class="title">{t('tc.heading')}</h1>
    <p class="subtitle">{t('tc.subheading')}</p>
    <p class="privacy-badge">{t('tc.privacy.badge')}</p>
  </div>

  <!-- Main Tool -->
  <div class="tc-tool">
    <!-- Input Area -->
    <div class="input-section">
      <label for="tc-input" class="input-label">{t('tc.input.label')}</label>
      <textarea id="tc-input" class="input-field" placeholder={t('tc.input.placeholder')} maxlength="200" rows="2"></textarea>
      <p class="input-hint">{t('tc.input.hint')}</p>
    </div>

    <!-- Tabs -->
    <div class="tabs-container">
      <button class="tab-btn active" data-tab="styles">✨ {t('tc.tab.styles')}</button>
      <button class="tab-btn" data-tab="emoji">😀 {t('tc.tab.emoji')}</button>
      <button class="tab-btn" data-tab="templates">📋 {t('tc.tab.templates')}</button>
      <button class="tab-btn" data-tab="symbols">☆ {t('tc.tab.symbols')}</button>
    </div>

    <!-- Tab Content: Styles -->
    <div id="tab-styles" class="tab-content active">
      <div id="styles-results" class="results-grid"></div>
    </div>

    <!-- Tab Content: Emoji -->
    <div id="tab-emoji" class="tab-content">
      <div class="emoji-search-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="emoji-search-icon"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="emoji-search" class="emoji-search-input" placeholder={t('tc.emoji.search')} autocomplete="off" />
      </div>
      <div class="emoji-categories">
        <button class="emoji-cat active" data-cat="smileys">😊</button>
        <button class="emoji-cat" data-cat="people">👤</button>
        <button class="emoji-cat" data-cat="animals">🐾</button>
        <button class="emoji-cat" data-cat="food">🍕</button>
        <button class="emoji-cat" data-cat="activities">⚽</button>
        <button class="emoji-cat" data-cat="travel">✈️</button>
        <button class="emoji-cat" data-cat="objects">💡</button>
        <button class="emoji-cat" data-cat="symbols">❤️</button>
        <button class="emoji-cat" data-cat="flags">🏳️</button>
      </div>
      <div id="emoji-grid" class="emoji-grid"></div>
      <div id="emoji-recent" class="emoji-recent">
        <span class="recent-label">{t('tc.emoji.recent')}</span>
        <div id="recent-emojis" class="recent-list"></div>
      </div>
    </div>

    <!-- Tab Content: Templates -->
    <div id="tab-templates" class="tab-content">
      <div class="template-categories">
        <button class="template-cat active" data-tcat="greeting">👋 {t('tc.template.cat.greeting')}</button>
        <button class="template-cat" data-tcat="love">❤️ {t('tc.template.cat.love')}</button>
        <button class="template-cat" data-tcat="business">💼 {t('tc.template.cat.business')}</button>
        <button class="template-cat" data-tcat="hype">🔥 {t('tc.template.cat.hype')}</button>
        <button class="template-cat" data-tcat="bio">✍️ {t('tc.template.cat.bio')}</button>
        <button class="template-cat" data-tcat="holiday">🎉 {t('tc.template.cat.holiday')}</button>
      </div>
      <div id="templates-grid" class="templates-grid"></div>
    </div>

    <!-- Tab Content: Symbols -->
    <div id="tab-symbols" class="tab-content">
      <div class="symbol-categories">
        <button class="symbol-cat active" data-scat="stars">★ {t('tc.symbol.cat.stars')}</button>
        <button class="symbol-cat" data-scat="arrows">→ {t('tc.symbol.cat.arrows')}</button>
        <button class="symbol-cat" data-scat="numbers">① {t('tc.symbol.cat.numbers')}</button>
        <button class="symbol-cat" data-scat="shapes">■ {t('tc.symbol.cat.shapes')}</button>
        <button class="symbol-cat" data-scat="decorative">❀ {t('tc.symbol.cat.decorative')}</button>
        <button class="symbol-cat" data-scat="math">∑ {t('tc.symbol.cat.math')}</button>
      </div>
      <div id="symbols-grid" class="symbols-grid"></div>
    </div>

    <!-- Output Preview -->
    <div class="output-section">
      <div class="output-header">
        <span class="output-label">{t('tc.output.label')}</span>
        <div class="output-actions">
          <button id="output-copy" class="action-btn copy-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
            <span>{t('tc.btn.copy')}</span>
          </button>
          <button id="output-clear" class="action-btn clear-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v1"/></svg>
            <span>{t('tc.btn.clear')}</span>
          </button>
        </div>
      </div>
      <div id="output-preview" class="output-preview"></div>
      <p class="char-count"><span id="char-count-num">0</span> {t('tc.output.chars')}</p>
    </div>
  </div>

  <!-- FAQ Section -->
  <section class="faq-section">
    <h2 class="section-title">{t('tc.seo.faq.heading')}</h2>
    <div class="faq-list">
      {faqItems.map(item => (
        <div class="faq-item">
          <button type="button" class="faq-question" aria-expanded="false">
            <span class="faq-q-text">{item.q}</span>
            <svg class="faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="faq-answer">
            <p class="faq-a-text">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
</div>
</Layout>

