---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { type Lang } from '../i18n/ui';

interface BreadcrumbItem {
  label: string;
  href?: string;  // undefined = current page (no link)
}

export interface Props {
  lang: Lang;
  items: BreadcrumbItem[];
}

const { lang, items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  {items.map((item, i) => (
    i < items.length - 1 && item.href
      ? <a href={item.href} class="bc-link">{item.label}</a>
      : <span class="bc-current">{item.label}</span>
  ))}
  {items.map((item, i) => (
    i < items.length - 1 && <span class="bc-sep">›</span>
  ))}
</nav>

<style>
  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .bc-link {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s;
  }

  .bc-link:hover {
    color: var(--opn-primary);
  }

  .bc-sep {
    color: var(--text-secondary);
    opacity: 0.5;
  }

  .bc-current {
    font-weight: 600;
    color: var(--text-primary);
  }
</style>
