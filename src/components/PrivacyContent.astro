---
import Layout from '../layouts/Layout.astro';
import { useTranslations, getLocalizedPath, getAlternateUrl } from '../i18n/utils';
import { languages, langCodes, type Lang } from '../i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const otherLangs = (Object.keys(languages) as Lang[]).filter(l => l !== lang);

const localeMap: Record<Lang, string> = { en: 'en_US', es: 'es_ES', pt: 'pt_BR', id: 'id_ID', ru: 'ru_RU', ar: 'ar_SA', de: 'de_DE' };
const alternateLocales = otherLangs.map(l => localeMap[l]);

const privacySchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "name": t('privacy.heading'),
      "url": getAlternateUrl(lang, 'privacy'),
      "description": t('privacy.meta.description'),
      "isPartOf": {
        "@type": "WebSite",
        "name": "OPN Chat",
        "url": "https://opnchat.net/"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "OPN Chat",
          "item": getAlternateUrl(lang, '')
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('privacy.heading'),
          "item": getAlternateUrl(lang, 'privacy')
        }
      ]
    }
  ]
};
---

<Layout title={t('privacy.meta.title')} lang={lang} service="privacy">
  <Fragment slot="meta">
    <meta name="description" content={t('privacy.meta.description')} />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={getAlternateUrl(lang, 'privacy')} />
    <script type="application/ld+json" set:html={JSON.stringify(privacySchema)} />
  </Fragment>

  <main class="container">
    <!-- Header with nav -->
    <header class="site-header">
      <a href={getLocalizedPath(lang, '')} class="logo" aria-label="OPN Chat — Home">
        <span class="logo-text">OPN Chat</span>
        <svg viewBox="0 0 24 24" fill="currentColor" class="logo-icon" aria-hidden="true">
          <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
        </svg>
      </a>
      <LanguageSwitcher lang={lang} path="privacy" />
      <button type="button" class="theme-toggle" aria-label="Toggle theme" id="theme-toggle">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
    </header>

    <!-- Breadcrumbs -->
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={getLocalizedPath(lang)} class="bc-link">{t('bc.home')}</a>
      <span class="bc-sep">›</span>
      <span class="bc-current">{t('bc.privacy')}</span>
    </nav>

    <!-- Page heading -->
    <div class="hero">
      <h1 class="title">{t('privacy.heading')}</h1>
      <p class="last-updated">{t('privacy.lastUpdated')}</p>
    </div>

    <!-- Privacy Sections -->
    <article class="disclaimer-block">
      <h2 class="section-heading">{t('privacy.intro.heading')}</h2>
      <p class="section-text">{t('privacy.intro.text')}</p>
    </article>

    <article class="disclaimer-block">
      <h2 class="section-heading">{t('privacy.nodata.heading')}</h2>
      <p class="section-text">{t('privacy.nodata.text')}</p>
    </article>

    <article class="disclaimer-block">
      <h2 class="section-heading">{t('privacy.cloudflare.heading')}</h2>
      <p class="section-text">{t('privacy.cloudflare.text')}</p>

      <div class="sub-sections">
        <div class="sub-section">
          <h3 class="sub-heading">{t('privacy.cloudflare.nocookie.heading')}</h3>
          <p class="section-text">{t('privacy.cloudflare.nocookie.text')}</p>
        </div>

        <div class="sub-section">
          <h3 class="sub-heading">{t('privacy.cloudflare.nocross.heading')}</h3>
          <p class="section-text">{t('privacy.cloudflare.nocross.text')}</p>
        </div>

        <div class="sub-section">
          <h3 class="sub-heading">{t('privacy.cloudflare.aggregated.heading')}</h3>
          <p class="section-text">{t('privacy.cloudflare.aggregated.text')}</p>
        </div>

        <div class="sub-section">
          <h3 class="sub-heading">{t('privacy.cloudflare.nopii.heading')}</h3>
          <p class="section-text">{t('privacy.cloudflare.nopii.text')}</p>
        </div>

        <p class="section-text highlight-text">{t('privacy.cloudflare.conclusion.text')}</p>
      </div>
    </article>

    <article class="disclaimer-block">
      <h2 class="section-heading">{t('privacy.localstorage.heading')}</h2>
      <p class="section-text">{t('privacy.localstorage.text')}</p>
    </article>

    <article class="disclaimer-block">
      <h2 class="section-heading">{t('privacy.thirdparty.heading')}</h2>
      <p class="section-text">{t('privacy.thirdparty.text')}</p>
    </article>

    <article class="disclaimer-block">
      <h2 class="section-heading">{t('privacy.children.heading')}</h2>
      <p class="section-text">{t('privacy.children.text')}</p>
    </article>

    <article class="disclaimer-block">
      <h2 class="section-heading">{t('privacy.rights.heading')}</h2>
      <p class="section-text">{t('privacy.rights.text')}</p>
    </article>

    <article class="disclaimer-block">
      <h2 class="section-heading">{t('privacy.changes.heading')}</h2>
      <p class="section-text">{t('privacy.changes.text')}</p>
    </article>

    <!-- Back Link -->
    <a href={getLocalizedPath(lang, '')} class="back-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="back-icon">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
      {t('privacy.back')}
    </a>
    <a href={getLocalizedPath(lang, 'unit-converter')} class="back-link">
      {t('footer.converter.link')}
    </a>
  </main>
</Layout>

<style>
  .container {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 640px;
    padding: 2rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Breadcrumbs */
  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .bc-link {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s;
  }

  .bc-link:hover {
    color: var(--opn-primary);
  }

  .bc-sep {
    color: var(--text-secondary);
    opacity: 0.5;
  }

  .bc-current {
    font-weight: 600;
    color: var(--text-primary);
  }

  /* Site Header */
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 0.75rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text-primary);
  }

  @media (max-width: 640px) {
    .logo { display: none; }
  }

  .logo-icon {
    width: 24px;
    height: 24px;
    color: var(--opn-primary);
    flex-shrink: 0;
  }

  .logo-text {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }


  .hero {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .title {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, #25D366, #6fe89d);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .last-updated {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .disclaimer-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .section-heading {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .section-text {
    font-size: 0.9rem;
    line-height: 1.75;
    color: var(--text-secondary);
  }

  .section-text :global(a) {
    color: var(--opn-primary-light);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .section-text :global(a:hover) {
    opacity: 0.8;
  }

  /* Sub-sections within Cloudflare block */
  .sub-sections {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 0.75rem;
    padding-left: 1rem;
    border-left: 3px solid var(--opn-primary);
  }

  .sub-section {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .sub-heading {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .highlight-text {
    margin-top: 0.5rem;
    padding: 0.75rem 1rem;
    background: var(--bg-secondary);
    border-radius: 8px;
    border: 1px solid var(--border-color);
    font-style: italic;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--opn-primary);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    padding: 0.75rem 1.25rem;
    border-radius: 12px;
    border: 1.5px solid var(--border-color);
    background: var(--bg-secondary);
    transition: all 0.2s;
    margin-top: 0.5rem;
  }

  .back-link:hover {
    border-color: var(--opn-primary);
    background: var(--bg-input);
    transform: translateY(-1px);
  }

  .back-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  @media (max-width: 520px) {
    .container {
      padding: 1.25rem 1rem;
    }
    .title {
      font-size: 1.5rem;
    }
    .site-header {
      justify-content: center;
    }
    .section-heading {
      font-size: 1rem;
    }
    .section-text {
      font-size: 0.85rem;
    }
    .sub-heading {
      font-size: 0.9rem;
    }
    .sub-sections {
      padding-left: 0.75rem;
    }
  }
</style>

<script>
</script>
