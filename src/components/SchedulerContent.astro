---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { languages, type Lang } from '../i18n/ui';
import SiteHeader from './SiteHeader.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import SEOHead from './SEOHead.astro';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Schema.org
const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": t('meta.title'),
  "url": getAbsoluteLocaleUrl(lang, 'scheduler'),
  "description": t('meta.description'),
  "applicationCategory": "UtilityApplication",
  "operatingSystem": "Any",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    t('feature1.title') + ': ' + t('feature1.desc'),
    t('feature2.title') + ': ' + t('feature2.desc'),
    t('feature3.title') + ': ' +('feature3.desc'),
  ]
};
---

<SEOHead
  title={t('meta.title')}
  description={t('meta.description')}
  lang={lang}
  path="/scheduler"
/>
<Layout title={t('meta.title')} lang={lang} service="whatsapp">
  <SiteHeader 
    title={t('header.title')}
    subtitle={t('header.subtitle')}
    lang={lang}
  />
  
  <Breadcrumbs
    items={[
      { label: t('bc.home'), href: '/' },
      { label: t('bc.scheduler'), href: '/scheduler' }
    ]}
    lang={lang}
  />

  <!-- Main Content -->
  <main class="scheduler-container">
    <!-- How It Works -->
    <section class="how-it-works">
      <h2 class="section-title">{t('howItWorks.title')}</h2>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-number">1</div>
          <h3>{t('howItWorks.step1.title')}</h3>
          <p>{t('howItWorks.step1.desc')}</p>
        </div>
        <div class="step-card">
          <div class="step-number">2</div>
          <h3>{t('howItWorks.step2.title')}</h3>
          <p>{t('howItWorks.step2.desc')}</p>
        </div>
        <div class="step-card">
          <div class="step-number">3</div>
          <h3>{t('howItWorks.step3.title')}</h3>
          <p>{t('howItWorks.step3.desc')}</p>
        </div>
      </div>
    </section>

    <!-- Scheduler Form -->
    <section class="scheduler-form-section">
      <h2 class="section-title">{t('form.title')}</h2>
      
      <form id="scheduler-form" class="scheduler-form">
        <!-- Phone Number Input -->
        <div class="form-group">
          <label for="phone" class="form-label">{t('form.phone.label')}</label>
          <input 
            type="tel" 
            id="phone" 
            name="phone" 
            class="form-input phone-input"
            placeholder={t('form.phone.placeholder')}
            autocomplete="tel"
            inputmode="numeric"
            required
          />
          <span class="form-hint">{t('form.phone.hint')}</span>
        </div>

        <!-- Message Input -->
        <div class="form-group">
          <label for="message" class="form-label">{t('form.message.label')} <span class="optional">{t('form.message.optional')}</span></label>
          <textarea 
            id="message" 
            name="message" 
            class="form-input message-textarea"
            placeholder={t('form.message.placeholder')}
            rows="4"
            maxlength="1000"
          ></textarea>
          <div class="char-count"><span id="char-count">0</span>/1000</div>
        </div>

        <!-- Date & Time Inputs -->
        <div class="datetime-row">
          <div class="form-group datetime-group">
            <label for="date" class="form-label">{t('form.date.label')}</label>
            <input 
              type="date" 
              id="date" 
              name="date" 
              class="form-input date-input"
              required
            />
          </div>
          <div class="form-group datetime-group">
            <label for="time" class="form-label">{t('form.time.label')}</label>
            <input 
              type="time" 
              id="time" 
              name="time" 
              class="form-input time-input"
              required
            />
          </div>
        </div>

        <!-- Timezone Info -->
        <div class="timezone-info">
          <svg class="timezone-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 6v6l4 2"/>
          </svg>
          <span id="timezone-display"></span>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="submit-btn" id="submit-btn">
          <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
                <line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
          {t('form.submit')}
        </button>
      </form>

      <!-- Success Message (hidden by default) -->
      <div id="success-message" class="success-message hidden">
        <div class="success-icon">✓</div>
        <h3>{t('success.title')}</h3>
        <p id="success-details"></p>
        <div class="task-link-section">
          <p>{t('success.linkText')}</p>
          <a id="task-link" href="#" target="_blank" rel="noopener" class="task-link"></a>
          <button id="copy-link-btn" class="copy-btn" data-copy={t('success.copy')}>
            {t('success.copyLink')}
          </button>
        </div>
        <button id="schedule-another" class="secondary-btn">{t('success.another')}</button>
      </div>
    </section>

    <!-- Scheduled Tasks List -->
    <section class="tasks-list-section" id="tasks-section">
      <h2 class="section-title">{t('tasks.title')}</h2>
      <div id="tasks-list" class="tasks-list">
        <div class="empty-state">
          <svg class="empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
            <line x1="9" y1="16" x2="15" y2="16"/>
          </svg>
          <p>{t('tasks.empty')}</p>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="features-section">
      <h2 class="section-title">{t('features.title')}</h2>
      <div class="features-grid">
        <div class="feature-item">
          <div class="feature-icon">🕐</div>
          <h3>{t('feature1.title')}</h3>
          <p>{t('feature1.desc')}</p>
        </div>
        <div class="feature-item">
          <div class="feature-icon">🔗</div>
          <h3>{t('feature2.title')}</h3>
          <p>{t('feature2.desc')}</p>
        </div>
        <div class="feature-item">
          <div class="feature-icon">🔒</div>
          <h3>{t('feature3.title')}</h3>
          <p>{t('feature3.desc')}</p>
        </div>
        <div class="feature-item">
          <div class="feature-icon">🌍</div>
          <h3>{t('feature4.title')}</h3>
          <p>{t('feature4.desc')}</p>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-section">
      <h2 class="section-title">{t('faq.title')}</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary>{t('faq.q1.q')}</summary>
          <p>{t('faq.q1.a')}</p>
        </details>
        <details class="faq-item">
          <summary>{t('faq.q2.q')}</summary>
          <p>{t('faq.q2.a')}</p>
        </details>
        <details class="faq-item">
          <summary>{t('faq.q3.q')}</summary>
          <p>{t('faq.q3.a')}</p>
        </details>
        <details class="faq-item">
          <summary>{t('faq.q4.q')}</summary>
          <p>{t('faq.q4.a')}</p>
        </details>
      </div>
    </section>
  </main>

  <!-- SEO Content -->
  <section class="seo-section">
    <h2>{t('seo.contentTitle')}</h2>
    <p>{t('seo.content1')}</p>
    <p>{t('seo.content2')}</p>
    <p>{t('seo.content3')}</p>
  </section>
</Layout>

<script define:vars={{ lang }}>
  // DOM Elements
  const form = document.getElementById('scheduler-form');
  const phoneInput = document.getElementById('phone');
  const messageInput = document.getElementById('message');
  const dateInput = document.getElementById('date');
  const timeInput = document.getElementById('time');
  const charCount = document.getElementById('char-count');
  const submitBtn = document.getElementById('submit-btn');
  const successMessage = document.getElementById('success-message');
  const successDetails = document.getElementById('success-details');
  const taskLink = document.getElementById('task-link');
  const copyLinkBtn = document.getElementById('copy-link-btn');
  const scheduleAnotherBtn = document.getElementById('schedule-another');
  const tasksList = document.getElementById('tasks-list');
  const timezoneDisplay = document.getElementById('timezone-display');

  // Set minimum date to today
  const today = new Date().toISOString().split('T')[0];
  dateInput.setAttribute('min', today);

  // Display user's timezone
  const userTimezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
  timezoneDisplay.textContent = `Timezone: ${userTimezone}`;

  // Character counter
  messageInput.addEventListener('input', () => {
    charCount.textContent = messageInput.value.length;
  });

  // Format phone number as user types
  phoneInput.addEventListener('input', (e) => {
    let value = e.target.value.replace(/\D/g, '');
    if (value.length > 15) value = value.slice(0, 15);
    e.target.value = value;
  });

  // Generate unique task ID client-side
  function generateTaskId() {
    const timestamp = Date.now().toString(36);
    const randomPart = Math.random().toString(36).substring(2, 10);
    return `task_${timestamp}_${randomPart}`;
  }

  // Form submission - with localStorage fallback
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const phone = phoneInput.value.replace(/\D/g, '');
    const message = messageInput.value.trim();
    const date = dateInput.value;
    const time = timeInput.value;

    // Validate
    if (phone.length < 8 || phone.length > 15) {
      alert(lang === 'ru' ? 'Введите корректный номер телефона' : 'Please enter a valid phone number');
      return;
    }

    const scheduledDateTime = new Date(`${date}T${time}`);
    if (scheduledDateTime <= new Date()) {
      alert(lang === 'ru' ? 'Выберите будущую дату и время' : 'Please select a future date and time');
      return;
    }

    // Show loading state
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="spinner"></span> Scheduling...';

    // Create task object (used for both API and localStorage)
    const taskId = generateTaskId();
    const task = {
      id: taskId,
      phone: phone,
      message: message,
      scheduledFor: scheduledDateTime.toISOString(),
      timezone: userTimezone,
      lang: lang,
      status: 'scheduled',
      createdAt: new Date().toISOString(),
      whatsappLink: `https://wa.me/${phone}${message ? '?text=' + encodeURIComponent(message) : ''}`
    };

    try {
      // Try API first (for future server-side implementation)
      const response = await fetch('/api/scheduler', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          phone,
          message,
          scheduledFor: scheduledDateTime.toISOString(),
          timezone: userTimezone,
          lang
        })
      });

      if (response.ok) {
        const data = await response.json();
        if (data.success) {
          // Use server-returned task data
          Object.assign(task, data.task);
        }
      }
    } catch (error) {
      // API not available - continue with localStorage only
      console.log('API not available, using localStorage mode');
    }

    // Save to localStorage (always, as backup/source of truth for now)
    saveTaskLocally(task);

    // Show success
    form.classList.add('hidden');
    successMessage.classList.remove('hidden');
    
    const formattedDate = new Date(task.scheduledFor).toLocaleString(lang);
    successDetails.textContent = `+${task.phone.replace(/(\d{1,3})(\d{3})(\d{3})(\d{2,})/, '$1 $2 $3 $4')} at ${formattedDate}`;
    
    taskLink.href = `/scheduler/task/${task.id}`;
    taskLink.textContent = `${window.location.origin}/scheduler/task/${task.id}`;
    
    // Refresh tasks list
    loadTasks();

    submitBtn.disabled = false;
    submitBtn.innerHTML = `<svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="3" y="4" width="18" height="18" rx="2"/>
      <line x1="16" y1="2" x2="16" y="6"/>
      <line x1="8" y1="2" x2="8" y="6"/>
      <line x1="3" y1="10" x2="21" y="10"/>
    </svg> ${lang === 'ru' ? 'Запланировать сообщение' : 'Schedule Message'}`;
  });

  // Copy link button
  copyLinkBtn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(taskLink.href);
      copyLinkBtn.textContent = 'Copied!';
      setTimeout(() => {
        copyLinkBtn.textContent = copyLinkBtn.dataset.copy;
      }, 2000);
    } catch (err) {
      console.error('Failed to copy:', err);
    }
  });

  // Schedule another button
  scheduleAnotherBtn.addEventListener('click', () => {
    form.reset();
    charCount.textContent = '0';
    form.classList.remove('hidden');
    successMessage.classList.add('hidden');
  });

  // Local storage functions for tasks
  function saveTaskLocally(task) {
    const tasks = JSON.parse(localStorage.getItem('opnchat-scheduled-tasks') || '[]');
    tasks.unshift(task);
    // Keep only last 50 tasks
    if (tasks.length > 50) tasks.pop();
    localStorage.setItem('opnchat-scheduled-tasks', JSON.stringify(tasks));
  }

  function loadTasks() {
    const tasks = JSON.parse(localStorage.getItem('opnchat-scheduled-tasks') || '[]');
    
    if (tasks.length === 0) {
      tasksList.innerHTML = `
        <div class="empty-state">
          <svg class="empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
            <line x1="9" y1="16" x2="15" y2="16"/>
          </svg>
          <p>No scheduled messages yet</p>
        </div>
      `;
      return;
    }

    tasksList.innerHTML = tasks.map(task => {
      const scheduledDate = new Date(task.scheduledFor);
      const now = new Date();
      const isPast = scheduledDate <= now;
      const statusClass = isPast ? 'status-past' : 'status-pending';
      const statusText = isPast ? 'Ready to send' : 'Scheduled';
      
      return `
        <div class="task-item ${statusClass}">
          <div class="task-info">
            <span class="task-phone">${task.phone.replace(/(\d{1,3})(\d{3})(\d{3})(\d{2,})/, '+$1 $2 $3 $4')}</span>
            <span class="task-time">${scheduledDate.toLocaleString(lang)}</span>
          </div>
          <div class="task-status">${statusText}</div>
          <a href="/scheduler/task/${task.id}" class="task-view-btn" target="_blank">View</a>
        </div>
      `;
    }).join('');
  }

  // Load tasks on page init
  loadTasks();
</script>

<style>
  .scheduler-container {
    max-width: 700px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
    color: var(--text-primary);
    text-align: center;
  }

  /* How It Works */
  .how-it-works {
    margin-bottom: 2.5rem;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }

  .step-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 1.25rem;
    text-align: center;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .step-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--card-shadow);
  }

  .step-number {
    width: 36px;
    height: 36px;
    background: linear-gradient(135deg, var(--opn-primary), #128C7E);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.1rem;
    margin: 0 auto 0.75rem;
  }

  .step-card h3 {
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .step-card p {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  /* Form Styles */
  .scheduler-form-section {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 2rem;
    margin-bottom: 2rem;
  }

  .form-group {
    margin-bottom: 1.25rem;
  }

  .form-label {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .optional {
    font-weight: 400;
    color: var(--text-secondary);
    font-size: 0.85rem;
  }

  .form-input {
    width: 100%;
    padding: 0.875rem 1rem;
    background: var(--bg-input);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    color: var(--text-primary);
    font-size: 1rem;
    font-family: inherit;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--opn-primary);
    box-shadow: 0 0 0 3px rgba(37, 211, 102, 0.15);
  }

  .form-input::placeholder {
    color: var(--text-secondary);
    opacity: 0.7;
  }

  .form-hint {
    display: block;
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-top: 0.375rem;
  }

  .message-textarea {
    resize: vertical;
    min-height: 100px;
  }

  .char-count {
    text-align: right;
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-top: 0.375rem;
  }

  .datetime-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .datetime-group {
    margin-bottom: 0;
  }

  .date-input,
  .time-input {
    cursor: pointer;
  }

  /* Timezone info */
  .timezone-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 8px;
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
  }

  .timezone-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  /* Submit Button */
  .submit-btn {
    width: 100%;
    padding: 1rem 1.5rem;
    background: linear-gradient(135deg, #25D366, #128C7E);
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .submit-btn:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(37, 211, 102, 0.35);
  }

  .submit-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .btn-icon {
    width: 20px;
    height: 20px;
  }

  /* Success Message */
  .success-message {
    text-align: center;
    padding: 2rem;
  }

  .success-message.hidden {
    display: none;
  }

  .form.hidden {
    display: none;
  }

  .success-icon {
    width: 64px;
    height: 64px;
    background: linear-gradient(135deg, #25D366, #128C7E);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    font-weight: 700;
    margin: 0 auto 1rem;
  }

  .success-message h3 {
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .success-message p {
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .task-link-section {
    background: var(--bg-input);
    border-radius: 10px;
    padding: 1rem;
    margin: 1.25rem 0;
  }

  .task-link-section p {
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  .task-link {
    display: block;
    word-break: break-all;
    color: var(--opn-primary);
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
  }

  .copy-btn {
    padding: 0.5rem 1rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    color: var(--text-primary);
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .copy-btn:hover {
    background: var(--opn-primary);
    color: white;
    border-color: var(--opn-primary);
  }

  .secondary-btn {
    padding: 0.75rem 1.5rem;
    background: transparent;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    color: var(--text-primary);
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .secondary-btn:hover {
    background: var(--bg-input);
    border-color: var(--opn-primary);
  }

  /* Tasks List */
  .tasks-list-section {
    margin-bottom: 2rem;
  }

  .tasks-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .empty-state {
    text-align: center;
    padding: 2.5rem 1rem;
    color: var(--text-secondary);
  }

  .empty-icon {
    width: 48px;
    height: 48px;
    margin: 0 auto 1rem;
    opacity: 0.5;
  }

  .task-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 10px;
