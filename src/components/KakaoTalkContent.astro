    color: var(--text-primary);
    cursor: pointer;
    list-style: none;
    transition: background 0.15s;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question::after {
    content: '+';
    float: right;
    font-size: 1.1rem;
