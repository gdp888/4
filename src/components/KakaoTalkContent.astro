  @media (max-width: 520px) {
    .title {
      font-size: 1.6rem;
    }

    .form {
      padding: 1.25rem;
    }
    
    .form-actions {
      flex-direction: column;
    }
    
    .copy-link-btn {
      justify-content: center;
    }

    .qr-input-group {
      flex-direction: column;
    }
    
    .seo-heading {
      font-size: 1.1rem;
    }
    .seo-text {
      font-size: 0.85rem;
    }
    
    .template-tabs {
      justify-content: flex-start;
