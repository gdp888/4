</style>

<script define:vars={{ lang }}>
  // ==================== CONTACT TYPE TOGGLE ====================
  const contactTabs = document.querySelectorAll('.contact-tab');
  const phoneSection = document.getElementById('phone-section');
  const idSection = document.getElementById('id-section');
  const phoneInput = document.getElementById('phone');
  const kakaoIdInput = document.getElementById('kakao-id');

  let currentContactType = 'phone';

  contactTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      contactTabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      currentContactType = tab.dataset.type;

      if (currentContactType === 'phone') {
        phoneSection.style.display = 'block';
        idSection.style.display = 'none';
      } else {
        phoneSection.style.display = 'none';
        idSection.style.display = 'block';
        kakaoIdInput.focus();
      }
      errorMsg.textContent = '';
    });
  });

  // ==================== FORM ELEMENTS ====================
  const form = document.getElementById('kakao-form');
  const messageInput = document.getElementById('message');
  const errorMsg = document.getElementById('error-msg');
  const historySection = document.getElementById('history-section');
  const historyList = document.getElementById('history-list');
  const clearBtn = document.getElementById('clear-history');

  const STORAGE_KEY = 'opnchat-kakao-history';
  const MAX_HISTORY = 5;

  const localeMap = { en: 'en-US', es: 'es-ES', pt: 'pt-BR', id: 'id-ID', ru: 'ru-RU', ar: 'ar-SA', de: 'de-DE' };
  const locale = localeMap[lang] || 'en-US';

  const chatLabel = 'KakaoTalk';

  // Phone input — digits only
  phoneInput.addEventListener('input', () => {
    let val = phoneInput.value.replace(/\D/g, '');
    if (val.length > 15) val = val.slice(0, 15);
    phoneInput.value = val;
    errorMsg.textContent = '';
  });

  // KakaoID input — alphanumeric only
  kakaoIdInput.addEventListener('input', () => {
    let val = kakaoIdInput.value.replace(/[^a-zA-Z0-9_.-]/g, '');
    if (val.length > 30) val = val.slice(0, 30);
    kakaoIdInput.value = val.toLowerCase();
    errorMsg.textContent = '';
  });

  // ==================== CHARACTER COUNTER ====================
  const charCount = document.getElementById('char-count');
  const charBarFill = document.getElementById('char-bar-fill');
  const MAX_CHARS = 5000;

  function updateCharCounter() {
    const len = messageInput.value.length;
    charCount.textContent = len;
    const percent = (len / MAX_CHARS) * 100;
    charBarFill.style.width = Math.min(percent, 100) + '%';
    
    charBarFill.classList.remove('warning', 'danger');
    if (percent > 90) {
      charBarFill.classList.add('danger');
    } else if (percent > 70) {
      charBarFill.classList.add('warning');
    }
  }

  messageInput.addEventListener('input', updateCharCounter);

  // ==================== HISTORY ====================
  function loadHistory() {
    try {
      const data = localStorage.getItem(STORAGE_KEY);
      return data ? JSON.parse(data) : [];
    } catch {
      return [];
    }
  }

  function saveHistory(contactValue, contactType) {
    const history = loadHistory().filter(h => h.value !== contactValue || h.type !== contactType);
    history.unshift({ value: contactValue, type: contactType, timestamp: Date.now() });
    if (history.length > MAX_HISTORY) history.pop();
    localStorage.setItem(STORAGE_KEY, JSON.stringify(history));
    renderHistory();
  }

  function renderHistory() {
    const history = loadHistory();
    if (history.length === 0) {
      historySection.style.display = 'none';
      return;
    }
    historySection.style.display = 'block';
    historyList.innerHTML = '';

    history.forEach(item => {
      const li = document.createElement('li');
      li.className = 'history-item';

      const leftDiv = document.createElement('div');
      leftDiv.className = 'history-left';

      const numSpan = document.createElement('span');
      numSpan.className = 'history-number';
      numSpan.textContent = item.type === 'id' ? `@${item.value}` : `+${item.value}`;
      numSpan.addEventListener('click', (e) => {
        e.stopPropagation();
        if (item.type === 'id') {
          kakaoIdInput.value = item.value;
          currentContactType = 'id';
          contactTabs.forEach(t => t.classList.remove('active'));
          document.querySelector('[data-type="id"]').classList.add('active');
          phoneSection.style.display = 'none';
          idSection.style.display = 'block';
        } else {
          phoneInput.value = item.value;
          currentContactType = 'phone';
          contactTabs.forEach(t => t.classList.remove('active'));
          document.querySelector('[data-type="phone"]').classList.add('active');
          phoneSection.style.display = 'block';
          idSection.style.display = 'none';
        }
      });

      const timeSpan = document.createElement('span');
      timeSpan.className = 'history-time';
      const time = new Date(item.timestamp);
      timeSpan.textContent = time.toLocaleTimeString(locale, { hour: '2-digit', minute: '2-digit' });

      leftDiv.appendChild(numSpan);
      leftDiv.appendChild(timeSpan);

      const chatBtn = document.createElement('button');
      chatBtn.type = 'button';
      chatBtn.className = 'history-chat-btn';
      chatBtn.textContent = chatLabel;
      chatBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        openKakaoChat(item.value, item.type);
      });

      li.appendChild(leftDiv);
      li.appendChild(chatBtn);
      historyList.appendChild(li);
    });
  }

  clearBtn.addEventListener('click', () => {
    localStorage.removeItem(STORAGE_KEY);
    renderHistory();
  });

  renderHistory();

  // ==================== KAKAO TALK DEEP LINK ====================
  function openKakaoChat(value, type) {
    let url;
    const message = messageInput.value.trim();

    if (type === 'id') {
      // KakaoTalk ID format: kakaotalk://profile?userId={ID}
      url = `kakaotalk://profile?userId=${encodeURIComponent(value)}`;
    } else {
      // Phone format: kakaotalk://send?phone={number}
      url = `kakaotalk://send?phone=+${value}`;
    }

    if (message) {
      url += `&message=${encodeURIComponent(message)}`;
    }

    saveHistory(value, type);
    window.open(url, '_self');
  }

  // Form submit
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    errorMsg.textContent = '';

    const errorMessages = {
      validPhone: lang === 'ru' ? 'Введите корректный номер телефона' : 'Please enter a valid phone number',
      shortPhone: lang === 'ru' ? 'Номер телефона слишком короткий' : 'Phone number is too short',
      validId: lang === 'ru' ? 'Введите корректный KakaoTalk ID' : 'Please enter a valid KakaoTalk ID',
      noContact: lang === 'ru' ? 'Введите номер или KakaoTalk ID' : 'Please enter phone number or KakaoTalk ID'
    };

    if (currentContactType === 'phone') {
      const rawPhone = phoneInput.value.replace(/\D/g, '');
      if (rawPhone.length < 7) {
        errorMsg.textContent = errorMessages.validPhone;
        phoneInput.focus();
        return;
      }
      if (rawPhone.length < 10) {
        errorMsg.textContent = errorMessages.shortPhone;
        phoneInput.focus();
        return;
      }
      openKakaoChat(rawPhone, 'phone');
    } else {
      const kakaoId = kakaoIdInput.value.trim();
      if (kakaoId.length < 2) {
        errorMsg.textContent = errorMessages.validId;
        kakaoIdInput.focus();
        return;
      }
      openKakaoChat(kakaoId, 'id');
    }
  });

  // Keyboard shortcuts
  phoneInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      form.dispatchEvent(new Event('submit', { cancelable: true }));
    }
  });

  kakaoIdInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      form.dispatchEvent(new Event('submit', { cancelable: true }));
    }
  });

  // ==================== COPY LINK BUTTON ====================
  const copyLinkBtn = document.getElementById('copy-link-btn');
  const copyLinkText = document.getElementById('copy-link-text');

  copyLinkBtn.addEventListener('click', async () => {
    let value, type;
    if (currentContactType === 'phone') {
      value = phoneInput.value.replace(/\D/g, '');
      type = 'phone';
    } else {
      value = kakaoIdInput.value.trim();
      type = 'id';
    }

    if (!value || value.length < 2) {
      errorMsg.textContent = lang === 'ru' ? 'Сначала введите контактные данные' : 'Please enter contact details first';
      return;
    }

    let url;
    if (type === 'id') {
      url = `https://www.kakaocorp.com/service/KakaoTalk?userId=${encodeURIComponent(value)}`;
    } else {
      url = `https://www.kakaocorp.com/service/KakaoTalk?phone=+${value}`;
    }

    try {
      await navigator.clipboard.writeText(url);
      copyLinkBtn.classList.add('copied');
      const originalText = copyLinkText.textContent;
      copyLinkText.textContent = lang === 'ru' ? 'Скопировано!' : 'Copied!';
      setTimeout(() => {
        copyLinkBtn.classList.remove('copied');
        copyLinkText.textContent = originalText;
      }, 2000);
    } catch (err) {
      const textarea = document.createElement('textarea');
      textarea.value = url;
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      document.body.removeChild(textarea);
      copyLinkText.textContent = lang === 'ru' ? 'Скопировано!' : 'Copied!';
      setTimeout(() => {
        copyLinkText.textContent = originalText;
      }, 2000);
    }
  });

  // ==================== FAVORITES SYSTEM ====================
  const FAV_KEY = 'opnchat-kakao-favorites';
  const favoritesSection = document.getElementById('favorites-section');
  const favoritesList = document.getElementById('favorites-list');
  const addFavBtn = document.getElementById('add-favorite-btn');
  const favModalOverlay = document.getElementById('fav-modal-overlay');
  const favNameInput = document.getElementById('fav-name-input');
  const favContactDisplay = document.getElementById('fav-contact-display');
  const closeFavModal = document.getElementById('close-fav-modal');
  const cancelFavBtn = document.getElementById('cancel-fav-btn');
  const saveFavBtn = document.getElementById('save-fav-btn');

  function loadFavorites() {
    try {
      const data = localStorage.getItem(FAV_KEY);
      return data ? JSON.parse(data) : [];
    } catch {
      return [];
    }
  }

  function saveFavorites(favorites) {
    localStorage.setItem(FAV_KEY, JSON.stringify(favorites));
  }

  function renderFavorites() {
    const favorites = loadFavorites();
    favoritesList.innerHTML = '';
    
    if (favorites.length === 0) {
      const emptyMsg = document.createElement('li');
      emptyMsg.className = 'fav-empty';
      emptyMsg.textContent = lang === 'ru' ? 'Нет избранных контактов' : 'No favorite contacts yet';
      favoritesList.appendChild(emptyMsg);
      return;
    }

    favorites.forEach((fav, index) => {
      const li = document.createElement('li');
      li.className = 'fav-item';

      const leftDiv = document.createElement('div');
      leftDiv.className = 'fav-item-left';

      const avatar = document.createElement('div');
      avatar.className = 'fav-avatar';
      avatar.textContent = fav.name.charAt(0).toUpperCase();

      const infoDiv = document.createElement('div');
      infoDiv.className = 'fav-info';

      const nameSpan = document.createElement('span');
      nameSpan.className = 'fav-name';
      nameSpan.textContent = fav.name;

      const valueSpan = document.createElement('span');
      valueSpan.className = 'fav-number';
      valueSpan.textContent = fav.type === 'id' ? `@${fav.value}` : `+${fav.value}`;

      infoDiv.appendChild(nameSpan);
      infoDiv.appendChild(valueSpan);
      leftDiv.appendChild(avatar);
      leftDiv.appendChild(infoDiv);

      const actionsDiv = document.createElement('div');
      actionsDiv.className = 'fav-actions';

      const chatBtn = document.createElement('button');
      chatBtn.type = 'button';
      chatBtn.className = 'fav-chat-btn';
      chatBtn.textContent = chatLabel;
      chatBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        openKakaoChat(fav.value, fav.type);
      });

      const deleteBtn = document.createElement('button');
      deleteBtn.type = 'button';
      deleteBtn.className = 'fav-delete-btn';
      deleteBtn.textContent = '✕';
      deleteBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const favs = loadFavorites();
        favs.splice(index, 1);
        saveFavorites(favs);
        renderFavorites();
      });

      actionsDiv.appendChild(chatBtn);
      actionsDiv.appendChild(deleteBtn);

      li.appendChild(leftDiv);
      li.appendChild(actionsDiv);

      li.addEventListener('click', () => {
        if (fav.type === 'id') {
          kakaoIdInput.value = fav.value;
          currentContactType = 'id';
          contactTabs.forEach(t => t.classList.remove('active'));
          document.querySelector('[data-type="id"]').classList.add('active');
          phoneSection.style.display = 'none';
          idSection.style.display = 'block';
        } else {
          phoneInput.value = fav.value;
          currentContactType = 'phone';
          contactTabs.forEach(t => t.classList.remove('active'));
          document.querySelector('[data-type="phone"]').classList.add('active');
          phoneSection.style.display = 'block';
          idSection.style.display = 'none';
        }
      });

      favoritesList.appendChild(li);
    });
  }

  function openFavModal() {
    let value, type;
    if (currentContactType === 'phone') {
      value = phoneInput.value.replace(/\D/g, '');
      type = 'phone';
    } else {
      value = kakaoIdInput.value.trim();
      type = 'id';
    }

    if (!value || value.length < 2) {
      errorMsg.textContent = lang === 'ru' ? 'Сначала введите контактные данные' : 'Please enter contact details first';
      return;
    }

    favContactDisplay.innerHTML = type === 'id' 
      ? `<strong>KakaoTalk ID:</strong> @${value}`
      : `<strong>${lang === 'ru' ? 'Телефон' : 'Phone'}:</strong> +${value}`;
    favNameInput.value = '';
    favModalOverlay.style.display = 'flex';
    setTimeout(() => favNameInput.focus(), 100);
  }

  function closeFavModalFn() {
    favModalOverlay.style.display = 'none';
    favNameInput.value = '';
  }

  addFavBtn.addEventListener('click', openFavModal);
  closeFavModal.addEventListener('click', closeFavModalFn);
  cancelFavBtn.addEventListener('click', closeFavModalFn);

  saveFavBtn.addEventListener('click', () => {
    const name = favNameInput.trim();
    if (!name) {
      favNameInput.style.borderColor = '#ef4444';
      return;
    }

    let value, type;
    if (currentContactType === 'phone') {
      value = phoneInput.value.replace(/\D/g, '');
      type = 'phone';
    } else {
      value = kakaoIdInput.value.trim();
      type = 'id';
    }

    const favorites = loadFavorites();
    favorites.unshift({ name, value, type, timestamp: Date.now() });
    saveFavorites(favorites);
    renderFavorites();
    closeFavModalFn();
  });

  favModalOverlay.addEventListener('click', (e) => {
    if (e.target === favModalOverlay) {
      closeFavModalFn();
    }
  });

  renderFavorites();

  // ==================== QR CODE GENERATOR ====================
  const qrValueInput = document.getElementById('qr-value-input');
  const generateQrBtn = document.getElementById('generate-qr-btn');
  const qrCodeContainer = document.getElementById('qr-code-container');

  generateQrBtn.addEventListener('click', () => {
    const value = qrValueInput.value.trim();
    if (!value) {
      qrCodeContainer.innerHTML = `<p style="color:var(--text-secondary);font-size:0.85rem;">${lang === 'ru' ? 'Введите значение для QR-кода' : 'Enter a value for QR code'}</p>`;
      return;
    }

    // Create simple QR-like visual representation
    // In production, you'd use a library like qrcode.js
    const qrData = value.startsWith('@') 
      ? `kakaotalk://profile?userId=${value.substring(1)}`
      : `kakaotalk://send?phone=${value.startsWith('+') ? value : '+' + value}`;

    // Generate a visual QR representation using canvas
    const canvas = document.createElement('canvas');
    canvas.width = 200;
    canvas.height = 200;
    const ctx = canvas.getContext('2d');

    // Background
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, 200, 200);

    // Draw pattern based on input hash
    const hash = value.split('').reduce((acc, char, i) => acc + char.charCodeAt(0) * (i + 1), 0);
    const cellSize = 8;
    const gridSize = Math.floor(200 / cellSize);

    ctx.fillStyle = '#000000';

    // Position markers (corners)
    drawPositionMarker(ctx, 0, 0, cellSize * 7);
    drawPositionMarker(ctx, (gridSize - 7) * cellSize, 0, cellSize * 7);
    drawPositionMarker(ctx, 0, (gridSize - 7) * cellSize, cellSize * 7);

    // Data area pattern
    for (let row = 0; row < gridSize; row++) {
      for (let col = 0; col < gridSize; col++) {
        // Skip position marker areas
        if ((row < 8 && col < 8) || (row < 8 && col >= gridSize - 8) || (row >= gridSize - 8 && col < 8)) {
          continue;
        }
        
        const seed = (hash * (row + 1) * (col + 1)) % 100;
        if (seed < 50) {
          ctx.fillRect(col * cellSize, row * cellSize, cellSize - 1, cellSize - 1);
        }
      }
    }

    // Add KakaoTalk label
    ctx.fillStyle = '#FEE500';
    ctx.fillRect(70, 85, 60, 30);
    ctx.fillStyle = '#000000';
    ctx.font = 'bold 10px sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('KakaoTalk', 100, 104);

    qrCodeContainer.innerHTML = '';
    qrCodeContainer.appendChild(canvas);

    // Add download hint
    const hint = document.createElement('p');
    hint.style.cssText = 'margin-top:0.5rem;font-size:0.78rem;color:var(--text-secondary);text-align:center;';
    hint.textContent = lang === 'ru' ? 'Отсканируйте для добавления в KakaoTalk' : 'Scan to add on KakaoTalk';
    qrCodeContainer.appendChild(hint);
  });

  function drawPositionMarker(ctx, x, y, size) {
    // Outer square
    ctx.fillStyle = '#000000';
    ctx.fillRect(x, y, size, size);
    // Inner white
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(x + 2 * 8, y + 2 * 8, size - 4 * 8, size - 4 * 8);
    // Center black
    ctx.fillStyle = '#000000';
    ctx.fillRect(x + 3 * 8, y + 3 * 8, size - 6 * 8, size - 6 * 8);
  }

  // ==================== MESSAGE TEMPLATES ====================
  const templatesGrid = document.getElementById('templates-grid');
  const templateTabs = document.querySelectorAll('.template-tab');

  const templates = {
    greeting: [
      { text: lang === 'ru' ? 'Привет! 👋 Как дела?' : 'Hi! 👋 How are you?', emoji: '👋' },
      { text: lang === 'ru' ? 'Добрый день! Рад связаться с вами.' : 'Good day! Nice to connect with you.', emoji: '☀️' },
      { text: lang === 'ru' ? 'Приветствую! 👋 Надеюсь, у вас отличный день.' : 'Greetings! 👋 Hope you\'re having a great day.', emoji: '🌟' },
      { text: lang === 'ru' ? 'Здравствуйте! ✨ Пишу по делу.' : 'Hello! ✅ Writing regarding an important matter.', emoji: '✨' },
      { text: lang === 'ru' ? 'Привет! Давно не виделись! 🤗' : 'Hey! Long time no see! 🤗', emoji: '🤗' },
    ],
    business: [
      { text: lang === 'ru' ? 'Здравствуйте! По поводу нашего заказа.' : 'Hello! Regarding our order.', emoji: '📦' },
      { text: lang === 'ru' ? 'Добрый день! Интересует ваша услуга.' : 'Good day! Interested in your service.', emoji: '💼' },
      { text: lang === 'ru' ? 'Коллеги, напоминаю о встрече.' : 'Team, reminder about the meeting.', emoji: '📅' },
      { text: lang === 'ru' ? 'Отправляю отчёт. Пожалуйста, проверьте.' : 'Sending the report. Please review.', emoji: '📊' },
      { text: lang === 'ru' ? 'Благодарим за сотрудничество! 🙏' : 'Thank you for your cooperation! 🙏', emoji: '🤝' },
    ],
    personal: [
      { text: lang === 'ru' ? 'Скучаю по тебе! 💕 Когда созвонимся?' : 'Missing you! 💕 When can we talk?', emoji: '💕' },
      { text: lang === 'ru' ? 'Как прошли выходные? 🎉 Расскажи!' : 'How was your weekend? 🎉 Tell me!', emoji: '🎉' },
      { text: lang === 'ru' ? 'Поздравляю! 🎊 Ты лучший(ая)!' : 'Congratulations! 🎊 You\'re the best!', emoji: '🎊' },
      { text: lang === 'ru' ? 'Держись! Всё будет хорошо! 💪' : 'Hang in there! Everything will be fine! 💪', emoji: '💪' },
      { text: lang === 'ru' ? 'Спасибо, что ты есть! ❤️' : 'Thank you for being there! ❤️', emoji: '❤️' },
    ],
    korean: [
      { text: '안녕하세요! 👋 반갑습니다!', emoji: '🇰🇷' },
      { text: '감사합니다! 🙏 고맙습니다!', emoji: '🙏' },
      { text: '좋은 아침이에요! ☀️ 좋은 하루 되세요!', emoji: '☀️' },
      { text: '건강하세요! 💪 잘 지내시나요?', emoji: '💪' },
      { text: '사랑해요! ❤️ 보고 싶어요!', emoji: '❤️' },
      { text: '축하해요! 🎉 생일 축하합니다!', emoji: '🎂' },
    ]
  };

  let activeCategory = 'greeting';

  function renderTemplates(category) {
    templatesGrid.innerHTML = '';
    const categoryTemplates = templates[category] || [];
    
    categoryTemplates.forEach(template => {
      const card = document.createElement('div');
      card.className = 'template-card';
      
      const textDiv = document.createElement('div');
      textDiv.className = 'template-card-text';
      textDiv.textContent = template.text;
      
      const actionDiv = document.createElement('div');
      actionDiv.className = 'template-card-action';
      actionDiv.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:12px;height:12px;"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>${lang === 'ru' ? 'Использовать' : 'Use'}`;
      
      card.appendChild(textDiv);
      card.appendChild(actionDiv);
      
      card.addEventListener('click', () => {
        messageInput.value = template.text;
        messageInput.focus();
        updateCharCounter();
        const messageDetails = document.querySelector('.message-details');
        if (messageDetails && !messageDetails.open) {
          messageDetails.open = true;
        }
      });
      
      templatesGrid.appendChild(card);
    });
  }

  templateTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      templateTabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      activeCategory = tab.dataset.category;
      renderTemplates(activeCategory);
    });
  });

  renderTemplates(activeCategory);
</script>
