---
import { useTranslations, getLocalizedPath } from '../i18n/utils';
import { type Lang } from '../i18n/ui';

export interface Props {
  lang: Lang;
  activeTool: string; // e.g. 'wa-link', 'tg-link', 'whatsapp', etc
  accentColor?: string; // e.g. '#25D366' for WhatsApp, '#2AABEE' for Telegram
}

const { lang, activeTool, accentColor = '#25D366' } = Astro.props;
const t = useTranslations(lang);

const tools = [
  // WhatsApp
  { category: 'sidebar.whatsapp', items: [
    { slug: 'whatsapp', key: 'hub.service.whatsapp.title', icon: 'wa', iconType: 'fill' },
    { slug: 'wa-link', key: 'hub.service.walink.title', icon: 'wa', iconType: 'fill' },
    { slug: 'wa-widget', key: 'hub.service.widget.title', icon: 'wa', iconType: 'fill' },
    { slug: 'whatsapp-text-formatter', key: 'hub.service.formatter.title', icon: 'wa', iconType: 'fill' },
  ]},
  // Telegram
  { category: 'sidebar.telegram', items: [
    { slug: 'telegram', key: 'hub.service.telegram.title', icon: 'tg', iconType: 'fill' },
    { slug: 'tg-link', key: 'hub.service.tglink.title', icon: 'tg', iconType: 'fill' },
  ]},
  // Text Tools
  { category: 'sidebar.texttools', items: [
    { slug: 'fancy-text', key: 'hub.service.fancytext.title', icon: 'format', iconType: 'stroke' },
    { slug: 'word-counter', key: 'hub.service.wordcounter.title', icon: 'doc', iconType: 'stroke' },
    { slug: 'notepad', key: 'hub.service.notepad.title', icon: 'notepad', iconType: 'stroke' },
  ]},
  // Utilities
  { category: 'sidebar.utilities', items: [
    { slug: 'qr-code', key: 'hub.service.qr.title', icon: 'qr', iconType: 'stroke' },
    { slug: 'password', key: 'hub.service.password.title', icon: 'lock', iconType: 'stroke' },
    { slug: 'unit-converter', key: 'hub.service.converter.title', icon: 'convert', iconType: 'stroke' },
    { slug: 'emoji-picker', key: 'hub.service.emojipicker.title', icon: 'emoji', iconType: 'stroke' },
  ]},
];

// SVG icon map
const icons = {
  wa: `<svg viewBox="0 0 24 24" fill="currentColor" class="sidebar-icon" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>`,
  tg: `<svg viewBox="0 0 24 24" fill="currentColor" class="sidebar-icon" aria-hidden="true"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>`,
  link: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="sidebar-icon" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>`,
  chat: `<svg viewBox="0 0 24 24" fill="currentColor" class="sidebar-icon" aria-hidden="true"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.17L4 17.17V4h16v12z"/><path d="M7 9h2v2H7zm4 0h2v2h-2zm4 0h2v2h-2z"/></svg>`,
  format: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="sidebar-icon" aria-hidden="true"><path d="M4 7V4h16v3"/><path d="M9 20h6"/><path d="M12 4v16"/></svg>`,
  doc: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="sidebar-icon" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>`,
  notepad: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="sidebar-icon" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>`,
  qr: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="sidebar-icon" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="3" height="3"/><line x1="21" y1="14" x2="21" y2="14.01"/><line x1="21" y1="21" x2="21" y2="21.01"/><line x1="17" y1="18" x2="17" y2="18.01"/></svg>`,
  lock: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="sidebar-icon" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`,
  convert: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="sidebar-icon" aria-hidden="true"><path d="M7 16V4m0 0L3 8m4-4l4 4M17 8v12m0 0l4-4m-4 4l-4-4"/></svg>`,
  emoji: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="sidebar-icon" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>`,
};
---

<aside class="sidebar" aria-label="Tools navigation" data-accent={accentColor}>
  <div class="sidebar-header">
    <a href={getLocalizedPath(lang)} class="sidebar-logo">OPN Chat</a>
  </div>

  {tools.map((cat) => (
    <div class="sidebar-category">
      <h3 class="sidebar-cat-title">{t(cat.category)}</h3>
      {cat.items.map((item) => (
        <a
          href={getLocalizedPath(lang, item.slug)}
          class:list={['sidebar-link', { 'sidebar-link-active': item.slug === activeTool }]}
          data-accent={accentColor}
        >
          <Fragment set:html={icons[item.icon]} />
          {t(item.key)}
        </a>
      ))}
    </div>
  ))}
</aside>

<style>
  .sidebar {
    width: 220px;
    flex-shrink: 0;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 1rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    position: sticky;
    top: 2rem;
    align-self: flex-start;
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
  }

  .sidebar::-webkit-scrollbar {
    width: 4px;
  }

  .sidebar::-webkit-scrollbar-thumb {
    background: var(--border-color);
    border-radius: 4px;
  }

  .sidebar-header {
    padding: 0.5rem 1rem 0.75rem;
    border-bottom: 1px solid var(--border-color);
  }

  .sidebar-logo {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .sidebar-logo:hover {
    color: var(--opn-primary);
  }

  .sidebar-category {
    padding: 0.5rem 0;
  }

  .sidebar-cat-title {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-secondary);
    padding: 0.25rem 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 1rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: 8px;
    transition: all 0.15s;
    margin: 0.1rem 0.5rem;
    line-height: 1.3;
  }

  .sidebar-link:hover {
    color: var(--text-primary);
    background: var(--bg-input);
  }

  .sidebar-link-active {
    color: #25D366;
    background: rgba(37, 211, 102, 0.1);
    font-weight: 600;
  }

  .sidebar-link-active:hover {
    color: #25D366;
    background: rgba(37, 211, 102, 0.15);
  }

  /* Dynamic accent color override for active links */
  .sidebar[data-accent="#2AABEE"] .sidebar-link-active {
    color: #2AABEE;
    background: rgba(42, 171, 238, 0.1);
  }
  .sidebar[data-accent="#2AABEE"] .sidebar-link-active:hover {
    color: #2AABEE;
    background: rgba(42, 171, 238, 0.15);
  }

  :global(.sidebar-icon) {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .sidebar {
      display: none;
    }
  }
</style>
