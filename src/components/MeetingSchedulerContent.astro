---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';
import { getRelativeLocaleUrl, getAbsoluteLocaleUrl } from 'astro:i18n';
import { languages, type Lang } from '../i18n/ui';
import SiteHeader from './SiteHeader.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import SEOHead from './SEOHead.astro';
import { timezones } from '../data/timezones';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Localized city name map for client-side JS
const cityTranslations: Record<string, string> = {};
timezones.forEach(tz => { cityTranslations[tz.value] = t(tz.cityKey); });

const msSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": t('ms.heading'),
      "url": getAbsoluteLocaleUrl(lang, 'meeting-scheduler'),
      "description": t('ms.meta.description'),
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Any",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "isPartOf": {
        "@type": "WebSite",
        "name": "OPN Chat",
        "url": "https://opnchat.net/"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "OPN Chat",
          "item": getAbsoluteLocaleUrl(lang, '')
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": t('ms.heading'),
          "item": getAbsoluteLocaleUrl(lang, 'meeting-scheduler')
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": t('ms.faq.q1'), "acceptedAnswer": { "@type": "Answer", "text": t('ms.faq.a1') } },
        { "@type": "Question", "name": t('ms.faq.q2'), "acceptedAnswer": { "@type": "Answer", "text": t('ms.faq.a2') } },
        { "@type": "Question", "name": t('ms.faq.q3'), "acceptedAnswer": { "@type": "Answer", "text": t('ms.faq.a3') } },
        { "@type": "Question", "name": t('ms.faq.q4'), "acceptedAnswer": { "@type": "Answer", "text": t('ms.faq.a4') } },
        { "@type": "Question", "name": t('ms.faq.q5'), "acceptedAnswer": { "@type": "Answer", "text": t('ms.faq.a5') } },
      ]
    }
  ]
};
---

<Layout title={t('ms.meta.title')} lang={lang} service="meeting-scheduler">
  <Fragment slot="meta">
  <SEOHead
    lang={lang}
    description={t('ms.meta.description')}
    canonicalUrl={getAbsoluteLocaleUrl(lang, 'meeting-scheduler')}
    ogTitle={t('ms.meta.og.title')}
    ogDescription={t('ms.meta.og.description')}
    ogUrl={getAbsoluteLocaleUrl(lang, 'meeting-scheduler')}
    schema={msSchema}
    extraMeta={`<meta name="keywords" content="${t('ms.meta.keywords')}" /><meta name="twitter:card" content="summary" /><meta name="twitter:title" content="${t('ms.meta.twitter.title')}" /><meta name="twitter:description" content="${t('ms.meta.twitter.description')}" />`}
  />
  </Fragment>

  <div class="container">
    <!-- Header -->
    <SiteHeader lang={lang} path="meeting-scheduler" activeTool="meeting-scheduler" />

    <Breadcrumbs lang={lang} items={[{ label: t('bc.home'), href: getRelativeLocaleUrl(lang) }, { label: t('bc.meetingscheduler') }]} />

    <!-- Hero -->
    <div class="hero">
      <h1 class="title">{t('ms.heading')}</h1>
      <p class="subtitle">{t('ms.subtitle')}</p></div>

    <!-- Timezone selectors -->
      <!-- Pass localized strings to client-side JS -->
      <div id="ms-city-data" data-cities={JSON.stringify(cityTranslations)} style="display:none"></div>
      <div id="ms-i18n" data-lang={lang} data-meeting-at={t('ms.result.meeting_at')} data-copied={t('ms.result.copied')} data-copy={t('ms.result.copy')} data-no-overlap={t('ms.result.no_overlap')} data-overlap-text={t('ms.result.overlap_window')} data-no-slots={t('ms.result.no_slots')} style="display:none"></div>
    <div class="tz-row">
      <div class="tz-card">
        <label class="tz-label" for="my-tz">{t('ms.your.tz')}</label>
        <select id="my-tz" class="tz-select">
          {timezones.map(tz => (
            <option value={tz.value}>{t(tz.cityKey)} ({tz.offset})</option>
          ))}
        </select>
        <div class="tz-current-time" id="my-current-time">--:--</div>
      </div>

      <div class="tz-arrow">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </div>

      <div class="tz-card">
        <label class="tz-label" for="their-tz">{t('ms.their.tz')}</label>
        <select id="their-tz" class="tz-select">
          {timezones.map(tz => (
            <option value={tz.value}>{t(tz.cityKey)} ({tz.offset})</option>
          ))}
        </select>
        <div class="tz-current-time" id="their-current-time">--:--</div>
      </div>
    </div>

    <!-- Working hours config -->
    <div class="work-hours-card">
      <h3 class="card-title">{t('ms.workhours.title')}</h3>
      <div class="work-hours-row">
        <div class="work-hours-field">
          <label for="work-start">{t('ms.workhours.start')}</label>
          <input type="time" id="work-start" value="09:00" class="time-input" />
        </div>
        <span class="work-hours-dash">&mdash;</span>
        <div class="work-hours-field">
          <label for="work-end">{t('ms.workhours.end')}</label>
          <input type="time" id="work-end" value="18:00" class="time-input" />
        </div>
      </div>
    </div>

    <!-- Visual Timeline -->
    <div class="timeline-card">
      <h3 class="card-title">{t('ms.timeline.title')}</h3>
      <div class="timeline-legend">
        <span class="legend-item"><span class="legend-swatch legend-work"></span>{t('ms.timeline.work')}</span>
        <span class="legend-item"><span class="legend-swatch legend-sleep"></span>{t('ms.timeline.sleep')}</span>
        <span class="legend-item"><span class="legend-swatch legend-overlap"></span>{t('ms.timeline.overlap')}</span>
      </div>
      <div class="timeline-container" id="timeline-container">
        <!-- Rendered by JS -->
      </div>
    </div>

    <!-- Best meeting time -->
    <div class="best-time-card" id="best-time-card">
      <h3 class="card-title">{t('ms.best.title')}</h3>
      <div class="best-time-content" id="best-time-content">
        <!-- Rendered by JS -->
      </div>
    </div>

    <!-- Selected meeting time + WhatsApp link -->
    <div class="meeting-result-card" id="meeting-result-card" style="display:none;">
      <h3 class="card-title">{t('ms.result.title')}</h3>
      <div class="meeting-times" id="meeting-times"></div>
      <div class="meeting-actions">
        <button class="wa-btn" id="wa-btn" type="button">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          {t('ms.result.wa')}
        </button>
        <button class="copy-btn" id="copy-btn" type="button">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
          {t('ms.result.copy')}
        </button>
      </div>
    </div>

    <!-- Time slot picker -->
    <div class="slot-picker-card">
      <h3 class="card-title">{t('ms.picker.title')}</h3>
      <p class="picker-hint">{t('ms.picker.hint')}</p>
      <div class="slot-grid" id="slot-grid">
        <!-- Rendered by JS -->
      </div>
    </div>

    <!-- Business Use Case -->
    <section class="business-section">
      <h2 class="section-title">{t('ms.business.title')}</h2>
      <div class="business-grid">
        <div class="business-card">
          <div class="business-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </div>
          <h3 class="business-card-title">{t('ms.business.wa.title')}</h3>
          <p class="business-card-desc">{t('ms.business.wa.desc')}</p>
        </div>
        <div class="business-card">
          <div class="business-icon remote-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
          </div>
          <h3 class="business-card-title">{t('ms.business.remote.title')}</h3>
          <p class="business-card-desc">{t('ms.business.remote.desc')}</p>
        </div>
        <div class="business-card">
          <div class="business-icon global-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
          </div>
          <h3 class="business-card-title">{t('ms.business.global.title')}</h3>
          <p class="business-card-desc">{t('ms.business.global.desc')}</p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq-section">
      <h2 class="section-title">{t('ms.faq.title')}</h2>
      {[
        { q: t('ms.faq.q1'), a: t('ms.faq.a1') },
        { q: t('ms.faq.q2'), a: t('ms.faq.a2') },
        { q: t('ms.faq.q3'), a: t('ms.faq.a3') },
        { q: t('ms.faq.q4'), a: t('ms.faq.a4') },
        { q: t('ms.faq.q5'), a: t('ms.faq.a5') },
      ].map((item) => (
        <details class="faq-item">
          <summary class="faq-q">{item.q}</summary>
          <p class="faq-a">{item.a}</p>
        </details>
      ))}
    </section>

    <!-- SEO -->
    <section class="seo-section">
      <h2 class="section-title">{t('ms.seo.title')}</h2>
      <div class="seo-grid">
        <div class="seo-card">
          <h3>{t('ms.seo.feature1.title')}</h3>
          <p>{t('ms.seo.feature1.desc')}</p>
        </div>
        <div class="seo-card">
          <h3>{t('ms.seo.feature2.title')}</h3>
          <p>{t('ms.seo.feature2.desc')}</p>
        </div>
        <div class="seo-card">
          <h3>{t('ms.seo.feature3.title')}</h3>
          <p>{t('ms.seo.feature3.desc')}</p>
        </div>
        <div class="seo-card">
          <h3>{t('ms.seo.feature4.title')}</h3>
          <p>{t('ms.seo.feature4.desc')}</p>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  // ===== Meeting Scheduler Logic =====
  const myTzSelect = document.getElementById('my-tz') as HTMLSelectElement;
  const theirTzSelect = document.getElementById('their-tz') as HTMLSelectElement;
  const myCurrentTime = document.getElementById('my-current-time');
  const theirCurrentTime = document.getElementById('their-current-time');
  const workStartInput = document.getElementById('work-start') as HTMLInputElement;
  const workEndInput = document.getElementById('work-end') as HTMLInputElement;
  const timelineContainer = document.getElementById('timeline-container');
  const bestTimeContent = document.getElementById('best-time-content');
  const slotGrid = document.getElementById('slot-grid');
  const meetingResultCard = document.getElementById('meeting-result-card');
  const meetingTimes = document.getElementById('meeting-times');
  const waBtn = document.getElementById('wa-btn');
  const copyBtn = document.getElementById('copy-btn');

  // Localized city names (from server-side i18n)
  const msCityDataEl = document.getElementById('ms-city-data');
  const cityNames: Record<string, string> = msCityDataEl?.dataset?.cities
    ? JSON.parse(msCityDataEl.dataset.cities)
    : {};

  // Localized UI strings (from server-side i18n)
  const msI18nEl = document.getElementById('ms-i18n');
  const pageLocale = msI18nEl?.dataset?.lang || 'en';
  const i18n = {
    meetingAt: msI18nEl?.dataset?.meetingAt || 'Meeting at',
    copied: msI18nEl?.dataset?.copied || 'Copied!',
    copy: msI18nEl?.dataset?.copy || 'Copy',
    noOverlap: msI18nEl?.dataset?.noOverlap || 'No working hours overlap found. Try adjusting your working hours.',
    overlapText: msI18nEl?.dataset?.overlapText || 'overlap window',
    noSlots: msI18nEl?.dataset?.noSlots || 'No overlapping slots available',
  };

  // Get hour in a timezone (0-23)
  function getHourInTz(tz: string, date?: Date): number {
    try {
      const d = date || new Date();
      const formatter = new Intl.DateTimeFormat(pageLocale, {
        timeZone: tz, hour: 'numeric', hour12: false
      });
      const hour = parseInt(formatter.format(d));
      return hour === 24 ? 0 : hour;
    } catch { return 12; }
  }

  // Get offset in minutes for a timezone
  function getOffsetMinutes(tz: string, date?: Date): number {
    const d = date || new Date();
    const utcDate = new Date(d.getTime());
    const tzString = d.toLocaleString(pageLocale, { timeZone: tz });
    const tzDate = new Date(tzString);
    return (tzDate.getTime() - utcDate.getTime()) / 60000;
  }

  // Get offset label
  function getOffsetLabel(tz: string): string {
    try {
      const formatter = new Intl.DateTimeFormat(pageLocale, {
        timeZone: tz, timeZoneName: 'shortOffset'
      });
      const parts = formatter.formatToParts(new Date());
      const offsetPart = parts.find(p => p.type === 'timeZoneName');
      return offsetPart?.value || tz;
    } catch { return tz; }
  }

  // Format time in timezone
  function formatTimeInTz(tz: string, date?: Date): string {
    try {
      const d = date || new Date();
      return new Intl.DateTimeFormat(pageLocale, {
        timeZone: tz, hour: '2-digit', minute: '2-digit', hour12: false
      }).format(d);
    } catch { return '--:--'; }
  }

  // Find overlap between two working hour ranges
  function findOverlap(myTz: string, theirTz: string, workStart: number, workEnd: number): { myStart: number; myEnd: number; theirStart: number; theirEnd: number }[] {
    const myOffset = getOffsetMinutes(myTz);
    const theirOffset = getOffsetMinutes(theirTz);
    const diffHours = (theirOffset - myOffset) / 60;

    // Their working hours in my timezone
    const theirWorkStartInMy = workStart - diffHours;
    const theirWorkEndInMy = workEnd - diffHours;

    const overlaps: { myStart: number; myEnd: number; theirStart: number; theirEnd: number }[] = [];

    // Check today and tomorrow (wrap-around)
    for (let dayOffset = -1; dayOffset <= 1; dayOffset++) {
      const theirStartAdj = theirWorkStartInMy + dayOffset * 24;
      const theirEndAdj = theirWorkEndInMy + dayOffset * 24;

      const overlapStart = Math.max(workStart, theirStartAdj);
      const overlapEnd = Math.min(workEnd, theirEndAdj);

      if (overlapEnd > overlapStart && overlapStart >= 0 && overlapEnd <= 24) {
        overlaps.push({
          myStart: overlapStart,
          myEnd: overlapEnd,
          theirStart: overlapStart + diffHours,
          theirEnd: overlapEnd + diffHours,
        });
      }
    }

    return overlaps;
  }

  // Render timeline
  function renderTimeline() {
    if (!timelineContainer) return;

    const myTz = myTzSelect?.value || 'Europe/Moscow';
    const theirTz = theirTzSelect?.value || 'America/New_York';
    const workStart = parseInt(workStartInput?.value?.split(':')[0] || '9');
    const workEnd = parseInt(workEndInput?.value?.split(':')[0] || '18');

    // Update current times
    if (myCurrentTime) {
      myCurrentTime.textContent = formatTimeInTz(myTz) + ' ' + getOffsetLabel(myTz);
    }
    if (theirCurrentTime) {
      theirCurrentTime.textContent = formatTimeInTz(theirTz) + ' ' + getOffsetLabel(theirTz);
    }

    const myName = cityNames[myTz] || myTz.split('/').pop() || myTz;
    const theirName = cityNames[theirTz] || theirTz.split('/').pop() || theirTz;

    const overlaps = findOverlap(myTz, theirTz, workStart, workEnd);

    // Build timeline HTML
    let html = '';

    // Build hour markers
    const hours = Array.from({ length: 24 }, (_, i) => i);

    // My timeline
    html += '<div class="timeline-row">';
    html += `<div class="timeline-label">${myName}</div>`;
    html += '<div class="timeline-bar">';
    for (let h = 0; h < 24; h++) {
      const isWork = h >= workStart && h < workEnd;
      const isOverlap = overlaps.some(o => h >= Math.floor(o.myStart) && h < Math.ceil(o.myEnd));
      let cls = 'timeline-cell';
      if (isOverlap) cls += ' overlap';
      else if (isWork) cls += ' work';
      else cls += ' sleep';
      html += `<div class="${cls}" data-hour="${h}" title="${h}:00">${h}</div>`;
    }
    html += '</div></div>';

    // Their timeline
    html += '<div class="timeline-row">';
    html += `<div class="timeline-label">${theirName}</div>`;
    html += '<div class="timeline-bar">';
    const theirOffset = getOffsetMinutes(theirTz);
    const myOffset = getOffsetMinutes(myTz);
    const diffHours = (theirOffset - myOffset) / 60;
    for (let h = 0; h < 24; h++) {
      const theirHour = h + diffHours;
      const theirHourNorm = ((theirHour % 24) + 24) % 24;
      const isWork = theirHourNorm >= workStart && theirHourNorm < workEnd;
      const isOverlap = overlaps.some(o => h >= Math.floor(o.myStart) && h < Math.ceil(o.myEnd));
      let cls = 'timeline-cell';
      if (isOverlap) cls += ' overlap';
      else if (isWork) cls += ' work';
      else cls += ' sleep';
      const displayHour = Math.floor(theirHourNorm);
      html += `<div class="${cls}" data-hour="${h}" title="${displayHour}:00 ${theirName}">${displayHour}</div>`;
    }
    html += '</div></div>';

    timelineContainer.innerHTML = html;

    // Best time
    renderBestTime(overlaps, myTz, theirTz, workStart, workEnd);

    // Slot picker
    renderSlotPicker(overlaps, myTz, theirTz);
  }

  function renderBestTime(overlaps: { myStart: number; myEnd: number; theirStart: number; theirEnd: number }[], myTz: string, theirTz: string, workStart: number, workEnd: number) {
    if (!bestTimeContent) return;

    const myName = cityNames[myTz] || myTz.split('/').pop() || myTz;
    const theirName = cityNames[theirTz] || theirTz.split('/').pop() || theirTz;

    if (overlaps.length === 0) {
      bestTimeContent.innerHTML = `<div class="no-overlap">${i18n.noOverlap}</div>`;
      return;
    }

    // Find the longest overlap
    const longest = overlaps.reduce((a, b) => (b.myEnd - b.myStart) > (a.myEnd - a.myStart) ? b : a);
    const duration = longest.myEnd - longest.myStart;
    const midPoint = Math.floor((longest.myStart + longest.myEnd) / 2);

    // Format times
    const myStartStr = formatHour(longest.myStart);
    const myEndStr = formatHour(longest.myEnd);
    const theirStartStr = formatHour(longest.theirStart);
    const theirEndStr = formatHour(longest.theirEnd);

    bestTimeContent.innerHTML = `
      <div class="best-time-main">
        <div class="best-time-label">${myName}</div>
        <div class="best-time-value">${myStartStr} — ${myEndStr}</div>
        <div class="best-time-label">${theirName}</div>
        <div class="best-time-value">${theirStartStr} — ${theirEndStr}</div>
      </div>
      <div class="best-time-duration">${duration}h ${i18n.overlapText}</div>
    `;
  }

  function formatHour(h: number): string {
    const normalized = ((h % 24) + 24) % 24;
    const hours = Math.floor(normalized);
    const minutes = Math.round((normalized - hours) * 60);
    return `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}`;
  }

  // Slot picker
  let selectedSlot: { myHour: number; theirHour: number } | null = null;

  function renderSlotPicker(overlaps: { myStart: number; myEnd: number; theirStart: number; theirEnd: number }[], myTz: string, theirTz: string) {
    if (!slotGrid) return;

    const myName = cityNames[myTz] || myTz.split('/').pop() || myTz;
    const theirName = cityNames[theirTz] || theirTz.split('/').pop() || theirTz;

    if (overlaps.length === 0) {
      slotGrid.innerHTML = `<div class="no-slots">${i18n.noSlots}</div>`;
      return;
    }

    // Generate 1-hour slots from overlaps
    const slots: { myHour: number; theirHour: number }[] = [];
    for (const overlap of overlaps) {
      for (let h = Math.ceil(overlap.myStart); h < Math.floor(overlap.myEnd); h++) {
        if (h >= 0 && h < 24) {
          const theirH = h + (getOffsetMinutes(theirTz) - getOffsetMinutes(myTz)) / 60;
          slots.push({ myHour: h, theirHour: theirH });
        }
      }
    }

    let html = '';
    slots.forEach((slot, i) => {
      const myStr = formatHour(slot.myHour);
      const theirStr = formatHour(slot.theirHour);
      html += `<button class="slot-btn" data-idx="${i}" data-my-hour="${slot.myHour}" data-their-hour="${slot.theirHour}">
        <span class="slot-my">${myStr} ${myName}</span>
        <span class="slot-sep">=</span>
        <span class="slot-their">${theirStr} ${theirName}</span>
      </button>`;
    });

    slotGrid.innerHTML = html;

    // Attach click handlers
    slotGrid.querySelectorAll('.slot-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        slotGrid.querySelectorAll('.slot-btn').forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');
        const myHour = parseFloat(btn.getAttribute('data-my-hour') || '0');
        const theirHour = parseFloat(btn.getAttribute('data-their-hour') || '0');
        selectedSlot = { myHour, theirHour };
        showMeetingResult(myTz, theirTz, myHour, theirHour);
      });
    });
  }

  function showMeetingResult(myTz: string, theirTz: string, myHour: number, theirHour: number) {
    if (!meetingResultCard || !meetingTimes) return;
    const myName = cityNames[myTz] || myTz.split('/').pop() || myTz;
    const theirName = cityNames[theirTz] || theirTz.split('/').pop() || theirTz;

    const myStr = formatHour(myHour);
    const theirStr = formatHour(theirHour);

    meetingTimes.innerHTML = `
      <div class="meeting-time-row">
        <span class="meeting-time-label">${myName}</span>
        <span class="meeting-time-value">${myStr}</span>
      </div>
      <div class="meeting-time-row">
        <span class="meeting-time-label">${theirName}</span>
        <span class="meeting-time-value">${theirStr}</span>
      </div>
    `;
    meetingResultCard.style.display = '';

    // Generate WhatsApp message
    const message = `${i18n.meetingAt} ${myStr} (${myName}) / ${theirStr} (${theirName})`;
    if (waBtn) {
      waBtn.onclick = () => {
        window.open(`https://wa.me/?text=${encodeURIComponent(message)}`, '_blank');
      };
    }
    if (copyBtn) {
      copyBtn.onclick = () => {
        navigator.clipboard.writeText(message).then(() => {
          const original = copyBtn.textContent;
          copyBtn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg> ${i18n.copied}`;
          setTimeout(() => {
            copyBtn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg> ${i18n.copy}`;
          }, 2000);
        });
      };
    }
  }

  // Live updates
  myTzSelect?.addEventListener('change', () => { selectedSlot = null; meetingResultCard && (meetingResultCard.style.display = 'none'); renderTimeline(); });
  theirTzSelect?.addEventListener('change', () => { selectedSlot = null; meetingResultCard && (meetingResultCard.style.display = 'none'); renderTimeline(); });
  workStartInput?.addEventListener('change', () => { selectedSlot = null; meetingResultCard && (meetingResultCard.style.display = 'none'); renderTimeline(); });
  workEndInput?.addEventListener('change', () => { selectedSlot = null; meetingResultCard && (meetingResultCard.style.display = 'none'); renderTimeline(); });

  // Initial render + live clock
  renderTimeline();
  setInterval(() => {
    if (myCurrentTime) myCurrentTime.textContent = formatTimeInTz(myTzSelect?.value || 'Europe/Moscow') + ' ' + getOffsetLabel(myTzSelect?.value || 'Europe/Moscow');
    if (theirCurrentTime) theirCurrentTime.textContent = formatTimeInTz(theirTzSelect?.value || 'America/New_York') + ' ' + getOffsetLabel(theirTzSelect?.value || 'America/New_York');
  }, 1000);
</script>

