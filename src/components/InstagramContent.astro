---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';
import { getRelativeLocaleUrl, getAbsoluteLocaleUrl } from 'astro:i18n';
import { languages, type Lang } from '../i18n/ui';
import SiteHeader from './SiteHeader.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import SEOHead from './SEOHead.astro';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Schema.org — FAQ data
const faqItems = [
  { q: t('ig.seo.faq.q1'), a: t('ig.seo.faq.a1') },
  { q: t('ig.seo.faq.q2'), a: t('ig.seo.faq.a2') },
  { q: t('ig.seo.faq.q3'), a: t('ig.seo.faq.a3') },
  { q: t('ig.seo.faq.q4'), a: t('ig.seo.faq.a4') },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "OPN Chat — Instagram Direct",
      "url": getAbsoluteLocaleUrl(lang, 'instagram'),
      "description": t('ig.meta.description'),
      "applicationCategory": "CommunicationApplication",
      "operatingSystem": "Any",
      "browserRequirements": "Requires JavaScript. Requires Instagram app installed.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "inLanguage": Object.keys(languages),
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "OPN Chat",
          "item": getAbsoluteLocaleUrl(lang, '')
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Instagram Direct",
          "item": getAbsoluteLocaleUrl(lang, 'instagram')
        }
      ]
    }
  ]
};
---

<Layout title={t('ig.meta.title')} lang={lang} service="instagram">
  <Fragment slot="meta">
  <SEOHead
    lang={lang}
    description={t('ig.meta.description')}
    canonicalUrl={getAbsoluteLocaleUrl(lang, 'instagram')}
    ogTitle={t('ig.meta.og.title')}
    ogDescription={t('ig.meta.og.description')}
    ogUrl={getAbsoluteLocaleUrl(lang, 'instagram')}
    schema={pageSchema}
    extraMeta={`<meta name="keywords" content="${t('ig.meta.keywords')}" /><meta name="twitter:card" content="summary" /><meta name="twitter:title" content="${t('ig.meta.twitter.title')}" /><meta name="twitter:description" content="${t('ig.meta.twitter.description')}" />`}
/>
</Fragment>

  <div class="container">
    <SiteHeader lang={lang} path="instagram" activeTool="instagram" />

    <Breadcrumbs lang={lang} items={[{ label: t('bc.home'), href: getRelativeLocaleUrl(lang) }, { label: t('bc.instagram') }]} />

    <!-- Hero -->
    <div class="hero">
      <div class="ig-logo">
        <svg viewBox="0 0 24 24" fill="none" width="48" height="48">
          <defs>
            <linearGradient id="ig-gradient" x1="0%" y1="100%" x2="100%" y2="0%">
              <stop offset="0%" style="stop-color:#FD5949"/>
              <stop offset="50%" style="stop-color:#D6249F"/>
              <stop offset="100%" style="stop-color:#285AEB"/>
            </linearGradient>
          </defs>
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5" fill="url(#ig-gradient)"/>
          <path d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 8a3 3 0 1 1 0-6 3 3 0 0 1 0 6z" fill="white"/>
          <circle cx="17.5" cy="6.5" r="1" fill="white"/>
        </svg>
      </div>
      <h1 class="title">{t('ig.header.description')}</h1>
    </div>

    <!-- Form -->
    <form id="ig-form" class="form">
      <div class="input-group">
        <label for="username" class="label">{t('ig.form.label.username')}</label>
        <div class="username-input-group">
          <span class="username-prefix">@</span>
          <input
            type="text"
            id="username"
            class="username-input"
            placeholder={t('ig.form.placeholder.username')}
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            pattern="[a-zA-Z0-9_.]{1,30}"
          />
        </div>
        <span class="hint">{t('ig.form.hint.username')}</span>
      </div>

      <span id="error-msg" class="error-msg" role="alert"></span>

      <!-- Action Buttons -->
      <div class="form-actions">
        <button type="submit" class="submit-btn" id="submit-btn">
          <svg viewBox="0 0 24 24" fill="currentColor" class="btn-icon">
            <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
          </svg>
          {t('ig.form.submit')}
        </button>
        <button type="button" class="copy-link-btn" id="copy-dm-btn" aria-label="Copy DM link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="copy-link-icon">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
          </svg>
          <span id="copy-dm-text">{t('ig.form.copyDm')}</span>
        </button>
        <button type="button" class="copy-link-btn copy-profile-btn" id="copy-profile-btn" aria-label="Copy profile link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="copy-link-icon">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
          <span id="copy-profile-text">{t('ig.form.copyProfile')}</span>
        </button>
      </div>
    </form>

    <!-- Result Section -->
    <div id="result-section" class="result-section" style="display:none;">
      <h3 class="result-title">{t('ig.result.title')}</h3>
      
      <div class="link-card dm-card">
        <div class="link-card-header">
          <svg viewBox="0 0 24 24" fill="currentColor" class="link-card-icon">
            <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.17L4 17.17V4h16v12z"/>
            <path d="M7 9h2v2H7zm4 0h2v2h-2zm4 0h2v2h-2z"/>
          </svg>
          <span>{t('ig.result.dmLink')}</span>
        </div>
        <a id="dm-link" href="#" target="_blank" rel="noopener noreferrer" class="generated-link"></a>
      </div>

      <div class="link-card profile-card">
        <div class="link-card-header">
          <svg viewBox="0 0 24 24" fill="currentColor" class="link-card-icon">
            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
          </svg>
          <span>{t('ig.result.profileLink')}</span>
        </div>
        <a id="profile-link" href="#" target="_blank" rel="noopener noreferrer" class="generated-link"></a>
      </div>
    </div>

    <!-- How it works -->
    <div class="how-it-works">
      <h3 class="section-heading">{t('ig.howItWorks.title')}</h3>
      <ol class="steps-list">
        <li class="step-item">
          <span class="step-number">1</span>
          <div class="step-content">
            <strong>{t('ig.howItWorks.step1.title')}</strong>
            <p>{t('ig.howItWorks.step1.desc')}</p>
          </div>
        </li>
        <li class="step-item">
          <span class="step-number">2</span>
          <div class="step-content">
            <strong>{t('ig.howItWorks.step2.title')}</strong>
            <p>{t('ig.howItWorks.step2.desc')}</p>
          </div>
        </li>
        <li class="step-item">
          <span class="step-number">3</span>
          <div class="step-content">
            <strong>{t('ig.howItWorks.step3.title')}</strong>
            <p>{t('ig.howItWorks.step3.desc')}</p>
          </div>
        </li>
      </ol>
    </div>

    <!-- SEO Content -->
    <div class="seo-content">
      <h2 class="seo-heading">{t('ig.seo.mainHeading')}</h2>
      <div class="seo-text">
        <p>{t('ig.seo.text1')}</p>
        <p>{t('ig.seo.text2')}</p>
        <p>{t('ig.seo.text3')}</p>
      </div>
      
      <h3 class="seo-subheading">{t('ig.seo.featuresHeading')}</h3>
      <ul class="features-list">
        <li><strong>{t('ig.seo.feature1.title')}</strong> — {t('ig.seo.feature1.desc')}</li>
        <li><strong>{t('ig.seo.feature2.title')}</strong> — {t('ig.seo.feature2.desc')}</li>
        <li><strong>{t('ig.seo.feature3.title')}</strong> — {t('ig.seo.feature3.desc')}</li>
        <li><strong>{t('ig.seo.feature4.title')}</strong> — {t('ig.seo.feature4.desc')}</li>
      </ul>
    </div>

    <!-- FAQ Section -->
    <div class="faq-section">
      <h2 class="faq-heading">{t('ig.seo.faq.heading')}</h2>
      {faqItems.map((item) => (
        <details class="faq-item">
          <summary class="faq-question">{item.q}</summary>
          <p class="faq-answer">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</Layout>

<style>
  .container {
    max-width: 680px;
    margin: 0 auto;
    padding: 1rem;
    font-family: var(--font-body);
  }

  /* Hero */
  .hero {
    text-align: center;
    padding: 2rem 0 1.5rem;
  }

  .ig-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .title {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    line-height: 1.2;
  }

  /* Form */
  .form {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 1.75rem;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,.07), 0 2px 4px -2px rgba(0,0,0,.05);
  }

  .input-group {
    margin-bottom: 1.25rem;
  }

  .label {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .username-input-group {
    display: flex;
    align-items: center;
    background: var(--bg-primary);
    border: 2px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .username-input-group:focus-within {
    border-color: #E1306C;
  }

  .username-prefix {
    padding: 0 1rem;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-secondary);
    background: transparent;
    border-right: 2px solid var(--border-color);
    user-select: none;
  }

  .username-input {
    flex: 1;
    padding: 0.85rem 1rem;
    font-size: 1.05rem;
    border: none;
    background: transparent;
    color: var(--text-primary);
    outline: none;
    min-width: 0;
  }

  .username-input::placeholder {
    color: var(--text-muted);
  }

  .hint {
    display: block;
    font-size: 0.82rem;
    color: var(--text-secondary);
    margin-top: 0.45rem;
  }

  .error-msg {
    display: none;
    color: #EF4444;
    font-size: 0.88rem;
    background: #FEF2F2;
    padding: 0.65rem 1rem;
    border-radius: 8px;
    border: 1px solid #FECACA;
    margin-bottom: 1rem;
  }

  /* Action Buttons */
  .form-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .submit-btn {
    flex: 1;
    min-width: 140px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.9rem 1.5rem;
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    background: linear-gradient(135deg, #833AB4, #E1306C, #F77737);
    border: none;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(225, 48, 108, 0.35);
  }

  .submit-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(225, 48, 108, 0.45);
  }

  .btn-icon {
    width: 18px;
    height: 18px;
  }

  .copy-link-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.9rem 1.1rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-secondary);
    background: var(--bg-primary);
    border: 2px solid var(--border-color);
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .copy-link-btn:hover {
    border-color: #E1306C;
    color: #E1306C;
    background: rgba(225, 48, 108, 0.08);
  }

  .copy-link-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  /* Result Section */
  .result-section {
    margin-top: 1.5rem;
    animation: fadeInUp 0.3s ease;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .result-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .link-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    margin-bottom: 0.75rem;
    transition: border-color 0.2s ease;
  }

  .link-card:hover {
    border-color: #E1306C;
  }

  .dm-card:hover {
    border-color: #833AB4;
  }

  .link-card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .link-card-icon {
    width: 16px;
    height: 16px;
    opacity: 0.7;
  }

  .generated-link {
    display: block;
    font-size: 0.95rem;
    color: #E1306C;
    word-break: break-all;
    text-decoration: none;
    font-weight: 500;
  }

  .generated-link:hover {
    text-decoration: underline;
  }

  /* How it works */
  .how-it-works {
    margin-top: 2.5rem;
    padding: 1.5rem;
    background: var(--bg-secondary);
    border-radius: 16px;
    border: 1px solid var(--border-color);
  }

  .section-heading {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .steps-list {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: step-counter;
  }

  .step-item {
    display: flex;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--border-color);
  }

  .step-item:last-child {
    border-bottom: none;
  }

  .step-number {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #833AB4, #E1306C);
    color: white;
    border-radius: 50%;
    font-weight: 700;
    font-size: 0.9rem;
  }

  .step-content strong {
    display: block;
    font-size: 0.95rem;
    color: var(--text-primary);
    margin-bottom: 0.2rem;
  }

  .step-content p {
    font-size: 0.87rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  /* SEO Content */
  .seo-content {
    margin-top: 2.5rem;
  }

  .seo-heading {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .seo-subheading {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 1.5rem 0 0.75rem;
  }

  .seo-text p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 0.85rem;
  }

  .features-list {
    padding-left: 1.25rem;
    margin: 0;
  }

  .features-list li {
    font-size: 0.93rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 0.6rem;
  }

  /* FAQ */
  .faq-section {
    margin-top: 2.5rem;
  }

  .faq-heading {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .faq-item {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    margin-bottom: 0.75rem;
    overflow: hidden;
  }

  .faq-question {
    padding: 1rem 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    cursor: pointer;
    user-select: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
    font-size: 0.95rem;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question::after {
    content: '+';
    font-size: 1.2rem;
    font-weight: 300;
    color: var(--text-secondary);
    transition: transform 0.2s;
  }

  .faq-item[open] .faq-question::after {
    content: '\2212';
  }

  .faq-question:hover {
    background: var(--border-color);
  }

  .faq-answer {
    padding: 0 1.25rem 1rem 1.25rem;
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  @media (max-width: 520px) {
    .title {
      font-size: 1.6rem;
    }

    .form {
      padding: 1.25rem;
    }
    
    .form-actions {
      flex-direction: column;
    }
    
    .copy-link-btn {
      justify-content: center;
    }

    .seo-heading {
      font-size: 1.2rem;
    }
    .seo-text {
      font-size: 0.85rem;
    }
  }
</style>

<script define:vars={{ lang }}>
  // ==================== FORM HANDLING ====================
  const form = document.getElementById('ig-form');
  const usernameInput = document.getElementById('username');
  const errorMsg = document.getElementById('error-msg');
  const resultSection = document.getElementById('result-section');
  const dmLink = document.getElementById('dm-link');
  const profileLink = document.getElementById('profile-link');
  const copyDmBtn = document.getElementById('copy-dm-btn');
  const copyProfileBtn = document.getElementById('copy-profile-btn');
  const copyDmText = document.getElementById('copy-dm-text');
  const copyProfileText = document.getElementById('copy-profile-text');

  let currentUsername = '';

  function showError(msg) {
    errorMsg.textContent = msg;
    errorMsg.style.display = 'block';
  }

  function hideError() {
    errorMsg.style.display = 'none';
  }

  function sanitizeUsername(input) {
    // Remove @ if user typed it, trim whitespace
    return input.replace(/^@/, '').trim().toLowerCase();
  }

  function validateUsername(username) {
    if (!username) {
      return lang === 'ru' ? 'Введите имя пользователя' : 'Please enter a username';
    }
    if (username.length < 1 || username.length > 30) {
      return lang === 'ru' ? 'Имя пользователя должно быть от 1 до 30 символов' : 'Username must be 1-30 characters';
    }
    // Instagram allows: letters, numbers, dots, underscores
    if (!/^[a-z0-9_.]+$/.test(username)) {
      return lang === 'ru' ? 'Только буквы, цифры, точки и подчёркивания' : 'Only letters, numbers, dots and underscores';
    }
    return null;
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    hideError();

    const rawValue = usernameInput.value;
    currentUsername = sanitizeUsername(rawValue);

    const error = validateUsername(currentUsername);
    if (error) {
      showError(error);
      return;
    }

    // Generate links
    const dmUrl = `https://ig.me/m/${currentUsername}`;
    const profileUrl = `https://instagram.com/${currentUsername}`;

    dmLink.href = dmUrl;
    dmLink.textContent = dmUrl;
    profileLink.href = profileUrl;
    profileLink.textContent = profileUrl;

    // Show results
    resultSection.style.display = 'block';

    // Scroll to results smoothly
    resultSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });

  // Real-time validation feedback
  usernameInput.addEventListener('input', () => {
    hideError();
    if (resultSection.style.display !== 'none') {
      const sanitized = sanitizeUsername(usernameInput.value);
      if (validateUsername(sanitized) === null && sanitized) {
        currentUsername = sanitized;
        const dmUrl = `https://ig.me/m/${sanitized}`;
        const profileUrl = `https://instagram.com/${sanitized}`;
        dmLink.href = dmUrl;
        dmLink.textContent = dmUrl;
        profileLink.href = profileUrl;
        profileLink.textContent = profileUrl;
        resultSection.style.display = 'block';
      } else {
        resultSection.style.display = 'none';
      }
    }
  });

  // ==================== COPY FUNCTIONALITY ====================
  async function copyToClipboard(text, btn, originalText) {
    try {
      await navigator.clipboard.writeText(text);
      btn.querySelector('span').textContent = lang === 'ru' ? 'Скопировано!' : 'Copied!';
      setTimeout(() => {
        btn.querySelector('span').textContent = originalText;
      }, 2000);
    } catch (err) {
      console.error('Failed to copy:', err);
    }
  }

  copyDmBtn.addEventListener('click', () => {
    if (currentUsername) {
      copyToClipboard(`https://ig.me/m/${currentUsername}`, copyDmBtn, copyDmText.textContent);
    }
  });

  copyProfileBtn.addEventListener('click', () => {
    if (currentUsername) {
      copyToClipboard(`https://instagram.com/${currentUsername}`, copyProfileBtn, copyProfileText.textContent);
    }
  });
</script>
