---
import { useTranslations } from '../i18n/utils';

export interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="top-banner" id="top-banner">
  <div class="banner-content">
    <div class="banner-icons">
      <svg class="banner-icon shield-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        <path d="m9 12 2 2 4-4"/>
      </svg>
      <svg class="banner-icon lock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
    </div>
    <span class="banner-text">{t('banner.free')}</span>
    <span class="banner-separator">•</span>
    <span class="banner-text">{t('banner.private')}</span>
    <button class="banner-close" id="banner-close" aria-label={t('banner.close')} title={t('banner.close')}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>
</div>

<style>
  .top-banner {
    background: linear-gradient(135deg, rgba(37, 211, 102, 0.15) 0%, rgba(56, 189, 248, 0.12) 100%);
    border-bottom: 1px solid rgba(37, 211, 102, 0.25);
    padding: 10px 16px;
    position: relative;
    animation: bannerSlideDown 0.4s ease-out;
  }

  @keyframes bannerSlideDown {
    from {
      opacity: 0;
      transform: translateY(-100%);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .banner-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    max-width: 900px;
    margin: 0 auto;
    flex-wrap: wrap;
  }

  .banner-icons {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .banner-icon {
    width: 18px;
    height: 18px;
    color: var(--opn-primary);
    flex-shrink: 0;
  }

  .shield-icon {
    color: #25D366;
  }

  .lock-icon {
    color: #38bdf8;
  }

  .banner-text {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .banner-separator {
    color: var(--text-secondary);
    font-size: 12px;
    user-select: none;
  }

  .banner-close {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: transparent;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 0;
  }

  .banner-close:hover {
    background: rgba(128, 128, 128, 0.15);
    color: var(--text-primary);
  }

  .banner-close:focus-visible {
    outline: 2px solid var(--opn-primary);
    outline-offset: 2px;
  }

  .banner-close svg {
    width: 14px;
    height: 14px;
  }

  /* Hidden state */
  .top-banner.hidden {
    display: none;
  }

  /* RTL support */
  [dir="rtl"] .banner-close {
    right: auto;
    left: 8px;
  }

  @media (max-width: 520px) {
    .top-banner {
      padding: 8px 12px;
    }
    
    .banner-text {
      font-size: 12px;
    }
    
    .banner-icon {
      width: 16px;
      height: 16px;
    }
    
    .banner-close {
      width: 26px;
      height: 26px;
      right: 4px;
    }
    
    [dir="rtl"] .banner-close {
      left: 4px;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var banner = document.getElementById('top-banner');
    var closeBtn = document.getElementById('banner-close');
    
    if (!banner || !closeBtn) return;
    
    // Check if user previously closed the banner
    if (localStorage.getItem('opnchat-banner-closed') === 'true') {
      banner.classList.add('hidden');
    }
    
    closeBtn.addEventListener('click', function() {
      banner.classList.add('hidden');
      localStorage.setItem('opnchat-banner-closed', 'true');
    });
  });
  
  // Re-attach after View Transitions
  document.addEventListener('astro:after-swap', function() {
    var banner = document.getElementById('top-banner');
    var closeBtn = document.getElementById('banner-close');
    
    if (!banner || !closeBtn) return;
    
    if (localStorage.getItem('opnchat-banner-closed') === 'true') {
      banner.classList.add('hidden');
    }
    
    closeBtn.onclick = function() {
      banner.classList.add('hidden');
      localStorage.setItem('opnchat-banner-closed', 'true');
    };
  });
</script>
