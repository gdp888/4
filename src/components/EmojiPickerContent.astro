  // Remove duplicate emojis
  for (const cat of Object.keys(emojiData)) {
    const seen = new Set<string>();
    emojiData[cat] = emojiData[cat].filter(item => {
      if (seen.has(item.emoji)) return false;
      seen.add(item.emoji);
      return true;
    });
  }

  // State
  let currentCat = 'smileys';
  const recentMax = 24;

  // Render emoji grid
  function renderGrid(cat: string, searchQuery?: string) {
    const grid = document.getElementById('ep-grid');
    const empty = document.getElementById('ep-empty');
    if (!grid || !empty) return;

    let items = emojiData[cat] || [];

    if (searchQuery && searchQuery.trim()) {
      const q = searchQuery.trim().toLowerCase();
      // Search across ALL categories
      const allItems = Object.values(emojiData).flat();
      items = allItems.filter(item =>
        item.keywords.some(kw => kw.toLowerCase().includes(q)) || item.emoji.includes(q)
      );
    }

    if (items.length === 0) {
      grid.innerHTML = '';
      empty.style.display = 'block';
      return;
    }

    empty.style.display = 'none';
    grid.innerHTML = items.map(item =>
      `<button type="button" class="ep-emoji-btn" data-emoji="${item.emoji}" title="${item.keywords.join(', ')}">${item.emoji}</button>`
    ).join('');

    // Attach copy handlers
    grid.querySelectorAll('.ep-emoji-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const emoji = (btn as HTMLElement).getAttribute('data-emoji') || '';
        navigator.clipboard.writeText(emoji).then(() => {
          // Toast notification
          showToast(emoji);
          // Add to recently used
          addToRecent(emoji);
          // Brief highlight
          btn.classList.add('copied');
          setTimeout(() => btn.classList.remove('copied'), 400);
        });
      });
    });
  }

  // Toast
  function showToast(emoji: string) {
    const toast = document.getElementById('ep-toast');
    const toastEmoji = document.getElementById('ep-toast-emoji');
    const toastText = document.getElementById('ep-toast-text');
    if (!toast || !toastEmoji || !toastText) return;

    toastEmoji.textContent = emoji;
    toast.style.display = 'flex';
    // Force re-animation
    toast.style.animation = 'none';
    toast.offsetHeight; // trigger reflow
    toast.style.animation = 'ep-toast-in 0.3s ease, ep-toast-out 0.3s ease 1.2s forwards';

    setTimeout(() => {
      toast.style.display = 'none';
    }, 1500);
  }

  // Recently used
  function addToRecent(emoji: string) {
    let recent: string[] = [];
    try {
      const stored = localStorage.getItem('opnchat-emoji-recent');
      if (stored) recent = JSON.parse(stored);
    } catch {}

    // Remove duplicate if exists, add to front
    recent = recent.filter(e => e !== emoji);
    recent.unshift(emoji);
    if (recent.length > recentMax) recent = recent.slice(0, recentMax);

    localStorage.setItem('opnchat-emoji-recent', JSON.stringify(recent));
    renderRecent();
  }

  function renderRecent() {
    const section = document.getElementById('ep-recent-section');
    const grid = document.getElementById('ep-recent-grid');
    if (!section || !grid) return;

    let recent: string[] = [];
    try {
      const stored = localStorage.getItem('opnchat-emoji-recent');
      if (stored) recent = JSON.parse(stored);
    } catch {}

    if (recent.length === 0) {
      section.style.display = 'none';
      return;
    }

    section.style.display = 'block';
    grid.innerHTML = recent.map(emoji =>
      `<button type="button" class="ep-emoji-btn" data-emoji="${emoji}">${emoji}</button>`
    ).join('');

    grid.querySelectorAll('.ep-emoji-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const emoji = (btn as HTMLElement).getAttribute('data-emoji') || '';
        navigator.clipboard.writeText(emoji).then(() => {
          showToast(emoji);
          addToRecent(emoji);
        });
      });
    });
  }

  // Category tabs
  function initCategories() {
    const catBtns = document.querySelectorAll('.ep-cat-btn');
    catBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Clear search
        const searchInput = document.getElementById('ep-search') as HTMLInputElement;
        if (searchInput) searchInput.value = '';

        // Update active
        catBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        currentCat = (btn as HTMLElement).getAttribute('data-cat') || 'smileys';
        renderGrid(currentCat);
      });
    });
  }

  // Search
  function initSearch() {
    const searchInput = document.getElementById('ep-search') as HTMLInputElement;
    if (!searchInput) return;

    searchInput.addEventListener('input', () => {
      const q = searchInput.value;
      if (q.trim()) {
        // Deactivate category highlighting during search
        document.querySelectorAll('.ep-cat-btn').forEach(b => b.classList.remove('active'));
        renderGrid(currentCat, q);
      } else {
        // Restore active category
        const activeBtn = document.querySelector(`.ep-cat-btn[data-cat="${currentCat}"]`);
        if (activeBtn) activeBtn.classList.add('active');
        renderGrid(currentCat);
      }
    });
  }

  // Initialize
  renderGrid('smileys');
  initCategories();
  initSearch();
  renderRecent();

  // FAQ toggle
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      if (item) item.classList.toggle('open');
      btn.setAttribute('aria-expanded', item?.classList.contains('open') ? 'true' : 'false');
    });
  });

  // Theme toggle
  const themeBtn = document.getElementById('theme-toggle');
  if (themeBtn) {
    themeBtn.addEventListener('click', () => {
      const root = document.documentElement;
      const current = root.getAttribute('data-theme');
      root.setAttribute('data-theme', current === 'dark' ? 'light' : 'dark');
      localStorage.setItem('opnchat-theme', current === 'dark' ? 'light' : 'dark');
    });
    // Restore saved theme
    const saved = localStorage.getItem('opnchat-theme');
    if (saved) document.documentElement.setAttribute('data-theme', saved);
  }
