</main>
</Layout>

<style>
  .container {
    position: relative;
    z-index: 1;
    width: 100%;
    margin: 0 auto;
    max-width: 640px;
    padding: 2rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (max-width: 640px) {

  }

  /* Hero */
  .hero {
    text-align: center;
    margin-bottom: 0.5rem;
  }

  .title {
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.2;
    color: var(--text-primary);
  }

  /* title is now pure description — brand lives in the logo */

  .subtitle {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-top: 0.5rem;
    line-height: 1.5;
  }

  /* Service Cards Grid */
  .services-grid {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .service-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.15rem 1.25rem;
    background: var(--bg-secondary);
    border: 1.5px solid var(--border-color);
    border-radius: 14px;
    text-decoration: none;
    transition: all 0.25s ease;
    cursor: pointer;
  }

  .service-card:hover {
    border-color: var(--opn-primary);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.1);
  }

  /* Card Icon */
  .card-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    flex-shrink: 0;
  }

  .wl-icon {
    background: rgba(37, 211, 102, 0.12);
    color: #25D366;
  }

  .tglink-icon {
    background: rgba(42, 171, 238, 0.12);
    color: #2AABEE;
  }

  .tg-icon {
    background: rgba(42, 171, 238, 0.12);
    color: #2AABEE;
  }

  .qr-icon {
    background: rgba(139, 92, 246, 0.12);
    color: #8B5CF6;
  }

  .pw-icon {
    background: rgba(234, 179, 8, 0.12);
    color: #EAB308;
  }

  .np-icon {
    background: rgba(99, 102, 241, 0.12);
    color: #6366F1;
  }

  .cv-icon {
    background: rgba(245, 158, 11, 0.12);
    color: #F59E0B;
  }

  .fmt-icon {
    background: rgba(37, 211, 102, 0.12);
    color: #25D366;
  }

  .wc-icon {
    background: rgba(139, 92, 246, 0.12);
    color: #8B5CF6;
  }

  .wl-icon {
    background: rgba(37, 211, 102, 0.12);
    color: #25D366;
  }

  .cs-icon {
    background: rgba(134, 150, 168, 0.12);
    color: var(--text-secondary);
  }

  .cw-icon {
    background: rgba(37, 211, 102, 0.12);
    color: #25D366;
  }

