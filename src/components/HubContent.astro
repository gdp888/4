---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';
import { getRelativeLocaleUrl, getAbsoluteLocaleUrl } from 'astro:i18n';
import { languages, defaultLang, type Lang } from '../i18n/ui';
import SiteHeader from './SiteHeader.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import SEOHead from './SEOHead.astro';
import { localeMap } from '../i18n/localeMap';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const hubSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "name": "OPN Chat",
      "url": getAbsoluteLocaleUrl(lang, ''),
      "description": t('hub.meta.description'),
      "inLanguage": Object.keys(languages),
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "OPN Chat",
          "item": getAbsoluteLocaleUrl(lang, '')
        }
      ]
    }
  ]
};
---

<Layout title={t('hub.meta.title')} lang={lang} service="">
  <Fragment slot="meta">
  <SEOHead
  lang={lang}
  description={t('hub.meta.description')}
  canonicalUrl={getAbsoluteLocaleUrl(lang, '')}
  ogTitle={t('hub.meta.title')}
  ogDescription={t('hub.meta.description')}
  ogUrl={getAbsoluteLocaleUrl(lang, '')}
  schema={hubSchema}
  extraMeta={`<meta name="keywords" content="${t('hub.meta.keywords')}" /><meta name="twitter:card" content="summary" /><meta name="twitter:title" content="${t('hub.meta.title')}" /><meta name="twitter:description" content="${t('hub.meta.description')}" />`}
/>
  <!-- Language auto-detect: ONLY on the hub root page, never on internal pages -->
  <script is:inline>
      (function() {
        var supportedLangs = ['es', 'pt', 'id', 'ru'];
        var path = window.location.pathname;

        // Save current language preference from URL
        var langMatch = path.match(/^\/(es|pt|id|ru)(\/|$)/);
        if (langMatch) {
          localStorage.setItem('opnchat-lang', langMatch[1]);
        }

        // Auto-redirect only on the English hub root
        var isEnglishHub = (path === '/' || path === '');
        var savedLang = localStorage.getItem('opnchat-lang');

        if (isEnglishHub) {
          if (!savedLang) {
            // First-time visitor — detect browser language
            var browserLang = (navigator.language || navigator.userLanguage || 'en').split('-')[0].toLowerCase();
            if (supportedLangs.indexOf(browserLang) !== -1) {
              localStorage.setItem('opnchat-lang', browserLang);
              window.location.replace('/' + browserLang + '/');
            } else {
              // English or unsupported — save 'en' so we don't keep checking
              localStorage.setItem('opnchat-lang', 'en');
            }
          } else if (supportedLangs.indexOf(savedLang) !== -1) {
            // Returning visitor with saved non-English preference — redirect
            window.location.replace('/' + savedLang + '/');
          }
          // savedLang === 'en' — stay on English hub
        }
      })();
    </script>
</Fragment>

  <main class="container">
    <SiteHeader lang={lang} path="" />

    <!-- Hero -->
    <div class="hero">
      <h1 class="title">{t('hub.hero.title')}</h1>
      <p class="subtitle">{t('hub.hero.subtitle')}</p>
    </div>

    <!-- Service Cards -->
    <div class="services-grid">
      <!-- WhatsApp Card -->
      <a href={getRelativeLocaleUrl(lang, 'whatsapp')} class="service-card whatsapp-card">
        <div class="card-icon-wrapper wa-icon">
          <svg viewBox="0 0 24 24" fill="currentColor" class="card-icon" aria-hidden="true">
