      <!-- ===== TEXT TOOLS SECTION ===== -->
      <div class="category-section">
        <h2 class="category-heading">{t('hub.category.texttools')}</h2>
        <div class="category-cards">
          <!-- Fancy Text Card -->
          <a href={getRelativeLocaleUrl(lang, 'fancy-text')} class="service-card fancytext-card">
            <div class="card-icon-wrapper ft-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="card-icon" aria-hidden="true">
