---
import { languages, type Lang } from '../i18n/ui';
import { localeMap } from '../i18n/localeMap';

export interface Props {
  lang: Lang;
  description: string;
  canonicalUrl: string;
  ogTitle: string;
  ogDescription: string;
  ogUrl: string;
  ogType?: string;
  /** Schema.org JSON-LD object — rendered as <script type="application/ld+json"> */
  schema?: object;
  /** Extra meta tags to inject before the schema */
  extraMeta?: string;
}

const { lang, description, canonicalUrl, ogTitle, ogDescription, ogUrl, ogType, schema, extraMeta } = Astro.props;

const otherLangs = (Object.keys(languages) as Lang[]).filter(l => l !== lang);
const alternateLocales = otherLangs.map(l => localeMap[l]);
---

<meta name="description" content={description} />
{extraMeta && <Fragment set:html={extraMeta} />}
<link rel="canonical" href={canonicalUrl} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:url" content={ogUrl} />
<meta property="og:type" content={ogType || 'website'} />
<meta property="og:site_name" content="OPN Chat" />
<meta property="og:locale" content={localeMap[lang]} />
{alternateLocales.map(loc => (
  <meta property="og:locale:alternate" content={loc} />
))}
{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
