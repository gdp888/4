  // Style labels (displayed in cards)
  const styleLabels: Record<string, string> = {
    bold: 'Bold',
    italic: 'Italic',
    boldItalic: 'Bold Italic',
    script: 'Script',
    boldScript: 'Bold Script',
    fraktur: 'Fraktur',
    boldFraktur: 'Bold Fraktur',
    doubleStruck: 'Double-Struck',
    monospace: 'Monospace',
    circled: 'Circled',
    squared: 'Squared',
    smallCaps: 'Small Caps',
    upsideDown: 'Upside Down',
  };

  function convertText(input: string, map: Record<string, string>): string {
    return input.split('').map(ch => {
      if (map[ch]) return map[ch];
      // Keep digits, spaces, punctuation, and non-Latin characters unchanged
      return ch;
    }).join('');
  }

  function generateResults(input: string): void {
    const container = document.getElementById('ft-results');
    if (!container) return;

    if (!input.trim()) {
      container.innerHTML = '';
      return;
    }

    const copyLabel = (document.querySelector('.ft-copy-btn')?.getAttribute('data-copy') || 'Copy');
    const copiedLabel = (document.querySelector('.ft-copy-btn')?.getAttribute('data-copied') || 'Copied!');

    container.innerHTML = Object.keys(styleMaps).map(styleName => {
      const map = styleMaps[styleName];
      const label = styleLabels[styleName] || styleName;
      const output = convertText(input, map);
      return `
        <div class="ft-result-card">
          <span class="ft-style-name">${label}</span>
          <span class="ft-style-output">${output}</span>
          <button type="button" class="ft-copy-btn" data-copy="${copyLabel}" data-copied="${copiedLabel}" data-text="${output}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ft-copy-icon"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <span>${copyLabel}</span>
          </button>
        </div>
      `;
    }).join('');

    // Attach copy handlers
    container.querySelectorAll('.ft-copy-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const text = (btn as HTMLElement).getAttribute('data-text') || '';
        navigator.clipboard.writeText(text).then(() => {
          btn.classList.add('copied');
          const span = btn.querySelector('span');
          if (span) span.textContent = btn.getAttribute('data-copied');
          setTimeout(() => {
            btn.classList.remove('copied');
            if (span) span.textContent = btn.getAttribute('data-copy');
          }, 1500);
        });
      });
    });
  }

  // Initialize
  const input = document.getElementById('ft-input') as HTMLInputElement;
  if (input) {
    input.addEventListener('input', () => generateResults(input.value));
    // Generate on page load if input has value
    if (input.value) generateResults(input.value);
  }

  // FAQ toggle
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      if (item) item.classList.toggle('open');
      btn.setAttribute('aria-expanded', item?.classList.contains('open') ? 'true' : 'false');
    });
  });

  // Theme toggle
  const themeBtn = document.getElementById('theme-toggle');
  if (themeBtn) {
    themeBtn.addEventListener('click', () => {
      const root = document.documentElement;
      const current = root.getAttribute('data-theme');
      root.setAttribute('data-theme', current === 'dark' ? 'light' : 'dark');
      localStorage.setItem('opnchat-theme', current === 'dark' ? 'light' : 'dark');
    });
    // Restore saved theme
    const saved = localStorage.getItem('opnchat-theme');
    if (saved) document.documentElement.setAttribute('data-theme', saved);
  }
</script>
