---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';
import { getRelativeLocaleUrl, getAbsoluteLocaleUrl } from 'astro:i18n';
import { languages, type Lang } from '../i18n/ui';
import SiteHeader from './SiteHeader.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import SEOHead from './SEOHead.astro';
import { localeMap } from '../i18n/localeMap';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const faqItems = [
  { q: t('ft.faq.q1'), a: t('ft.faq.a1') },
  { q: t('ft.faq.q2'), a: t('ft.faq.a2') },
  { q: t('ft.faq.q3'), a: t('ft.faq.a3') },
  { q: t('ft.faq.q4'), a: t('ft.faq.a4') },
  { q: t('ft.faq.q5'), a: t('ft.faq.a5') },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": t('ft.heading'),
      "url": getAbsoluteLocaleUrl(lang, 'fancy-text'),
      "description": t('ft.meta.description'),
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Any",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "inLanguage": Object.keys(languages),
      "featureList": [
        t('ft.seo.why.feature1.title') + ': ' + t('ft.seo.why.feature1.desc'),
        t('ft.seo.why.feature2.title') + ': ' + t('ft.seo.why.feature2.desc'),
        t('ft.seo.why.feature3.title') + ': ' + t('ft.seo.why.feature3.desc'),
        t('ft.seo.why.feature4.title') + ': ' + t('ft.seo.why.feature4.desc'),
      ],
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": { "@type": "Answer", "text": item.a }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "OPN Chat", "item": getAbsoluteLocaleUrl(lang, '') },
        { "@type": "ListItem", "position": 2, "name": t('bc.fancytext'), "item": getAbsoluteLocaleUrl(lang, 'fancy-text') }
      ]
    }
  ]
};
---

<Layout title={t('ft.meta.title')} lang={lang} service="fancy-text">
  <Fragment slot="meta">
  <SEOHead
  lang={lang}
  description={t('ft.meta.description')}
  canonicalUrl={getAbsoluteLocaleUrl(lang, 'fancy-text')}
  ogTitle={t('ft.meta.og.title')}
  ogDescription={t('ft.meta.og.description')}
  ogUrl={getAbsoluteLocaleUrl(lang, 'fancy-text')}
  schema={pageSchema}
  extraMeta={`<meta name="keywords" content="${t('ft.meta.keywords')}" /><meta name="twitter:card" content="summary" /><meta name="twitter:title" content="${t('ft.meta.twitter.title')}" /><meta name="twitter:description" content="${t('ft.meta.twitter.description')}" />`}
/>
</Fragment>

  <div class="container">
    <!-- Header -->
    <SiteHeader lang={lang} path="fancy-text" activeTool="fancy-text" />

    <Breadcrumbs lang={lang} items={[{ label: t('bc.home'), href: getRelativeLocaleUrl(lang) }, { label: t('bc.fancytext') }]} />

    <!-- Hero -->
    <div class="hero">
      <h1 class="title">{t('ft.heading')}</h1>
      <p class="subtitle">{t('ft.subheading')}</p>
      <p class="privacy-badge">{t('ft.privacy.badge')}</p>
    </div>

    <!-- Fancy Text Generator Tool -->
    <div class="ft-tool">
      <!-- Input -->
      <div class="form-group">
        <label for="ft-input" class="form-label">{t('ft.form.input.label')}</label>
        <input type="text" id="ft-input" class="form-input" placeholder={t('ft.form.input.placeholder')} maxlength="100" autocomplete="off" />
        <p class="form-hint">{t('ft.form.input.hint')}</p>
      </div>

      <!-- Results Grid -->
      <div id="ft-results" class="ft-results"></div>
    </div>

    <!-- SEO Content Section -->
    <section class="seo-section" aria-label="About Fancy Text Generator">

      <article class="seo-block">
        <h2 class="seo-heading">{t('ft.seo.what.heading')}</h2>
        <p class="seo-text">{t('ft.seo.what.text')}</p>
      </article>

      <article class="seo-block">
        <h2 class="seo-heading">{t('ft.seo.why.heading')}</h2>
        <div class="seo-features">
          <div class="feature-item">
            <span class="feature-icon">A</span>
            <div>
              <h3 class="feature-title">{t('ft.seo.why.feature1.title')}</h3>
              <p class="feature-desc">{t('ft.seo.why.feature1.desc')}</p>
            </div>
          </div>
          <div class="feature-item">
            <span class="feature-icon">&#9733;</span>
            <div>
              <h3 class="feature-title">{t('ft.seo.why.feature2.title')}</h3>
              <p class="feature-desc">{t('ft.seo.why.feature2.desc')}</p>
            </div>
          </div>
          <div class="feature-item">
            <span class="feature-icon">&#9889;</span>
            <div>
              <h3 class="feature-title">{t('ft.seo.why.feature3.title')}</h3>
              <p class="feature-desc">{t('ft.seo.why.feature3.desc')}</p>
            </div>
          </div>
          <div class="feature-item">
            <span class="feature-icon">&#9878;</span>
            <div>
              <h3 class="feature-title">{t('ft.seo.why.feature4.title')}</h3>
              <p class="feature-desc">{t('ft.seo.why.feature4.desc')}</p>
            </div>
          </div>
        </div>
      </article>

      <article class="seo-block">
        <h2 class="seo-heading">{t('ft.seo.how.heading')}</h2>
        <p class="seo-text">{t('ft.seo.how.text')}</p>
      </article>

      <article class="seo-block">
        <h2 class="seo-heading">{t('ft.seo.styles.heading')}</h2>
        <p class="seo-text">{t('ft.seo.styles.text')}</p>
      </article>

      <!-- FAQ -->
      <article class="seo-block">
        <h2 class="seo-heading">{t('ft.seo.faq.heading')}</h2>
        <div class="faq-list">
          {faqItems.map(item => (
            <div class="faq-item">
              <button type="button" class="faq-question" aria-expanded="false">
                <span class="faq-q-text">{item.q}</span>
                <svg class="faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
              <div class="faq-answer">
                <p class="faq-a-text">{item.a}</p>
              </div>
            </div>
          ))}
        </div>
      </article>
    </section>
</div>
</Layout>

<style>
  .container {
    position: relative;
    z-index: 1;
    width: 100%;
    margin: 0 auto;
    max-width: 640px;
    padding: 2rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Hero */
  .hero {
    text-align: center;
    padding: 1.5rem 0;
  }

  .title {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .subtitle {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin: 0.75rem 0 0;
    line-height: 1.5;
  }

  .privacy-badge {
    font-size: 0.75rem;
    color: var(--opn-primary);
    margin: 0.5rem 0 0;
    font-weight: 500;
    opacity: 0.9;
  }

  /* Form */
  .ft-tool {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .form-input {
    width: 100%;
    padding: 0.75rem 0.9rem;
    border: 1.5px solid var(--border-color);
    border-radius: 0.6rem;
    background: var(--bg-secondary);
    color: var(--text-primary);
    font-size: 0.95rem;
    transition: border-color 0.2s, box-shadow 0.2s;
    outline: none;
    box-sizing: border-box;
  }

  .form-input:focus {
    border-color: var(--opn-primary);
    box-shadow: 0 0 0 3px rgba(0, 180, 216, 0.15);
  }

  .form-hint {
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Results Grid */
  .ft-results {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .ft-result-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.65rem 0.9rem;
    border: 1.5px solid var(--border-color);
    border-radius: 0.6rem;
    background: var(--bg-secondary);
    transition: border-color 0.2s, background 0.2s;
    cursor: default;
  }

  .ft-result-card:hover {
    border-color: var(--opn-primary);
    background: var(--bg-card-hover);
  }

  .ft-style-name {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-secondary);
    width: 5.5rem;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .ft-style-output {
    flex: 1;
    font-size: 0.9rem;
    color: var(--text-primary);
    word-break: break-word;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ft-copy-btn {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--border-color);
    border-radius: 0.4rem;
    background: var(--bg-primary);
    color: var(--text-secondary);
    font-size: 0.75rem;
    cursor: pointer;
    transition: all 0.15s;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .ft-copy-btn:hover {
    border-color: var(--opn-primary);
    color: var(--opn-primary);
    background: rgba(0, 180, 216, 0.08);
  }

  .ft-copy-btn.copied {
    border-color: #25D366;
    color: #25D366;
  }

  .ft-copy-icon {
    width: 0.85rem;
    height: 0.85rem;
  }

  /* SEO Section */
  .seo-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-top: 1rem;
  }

  .seo-block { }

  .seo-heading {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.5rem;
  }

  .seo-text {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.6;
  }

  /* SEO Features */
  .seo-features {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.6rem 0;
  }

  .feature-icon {
    font-size: 1.3rem;
    color: var(--opn-primary);
    flex-shrink: 0;
    width: 2rem;
    text-align: center;
  }

  .feature-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 0.2rem;
  }

  .feature-desc {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  /* FAQ */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .faq-item {
    border: 1px solid var(--border-color);
    border-radius: 0.5rem;
    overflow: hidden;
    transition: border-color 0.2s;
  }

  .faq-item:hover {
    border-color: var(--opn-primary);
  }

  .faq-question {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 0.9rem;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-primary);
    font-size: 0.85rem;
    font-weight: 600;
    text-align: left;
    gap: 0.5rem;
  }

  .faq-q-text { flex: 1; }

  .faq-chevron {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    transition: transform 0.3s;
    color: var(--text-secondary);
  }

  .faq-item.open .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s ease, padding 0.35s ease;
    padding: 0 0.9rem;
  }

  .faq-item.open .faq-answer {
    max-height: 500px;
    padding: 0.5rem 0.9rem 0.75rem;
  }

  .faq-a-text {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* Responsive — 640px */
  @media (max-width: 640px) {
    .container {
      padding: 1.5rem 1rem;
    }

    .title {
      font-size: 1.3rem;
    }
  }

  /* Responsive — 520px (deep mobile) */
  @media (max-width: 520px) {
    .container {
      padding: 1.25rem 0.75rem;
      gap: 1rem;
    }
    .title {
      font-size: 1.1rem;
    }
    .subtitle {
      font-size: 0.8rem;
    }
    .hero {
      padding: 1rem 0;
    }
    .ft-result-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.3rem;
    }
    .ft-style-name {
      width: auto;
    }
    .ft-style-output {
      white-space: normal;
    }
    .ft-copy-btn {
      align-self: flex-end;
    }
    .seo-heading {
      font-size: 1rem;
    }
    .feature-item {
      gap: 0.5rem;
    }
    .feature-icon {
      width: 1.5rem;
    }
  }
</style>

